{% extends "layout.html.twig" %}
{% block title %}{{ post.title }} · {{ site.site_name }}{% endblock %}
{% block body %}
<nav class="breadcrumb" aria-label="현재 위치"><a href="{{ url_for('boards.index') }}">커뮤니티</a><span class="breadcrumb-separator" aria-hidden="true">→</span><a href="{{ url_for('posts.index', {'key': board.board_key}) }}">{{ board.name }}</a><span class="breadcrumb-separator" aria-hidden="true">→</span><strong>이야기</strong></nav>
<div class="studio-article-layout">
  <article class="surface article-card">
    <header class="article-header">
      <div class="studio-article-label">{% if post.category %}<span>{{ post.category }}</span>{% endif %}<span>POST</span></div>
      <h1 class="article-title">{{ post.title }}</h1>
      <p class="article-meta"><strong>{{ post.author_name }}</strong><span>{{ post.created_at }}</span><span>조회 {{ post.view_count }}</span></p>
    </header>
    <div class="article-body">{{ post.content|nl2br }}</div>
    {% if post.attachments is not empty %}
      <section class="studio-attachments" aria-labelledby="attachments-title"><h2 id="attachments-title">첨부파일</h2><ul class="attachments">
      {% for file in post.attachments %}<li><a href="{{ url_for('files.download', {'id': post.id, 'index': file.index}) }}">{{ file.name }}</a><span class="muted">{{ file.size }} bytes</span></li>{% endfor %}
      </ul></section>
    {% endif %}
    <section class="comments" aria-labelledby="comments-title">
      <div class="studio-comments-head"><h2 id="comments-title">댓글</h2><span>{{ post.comment_count }}</span></div>
      {% if comments is empty %}<div class="studio-comment-empty"><p>아직 댓글이 없습니다.</p><span>첫 반응을 기다리고 있어요.</span></div>{% else %}{% include 'posts/_comments.html.twig' with {'nodes': comments, 'nested': false} only %}{% endif %}
    </section>
  </article>
  <aside class="studio-article-aside">
    <span>IN THIS BOARD</span><strong>{{ board.name }}</strong>
    {% if board.description %}<p>{{ board.description }}</p>{% endif %}
    <a href="{{ url_for('posts.index', {'key': board.board_key}) }}">목록으로 돌아가기 <span aria-hidden="true">→</span></a>
  </aside>
</div>
{% endblock %}
