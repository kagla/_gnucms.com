{% extends "layout.html.twig" %}
{% block title %}새 이야기 · {{ board.name }} · {{ site.site_name }}{% endblock %}
{% block body %}
<nav class="breadcrumb" aria-label="현재 위치"><a href="{{ url_for('boards.index') }}">커뮤니티</a><span class="breadcrumb-separator">→</span><a href="{{ url_for('posts.index', {'key': board.board_key}) }}">{{ board.name }}</a><span class="breadcrumb-separator">→</span><strong>새 이야기</strong></nav>
<div class="studio-compose-layout">
  <aside class="studio-compose-intro"><p class="section-index">NEW STORY</p><h1>생각을<br>들려주세요.</h1><p>{{ board.name }}에 새로운 이야기를 남깁니다. 제목은 명확하게, 내용은 편안하게 작성해 보세요.</p><span aria-hidden="true">✦</span></aside>
  <section class="surface editor-card">
    <form class="editor-form" method="post" action="{{ url_for('posts.create', {'key': board.board_key}) }}">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      {% if board.use_category and board.categories is not empty %}
        <label>분류<select name="category" required><option value="">분류를 선택하세요</option>{% for name in board.categories %}<option value="{{ name }}"{% if values.category|default('') == name %} selected{% endif %}>{{ name }}</option>{% endfor %}</select></label>
        {% if errors.category is defined %}<p class="field-error">{{ errors.category }}</p>{% endif %}
      {% endif %}
      <label>제목<input type="text" name="title" value="{{ values.title|default('') }}" maxlength="200" placeholder="어떤 이야기인가요?" required autofocus></label>
      {% if errors.title is defined %}<p class="field-error">{{ errors.title }}</p>{% endif %}
      <label>내용<textarea name="content" rows="13" placeholder="자유롭게 이야기를 작성해 주세요." required>{{ values.content|default('') }}</textarea></label>
      {% if errors.content is defined %}<p class="field-error">{{ errors.content }}</p>{% endif %}
      {% if board.use_secret %}<label class="check-label"><input type="checkbox" name="is_secret" value="1"{% if values.is_secret|default(false) %} checked{% endif %}><span>비밀글로 작성</span></label>{% endif %}
      <div class="form-actions"><a class="button button-secondary" href="{{ url_for('posts.index', {'key': board.board_key}) }}">취소</a><button type="submit">이야기 등록</button></div>
    </form>
  </section>
</div>
{% endblock %}
