{% extends "layout.html.twig" %}
{% import _self as pager %}
{% macro pageLink(board, query, p, label) %}<a href="{{ url_for('posts.index', {'key': board.board_key}) }}?page={{ p }}{% if query.q %}&amp;q={{ query.q|url_encode }}{% endif %}{% if query.category %}&amp;category={{ query.category|url_encode }}{% endif %}" aria-label="{{ p }} 페이지">{{ label|default(p) }}</a>{% endmacro %}
{% block title %}{{ board.name }} · {{ site.site_name }}{% endblock %}
{% block body %}
<nav class="breadcrumb" aria-label="현재 위치"><a href="{{ url_for('boards.index') }}">커뮤니티</a><span class="breadcrumb-separator" aria-hidden="true">→</span><strong>{{ board.name }}</strong></nav>
<header class="studio-board-hero">
  <div><p class="section-index">BOARD / {{ board.board_key|upper }}</p><h1>{{ board.name }}</h1>{% if board.description %}<p>{{ board.description }}</p>{% endif %}</div>
  {% if can_write %}<a class="button studio-write-button" href="{{ url_for('posts.create', {'key': board.board_key}) }}"><span aria-hidden="true">＋</span>새 이야기</a>{% endif %}
</header>
<div class="studio-board-toolbar">
  <p><strong>{{ list.total|default(list.data|length) }}</strong>개의 이야기</p>
  <form class="board-search" method="get" action="{{ url_for('posts.index', {'key': board.board_key}) }}" role="search">
    {% if board.use_category and board.categories is not empty %}<select name="category" aria-label="분류 선택"><option value="">전체 분류</option>{% for name in board.categories %}<option value="{{ name }}"{% if query.category == name %} selected{% endif %}>{{ name }}</option>{% endfor %}</select>{% endif %}
    <div class="board-search-field"><span class="board-search-icon" aria-hidden="true"></span><input type="search" name="q" value="{{ query.q }}" placeholder="제목이나 내용 검색" aria-label="게시글 검색"></div>
    <button type="submit">검색</button>
  </form>
</div>
<section class="studio-posts" aria-label="게시글 목록">
{% if list.data is empty and list.notices is empty %}
  <div class="studio-empty"><span aria-hidden="true">＋</span><h3>아직 이야기가 없습니다</h3><p>첫 번째 이야기를 남겨보세요.</p></div>
{% else %}
  <div class="studio-posts-label"><span>이야기</span><span>글쓴이</span><span>날짜</span><span>조회</span></div>
  {% for post in list.notices|merge(list.data) %}
  <article class="studio-post-row">
    <a class="studio-post-title" href="{{ url_for('posts.show', {'id': post.id}) }}">
      <span class="studio-post-flags">{% if post.is_notice %}<b>NOTICE</b>{% elseif board.use_category and post.category %}<b class="category">{{ post.category }}</b>{% endif %}{% if post.is_secret %}<i title="비밀글" aria-label="비밀글">●</i>{% endif %}</span>
      <strong>{{ post.title }}</strong>
      {% if post.comment_count > 0 %}<em>{{ post.comment_count }}</em>{% endif %}
      {% if post.file_count > 0 %}<i class="studio-file" title="첨부파일 있음" aria-label="첨부파일 있음">＋</i>{% endif %}
    </a>
    <span class="studio-post-author">{{ post.author_name }}</span>
    <time datetime="{{ post.created_at }}">{{ post.created_at|slice(0, 10) }}</time>
    <span class="studio-post-views">{{ post.view_count }}</span>
  </article>
  {% endfor %}
{% endif %}
</section>
{% if list.total_pages > 1 %}{% set window = 5 %}{% set start = max(1, list.page - window) %}{% set end = min(list.total_pages, list.page + window) %}<nav class="pagination" aria-label="페이지 이동">{% if start > 1 %}{{ pager.pageLink(board, query, 1) }}{% if start > 2 %}<span class="muted">…</span>{% endif %}{% endif %}{% for p in start..end %}{% if p == list.page %}<strong aria-current="page">{{ p }}</strong>{% else %}{{ pager.pageLink(board, query, p) }}{% endif %}{% endfor %}{% if end < list.total_pages %}{% if end < list.total_pages - 1 %}<span class="muted">…</span>{% endif %}{{ pager.pageLink(board, query, list.total_pages) }}{% endif %}</nav>{% endif %}
{% endblock %}
