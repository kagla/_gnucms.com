{% extends "admin/layout.html.twig" %}
{% block title %}관리 · {{ site.site_name }}{% endblock %}
{% block admin_section %}dashboard{% endblock %}
{% block body %}
<div class="page-head"><div class="page-head-copy"><p class="eyebrow">1인 운영</p><h1>사이트 관리</h1><p class="lead">사이트 내용과 커뮤니티를 복잡한 절차 없이 관리합니다.</p></div><div class="admin-actions"><a class="button" href="{{ url_for('admin.content.create') }}"><span aria-hidden="true">＋</span>내용 만들기</a></div></div>
{% if query.saved|default('') == '1' %}<p class="notice success">변경사항을 저장했습니다.</p>{% endif %}
{% if query.deleted|default('') == '1' %}<p class="notice success">게시판을 삭제했습니다.</p>{% endif %}
<section class="admin-stats" aria-label="운영 현황">
  <a class="surface stat-card stat-card-link" href="{{ url_for('admin.boards') }}"><span>게시판</span><strong>{{ board_count }}</strong><small>관리하기 →</small></a>
  <article class="surface stat-card"><span>내용</span><strong>{{ page_count }}</strong></article>
  <article class="surface stat-card"><span>게시글 / 회원</span><strong>{{ post_count }} / {{ user_count }}</strong></article>
</section>
{% endblock %}
