{% extends "layout.html.twig" %}
{% import '_icons.html.twig' as ico %}
{% block title %}비밀번호 변경 완료 · {{ site.site_name }}{% endblock %}
{% block body %}
<div class="auth-wrap">
  <section class="card auth-card auth-card-status">
    <div class="card-body">
      <span class="auth-mark auth-mark-ok" aria-hidden="true">{{ ico.i('check-circle', 24) }}</span>
      <h1 class="card-title">비밀번호를 변경했어요</h1>
      <p class="card-sub">새 비밀번호로 다시 로그인해 주세요.</p>
      <div class="card-actions"><a class="btn btn-primary btn-block btn-lg" href="{{ url_for('auth.login') }}">로그인</a></div>
    </div>
  </section>
</div>
{% endblock %}
