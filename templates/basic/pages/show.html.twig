{% extends "layout.html.twig" %}
{% import '_icons.html.twig' as ico %}
{% block title %}{{ page.title }} · {{ site.site_name }}{% endblock %}
{% block meta_description %}<meta name="description" content="{{ page.seo_description ?: site.site_tagline }}">{% endblock %}
{% block body %}
{% if not preview and not current_user.is_guest and current_user.is_admin %}
  <div class="alert alert-info admin-bar">
    <span aria-hidden="true">{{ ico.i('cog', 17) }}</span>
    <span>관리자에게만 보입니다.</span>
    <a class="btn btn-sm btn-primary" href="{{ url_for('admin.content.edit', {id: page.id}) }}">이 내용 수정</a>
  </div>
{% endif %}
{% if preview %}
  <div class="alert alert-info">
    <span aria-hidden="true">{{ ico.i('info', 18) }}</span>
    <span>{{ page.status == 'published' ? '공개된 내용 미리보기입니다.' : '아직 공개되지 않은 초안 미리보기입니다.' }}</span>
    <a class="btn btn-sm btn-ghost" href="{{ url_for('admin.content.edit', {id: page.id}) }}">편집으로 돌아가기</a>
  </div>
{% endif %}
<div class="read-progress" aria-hidden="true"></div>
<article class="card article article-page">
  <div class="card-body article-head">
    <span class="badge badge-ghost">{{ site.site_name }}</span>
    <h1 class="card-title article-title">{{ page.title }}</h1>
    {% if page.seo_description %}<p class="article-summary">{{ page.seo_description }}</p>{% endif %}
  </div>
  <div class="divider divider-flush"></div>
  <div class="card-body article-body prose rich-content">{{ page.content|cms_html }}</div>
</article>
{% endblock %}
