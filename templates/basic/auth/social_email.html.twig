{% extends "layout.html.twig" %}
{% import '_icons.html.twig' as ico %}
{% block title %}이메일 확인 · {{ site.site_name }}{% endblock %}
{% block body %}
<div class="auth-wrap">
  <section class="card auth-card">
    <div class="card-body">
      <div class="auth-head">
        <span class="auth-mark auth-mark-soft" aria-hidden="true">{{ ico.i('mail', 22) }}</span>
        <h1 class="card-title">이메일을 확인해 주세요</h1>
        <p class="card-sub">{{ provider_label }} 계정을 안전하게 연결하려면 사용할 이메일 주소를 한 번 확인해야 해요.</p>
      </div>
      <form method="post" action="{{ url_for('oauth.email') }}">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <fieldset class="fieldset{% if errors.email is defined %} is-invalid{% endif %}">
          <legend class="fieldset-legend">이메일</legend>
          <label class="input input-bordered input-block">
            <span class="input-icon" aria-hidden="true">{{ ico.i('mail', 16) }}</span>
            <input type="email" name="email" value="{{ values.email|default('') }}" maxlength="191" autocomplete="email" required>
          </label>
          {% if errors.email is defined %}<p class="validator-hint">{{ ico.i('warning', 14) }} {{ errors.email }}</p>{% endif %}
        </fieldset>
        <button class="btn btn-primary btn-block btn-lg" type="submit">확인 메일 보내기</button>
      </form>
    </div>
  </section>
</div>
{% endblock %}
