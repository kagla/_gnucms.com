{% import '_icons.html.twig' as ico %}
{# 목록 항목의 글쓴이·날짜·집계. 형태마다 같은 정보를 같은 모양으로 쓴다. #}
<div class="post-meta">
  <span class="avatar avatar-placeholder avatar-xs">
    <span class="avatar-inner" data-tone="{{ post.author_name|length % 6 }}" aria-hidden="true"><span>{{ post.author_name|slice(0, 1)|upper }}</span></span>
  </span>
  <span class="post-author">{{ post.author_name }}</span>
  <span aria-hidden="true">·</span>
  <time datetime="{{ post.created_at }}">{{ post.created_at|date('Y.m.d') }}</time>
</div>
<div class="post-stats">
  <span>{{ ico.i('eye', 14) }}{{ post.view_count }}</span>
  {% if post.file_count > 0 %}<span>{{ ico.i('clip', 14) }}{{ post.file_count }}</span>{% endif %}
</div>
