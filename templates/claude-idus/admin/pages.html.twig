{% extends "admin/layout.html.twig" %}
{% import '_icons.html.twig' as ico %}
{% block title %}내용 관리 · {{ site.site_name }}{% endblock %}
{% block admin_section %}content{% endblock %}
{% block body %}
<div class="breadcrumbs"><ul><li><a href="{{ url_for('admin.index') }}">사이트 관리</a></li><li aria-current="page">내용</li></ul></div>
<div class="page-head">
  <div><h1>내용 관리</h1><p class="page-sub">소개·이용안내 같은 사이트 내용을 작성합니다. 공개와 메뉴 표시만 고르면 됩니다.</p></div>
  <div class="page-head-actions">
    <a class="btn btn-outline" href="{{ url_for('admin.content.trash') }}">{{ ico.i('trash', 15) }} 휴지통{% if trash_count > 0 %} <span class="badge badge-ghost badge-sm">{{ trash_count }}</span>{% endif %}</a>
    <a class="btn btn-primary" href="{{ url_for('admin.content.create') }}">{{ ico.i('plus', 16) }} 내용 만들기</a>
  </div>
</div>
{% if query.saved|default('') == '1' %}<div class="alert alert-success"><span aria-hidden="true">{{ ico.i('check-circle', 18) }}</span><span>내용을 저장했습니다.</span></div>{% endif %}
{% if query.deleted|default('') == '1' %}<div class="alert alert-success"><span aria-hidden="true">{{ ico.i('check-circle', 18) }}</span><span>내용을 휴지통으로 옮겼습니다.</span></div>{% endif %}
<section class="card">
  <div class="table-wrap">
    <table class="table table-zebra">
      <thead><tr><th>제목</th><th>주소</th><th>상태</th><th>메뉴</th><th class="right">관리</th></tr></thead>
      <tbody>
      {% for page in pages %}
        <tr>
          <td data-label="제목">
            {% if page.status == 'published' %}<a class="cell-title link link-hover" href="{{ url_for('content.show', {slug: page.slug}) }}">{{ page.title }}</a>
            {% else %}<span class="cell-title">{{ page.title }}</span>{% endif %}
          </td>
          <td data-label="주소"><code class="kbd kbd-sm">/content/{{ page.slug }}</code></td>
          <td data-label="상태"><span class="badge badge-sm badge-soft {{ page.status == 'published' ? 'badge-success' : 'badge-ghost' }}">{{ page.status == 'published' ? '공개' : '초안' }}</span></td>
          <td data-label="메뉴">{{ page.show_in_menu ? '표시' : '숨김' }}</td>
          <td data-label="관리" class="right">
            <div class="join">
              <a class="btn btn-outline btn-sm join-item" href="{{ url_for('admin.content.preview', {id: page.id}) }}" target="_blank" rel="noopener">미리보기</a>
              <a class="btn btn-outline btn-sm join-item" href="{{ url_for('admin.content.edit', {id: page.id}) }}">수정</a>
            </div>
          </td>
        </tr>
      {% else %}
        <tr class="table-empty"><td colspan="5">아직 등록된 내용이 없습니다.</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endblock %}
