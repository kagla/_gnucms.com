{% extends "admin/layout.html.twig" %}
{% import '_icons.html.twig' as ico %}
{% block title %}{{ values.title }} 수정 · {{ site.site_name }}{% endblock %}
{% block admin_section %}legal{% endblock %}
{% block body %}
<div class="breadcrumbs"><ul><li><a href="{{ url_for('admin.index') }}">사이트 관리</a></li><li><a href="{{ url_for('admin.terms') }}">약관</a></li><li aria-current="page">{{ values.title }}</li></ul></div>
<section class="card">
  <div class="card-body">
    <h1 class="card-title">{{ values.title }} 수정</h1>
    <p class="card-sub">공개 주소는 <code class="kbd kbd-sm">/{{ type }}</code>로 고정되며, 공개하면 회원가입에 자동 연결됩니다.</p>
    <form method="post" action="{{ url_for('admin.terms.edit', {type: type}) }}">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <input type="hidden" name="image_key" value="{{ values.image_key }}">
      <input type="hidden" name="uploaded_images" value="{{ values.uploaded_images|default('') }}" data-uploaded-images>
      <fieldset class="fieldset{% if errors.title is defined %} is-invalid{% endif %}">
        <legend class="fieldset-legend">제목</legend>
        <input class="input input-bordered input-block" type="text" name="title" value="{{ values.title|default('') }}" maxlength="200" required>
        {% if errors.title is defined %}<p class="validator-hint">{{ ico.i('warning', 14) }} {{ errors.title }}</p>{% endif %}
      </fieldset>
      <fieldset class="fieldset{% if errors.content is defined %} is-invalid{% endif %}">
        <legend class="fieldset-legend">내용</legend>
        <textarea class="textarea textarea-bordered textarea-block" id="content-editor" name="content" rows="18" data-cms-editor>{{ values.content|default('') }}</textarea>
        <p class="fieldset-label">사진 올리기에서 여러 장을 선택하거나 편집 영역으로 끌어놓을 수 있습니다.</p>
        {% if errors.content is defined %}<p class="validator-hint">{{ ico.i('warning', 14) }} {{ errors.content }}</p>{% endif %}
      </fieldset>
      <fieldset class="fieldset">
        <legend class="fieldset-legend">상태</legend>
        <select class="select select-bordered select-block" name="status">
          <option value="draft"{{ values.status|default('draft') == 'draft' ? ' selected' : '' }}>초안</option>
          <option value="published"{{ values.status|default('draft') == 'published' ? ' selected' : '' }}>공개</option>
        </select>
      </fieldset>
      <input type="hidden" name="sort_order" value="{{ values.sort_order|default(0) }}">
      <div class="card-actions form-actions">
        <a class="btn btn-outline" href="{{ url_for('admin.terms.preview', {type: type}) }}" target="_blank" rel="noopener">{{ ico.i('eye', 15) }} 미리보기</a>
        <a class="btn btn-ghost" href="{{ url_for('admin.terms') }}">취소</a>
        <button class="btn btn-primary" type="submit">변경사항 저장</button>
      </div>
    </form>
  </div>
</section>
{% endblock %}
{% block scripts %}{% include "admin/_editor.html.twig" %}{% endblock %}
