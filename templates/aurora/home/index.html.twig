{% extends "layout.html.twig" %}
{% block title %}{{ site.site_name }} · {{ site.site_tagline }}{% endblock %}
{% block body %}
<section class="aurora-hero">
  <div class="aurora-hero-copy">
    <p class="aurora-badge"><span aria-hidden="true"></span> Welcome</p>
    <h1>{{ site.home_title }}</h1>
    <p class="aurora-lead">{{ site.home_intro }}</p>
    {% if boards is not empty %}
      <div class="aurora-hero-actions">
        <a class="aurora-btn aurora-btn-primary aurora-btn-lg" href="{{ url_for('posts.index', {'key': boards[0].board_key}) }}">이야기 둘러보기</a>
        <a class="aurora-btn aurora-btn-ghost aurora-btn-lg" href="#aurora-boards">게시판 목록</a>
      </div>
    {% endif %}
  </div>
  <aside class="aurora-hero-stats" aria-label="커뮤니티 요약">
    <div class="aurora-stat-card">
      <span class="aurora-stat-label">게시판</span>
      <strong>{{ boards|length }}</strong>
    </div>
    <div class="aurora-stat-card">
      <span class="aurora-stat-label">오늘의 기분</span>
      <strong>함께 ✦</strong>
    </div>
    <div class="aurora-stat-card aurora-stat-accent">
      <span class="aurora-stat-label">상태</span>
      <strong>OPEN</strong>
    </div>
  </aside>
</section>

<section class="aurora-boards" id="aurora-boards" aria-labelledby="aurora-boards-title">
  <header class="aurora-section-head">
    <div>
      <p class="aurora-section-kicker">Spaces</p>
      <h2 id="aurora-boards-title">게시판 둘러보기</h2>
    </div>
    <p class="aurora-section-desc">관심 있는 주제의 공간으로 들어가 이야기를 시작해 보세요.</p>
  </header>

  {% if boards is empty %}
    <div class="aurora-empty-state">
      <span class="aurora-empty-icon" aria-hidden="true">◇</span>
      <p>아직 만들어진 게시판이 없습니다.</p>
    </div>
  {% else %}
    <div class="aurora-board-grid">
      {% for board in boards %}
        <article class="aurora-board-card">
          <a class="aurora-board-card-head" href="{{ url_for('posts.index', {'key': board.board_key}) }}">
            <span class="aurora-board-index">{{ '%02d'|format(loop.index) }}</span>
            <div>
              <h3>{{ board.name }}</h3>
              <p>{{ board.description ?: '새로운 이야기와 소식을 확인해 보세요.' }}</p>
            </div>
            <span class="aurora-board-arrow" aria-hidden="true">→</span>
          </a>
          <div class="aurora-board-latest">
            <div class="aurora-board-latest-head">
              <span>최신글</span>
              <a href="{{ url_for('posts.index', {'key': board.board_key}) }}">전체</a>
            </div>
            {% if board.latest_posts is empty %}
              <p class="aurora-board-latest-empty">첫 이야기를 기다리고 있어요.</p>
            {% else %}
              <ul>
                {% for post in board.latest_posts|slice(0, 4) %}
                  <li>
                    <a href="{{ url_for('posts.show', {'id': post.id}) }}">
                      <span>{% if post.is_notice %}<em class="aurora-tag">공지</em>{% endif %}{{ post.title }}{% if post.comment_count > 0 %}<b>{{ post.comment_count }}</b>{% endif %}</span>
                      <time datetime="{{ post.created_at }}">{{ post.created_at|slice(5, 5) }}</time>
                    </a>
                  </li>
                {% endfor %}
              </ul>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  {% endif %}
</section>
{% endblock %}
