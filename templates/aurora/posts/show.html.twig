{% extends "layout.html.twig" %}
{% block title %}{{ post.title }} · {{ site.site_name }}{% endblock %}
{% block body %}
<nav class="aurora-crumb" aria-label="현재 위치">
  <a href="{{ url_for('boards.index') }}">홈</a>
  <span aria-hidden="true">/</span>
  <a href="{{ url_for('posts.index', {'key': board.board_key}) }}">{{ board.name }}</a>
  <span aria-hidden="true">/</span>
  <span>글</span>
</nav>

<article class="aurora-article">
  <header class="aurora-article-head">
    <div class="aurora-post-card-tags">
      {% if post.is_notice %}<span class="aurora-tag">공지</span>{% endif %}
      {% if post.category %}<span class="aurora-tag aurora-tag-soft">{{ post.category }}</span>{% endif %}
    </div>
    <h1>{{ post.title }}</h1>
    <div class="aurora-article-meta">
      <span class="aurora-author">{{ post.author_name }}</span>
      <time datetime="{{ post.created_at }}">{{ post.created_at }}</time>
      <span>조회 {{ post.view_count }}</span>
    </div>
  </header>
  <div class="aurora-article-body">{{ post.content|nl2br }}</div>
  {% if post.attachments is not empty %}
    <section class="aurora-attachments" aria-labelledby="attachments-title">
      <h2 id="attachments-title">첨부파일</h2>
      <ul>
        {% for file in post.attachments %}
          <li>
            <a href="{{ url_for('files.download', {'id': post.id, 'index': file.index}) }}">{{ file.name }}</a>
            <span class="muted">{{ file.size }} bytes</span>
          </li>
        {% endfor %}
      </ul>
    </section>
  {% endif %}
  <section class="aurora-comments" aria-labelledby="comments-title">
    <h2 id="comments-title">댓글 <span>{{ post.comment_count }}</span></h2>
    {% if comments is empty %}
      <div class="aurora-empty-state aurora-empty-compact">
        <p>첫 댓글을 기다리고 있습니다.</p>
      </div>
    {% else %}
      {% include 'posts/_comments.html.twig' with {'nodes': comments, 'nested': false} only %}
    {% endif %}
  </section>
</article>
{% endblock %}
