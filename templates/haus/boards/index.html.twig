{% extends "layout.html.twig" %}
{% import '_icons.html.twig' as ico %}
{% block title %}게시판 · {{ site.site_name }}{% endblock %}
{% block nav_section %}home{% endblock %}
{% block body %}
{% set recent = boards|reduce((c, b) => c + b.latest_posts|length, 0) %}

<section class="hero">
  <span class="hero-glow" aria-hidden="true"></span>
  <div class="hero-copy">
    <span class="badge badge-primary">{{ ico.i('sparkle', 13) }} {{ site.site_tagline }}</span>
    <h1 class="hero-title">{{ site.home_title }}</h1>
    <p class="hero-lead">{{ site.home_intro }}</p>
    <div class="hero-actions">
      {% if boards is not empty %}
        <a class="btn btn-primary btn-lg" href="{{ url_for('posts.index', {'key': boards[0].board_key}) }}">
          둘러보기 {{ ico.i('arrow-right', 17) }}
        </a>
      {% endif %}
      {% if current_user.is_guest and registration_available %}
        <a class="btn btn-white btn-lg" href="{{ url_for('auth.register') }}">회원가입</a>
      {% endif %}
    </div>
  </div>
  <dl class="hero-stats">
    <div><dt>게시판</dt><dd>{{ boards|length }}</dd></div>
    <div><dt>최근 글</dt><dd>{{ recent }}</dd></div>
  </dl>
</section>

{% if boards is not empty %}
  <nav class="shortcuts" aria-label="게시판 바로가기">
    {% for board in boards %}
      <a class="shortcut" href="{{ url_for('posts.index', {'key': board.board_key}) }}">
        <span class="shortcut-icon" data-tone="{{ loop.index0 % 6 }}" aria-hidden="true">{{ ico.i('board', 20) }}</span>
        <span class="shortcut-name">{{ board.name }}</span>
      </a>
    {% endfor %}
  </nav>
{% endif %}

{% if boards is empty %}
  <div class="empty">
    <span class="empty-icon" aria-hidden="true">{{ ico.i('board', 26) }}</span>
    <p class="empty-title">아직 만들어진 게시판이 없습니다</p>
    <p class="empty-text">관리 콘솔에서 첫 게시판을 만들어 보세요.</p>
    {% if not current_user.is_guest and current_user.is_admin %}
      <a class="btn btn-primary" href="{{ url_for('admin.boards.create') }}">{{ ico.i('plus', 16) }} 게시판 만들기</a>
    {% endif %}
  </div>
{% else %}
  {% for board in boards %}
    <section class="feed" aria-labelledby="feed-{{ board.board_key }}">
      <header class="feed-head">
        <div>
          <h2 id="feed-{{ board.board_key }}">{{ board.name }}</h2>
          <p class="feed-sub">{{ board.description ?: '새로운 이야기와 소식을 확인해 보세요.' }}</p>
        </div>
        <a class="feed-more" href="{{ url_for('posts.index', {'key': board.board_key}) }}">전체보기 {{ ico.i('chevron-right', 15) }}</a>
      </header>

      {% if board.latest_posts is empty %}
        <div class="empty empty-sm">
          <span class="empty-icon" aria-hidden="true">{{ ico.i('document', 22) }}</span>
          <p class="empty-title">아직 등록된 글이 없습니다</p>
        </div>
      {% else %}
        <div class="rail">
          {% for post in board.latest_posts %}
            <a class="post-card" href="{{ url_for('posts.show', {'id': post.id}) }}">
              <span class="post-cover" data-tone="{{ post.id % 6 }}">
                <span class="post-cover-tag">{% if post.is_notice %}공지{% elseif post.category %}{{ post.category }}{% else %}{{ board.name }}{% endif %}</span>
                <span class="post-cover-mark" aria-hidden="true">{{ post.title|slice(0, 1) }}</span>
              </span>
              <span class="post-card-body">
                <span class="post-card-title">{{ post.title }}</span>
                <span class="post-card-meta">
                  <span class="avatar avatar-xs" data-tone="{{ post.author_name|length % 6 }}" aria-hidden="true">{{ post.author_name|slice(0, 1)|upper }}</span>
                  <span class="post-card-author">{{ post.author_name }}</span>
                  <span class="sep" aria-hidden="true">·</span>
                  <time datetime="{{ post.created_at }}">{{ post.created_at|date('m.d') }}</time>
                </span>
                <span class="post-card-stats">
                  <span>{{ ico.i('eye', 14) }}{{ post.view_count }}</span>
                  <span>{{ ico.i('comment', 14) }}{{ post.comment_count }}</span>
                </span>
              </span>
            </a>
          {% endfor %}
        </div>
      {% endif %}
    </section>
  {% endfor %}
{% endif %}
{% endblock %}
