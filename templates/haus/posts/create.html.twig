{% extends "layout.html.twig" %}
{% import '_icons.html.twig' as ico %}
{% block title %}글쓰기 · {{ board.name }} · {{ site.site_name }}{% endblock %}
{% block nav_section %}board{% endblock %}
{% block extra_tabs %}<a class="nav-tab is-active" href="{{ url_for('posts.index', {'key': board.board_key}) }}" aria-current="page">{{ board.name }}</a>{% endblock %}
{% block body %}
<nav class="breadcrumb" aria-label="현재 위치">
  <a href="{{ url_for('boards.index') }}">홈</a>
  <span aria-hidden="true">{{ ico.i('chevron-right', 13) }}</span>
  <a href="{{ url_for('posts.index', {'key': board.board_key}) }}">{{ board.name }}</a>
  <span aria-hidden="true">{{ ico.i('chevron-right', 13) }}</span>
  <span aria-current="page">글쓰기</span>
</nav>

<section class="card">
  <div class="card-header">
    <h1>{{ ico.i('pencil', 19) }} 글쓰기</h1>
    <p class="card-sub">{{ board.name }}에 남길 이야기를 적어 주세요.</p>
  </div>

  <form class="card-body form" method="post" action="{{ url_for('posts.create', {'key': board.board_key}) }}">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

    {% if board.use_category and board.categories is not empty %}
      <div class="form-group{% if errors.category is defined %} has-error{% endif %}">
        <span class="label">분류</span>
        <div class="chip-picker">
          {% for name in board.categories %}
            <label class="chip-radio">
              <input type="radio" name="category" value="{{ name }}"{% if values.category|default('') == name %} checked{% endif %} required>
              <span>{{ name }}</span>
            </label>
          {% endfor %}
        </div>
        {% if errors.category is defined %}<p class="error-text">{{ ico.i('warning', 14) }} {{ errors.category }}</p>{% endif %}
      </div>
    {% endif %}

    <div class="form-group{% if errors.title is defined %} has-error{% endif %}">
      <label class="label" for="post-title">제목</label>
      <input class="input" id="post-title" type="text" name="title" value="{{ values.title|default('') }}" maxlength="200" required autofocus placeholder="제목을 입력해 주세요">
      {% if errors.title is defined %}<p class="error-text">{{ ico.i('warning', 14) }} {{ errors.title }}</p>{% endif %}
    </div>

    <div class="form-group{% if errors.content is defined %} has-error{% endif %}">
      <label class="label" for="post-content">내용</label>
      <textarea class="input textarea" id="post-content" name="content" rows="14" required placeholder="어떤 이야기를 나누고 싶으신가요?" data-autogrow>{{ values.content|default('') }}</textarea>
      {% if errors.content is defined %}<p class="error-text">{{ ico.i('warning', 14) }} {{ errors.content }}</p>{% endif %}
    </div>

    {% if board.use_secret %}
      <label class="switch">
        <input type="checkbox" name="is_secret" value="1"{% if values.is_secret|default(false) %} checked{% endif %}>
        <span class="switch-ui" aria-hidden="true"></span>
        <span class="switch-copy"><strong>{{ ico.i('lock', 14) }} 비밀글로 작성</strong><small>작성자와 관리자만 볼 수 있어요.</small></span>
      </label>
    {% endif %}

    <div class="form-actions">
      <a class="btn btn-white" href="{{ url_for('posts.index', {'key': board.board_key}) }}">취소</a>
      <button class="btn btn-primary" type="submit">등록하기</button>
    </div>
  </form>
</section>
{% endblock %}
{% block scripts %}
<script>
(function(){
  var a=document.querySelector('[data-autogrow]');if(!a){return}
  function g(){a.style.height='auto';a.style.height=Math.max(a.scrollHeight,260)+'px'}
  a.addEventListener('input',g);g();
})();
</script>
{% endblock %}
