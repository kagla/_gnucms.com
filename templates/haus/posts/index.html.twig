{% extends "layout.html.twig" %}
{% import '_icons.html.twig' as ico %}
{% import _self as h %}

{% macro listUrl(board, q, category, page) %}
{%- set params = [] -%}
{%- if q %}{% set params = params|merge(['q=' ~ q|url_encode]) %}{% endif -%}
{%- if category %}{% set params = params|merge(['category=' ~ category|url_encode]) %}{% endif -%}
{%- if page and page > 1 %}{% set params = params|merge(['page=' ~ page]) %}{% endif -%}
{{- url_for('posts.index', {'key': board.board_key}) }}{% if params is not empty %}?{{ params|join('&amp;')|raw }}{% endif %}
{%- endmacro %}

{% block title %}{{ board.name }} · {{ site.site_name }}{% endblock %}
{% block nav_section %}board{% endblock %}
{% block extra_tabs %}<a class="nav-tab is-active" href="{{ url_for('posts.index', {'key': board.board_key}) }}" aria-current="page">{{ board.name }}</a>{% endblock %}

{% block header_search %}
<form class="nav-search" method="get" action="{{ url_for('posts.index', {'key': board.board_key}) }}" role="search">
  {% if query.category is not empty %}<input type="hidden" name="category" value="{{ query.category }}">{% endif %}
  <span class="nav-search-icon" aria-hidden="true">{{ ico.i('search', 17) }}</span>
  <input type="search" name="q" value="{{ query.q }}" placeholder="{{ board.name }}에서 검색" aria-label="게시글 검색" data-search-input>
  <kbd class="nav-search-kbd" aria-hidden="true">/</kbd>
  <button class="nav-search-btn" type="submit">검색</button>
</form>
{% endblock %}

{% block subnav %}
<div class="subnav">
  <div class="container-app subnav-inner">
    <div class="chip-scroll" role="group" aria-label="분류 선택">
      {% if board.use_category and board.categories is not empty %}
        <a class="chip{% if query.category is empty %} is-active{% endif %}" href="{{ h.listUrl(board, query.q, null, 1)|trim }}">전체</a>
        {% for name in board.categories %}
          <a class="chip{% if query.category == name %} is-active{% endif %}" href="{{ h.listUrl(board, query.q, name, 1)|trim }}">{{ name }}</a>
        {% endfor %}
      {% else %}
        <span class="chip is-active">전체</span>
      {% endif %}
    </div>
    <span class="subnav-count">{{ list.total }}개</span>
  </div>
</div>
{% endblock %}

{% block body %}
{% set filtered = query.q is not empty or query.category is not empty %}

<nav class="breadcrumb" aria-label="현재 위치">
  <a href="{{ url_for('boards.index') }}">홈</a>
  <span aria-hidden="true">{{ ico.i('chevron-right', 13) }}</span>
  <span aria-current="page">{{ board.name }}</span>
</nav>

<header class="page-head">
  <div>
    <h1>{{ board.name }}</h1>
    {% if board.description %}<p class="page-desc">{{ board.description }}</p>{% endif %}
  </div>
  {% if can_write %}
    <a class="btn btn-primary hide-sm" href="{{ url_for('posts.create', {'key': board.board_key}) }}">{{ ico.i('pencil', 16) }} 글쓰기</a>
  {% endif %}
</header>

<form class="search-inline show-sm" method="get" action="{{ url_for('posts.index', {'key': board.board_key}) }}" role="search">
  {% if query.category is not empty %}<input type="hidden" name="category" value="{{ query.category }}">{% endif %}
  <span class="search-inline-icon" aria-hidden="true">{{ ico.i('search', 16) }}</span>
  <input type="search" name="q" value="{{ query.q }}" placeholder="{{ board.name }}에서 검색" aria-label="게시글 검색">
  <button class="btn btn-ghost btn-sm" type="submit">검색</button>
</form>

{% if filtered %}
  <p class="filter-note">
    {% if query.category is not empty %}<strong>{{ query.category }}</strong>{% endif %}
    {% if query.q is not empty %}<strong>“{{ query.q }}”</strong> 검색{% endif %}
    결과 {{ list.total }}개
    <a class="link" href="{{ url_for('posts.index', {'key': board.board_key}) }}">필터 지우기</a>
  </p>
{% endif %}

{% if list.notices is not empty %}
  <section class="card notice-card" aria-label="공지">
    {% for post in list.notices %}
      <a class="notice-item" href="{{ url_for('posts.show', {'id': post.id}) }}">
        <span class="notice-ico" aria-hidden="true">{{ ico.i('megaphone', 15) }}</span>
        <span class="badge badge-primary">공지</span>
        <span class="notice-title">{{ post.title }}</span>
        <time class="notice-date" datetime="{{ post.created_at }}">{{ post.created_at|date('m.d') }}</time>
      </a>
    {% endfor %}
  </section>
{% endif %}

{% if list.data is empty and list.notices is empty %}
  <div class="empty">
    <span class="empty-icon" aria-hidden="true">{{ ico.i(filtered ? 'search' : 'document', 26) }}</span>
    <p class="empty-title">{% if filtered %}조건에 맞는 글이 없습니다{% else %}아직 등록된 글이 없습니다{% endif %}</p>
    <p class="empty-text">{% if filtered %}다른 검색어나 분류로 다시 찾아보세요.{% else %}첫 이야기를 남겨 이 게시판을 열어보세요.{% endif %}</p>
    {% if filtered %}
      <a class="btn btn-white" href="{{ url_for('posts.index', {'key': board.board_key}) }}">전체 글 보기</a>
    {% elseif can_write %}
      <a class="btn btn-primary" href="{{ url_for('posts.create', {'key': board.board_key}) }}">{{ ico.i('pencil', 16) }} 첫 글 쓰기</a>
    {% endif %}
  </div>
{% elseif list.data is not empty %}
  <div class="card-grid">
    {% for post in list.data %}
      <a class="post-card" href="{{ url_for('posts.show', {'id': post.id}) }}">
        <span class="post-cover" data-tone="{{ post.id % 6 }}">
          <span class="post-cover-tag">{% if board.use_category and post.category %}{{ post.category }}{% else %}{{ board.name }}{% endif %}</span>
          <span class="post-cover-mark" aria-hidden="true">{{ post.title|slice(0, 1) }}</span>
          {% if post.is_secret %}<span class="post-cover-lock" title="비밀글" aria-label="비밀글">{{ ico.i('lock', 13) }}</span>{% endif %}
        </span>
        <span class="post-card-body">
          <span class="post-card-title">{{ post.title }}</span>
          <span class="post-card-meta">
            <span class="avatar avatar-xs" data-tone="{{ post.author_name|length % 6 }}" aria-hidden="true">{{ post.author_name|slice(0, 1)|upper }}</span>
            <span class="post-card-author">{{ post.author_name }}</span>
            <span class="sep" aria-hidden="true">·</span>
            <time datetime="{{ post.created_at }}">{{ post.created_at|date('Y.m.d') }}</time>
          </span>
          <span class="post-card-stats">
            <span>{{ ico.i('eye', 14) }}{{ post.view_count }}</span>
            <span>{{ ico.i('comment', 14) }}{{ post.comment_count }}</span>
            {% if post.file_count > 0 %}<span>{{ ico.i('clip', 14) }}{{ post.file_count }}</span>{% endif %}
          </span>
        </span>
      </a>
    {% endfor %}
  </div>
{% endif %}

{% if list.total_pages > 1 %}
  {% set window = 4 %}
  {% set start = max(1, list.page - window) %}
  {% set end = min(list.total_pages, list.page + window) %}
  <nav class="pagination" aria-label="페이지 이동">
    {% if list.page > 1 %}<a class="page-nav" rel="prev" href="{{ h.listUrl(board, query.q, query.category, list.page - 1)|trim }}" aria-label="이전 페이지">{{ ico.i('chevron-left', 16) }}</a>{% endif %}
    {% if start > 1 %}
      <a href="{{ h.listUrl(board, query.q, query.category, 1)|trim }}" aria-label="1 페이지">1</a>
      {% if start > 2 %}<span class="page-gap" aria-hidden="true">…</span>{% endif %}
    {% endif %}
    {% for p in start..end %}
      {% if p == list.page %}<strong aria-current="page">{{ p }}</strong>{% else %}<a href="{{ h.listUrl(board, query.q, query.category, p)|trim }}" aria-label="{{ p }} 페이지">{{ p }}</a>{% endif %}
    {% endfor %}
    {% if end < list.total_pages %}
      {% if end < list.total_pages - 1 %}<span class="page-gap" aria-hidden="true">…</span>{% endif %}
      <a href="{{ h.listUrl(board, query.q, query.category, list.total_pages)|trim }}" aria-label="{{ list.total_pages }} 페이지">{{ list.total_pages }}</a>
    {% endif %}
    {% if list.page < list.total_pages %}<a class="page-nav" rel="next" href="{{ h.listUrl(board, query.q, query.category, list.page + 1)|trim }}" aria-label="다음 페이지">{{ ico.i('chevron-right', 16) }}</a>{% endif %}
  </nav>
{% endif %}

{% if can_write %}
  <a class="fab" href="{{ url_for('posts.create', {'key': board.board_key}) }}" aria-label="글쓰기">{{ ico.i('pencil', 22) }}</a>
{% endif %}
{% endblock %}
