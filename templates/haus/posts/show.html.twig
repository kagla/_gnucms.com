{% extends "layout.html.twig" %}
{% import '_icons.html.twig' as ico %}
{% block title %}{{ post.title }} · {{ site.site_name }}{% endblock %}
{% block meta_description %}<meta name="description" content="{{ post.content|striptags|slice(0, 150) }}">{% endblock %}
{% block nav_section %}board{% endblock %}
{% block extra_tabs %}<a class="nav-tab is-active" href="{{ url_for('posts.index', {'key': board.board_key}) }}" aria-current="page">{{ board.name }}</a>{% endblock %}
{% block body %}
<div class="read-bar" aria-hidden="true"></div>

<nav class="breadcrumb" aria-label="현재 위치">
  <a href="{{ url_for('boards.index') }}">홈</a>
  <span aria-hidden="true">{{ ico.i('chevron-right', 13) }}</span>
  <a href="{{ url_for('posts.index', {'key': board.board_key}) }}">{{ board.name }}</a>
  <span aria-hidden="true">{{ ico.i('chevron-right', 13) }}</span>
  <span aria-current="page">게시글</span>
</nav>

<article class="card article">
  <header class="article-head">
    {% if post.category %}<span class="badge badge-tone" data-tone="{{ post.id % 6 }}">{{ ico.i('tag', 13) }} {{ post.category }}</span>{% endif %}
    <h1 class="article-title">{{ post.title }}</h1>
    <div class="article-writer">
      <span class="avatar" data-tone="{{ post.author_name|length % 6 }}" aria-hidden="true">{{ post.author_name|slice(0, 1)|upper }}</span>
      <span class="article-writer-copy">
        <strong>{{ post.author_name }}</strong>
        <time datetime="{{ post.created_at }}">{{ post.created_at|date('Y년 m월 d일 H:i') }}</time>
      </span>
      <a class="btn btn-white btn-sm article-back" href="{{ url_for('posts.index', {'key': board.board_key}) }}">{{ ico.i('arrow-left', 15) }} 목록</a>
    </div>
  </header>

  <div class="article-body prose">{{ post.content|nl2br }}</div>

  {% if post.attachments is not empty %}
    <section class="article-files" aria-labelledby="files-title">
      <h2 id="files-title" class="section-title">{{ ico.i('clip', 16) }} 첨부파일 {{ post.attachments|length }}</h2>
      <ul class="file-list">
        {% for file in post.attachments %}
          <li>
            <a href="{{ url_for('files.download', {'id': post.id, 'index': file.index}) }}">
              <span class="file-ico" aria-hidden="true">{{ ico.i('document', 17) }}</span>
              <span class="file-name">{{ file.name }}</span>
              <span class="file-size">{{ (file.size / 1024)|round }} KB</span>
            </a>
          </li>
        {% endfor %}
      </ul>
    </section>
  {% endif %}

  <div class="article-foot">
    <span class="stat">{{ ico.i('eye', 16) }} 조회 {{ post.view_count }}</span>
    <span class="stat">{{ ico.i('comment', 16) }} 댓글 {{ post.comment_count }}</span>
    <a class="stat stat-link" href="#comments">댓글 보기</a>
  </div>
</article>

<section class="card comments" id="comments" aria-labelledby="comments-title">
  <h2 class="section-title" id="comments-title">{{ ico.i('comment', 16) }} 댓글 <span class="badge badge-gray">{{ post.comment_count }}</span></h2>
  {% if comments is empty %}
    <div class="empty empty-sm">
      <span class="empty-icon" aria-hidden="true">{{ ico.i('comment', 22) }}</span>
      <p class="empty-title">첫 댓글을 기다리고 있어요</p>
    </div>
  {% else %}
    {% include 'posts/_comments.html.twig' with {'nodes': comments, 'nested': false} only %}
  {% endif %}
</section>

<div class="article-actions">
  <a class="btn btn-white btn-lg" href="{{ url_for('posts.index', {'key': board.board_key}) }}">목록으로 돌아가기</a>
</div>
{% endblock %}
