{% extends "layout.html.twig" %}
{% import '_icons.html.twig' as ico %}
{% block title %}{{ page.title }} · {{ site.site_name }}{% endblock %}
{% block meta_description %}<meta name="description" content="{{ page.seo_description ?: site.site_tagline }}">{% endblock %}
{% block body %}
{% if preview %}
  <div class="alert alert-info">
    <span class="alert-icon" aria-hidden="true">{{ ico.i('info', 17) }}</span>
    <span>{{ page.status == 'published' ? '공개된 내용 미리보기입니다.' : '아직 공개되지 않은 초안 미리보기입니다.' }}</span>
    <a class="link" href="{{ preview_legal_type ? url_for('admin.terms.edit', {type: preview_legal_type}) : url_for('admin.content.edit', {id: page.id}) }}">편집으로 돌아가기</a>
  </div>
{% endif %}
<div class="read-bar" aria-hidden="true"></div>
<article class="card article article-page">
  <header class="article-head">
    <span class="badge badge-gray">{{ site.site_name }}</span>
    <h1 class="article-title">{{ page.title }}</h1>
    {% if page.seo_description %}<p class="article-summary">{{ page.seo_description }}</p>{% endif %}
  </header>
  <div class="article-body prose rich-content">{{ page.content|cms_html }}</div>
</article>
{% endblock %}
