{% extends "admin/layout.html.twig" %}
{% import '_icons.html.twig' as ico %}
{% block title %}관리 · {{ site.site_name }}{% endblock %}
{% block admin_section %}dashboard{% endblock %}
{% block body %}
<div class="page-head">
  <div>
    <h1>사이트 관리</h1>
    <p class="page-desc">사이트 내용과 커뮤니티를 복잡한 절차 없이 관리합니다.</p>
  </div>
  <div class="page-head-actions">
    <a class="btn btn-primary" href="{{ url_for('admin.content.create') }}">{{ ico.i('plus', 16) }} 내용 만들기</a>
  </div>
</div>

{% if query.saved|default('') == '1' %}<div class="alert alert-success"><span class="alert-icon" aria-hidden="true">{{ ico.i('check-circle', 17) }}</span><span>변경사항을 저장했습니다.</span></div>{% endif %}
{% if query.deleted|default('') == '1' %}<div class="alert alert-success"><span class="alert-icon" aria-hidden="true">{{ ico.i('check-circle', 17) }}</span><span>게시판을 삭제했습니다.</span></div>{% endif %}

<section class="stat-grid" aria-label="운영 현황">
  <a class="stat-card" href="{{ url_for('admin.boards') }}">
    <span class="stat-icon" data-tone="0" aria-hidden="true">{{ ico.i('board', 19) }}</span>
    <span class="stat-label">게시판</span>
    <strong class="stat-value">{{ board_count }}</strong>
    <span class="stat-more">관리하기 {{ ico.i('arrow-right', 13) }}</span>
  </a>
  <a class="stat-card" href="{{ url_for('admin.content') }}">
    <span class="stat-icon" data-tone="2" aria-hidden="true">{{ ico.i('document', 19) }}</span>
    <span class="stat-label">내용</span>
    <strong class="stat-value">{{ page_count }}</strong>
    <span class="stat-more">관리하기 {{ ico.i('arrow-right', 13) }}</span>
  </a>
  <div class="stat-card">
    <span class="stat-icon" data-tone="3" aria-hidden="true">{{ ico.i('comment', 19) }}</span>
    <span class="stat-label">게시글</span>
    <strong class="stat-value">{{ post_count }}</strong>
    <span class="stat-note">삭제되지 않은 글</span>
  </div>
  <a class="stat-card" href="{{ url_for('admin.members') }}">
    <span class="stat-icon" data-tone="4" aria-hidden="true">{{ ico.i('users', 19) }}</span>
    <span class="stat-label">회원</span>
    <strong class="stat-value">{{ user_count }}</strong>
    <span class="stat-more">관리하기 {{ ico.i('arrow-right', 13) }}</span>
  </a>
</section>

<section class="card">
  <div class="card-header card-header-row">
    <h2>게시판 바로가기</h2>
    <a class="link" href="{{ url_for('admin.boards') }}">전체 관리 {{ ico.i('arrow-right', 13) }}</a>
  </div>
  {% if boards is empty %}
    <div class="empty empty-sm">
      <span class="empty-icon" aria-hidden="true">{{ ico.i('board', 22) }}</span>
      <p class="empty-title">아직 게시판이 없습니다</p>
      <a class="btn btn-primary" href="{{ url_for('admin.boards.create') }}">{{ ico.i('plus', 16) }} 첫 게시판 만들기</a>
    </div>
  {% else %}
    <ul class="list-group">
      {% for board in boards %}
        <li><a href="{{ url_for('admin.boards.edit', {key: board.board_key}) }}">
          <span class="list-icon" data-tone="{{ loop.index0 % 6 }}" aria-hidden="true">{{ ico.i('board', 17) }}</span>
          <span class="list-copy"><strong>{{ board.name }}</strong><small>/boards/{{ board.board_key }}</small></span>
          <span class="list-go" aria-hidden="true">{{ ico.i('chevron-right', 16) }}</span>
        </a></li>
      {% endfor %}
    </ul>
  {% endif %}
</section>
{% endblock %}
