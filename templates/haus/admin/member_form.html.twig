{% extends "admin/layout.html.twig" %}
{% import '_icons.html.twig' as ico %}
{% block title %}회원 수정 · {{ site.site_name }}{% endblock %}
{% block admin_section %}members{% endblock %}
{% block body %}
<nav class="breadcrumb" aria-label="현재 위치"><a href="{{ url_for('admin.index') }}">사이트 관리</a><span aria-hidden="true">{{ ico.i('chevron-right', 13) }}</span><a href="{{ url_for('admin.members') }}">회원</a><span aria-hidden="true">{{ ico.i('chevron-right', 13) }}</span><span aria-current="page">{{ values.email }}</span></nav>
<section class="card">
  <div class="card-header">
    <h1>회원 수정</h1>
    <p class="card-sub">로그인 이메일과 화면에 표시할 이름, 이용 상태를 관리합니다.</p>
  </div>
  <form class="card-body form" method="post" action="{{ url_for('admin.members.edit', {id: values.id}) }}">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <div class="form-group{% if errors.email is defined %} has-error{% endif %}">
      <label class="label" for="m-email">이메일</label>
      <input class="input" id="m-email" type="email" name="email" value="{{ values.email|default('') }}" maxlength="191" autocomplete="off" required>
      {% if errors.email is defined %}<p class="error-text">{{ ico.i('warning', 14) }} {{ errors.email }}</p>{% endif %}
    </div>
    <div class="form-group{% if errors.display_name is defined %} has-error{% endif %}">
      <label class="label" for="m-name">표시 이름</label>
      <input class="input" id="m-name" type="text" name="display_name" value="{{ values.display_name|default('') }}" maxlength="100" required>
      {% if errors.display_name is defined %}<p class="error-text">{{ ico.i('warning', 14) }} {{ errors.display_name }}</p>{% endif %}
    </div>
    <div class="form-group{% if errors.status is defined %} has-error{% endif %}">
      <label class="label" for="m-status">이용 상태</label>
      <select class="input select" id="m-status" name="status">
        <option value="active"{{ values.status|default('active') == 'active' ? ' selected' : '' }}>활성</option>
        <option value="blocked"{{ values.status|default('active') == 'blocked' ? ' selected' : '' }}>차단</option>
      </select>
      {% if errors.status is defined %}<p class="error-text">{{ ico.i('warning', 14) }} {{ errors.status }}</p>{% endif %}
    </div>
    <dl class="fact-list">
      <div><dt>권한</dt><dd>{{ values.is_admin ? '소유자' : '일반 회원' }}</dd></div>
      <div><dt>이메일 인증</dt><dd>{{ values.email_verified ? '완료' : '대기' }}</dd></div>
      <div><dt>가입일</dt><dd>{{ values.created_at|date('Y.m.d H:i') }}</dd></div>
    </dl>
    <div class="form-actions">
      <a class="btn btn-white" href="{{ url_for('admin.members') }}">취소</a>
      <button class="btn btn-primary" type="submit">변경사항 저장</button>
    </div>
  </form>
</section>
{% endblock %}
