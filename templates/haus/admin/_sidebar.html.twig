{% import '_icons.html.twig' as ico %}
<aside class="admin-sidebar" id="admin-sidebar">
  <div class="admin-sidebar-head">
    <a class="admin-brand" href="{{ url_for('admin.index') }}">
      <span class="brand-logo" aria-hidden="true">{{ ico.i('dashboard', 17) }}</span>
      <span class="admin-brand-copy">
        <strong>관리 콘솔</strong>
        <small>{{ site.site_name }}</small>
      </span>
    </a>
    <button class="btn-icon admin-fold" type="button" aria-controls="admin-sidebar" aria-expanded="true" aria-label="관리 메뉴 접기">{{ ico.i('chevron-left', 17) }}</button>
  </div>

  <nav class="admin-nav" aria-label="관리 메뉴">
    <p class="admin-nav-label">운영</p>
    <a class="admin-nav-item" href="{{ url_for('admin.index') }}"{% if section == 'dashboard' %} aria-current="page"{% endif %} title="대시보드">
      <span class="admin-nav-icon">{{ ico.i('dashboard', 18) }}</span><span class="admin-nav-text">대시보드</span>
    </a>
    <a class="admin-nav-item" href="{{ url_for('admin.boards') }}"{% if section == 'boards' %} aria-current="page"{% endif %} title="게시판 관리">
      <span class="admin-nav-icon">{{ ico.i('board', 18) }}</span><span class="admin-nav-text">게시판 관리</span>
    </a>
    <a class="admin-nav-item" href="{{ url_for('admin.content') }}"{% if section == 'content' %} aria-current="page"{% endif %} title="내용 관리">
      <span class="admin-nav-icon">{{ ico.i('document', 18) }}</span><span class="admin-nav-text">내용 관리</span>
    </a>
    <a class="admin-nav-item" href="{{ url_for('admin.members') }}"{% if section == 'members' %} aria-current="page"{% endif %} title="회원 관리">
      <span class="admin-nav-icon">{{ ico.i('users', 18) }}</span><span class="admin-nav-text">회원 관리</span>
    </a>

    <p class="admin-nav-label">설정</p>
    <a class="admin-nav-item" href="{{ url_for('admin.settings') }}"{% if section == 'site' %} aria-current="page"{% endif %} title="사이트 설정">
      <span class="admin-nav-icon">{{ ico.i('cog', 18) }}</span><span class="admin-nav-text">사이트 설정</span>
    </a>
    <a class="admin-nav-item" href="{{ url_for('admin.mail') }}"{% if section == 'mail' %} aria-current="page"{% endif %} title="메일 설정">
      <span class="admin-nav-icon">{{ ico.i('mail', 18) }}</span><span class="admin-nav-text">메일 설정</span>
    </a>
    <a class="admin-nav-item" href="{{ url_for('admin.terms') }}"{% if section == 'legal' %} aria-current="page"{% endif %} title="약관 관리">
      <span class="admin-nav-icon">{{ ico.i('scale', 18) }}</span><span class="admin-nav-text">약관 관리</span>
    </a>
    <a class="admin-nav-item" href="{{ url_for('admin.password') }}"{% if section == 'security' %} aria-current="page"{% endif %} title="계정 보안">
      <span class="admin-nav-icon">{{ ico.i('shield', 18) }}</span><span class="admin-nav-text">계정 보안</span>
    </a>
  </nav>

  <div class="admin-sidebar-foot">
    <div class="admin-user">
      <span class="avatar avatar-sm" data-tone="{{ current_user.display_name|length % 6 }}" aria-hidden="true">{{ current_user.display_name|slice(0, 1)|upper }}</span>
      <span class="admin-user-name">{{ current_user.display_name }}</span>
      <form class="inline-form" method="post" action="{{ url_for('auth.logout') }}">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <button class="btn-icon" type="submit" aria-label="로그아웃" title="로그아웃">{{ ico.i('logout', 17) }}</button>
      </form>
    </div>
  </div>
</aside>
