{% extends "admin/layout.html.twig" %}
{% import '_icons.html.twig' as ico %}
{% block title %}관리자 비밀번호 변경 · {{ site.site_name }}{% endblock %}
{% block admin_section %}security{% endblock %}
{% block body %}
<nav class="breadcrumb" aria-label="현재 위치"><a href="{{ url_for('admin.index') }}">사이트 관리</a><span aria-hidden="true">{{ ico.i('chevron-right', 13) }}</span><span aria-current="page">계정 보안</span></nav>
<section class="card card-narrow">
  <div class="card-header">
    <h1>{{ ico.i('shield', 19) }} 비밀번호 변경</h1>
    <p class="card-sub">새 비밀번호를 저장하면 모든 기기에서 다시 로그인해야 합니다.</p>
  </div>
  <form class="card-body form" method="post" action="{{ url_for('admin.password') }}">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <div class="form-group{% if errors.current_password is defined %} has-error{% endif %}">
      <label class="label" for="p-cur">현재 비밀번호</label>
      <input class="input" id="p-cur" type="password" name="current_password" autocomplete="current-password" required>
      {% if errors.current_password is defined %}<p class="error-text">{{ ico.i('warning', 14) }} {{ errors.current_password }}</p>{% endif %}
    </div>
    <div class="form-group{% if errors.password is defined %} has-error{% endif %}">
      <label class="label" for="p-new">새 비밀번호 <span class="label-hint">8자 이상</span></label>
      <input class="input" id="p-new" type="password" name="password" minlength="8" autocomplete="new-password" required>
      {% if errors.password is defined %}<p class="error-text">{{ ico.i('warning', 14) }} {{ errors.password }}</p>{% endif %}
    </div>
    <div class="form-group{% if errors.password_confirmation is defined %} has-error{% endif %}">
      <label class="label" for="p-new2">새 비밀번호 확인</label>
      <input class="input" id="p-new2" type="password" name="password_confirmation" minlength="8" autocomplete="new-password" required>
      {% if errors.password_confirmation is defined %}<p class="error-text">{{ ico.i('warning', 14) }} {{ errors.password_confirmation }}</p>{% endif %}
    </div>
    <div class="form-actions">
      <a class="btn btn-white" href="{{ url_for('admin.index') }}">취소</a>
      <button class="btn btn-primary" type="submit">비밀번호 변경</button>
    </div>
  </form>
</section>
{% endblock %}
