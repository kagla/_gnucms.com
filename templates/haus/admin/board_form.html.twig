{% extends "admin/layout.html.twig" %}
{% import '_icons.html.twig' as ico %}
{% block title %}{{ create ? '게시판 만들기' : '게시판 설정' }} · {{ site.site_name }}{% endblock %}
{% block admin_section %}boards{% endblock %}
{% block body %}
<nav class="breadcrumb" aria-label="현재 위치"><a href="{{ url_for('admin.index') }}">사이트 관리</a><span aria-hidden="true">{{ ico.i('chevron-right', 13) }}</span><a href="{{ url_for('admin.boards') }}">게시판</a><span aria-hidden="true">{{ ico.i('chevron-right', 13) }}</span><span aria-current="page">{{ create ? '게시판 만들기' : values.name }}</span></nav>

<section class="card">
  <div class="card-header">
    <h1>{{ create ? '게시판 만들기' : '게시판 설정' }}</h1>
    <p class="card-sub">기본 정보와 이용 권한을 설정합니다.</p>
  </div>
  <form class="card-body form" method="post" action="{{ create ? url_for('admin.boards.create') : url_for('admin.boards.edit', {key: board_key}) }}">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

    <fieldset class="fieldset">
      <legend>기본 정보</legend>
      {% if create %}
        <div class="form-group{% if errors.board_key is defined %} has-error{% endif %}">
          <label class="label" for="board-key">게시판 키 <span class="label-hint">주소에 쓰이는 영문 소문자</span></label>
          <input class="input" id="board-key" type="text" name="board_key" value="{{ values.board_key|default('') }}" maxlength="50" pattern="[a-z0-9_-]+" required>
          {% if errors.board_key is defined %}<p class="error-text">{{ ico.i('warning', 14) }} {{ errors.board_key }}</p>{% endif %}
        </div>
      {% endif %}
      <div class="form-group{% if errors.name is defined %} has-error{% endif %}">
        <label class="label" for="board-name">게시판 이름</label>
        <input class="input" id="board-name" type="text" name="name" value="{{ values.name|default('') }}" maxlength="100" required>
        {% if errors.name is defined %}<p class="error-text">{{ ico.i('warning', 14) }} {{ errors.name }}</p>{% endif %}
      </div>
      <div class="form-group">
        <label class="label" for="board-desc">설명</label>
        <textarea class="input textarea" id="board-desc" name="description" rows="3">{{ values.description|default('') }}</textarea>
      </div>
    </fieldset>

    <fieldset class="fieldset">
      <legend>이용 권한</legend>
      <div class="grid-3">
        <div class="form-group"><label class="label" for="perm-read">읽기</label>
          <select class="input select" id="perm-read" name="perm_read">{% for p in ['guest','member','admin'] %}<option value="{{ p }}"{{ values.perm_read == p ? ' selected' : '' }}>{{ p }}</option>{% endfor %}</select></div>
        <div class="form-group"><label class="label" for="perm-write">쓰기</label>
          <select class="input select" id="perm-write" name="perm_write">{% for p in ['guest','member','admin'] %}<option value="{{ p }}"{{ values.perm_write == p ? ' selected' : '' }}>{{ p }}</option>{% endfor %}</select></div>
        <div class="form-group"><label class="label" for="perm-comment">댓글</label>
          <select class="input select" id="perm-comment" name="perm_comment">{% for p in ['guest','member','admin'] %}<option value="{{ p }}"{{ values.perm_comment == p ? ' selected' : '' }}>{{ p }}</option>{% endfor %}</select></div>
      </div>
    </fieldset>

    <fieldset class="fieldset">
      <legend>기능과 노출</legend>
      <div class="form-group">
        <label class="label" for="board-cats">분류 <span class="label-hint">한 줄에 하나씩</span></label>
        <textarea class="input textarea" id="board-cats" name="categories_text" rows="3">{{ values.categories_text|default('') }}</textarea>
      </div>
      <div class="grid-2">
        <div class="form-group"><label class="label" for="board-per">페이지당 글 수</label>
          <input class="input" id="board-per" type="number" name="per_page" value="{{ values.per_page|default(20) }}" min="1" max="100"></div>
        <div class="form-group"><label class="label" for="board-sort">정렬 순서</label>
          <input class="input" id="board-sort" type="number" name="sort_order" value="{{ values.sort_order|default(0) }}" min="-9999" max="9999"></div>
      </div>
      <div class="switch-group">
        <label class="switch"><input type="checkbox" name="use_category" value="1"{{ values.use_category|default(false) ? ' checked' : '' }}><span class="switch-ui" aria-hidden="true"></span><span class="switch-copy"><strong>분류 사용</strong></span></label>
        <label class="switch"><input type="checkbox" name="use_secret" value="1"{{ values.use_secret|default(false) ? ' checked' : '' }}><span class="switch-ui" aria-hidden="true"></span><span class="switch-copy"><strong>비밀글 사용</strong></span></label>
        <label class="switch"><input type="checkbox" name="use_file" value="1"{{ values.use_file|default(false) ? ' checked' : '' }}><span class="switch-ui" aria-hidden="true"></span><span class="switch-copy"><strong>첨부파일 사용</strong></span></label>
      </div>
    </fieldset>

    <div class="form-actions">
      <a class="btn btn-white" href="{{ url_for('admin.boards') }}">취소</a>
      <button class="btn btn-primary" type="submit">{{ create ? '게시판 만들기' : '변경사항 저장' }}</button>
    </div>
  </form>

  {% if not create %}
    <form class="danger-zone" method="post" action="{{ url_for('admin.boards.delete', {key: board_key}) }}" onsubmit="return confirm('게시판의 글과 댓글도 함께 삭제됩니다. 정말 삭제할까요?')">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <div><strong>{{ ico.i('warning', 15) }} 게시판 삭제</strong><p>게시글과 댓글을 포함해 되돌릴 수 없이 삭제합니다.</p></div>
      <button class="btn btn-danger" type="submit">{{ ico.i('trash', 15) }} 삭제</button>
    </form>
  {% endif %}
</section>
{% endblock %}
