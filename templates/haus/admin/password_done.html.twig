{% extends "layout.html.twig" %}
{% import '_icons.html.twig' as ico %}
{% block title %}비밀번호 변경 완료 · {{ site.site_name }}{% endblock %}
{% block body %}
<div class="auth-wrap">
  <section class="card auth-card auth-card-status">
    <span class="auth-mark auth-mark-ok" aria-hidden="true">{{ ico.i('check-circle', 24) }}</span>
    <h1>비밀번호를 변경했어요</h1>
    <p class="auth-sub">새 비밀번호로 다시 로그인해 주세요.</p>
    <a class="btn btn-primary btn-lg btn-block" href="{{ url_for('auth.login') }}">로그인</a>
  </section>
</div>
{% endblock %}
