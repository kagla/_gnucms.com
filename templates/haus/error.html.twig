{% extends "layout.html.twig" %}
{% import '_icons.html.twig' as ico %}
{% block title %}{{ title }} · {{ site.site_name }}{% endblock %}
{% block body %}
<section class="status-card">
  <span class="status-icon status-icon-danger" aria-hidden="true">{{ ico.i('warning', 26) }}</span>
  <h1>{{ title }}</h1>
  <p class="status-lead">{{ message }}</p>
  {% if details is not empty %}
    <ul class="status-list">
      {% for field, detail in details %}<li><strong>{{ field }}</strong><span>{{ detail }}</span></li>{% endfor %}
    </ul>
  {% endif %}
  <a class="btn btn-primary btn-lg" href="{{ url_for('boards.index') }}">{{ ico.i('home', 16) }} 홈으로 가기</a>
</section>
{% endblock %}
