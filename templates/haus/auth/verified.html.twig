{% extends "layout.html.twig" %}
{% import '_icons.html.twig' as ico %}
{% block title %}이메일 인증 완료 · {{ site.site_name }}{% endblock %}
{% block body %}
<div class="auth-wrap">
  <section class="card auth-card auth-card-status">
    <span class="auth-mark auth-mark-ok" aria-hidden="true">{{ ico.i('check-circle', 24) }}</span>
    <h1>인증이 완료됐어요</h1>
    <p class="auth-sub">이제 로그인하고 커뮤니티에 참여할 수 있어요.</p>
    <a class="btn btn-primary btn-lg btn-block" href="{{ url_for('auth.login') }}">로그인하기</a>
  </section>
</div>
{% endblock %}
