{% extends "layout.html.twig" %}
{% import '_icons.html.twig' as ico %}
{% block title %}로그인 · {{ site.site_name }}{% endblock %}
{% block body %}
<div class="auth-wrap">
  <section class="card auth-card">
    <div class="auth-head">
      <span class="auth-mark" aria-hidden="true">{{ ico.i('home', 22) }}</span>
      <h1>{{ site.site_name }}에 로그인</h1>
      <p class="auth-sub">이야기를 이어서 나눠 보세요.</p>
    </div>
    <form class="form" method="post" action="{{ url_for('auth.login') }}">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <div class="form-group{% if errors.email is defined %} has-error{% endif %}">
        <label class="label" for="login-email">이메일</label>
        <div class="input-wrap">
          <span class="input-icon" aria-hidden="true">{{ ico.i('mail', 16) }}</span>
          <input class="input has-icon" id="login-email" type="email" name="email" value="{{ values.email|default('') }}" autocomplete="email" placeholder="you@example.com" required>
        </div>
        {% if errors.email is defined %}<p class="error-text">{{ ico.i('warning', 14) }} {{ errors.email }}</p>{% endif %}
      </div>
      <div class="form-group">
        <div class="label-row">
          <label class="label" for="login-password">비밀번호</label>
          <a class="link" href="{{ url_for('auth.forgot') }}">비밀번호 찾기</a>
        </div>
        <div class="input-wrap">
          <span class="input-icon" aria-hidden="true">{{ ico.i('lock', 16) }}</span>
          <input class="input has-icon" id="login-password" type="password" name="password" autocomplete="current-password" required>
        </div>
      </div>
      <button class="btn btn-primary btn-lg btn-block" type="submit">로그인</button>
    </form>
    {% include "auth/_social.html.twig" %}
    <p class="auth-switch">아직 회원이 아니신가요? <a href="{{ url_for('auth.register') }}">회원가입</a></p>
  </section>
</div>
{% endblock %}
