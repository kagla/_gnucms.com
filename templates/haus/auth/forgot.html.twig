{% extends "layout.html.twig" %}
{% import '_icons.html.twig' as ico %}
{% block title %}비밀번호 찾기 · {{ site.site_name }}{% endblock %}
{% block body %}
<div class="auth-wrap">
  <section class="card auth-card">
    <div class="auth-head">
      <span class="auth-mark auth-mark-soft" aria-hidden="true">{{ ico.i('mail', 22) }}</span>
      <h1>비밀번호 찾기</h1>
      <p class="auth-sub">가입한 이메일로 재설정 링크를 보내드려요.</p>
    </div>
    <form class="form" method="post" action="{{ url_for('auth.forgot') }}">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <div class="form-group">
        <label class="label" for="forgot-email">이메일</label>
        <div class="input-wrap">
          <span class="input-icon" aria-hidden="true">{{ ico.i('mail', 16) }}</span>
          <input class="input has-icon" id="forgot-email" type="email" name="email" autocomplete="email" placeholder="you@example.com" required>
        </div>
      </div>
      <button class="btn btn-primary btn-lg btn-block" type="submit">재설정 링크 받기</button>
    </form>
    <p class="auth-switch"><a href="{{ url_for('auth.login') }}">로그인으로 돌아가기</a></p>
  </section>
</div>
{% endblock %}
