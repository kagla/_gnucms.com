{% extends "layout.html.twig" %}
{% import '_icons.html.twig' as ico %}
{% block title %}이메일을 확인해 주세요 · {{ site.site_name }}{% endblock %}
{% block body %}
<div class="auth-wrap">
  <section class="card auth-card auth-card-status">
    <span class="auth-mark auth-mark-soft" aria-hidden="true">{{ ico.i('mail', 24) }}</span>
    <h1>이메일을 확인해 주세요</h1>
    <p class="auth-sub">가입 주소로 인증 링크를 보냈어요. 링크를 열면 회원가입이 완료됩니다.</p>
    <p class="auth-switch"><a href="{{ url_for('auth.login') }}">로그인으로 돌아가기</a></p>
  </section>
</div>
{% endblock %}
