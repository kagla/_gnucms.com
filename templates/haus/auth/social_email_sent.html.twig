{% extends "layout.html.twig" %}
{% import '_icons.html.twig' as ico %}
{% block title %}확인 메일 전송 · {{ site.site_name }}{% endblock %}
{% block body %}
<div class="auth-wrap">
  <section class="card auth-card auth-card-status">
    <span class="auth-mark auth-mark-soft" aria-hidden="true">{{ ico.i('mail', 24) }}</span>
    <h1>메일함을 확인해 주세요</h1>
    <p class="auth-sub">보내드린 링크를 열면 소셜 계정 연결과 로그인이 완료됩니다. 링크는 30분 동안 유효해요.</p>
    
  </section>
</div>
{% endblock %}
