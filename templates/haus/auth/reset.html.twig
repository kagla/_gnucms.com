{% extends "layout.html.twig" %}
{% import '_icons.html.twig' as ico %}
{% block title %}새 비밀번호 설정 · {{ site.site_name }}{% endblock %}
{% block body %}
<div class="auth-wrap">
  <section class="card auth-card">
    <div class="auth-head">
      <span class="auth-mark auth-mark-soft" aria-hidden="true">{{ ico.i('shield', 22) }}</span>
      <h1>새 비밀번호 설정</h1>
      <p class="auth-sub">앞으로 사용할 비밀번호를 입력해 주세요.</p>
    </div>
    <form class="form" method="post" action="{{ url_for('auth.reset') }}">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <input type="hidden" name="token" value="{{ token }}">
      <div class="form-group{% if errors.password is defined %} has-error{% endif %}">
        <label class="label" for="reset-password">새 비밀번호 <span class="label-hint">8자 이상</span></label>
        <div class="input-wrap">
          <span class="input-icon" aria-hidden="true">{{ ico.i('lock', 16) }}</span>
          <input class="input has-icon" id="reset-password" type="password" name="password" minlength="8" autocomplete="new-password" required>
        </div>
        {% if errors.password is defined %}<p class="error-text">{{ ico.i('warning', 14) }} {{ errors.password }}</p>{% endif %}
      </div>
      <div class="form-group{% if errors.password_confirmation is defined %} has-error{% endif %}">
        <label class="label" for="reset-password2">비밀번호 확인</label>
        <div class="input-wrap">
          <span class="input-icon" aria-hidden="true">{{ ico.i('lock', 16) }}</span>
          <input class="input has-icon" id="reset-password2" type="password" name="password_confirmation" minlength="8" autocomplete="new-password" required>
        </div>
        {% if errors.password_confirmation is defined %}<p class="error-text">{{ ico.i('warning', 14) }} {{ errors.password_confirmation }}</p>{% endif %}
      </div>
      {% if errors.token is defined %}<p class="error-text">{{ ico.i('warning', 14) }} {{ errors.token }}</p>{% endif %}
      <button class="btn btn-primary btn-lg btn-block" type="submit">비밀번호 변경</button>
    </form>
  </section>
</div>
{% endblock %}
