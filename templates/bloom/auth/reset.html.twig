{% extends "layout.html.twig" %}{% block title %}새 비밀번호 설정 · aboard{% endblock %}{% block body %}<div class="auth-shell"><section class="surface auth-card"><header class="auth-head"><p class="eyebrow">New password</p><h1>새 비밀번호 설정</h1></header><form class="auth-form" method="post" action="{{ url_for('auth.reset') }}"><input type="hidden" name="csrf_token" value="{{ csrf_token }}"><input type="hidden" name="token" value="{{ token }}"><label>새 비밀번호 <span class="muted">8자 이상</span><input type="password" name="password" minlength="8" autocomplete="new-password" required></label>{% if errors.password is defined %}<p class="field-error">{{ errors.password }}</p>{% endif %}<label>비밀번호 확인<input type="password" name="password_confirmation" minlength="8" autocomplete="new-password" required></label>{% if errors.password_confirmation is defined %}<p class="field-error">{{ errors.password_confirmation }}</p>{% endif %}{% if errors.token is defined %}<p class="field-error">{{ errors.token }}</p>{% endif %}<button class="auth-submit" type="submit">비밀번호 변경</button></form></section></div>{% endblock %}
