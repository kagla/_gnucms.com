{% extends "admin/layout.html.twig" %}
{% block title %}게시판 관리 · {{ site.site_name }}{% endblock %}
{% block admin_section %}boards{% endblock %}
{% block body %}
<nav class="crumb" aria-label="현재 위치"><a href="{{ url_for('admin.index') }}">사이트 관리</a><span aria-hidden="true">›</span><span aria-current="page">게시판</span></nav>
<div class="adm-head">
  <div>
    <h1>게시판 관리</h1>
    <p class="adm-sub">게시판을 만들고 이용 권한과 기능, 노출 순서를 관리합니다.</p>
  </div>
  <div class="adm-head-act"><a class="btn btn-brand" href="{{ url_for('admin.boards.create') }}">게시판 만들기</a></div>
</div>

{% if query.saved|default('') == '1' %}<p class="banner banner-ok">게시판 설정을 저장했습니다.</p>{% endif %}
{% if query.deleted|default('') == '1' %}<p class="banner banner-ok">게시판을 삭제했습니다.</p>{% endif %}

<section class="sheet">
  <div class="tbl-wrap">
    <table class="tbl">
      <thead><tr><th>게시판</th><th>주소</th><th>권한</th><th>사용 기능</th><th class="ta-r">정렬</th><th class="ta-r">관리</th></tr></thead>
      <tbody>
      {% for board in boards %}
        <tr>
          <td data-label="게시판">
            <a class="tbl-title" href="{{ url_for('posts.index', {key: board.board_key}) }}">{{ board.name }}</a>
            {% if board.description %}<span class="tbl-sub">{{ board.description }}</span>{% endif %}
          </td>
          <td data-label="주소"><code class="mono">/boards/{{ board.board_key }}</code></td>
          <td data-label="권한">
            <span class="tag-row">
              <span class="tag"><em>읽기</em>{{ board.perm_read }}</span>
              <span class="tag"><em>쓰기</em>{{ board.perm_write }}</span>
              <span class="tag"><em>댓글</em>{{ board.perm_comment }}</span>
            </span>
          </td>
          <td data-label="사용 기능">
            <span class="tag-row">
              {% if board.use_category %}<span class="tag">분류</span>{% endif %}
              {% if board.use_secret %}<span class="tag">비밀글</span>{% endif %}
              {% if board.use_file %}<span class="tag">첨부</span>{% endif %}
              {% if not board.use_category and not board.use_secret and not board.use_file %}<span class="dim">기본</span>{% endif %}
            </span>
          </td>
          <td data-label="정렬" class="ta-r">{{ board.sort_order }}</td>
          <td data-label="관리" class="ta-r"><a class="btn btn-ghost btn-sm" href="{{ url_for('admin.boards.edit', {key: board.board_key}) }}">설정</a></td>
        </tr>
      {% else %}
        <tr class="tbl-empty"><td colspan="6">아직 게시판이 없습니다. 첫 게시판을 만들어 보세요.</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endblock %}
