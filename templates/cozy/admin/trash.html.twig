{% extends "admin/layout.html.twig" %}
{% block title %}내용 휴지통 · {{ site.site_name }}{% endblock %}
{% block admin_section %}content{% endblock %}
{% block body %}
<nav class="crumb" aria-label="현재 위치"><a href="{{ url_for('admin.index') }}">사이트 관리</a><span aria-hidden="true">›</span><a href="{{ url_for('admin.content') }}">내용</a><span aria-hidden="true">›</span><span aria-current="page">휴지통</span></nav>
<div class="adm-head">
  <div>
    <h1>내용 휴지통</h1>
    <p class="adm-sub">삭제한 내용은 공개되지 않으며 언제든 복원할 수 있습니다.</p>
  </div>
  <div class="adm-head-act"><a class="btn btn-ghost" href="{{ url_for('admin.content') }}">내용 관리로 돌아가기</a></div>
</div>

{% if query.restored|default('') == '1' %}<p class="banner banner-ok">내용을 초안 상태로 복원했습니다.</p>{% endif %}
{% if query.deleted|default('') == '1' %}<p class="banner banner-ok">내용과 연결된 이미지를 완전히 삭제했습니다.</p>{% endif %}

<section class="sheet">
  <div class="tbl-wrap">
    <table class="tbl">
      <thead><tr><th>제목</th><th>주소</th><th>삭제일</th><th class="ta-r">관리</th></tr></thead>
      <tbody>
      {% for page in pages %}
        <tr>
          <td data-label="제목"><strong class="tbl-title">{{ page.title }}</strong></td>
          <td data-label="주소"><code class="mono">/content/{{ page.slug }}</code></td>
          <td data-label="삭제일">{{ page.deleted_at|date('Y.m.d H:i') }}</td>
          <td data-label="관리" class="ta-r">
            <span class="act-row">
              <form method="post" action="{{ url_for('admin.content.restore', {id: page.id}) }}">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                <button class="btn btn-ghost btn-sm" type="submit">복원</button>
              </form>
              <form method="post" action="{{ url_for('admin.content.permanent_delete', {id: page.id}) }}" onsubmit="return confirm('내용과 연결된 이미지를 모두 완전히 삭제할까요? 이 작업은 되돌릴 수 없습니다.')">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                <button class="btn btn-bad btn-sm" type="submit">완전 삭제</button>
              </form>
            </span>
          </td>
        </tr>
      {% else %}
        <tr class="tbl-empty"><td colspan="4">휴지통이 비어 있습니다.</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endblock %}
