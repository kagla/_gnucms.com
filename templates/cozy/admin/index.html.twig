{% extends "admin/layout.html.twig" %}
{% block title %}관리 · {{ site.site_name }}{% endblock %}
{% block admin_section %}dashboard{% endblock %}
{% block body %}
<div class="adm-head">
  <div>
    <h1>사이트 관리</h1>
    <p class="adm-sub">사이트 내용과 커뮤니티를 복잡한 절차 없이 관리합니다.</p>
  </div>
  <div class="adm-head-act"><a class="btn btn-brand" href="{{ url_for('admin.content.create') }}">내용 만들기</a></div>
</div>

{% if query.saved|default('') == '1' %}<p class="banner banner-ok">변경사항을 저장했습니다.</p>{% endif %}
{% if query.deleted|default('') == '1' %}<p class="banner banner-ok">게시판을 삭제했습니다.</p>{% endif %}

<section class="kpi-grid" aria-label="운영 현황">
  <a class="kpi" href="{{ url_for('admin.boards') }}">
    <span class="kpi-label">게시판</span><strong class="kpi-value">{{ board_count }}</strong><span class="kpi-go">관리하기 ›</span>
  </a>
  <a class="kpi" href="{{ url_for('admin.content') }}">
    <span class="kpi-label">내용</span><strong class="kpi-value">{{ page_count }}</strong><span class="kpi-go">관리하기 ›</span>
  </a>
  <div class="kpi">
    <span class="kpi-label">게시글</span><strong class="kpi-value">{{ post_count }}</strong><span class="kpi-note">삭제되지 않은 글</span>
  </div>
  <a class="kpi" href="{{ url_for('admin.members') }}">
    <span class="kpi-label">회원</span><strong class="kpi-value">{{ user_count }}</strong><span class="kpi-go">관리하기 ›</span>
  </a>
</section>

<section class="sheet">
  <header class="sheet-head sheet-head-row">
    <h2>게시판 바로가기</h2>
    <a class="link" href="{{ url_for('admin.boards') }}">전체 관리 ›</a>
  </header>
  {% if boards is empty %}
    <div class="blank blank-sm">
      <p class="blank-title">아직 게시판이 없습니다</p>
      <a class="btn btn-brand" href="{{ url_for('admin.boards.create') }}">첫 게시판 만들기</a>
    </div>
  {% else %}
    <ul class="rowlist">
      {% for board in boards %}
        <li><a href="{{ url_for('admin.boards.edit', {key: board.board_key}) }}">
          <span class="rowlist-icon" data-tone="{{ loop.index0 % 6 }}" aria-hidden="true">{{ board.name|slice(0, 1) }}</span>
          <span class="rowlist-copy"><strong>{{ board.name }}</strong><small>/boards/{{ board.board_key }}</small></span>
          <span class="rowlist-go" aria-hidden="true">›</span>
        </a></li>
      {% endfor %}
    </ul>
  {% endif %}
</section>
{% endblock %}
