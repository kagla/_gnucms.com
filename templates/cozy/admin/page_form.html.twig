{% extends "admin/layout.html.twig" %}
{% block title %}{{ create ? '내용 만들기' : (legal ? values.title ~ ' 수정' : '내용 수정') }} · {{ site.site_name }}{% endblock %}
{% block admin_section %}content{% endblock %}
{% block body %}
<nav class="crumb" aria-label="현재 위치"><a href="{{ url_for('admin.index') }}">사이트 관리</a><span aria-hidden="true">›</span><a href="{{ url_for(legal ? 'admin.terms' : 'admin.content') }}">{{ legal ? '약관' : '내용' }}</a><span aria-hidden="true">›</span><span aria-current="page">{{ create ? '새 내용' : values.title }}</span></nav>

<section class="sheet">
  <header class="sheet-head">
    <h1>{{ create ? '내용 만들기' : (legal ? values.title ~ ' 수정' : '내용 수정') }}</h1>
    <p class="sheet-sub">내용을 작성하고 공개 여부와 메뉴 표시만 정하세요.</p>
  </header>

  <form class="form" method="post" action="{{ create ? url_for('admin.content.create') : url_for('admin.content.edit', {id: page_id}) }}">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <input type="hidden" name="image_key" value="{{ values.image_key }}">
    <input type="hidden" name="uploaded_images" value="{{ values.uploaded_images|default('') }}" data-uploaded-images>

    <div class="field{% if errors.title is defined %} is-bad{% endif %}">
      <label class="field-label" for="c-title">제목</label>
      <input id="c-title" type="text" name="title" value="{{ values.title|default('') }}" maxlength="200" required>
      {% if errors.title is defined %}<p class="field-msg">{{ errors.title }}</p>{% endif %}
    </div>
    <div class="field{% if errors.slug is defined %} is-bad{% endif %}">
      <label class="field-label" for="c-slug">주소 <span class="field-tip">{{ legal ? '회원가입 연결을 위해 고정됩니다.' : '예: about' }}</span></label>
      <input id="c-slug" type="text" name="slug" value="{{ values.slug|default('') }}" maxlength="100" pattern="[a-z0-9][a-z0-9_-]*"{{ legal ? ' readonly' : '' }} required>
      {% if errors.slug is defined %}<p class="field-msg">{{ errors.slug }}</p>{% endif %}
    </div>
    <div class="field{% if errors.content is defined %} is-bad{% endif %}">
      <label class="field-label" for="content-editor">내용</label>
      <textarea id="content-editor" name="content" rows="14" data-cms-editor>{{ values.content|default('') }}</textarea>
      <p class="field-note">사진 올리기에서 여러 장을 선택하거나 편집 영역으로 끌어놓을 수 있습니다.</p>
      {% if errors.content is defined %}<p class="field-msg">{{ errors.content }}</p>{% endif %}
    </div>
    <div class="grid-2">
      <div class="field">
        <label class="field-label" for="c-status">상태</label>
        <select id="c-status" name="status">
          <option value="draft"{{ values.status|default('draft') == 'draft' ? ' selected' : '' }}>초안</option>
          <option value="published"{{ values.status|default('draft') == 'published' ? ' selected' : '' }}>공개</option>
        </select>
      </div>
      <div class="field">
        <label class="field-label" for="c-sort">메뉴 순서</label>
        <input id="c-sort" type="number" name="sort_order" value="{{ values.sort_order|default(0) }}" min="-9999" max="9999" inputmode="numeric">
      </div>
    </div>
    <div class="switch-list">
      <label class="switch">
        <input type="checkbox" name="show_in_menu" value="1"{{ values.show_in_menu|default(false) ? ' checked' : '' }}>
        <span class="switch-track" aria-hidden="true"><span class="switch-knob"></span></span>
        <span class="switch-copy"><strong>상단 메뉴에 표시</strong></span>
      </label>
    </div>
    <div class="form-bar">
      {% if not create %}<a class="btn btn-ghost" href="{{ url_for('admin.content.preview', {id: page_id}) }}" target="_blank" rel="noopener">미리보기</a>{% endif %}
      <a class="btn btn-ghost" href="{{ url_for(legal ? 'admin.terms' : 'admin.content') }}">취소</a>
      <button class="btn btn-brand" type="submit">{{ create ? '내용 만들기' : '변경사항 저장' }}</button>
    </div>
  </form>

  {% if not create %}
    <form class="danger-box" method="post" action="{{ url_for('admin.content.delete', {id: page_id}) }}" onsubmit="return confirm('이 내용을 휴지통으로 옮길까요?')">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <div><strong>휴지통으로 이동</strong><p>공개가 중단되며 휴지통에서 다시 복원할 수 있습니다.</p></div>
      <button class="btn btn-bad" type="submit">휴지통으로 이동</button>
    </form>
  {% endif %}
</section>
{% endblock %}
{% block scripts %}{% include "admin/_editor.html.twig" %}{% endblock %}
