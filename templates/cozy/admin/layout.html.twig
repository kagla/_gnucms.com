{% extends "layout.html.twig" %}
{% block body_class %}admin-page{% endblock %}
{% block admin_section %}dashboard{% endblock %}
{% block chrome %}
<div class="adm">
  {% include 'admin/_sidebar.html.twig' with {'section': block('admin_section')|trim} %}
  <div class="adm-main">
    <header class="adm-top">
      <button class="icon-btn adm-menu" type="button" aria-controls="adm-side" aria-expanded="false" aria-label="관리 메뉴 열기"><span class="bars" aria-hidden="true"></span></button>
      <a class="adm-top-title" href="{{ url_for('admin.index') }}">관리 콘솔</a>
      <div class="adm-top-right">
        <a class="btn btn-ghost btn-sm" href="{{ url_for('boards.index') }}">사이트 보기</a>
        <button class="icon-btn theme-toggle" type="button" aria-label="다크 모드로 전환" title="다크 모드로 전환"><span class="theme-icon" aria-hidden="true">☾</span></button>
      </div>
    </header>
    <div class="adm-body" id="main">{{ block('body') }}</div>
  </div>
  <div class="adm-dim" data-adm-close hidden></div>
</div>
<script>
(function(){
  var root=document.documentElement,shell=document.querySelector('.adm');
  var fold=document.querySelector('.adm-fold'),menu=document.querySelector('.adm-menu'),dim=document.querySelector('.adm-dim');
  function syncFold(){
    if(!fold){return}
    var folded=root.dataset.adminSidebar==='collapsed';
    fold.setAttribute('aria-expanded',folded?'false':'true');
    fold.setAttribute('aria-label',folded?'관리 메뉴 펼치기':'관리 메뉴 접기');
    fold.title=fold.getAttribute('aria-label');
  }
  if(fold){
    fold.addEventListener('click',function(){
      var folded=root.dataset.adminSidebar==='collapsed';
      if(folded){delete root.dataset.adminSidebar}else{root.dataset.adminSidebar='collapsed'}
      try{localStorage.setItem('{{ GNUCMS_ID }}-admin-sidebar',folded?'expanded':'collapsed')}catch(e){}
      syncFold();
    });
    syncFold();
  }
  function closeSide(){
    if(!shell){return}
    shell.classList.remove('is-open');
    if(dim){dim.hidden=true}
    if(menu){menu.setAttribute('aria-expanded','false');menu.setAttribute('aria-label','관리 메뉴 열기')}
  }
  if(menu&&shell){
    menu.addEventListener('click',function(){
      var open=shell.classList.toggle('is-open');
      if(dim){dim.hidden=!open}
      menu.setAttribute('aria-expanded',open?'true':'false');
      menu.setAttribute('aria-label',open?'관리 메뉴 닫기':'관리 메뉴 열기');
    });
    if(dim){dim.addEventListener('click',closeSide)}
    document.addEventListener('keydown',function(e){if(e.key==='Escape'){closeSide()}});
  }
})();
</script>
{% endblock %}
