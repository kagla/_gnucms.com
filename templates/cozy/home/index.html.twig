{% extends "layout.html.twig" %}
{% block title %}{{ site.site_name }} · {{ site.site_tagline }}{% endblock %}
{% block nav_section %}home{% endblock %}
{% block body %}
<section class="promo">
  <div class="promo-copy">
    <p class="promo-eyebrow">{{ site.site_tagline }}</p>
    <h1 class="promo-title">{{ site.home_title }}</h1>
    <p class="promo-lead">{{ site.home_intro }}</p>
    <div class="promo-actions">
      {% if boards is not empty %}
        <a class="btn btn-brand btn-lg" href="{{ url_for('posts.index', {'key': boards[0].board_key}) }}">둘러보기</a>
      {% endif %}
      {% if current_user.is_guest and registration_available %}
        <a class="btn btn-ghost btn-lg" href="{{ url_for('auth.register') }}">회원가입</a>
      {% endif %}
    </div>
  </div>
  <div class="promo-art" aria-hidden="true">
    <span class="promo-blob promo-blob-1"></span>
    <span class="promo-blob promo-blob-2"></span>
    <span class="promo-blob promo-blob-3"></span>
  </div>
</section>

{% if boards is not empty %}
  <nav class="quick-cats" aria-label="게시판 바로가기">
    {% for board in boards %}
      <a class="quick-cat" href="{{ url_for('posts.index', {'key': board.board_key}) }}">
        <span class="quick-cat-icon" data-tone="{{ loop.index0 % 6 }}" aria-hidden="true">{{ board.name|slice(0, 1) }}</span>
        <span class="quick-cat-name">{{ board.name }}</span>
      </a>
    {% endfor %}
  </nav>
{% endif %}

{% if boards is empty %}
  <div class="blank">
    <span class="blank-art" aria-hidden="true"></span>
    <p class="blank-title">아직 만들어진 게시판이 없습니다</p>
    <p class="blank-sub">관리 콘솔에서 첫 게시판을 만들어 보세요.</p>
    {% if not current_user.is_guest and current_user.is_admin %}
      <a class="btn btn-brand" href="{{ url_for('admin.boards.create') }}">게시판 만들기</a>
    {% endif %}
  </div>
{% else %}
  {% for board in boards %}
    <section class="feed" aria-labelledby="feed-{{ board.board_key }}">
      <header class="feed-head">
        <div>
          <h2 id="feed-{{ board.board_key }}">{{ board.name }}</h2>
          <p class="feed-sub">{{ board.description ?: '새로운 이야기와 소식을 확인해 보세요.' }}</p>
        </div>
        <a class="feed-more" href="{{ url_for('posts.index', {'key': board.board_key}) }}">전체보기 <span aria-hidden="true">›</span></a>
      </header>

      {% if board.latest_posts is empty %}
        <div class="blank blank-sm">
          <p class="blank-title">아직 등록된 글이 없습니다</p>
        </div>
      {% else %}
        <div class="card-rail">
          {% for post in board.latest_posts %}
            <a class="p-card" href="{{ url_for('posts.show', {'id': post.id}) }}">
              <span class="p-cover" data-tone="{{ post.id % 6 }}">
                <span class="p-cover-tag">{% if post.is_notice %}공지{% elseif post.category %}{{ post.category }}{% else %}{{ board.name }}{% endif %}</span>
                <span class="p-cover-mark" aria-hidden="true">{{ post.title|slice(0, 1) }}</span>
              </span>
              <span class="p-body">
                <span class="p-title">{{ post.title }}</span>
                <span class="p-meta">
                  <span class="avatar avatar-xs" data-tone="{{ post.author_name|length % 6 }}" aria-hidden="true">{{ post.author_name|slice(0, 1)|upper }}</span>
                  <span class="p-author">{{ post.author_name }}</span>
                  <span class="mid-dot" aria-hidden="true"></span>
                  <time datetime="{{ post.created_at }}">{{ post.created_at|date('m.d') }}</time>
                </span>
                <span class="p-stats">
                  <span class="p-stat"><span class="p-stat-icon" aria-hidden="true"><svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1.6 8s2.5-4.2 6.4-4.2S14.4 8 14.4 8s-2.5 4.2-6.4 4.2S1.6 8 1.6 8Z"/><circle cx="8" cy="8" r="1.8"/></svg></span>{{ post.view_count }}</span>
                  <span class="p-stat"><span class="p-stat-icon" aria-hidden="true"><svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><path d="M2.4 4.2a1.4 1.4 0 0 1 1.4-1.4h8.4a1.4 1.4 0 0 1 1.4 1.4v5.2a1.4 1.4 0 0 1-1.4 1.4H6.6L3.6 13.2v-2.4a1.4 1.4 0 0 1-1.2-1.4Z"/></svg></span>{{ post.comment_count }}</span>
                </span>
              </span>
            </a>
          {% endfor %}
        </div>
      {% endif %}
    </section>
  {% endfor %}
{% endif %}
{% endblock %}
