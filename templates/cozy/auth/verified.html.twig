{% extends "layout.html.twig" %}
{% block title %}이메일 인증 완료 · {{ site.site_name }}{% endblock %}
{% block body %}
<div class="gate">
  <section class="gate-card gate-card-done">
    <span class="gate-mark gate-mark-ok" aria-hidden="true">✓</span>
    <h1>인증이 완료됐어요</h1>
    <p class="gate-sub">이제 로그인하고 커뮤니티에 참여할 수 있어요.</p>
    <a class="btn btn-brand btn-lg btn-block" href="{{ url_for('auth.login') }}">로그인하기</a>
  </section>
</div>
{% endblock %}
