{% extends "layout.html.twig" %}
{% block title %}회원가입 · {{ site.site_name }}{% endblock %}
{% block body %}
<div class="gate">
  <section class="gate-card">
    <header class="gate-head">
      <span class="gate-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 10.4 12 3.6l8.5 6.8"/><path d="M5.8 12v7.2a1 1 0 0 0 1 1h10.4a1 1 0 0 0 1-1V12"/></svg>
      </span>
      <h1>{{ site.site_name }} 시작하기</h1>
      <p class="gate-sub">1분이면 가입할 수 있어요.</p>
    </header>
    <form class="form" method="post" action="{{ url_for('auth.register') }}">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <div class="field{% if errors.email is defined %} is-bad{% endif %}">
        <label class="field-label" for="join-email">이메일</label>
        <input id="join-email" type="email" name="email" value="{{ values.email|default('') }}" maxlength="191" autocomplete="email" placeholder="you@example.com" required>
        {% if errors.email is defined %}<p class="field-msg">{{ errors.email }}</p>{% endif %}
      </div>
      <div class="field{% if errors.password is defined %} is-bad{% endif %}">
        <label class="field-label" for="join-password">비밀번호 <span class="field-tip">8자 이상</span></label>
        <input id="join-password" type="password" name="password" minlength="8" autocomplete="new-password" required>
        {% if errors.password is defined %}<p class="field-msg">{{ errors.password }}</p>{% endif %}
      </div>
      <div class="field{% if errors.password_confirmation is defined %} is-bad{% endif %}">
        <label class="field-label" for="join-password2">비밀번호 확인</label>
        <input id="join-password2" type="password" name="password_confirmation" minlength="8" autocomplete="new-password" required>
        {% if errors.password_confirmation is defined %}<p class="field-msg">{{ errors.password_confirmation }}</p>{% endif %}
      </div>
      {% if legal %}
        <div class="agree-box">
          <label class="agree{% if errors.agree_terms is defined %} is-bad{% endif %}">
            <input type="checkbox" name="agree_terms" value="1"{{ values.agree_terms|default(false) ? ' checked' : '' }} required>
            <span class="agree-check" aria-hidden="true"></span>
            <span><a class="link" href="{{ url_for('terms.show', {type: 'service'}) }}" target="_blank" rel="noopener">이용약관</a> 동의 <em class="need">필수</em></span>
          </label>
          {% if errors.agree_terms is defined %}<p class="field-msg">{{ errors.agree_terms }}</p>{% endif %}
          <label class="agree{% if errors.agree_privacy is defined %} is-bad{% endif %}">
            <input type="checkbox" name="agree_privacy" value="1"{{ values.agree_privacy|default(false) ? ' checked' : '' }} required>
            <span class="agree-check" aria-hidden="true"></span>
            <span><a class="link" href="{{ url_for('terms.show', {type: 'privacy'}) }}" target="_blank" rel="noopener">개인정보 수집·이용</a> 동의 <em class="need">필수</em></span>
          </label>
          {% if errors.agree_privacy is defined %}<p class="field-msg">{{ errors.agree_privacy }}</p>{% endif %}
        </div>
      {% endif %}
      <button class="btn btn-brand btn-lg btn-block" type="submit">가입하기</button>
    </form>
    {% include "auth/_social.html.twig" %}
    <p class="gate-switch">이미 계정이 있으신가요? <a href="{{ url_for('auth.login') }}">로그인</a></p>
  </section>
</div>
{% endblock %}
