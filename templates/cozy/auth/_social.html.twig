{% if oauth_providers is not empty %}
  <div class="or-line"><span>또는</span></div>
  <div class="sns-list">
    {% for provider in oauth_providers %}
      <a class="sns-btn sns-{{ provider.key }}" href="{{ url_for('oauth.start', {provider: provider.key}) }}">
        <span class="sns-mark" aria-hidden="true">{% if provider.key == 'google' %}G{% elseif provider.key == 'naver' %}N{% elseif provider.key == 'kakao' %}K{% else %}⌘{% endif %}</span>
        <span>{{ provider.label }}로 계속하기</span>
      </a>
    {% endfor %}
  </div>
  {% include "auth/_social_consent.html.twig" %}
{% endif %}
