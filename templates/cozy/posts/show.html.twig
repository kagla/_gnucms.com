{% extends "layout.html.twig" %}
{% block title %}{{ post.title }} · {{ site.site_name }}{% endblock %}
{% block meta_description %}<meta name="description" content="{{ post.content|striptags|slice(0, 150) }}">{% endblock %}
{% block nav_section %}board{% endblock %}
{% block extra_tabs %}<a class="tab is-active" href="{{ url_for('posts.index', {'key': board.board_key}) }}" aria-current="page">{{ board.name }}</a>{% endblock %}
{% block body %}
<div class="back-row">
  <a class="back-link" href="{{ url_for('posts.index', {'key': board.board_key}) }}">
    <span aria-hidden="true">‹</span> {{ board.name }}
  </a>
</div>

<article class="detail">
  <header class="detail-head">
    {% if post.category %}<span class="chip-tone" data-tone="{{ post.id % 6 }}">{{ post.category }}</span>{% endif %}
    <h1 class="detail-title">{{ post.title }}</h1>
    <div class="detail-writer">
      <span class="avatar" data-tone="{{ post.author_name|length % 6 }}" aria-hidden="true">{{ post.author_name|slice(0, 1)|upper }}</span>
      <span class="detail-writer-copy">
        <strong>{{ post.author_name }}</strong>
        <time datetime="{{ post.created_at }}">{{ post.created_at|date('Y년 m월 d일 H:i') }}</time>
      </span>
      <a class="btn btn-ghost btn-sm detail-list-btn" href="{{ url_for('posts.index', {'key': board.board_key}) }}">목록</a>
    </div>
  </header>

  <div class="detail-body prose">{{ post.content|nl2br }}</div>

  {% if post.attachments is not empty %}
    <section class="files" aria-labelledby="files-title">
      <h2 id="files-title" class="mini-head">첨부파일 {{ post.attachments|length }}</h2>
      <ul class="file-list">
        {% for file in post.attachments %}
          <li>
            <a href="{{ url_for('files.download', {'id': post.id, 'index': file.index}) }}">
              <span class="file-icon" aria-hidden="true"><svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M11.5 3H6a1.5 1.5 0 0 0-1.5 1.5v11A1.5 1.5 0 0 0 6 17h8a1.5 1.5 0 0 0 1.5-1.5V7z"/><path d="M11.5 3v4h4"/></svg></span>
              <span class="file-name">{{ file.name }}</span>
              <span class="file-size">{{ (file.size / 1024)|round }} KB</span>
            </a>
          </li>
        {% endfor %}
      </ul>
    </section>
  {% endif %}

  <div class="detail-stats">
    <span class="d-stat"><span class="d-stat-icon" aria-hidden="true"><svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1.6 8s2.5-4.2 6.4-4.2S14.4 8 14.4 8s-2.5 4.2-6.4 4.2S1.6 8 1.6 8Z"/><circle cx="8" cy="8" r="1.8"/></svg></span>조회 {{ post.view_count }}</span>
    <span class="d-stat"><span class="d-stat-icon" aria-hidden="true"><svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><path d="M2.4 4.2a1.4 1.4 0 0 1 1.4-1.4h8.4a1.4 1.4 0 0 1 1.4 1.4v5.2a1.4 1.4 0 0 1-1.4 1.4H6.6L3.6 13.2v-2.4a1.4 1.4 0 0 1-1.2-1.4Z"/></svg></span>댓글 {{ post.comment_count }}</span>
    <a class="d-stat d-stat-link" href="#comments">댓글 보기 <span aria-hidden="true">↓</span></a>
  </div>
</article>

<section class="comments" id="comments" aria-labelledby="comments-title">
  <h2 class="mini-head" id="comments-title">댓글 <span class="num-pill">{{ post.comment_count }}</span></h2>
  {% if comments is empty %}
    <div class="blank blank-sm">
      <p class="blank-title">첫 댓글을 기다리고 있어요</p>
    </div>
  {% else %}
    {% include 'posts/_comments.html.twig' with {'nodes': comments, 'nested': false} only %}
  {% endif %}
</section>

<div class="detail-foot">
  <a class="btn btn-ghost btn-lg" href="{{ url_for('posts.index', {'key': board.board_key}) }}">목록으로 돌아가기</a>
</div>
{% endblock %}
