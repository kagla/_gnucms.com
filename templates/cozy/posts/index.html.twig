{% extends "layout.html.twig" %}
{% import _self as h %}

{% macro listUrl(board, q, category, page) %}
{%- set params = [] -%}
{%- if q %}{% set params = params|merge(['q=' ~ q|url_encode]) %}{% endif -%}
{%- if category %}{% set params = params|merge(['category=' ~ category|url_encode]) %}{% endif -%}
{%- if page and page > 1 %}{% set params = params|merge(['page=' ~ page]) %}{% endif -%}
{{- url_for('posts.index', {'key': board.board_key}) }}{% if params is not empty %}?{{ params|join('&amp;')|raw }}{% endif %}
{%- endmacro %}

{% block title %}{{ board.name }} · {{ site.site_name }}{% endblock %}
{% block nav_section %}board{% endblock %}

{% block extra_tabs %}<a class="tab is-active" href="{{ url_for('posts.index', {'key': board.board_key}) }}" aria-current="page">{{ board.name }}</a>{% endblock %}

{% block header_search %}
<form class="gnb-search" method="get" action="{{ url_for('posts.index', {'key': board.board_key}) }}" role="search">
  {% if query.category is not empty %}<input type="hidden" name="category" value="{{ query.category }}">{% endif %}
  <span class="gnb-search-icon" aria-hidden="true"><svg viewBox="0 0 20 20" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="9" cy="9" r="5.6"/><path d="M13.2 13.2 17.2 17.2"/></svg></span>
  <input type="search" name="q" value="{{ query.q }}" placeholder="{{ board.name }}에서 검색" aria-label="게시글 검색" data-search-input>
  <button class="gnb-search-go" type="submit">검색</button>
</form>
{% endblock %}

{% block subnav %}
<div class="subnav">
  <div class="subnav-inner container">
    {% if board.use_category and board.categories is not empty %}
      <div class="chip-row" role="group" aria-label="분류 선택">
        <a class="chip-tab{% if query.category is empty %} is-active{% endif %}" href="{{ h.listUrl(board, query.q, null, 1)|trim }}">전체</a>
        {% for name in board.categories %}
          <a class="chip-tab{% if query.category == name %} is-active{% endif %}" href="{{ h.listUrl(board, query.q, name, 1)|trim }}">{{ name }}</a>
        {% endfor %}
      </div>
    {% else %}
      <div class="chip-row"><span class="chip-tab is-active">전체</span></div>
    {% endif %}
    <span class="subnav-count">{{ list.total }}개</span>
  </div>
</div>
{% endblock %}

{% block body %}
{% set filtered = query.q is not empty or query.category is not empty %}

<header class="board-head">
  <div>
    <h1>{{ board.name }}</h1>
    {% if board.description %}<p class="board-desc">{{ board.description }}</p>{% endif %}
  </div>
  {% if can_write %}
    <a class="btn btn-brand board-write" href="{{ url_for('posts.create', {'key': board.board_key}) }}">글쓰기</a>
  {% endif %}
</header>

<form class="inline-search" method="get" action="{{ url_for('posts.index', {'key': board.board_key}) }}" role="search">
  {% if query.category is not empty %}<input type="hidden" name="category" value="{{ query.category }}">{% endif %}
  <span class="inline-search-icon" aria-hidden="true"><svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="9" cy="9" r="5.6"/><path d="M13.2 13.2 17.2 17.2"/></svg></span>
  <input type="search" name="q" value="{{ query.q }}" placeholder="{{ board.name }}에서 검색" aria-label="게시글 검색">
  <button class="btn btn-ghost btn-sm" type="submit">검색</button>
</form>

{% if filtered %}
  <p class="result-note">
    {% if query.category is not empty %}<strong>{{ query.category }}</strong>{% endif %}
    {% if query.q is not empty %}<strong>“{{ query.q }}”</strong> 검색{% endif %}
    결과 {{ list.total }}개
    <a class="link" href="{{ url_for('posts.index', {'key': board.board_key}) }}">필터 지우기</a>
  </p>
{% endif %}

{% if list.notices is not empty %}
  <section class="notice-strip" aria-label="공지">
    {% for post in list.notices %}
      <a class="notice-row" href="{{ url_for('posts.show', {'id': post.id}) }}">
        <span class="notice-badge" aria-hidden="true">
          <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M2.4 6.4h2.2l6-3v9.2l-6-3H2.4z"/><path d="M4.6 9.6v2.8h2"/></svg>
        </span>
        <span class="notice-label">공지</span>
        <span class="notice-title">{{ post.title }}</span>
        <time class="notice-date" datetime="{{ post.created_at }}">{{ post.created_at|date('m.d') }}</time>
      </a>
    {% endfor %}
  </section>
{% endif %}

{% if list.data is empty and list.notices is empty %}
  <div class="blank">
    <span class="blank-art" aria-hidden="true"></span>
    <p class="blank-title">{% if filtered %}조건에 맞는 글이 없습니다{% else %}아직 등록된 글이 없습니다{% endif %}</p>
    <p class="blank-sub">{% if filtered %}다른 검색어나 분류로 다시 찾아보세요.{% else %}첫 이야기를 남겨 이 게시판을 열어보세요.{% endif %}</p>
    {% if filtered %}
      <a class="btn btn-ghost" href="{{ url_for('posts.index', {'key': board.board_key}) }}">전체 글 보기</a>
    {% elseif can_write %}
      <a class="btn btn-brand" href="{{ url_for('posts.create', {'key': board.board_key}) }}">첫 글 쓰기</a>
    {% endif %}
  </div>
{% elseif list.data is not empty %}
  <div class="card-grid">
    {% for post in list.data %}
      <a class="p-card" href="{{ url_for('posts.show', {'id': post.id}) }}">
        <span class="p-cover" data-tone="{{ post.id % 6 }}">
          <span class="p-cover-tag">{% if board.use_category and post.category %}{{ post.category }}{% else %}{{ board.name }}{% endif %}</span>
          <span class="p-cover-mark" aria-hidden="true">{{ post.title|slice(0, 1) }}</span>
          {% if post.is_secret %}<span class="p-lock" title="비밀글" aria-label="비밀글"><svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3.2" y="7" width="9.6" height="6.6" rx="1.6"/><path d="M5.6 7V5.2a2.4 2.4 0 0 1 4.8 0V7"/></svg></span>{% endif %}
        </span>
        <span class="p-body">
          <span class="p-title">{{ post.title }}</span>
          <span class="p-meta">
            <span class="avatar avatar-xs" data-tone="{{ post.author_name|length % 6 }}" aria-hidden="true">{{ post.author_name|slice(0, 1)|upper }}</span>
            <span class="p-author">{{ post.author_name }}</span>
            <span class="mid-dot" aria-hidden="true"></span>
            <time datetime="{{ post.created_at }}">{{ post.created_at|date('Y.m.d') }}</time>
          </span>
          <span class="p-stats">
            <span class="p-stat"><span class="p-stat-icon" aria-hidden="true"><svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1.6 8s2.5-4.2 6.4-4.2S14.4 8 14.4 8s-2.5 4.2-6.4 4.2S1.6 8 1.6 8Z"/><circle cx="8" cy="8" r="1.8"/></svg></span>{{ post.view_count }}</span>
            <span class="p-stat"><span class="p-stat-icon" aria-hidden="true"><svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><path d="M2.4 4.2a1.4 1.4 0 0 1 1.4-1.4h8.4a1.4 1.4 0 0 1 1.4 1.4v5.2a1.4 1.4 0 0 1-1.4 1.4H6.6L3.6 13.2v-2.4a1.4 1.4 0 0 1-1.2-1.4Z"/></svg></span>{{ post.comment_count }}</span>
            {% if post.file_count > 0 %}<span class="p-stat"><span class="p-stat-icon" aria-hidden="true"><svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M10.5 5 5.8 9.7a1.9 1.9 0 0 0 2.7 2.7l4.7-4.7a3.4 3.4 0 0 0-4.8-4.8L3.6 7.6"/></svg></span>{{ post.file_count }}</span>{% endif %}
          </span>
        </span>
      </a>
    {% endfor %}
  </div>
{% endif %}

{% if list.total_pages > 1 %}
  {% set window = 4 %}
  {% set start = max(1, list.page - window) %}
  {% set end = min(list.total_pages, list.page + window) %}
  <nav class="pager" aria-label="페이지 이동">
    {% if list.page > 1 %}<a class="pager-step" rel="prev" href="{{ h.listUrl(board, query.q, query.category, list.page - 1)|trim }}" aria-label="이전 페이지"><span aria-hidden="true">‹</span></a>{% endif %}
    {% if start > 1 %}
      <a href="{{ h.listUrl(board, query.q, query.category, 1)|trim }}" aria-label="1 페이지">1</a>
      {% if start > 2 %}<span class="pager-gap" aria-hidden="true">…</span>{% endif %}
    {% endif %}
    {% for p in start..end %}
      {% if p == list.page %}<strong aria-current="page">{{ p }}</strong>{% else %}<a href="{{ h.listUrl(board, query.q, query.category, p)|trim }}" aria-label="{{ p }} 페이지">{{ p }}</a>{% endif %}
    {% endfor %}
    {% if end < list.total_pages %}
      {% if end < list.total_pages - 1 %}<span class="pager-gap" aria-hidden="true">…</span>{% endif %}
      <a href="{{ h.listUrl(board, query.q, query.category, list.total_pages)|trim }}" aria-label="{{ list.total_pages }} 페이지">{{ list.total_pages }}</a>
    {% endif %}
    {% if list.page < list.total_pages %}<a class="pager-step" rel="next" href="{{ h.listUrl(board, query.q, query.category, list.page + 1)|trim }}" aria-label="다음 페이지"><span aria-hidden="true">›</span></a>{% endif %}
  </nav>
{% endif %}

{% if can_write %}
  <a class="fab" href="{{ url_for('posts.create', {'key': board.board_key}) }}" aria-label="글쓰기">
    <span aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h4.2L19 9.2a2.1 2.1 0 0 0-3-3L5.2 17z"/><path d="M14.6 6.4 17.6 9.4"/></svg></span>
  </a>
{% endif %}
{% endblock %}
