<ul class="cmt-list{% if nested|default(false) %} cmt-list-sub{% endif %}">
{% for comment in nodes %}
  <li class="cmt{% if comment.deleted %} is-gone{% endif %}">
    <div class="cmt-row">
      <span class="avatar avatar-sm" data-tone="{{ comment.deleted ? 0 : comment.author_name|length % 6 }}" aria-hidden="true">{{ comment.deleted ? '·' : comment.author_name|slice(0, 1)|upper }}</span>
      <div class="cmt-main">
        <p class="cmt-head">
          {% if comment.deleted %}
            <span class="cmt-name is-gone">삭제된 댓글</span>
          {% else %}
            <span class="cmt-name">{{ comment.author_name }}</span>
          {% endif %}
          <time datetime="{{ comment.created_at }}">{{ comment.created_at|date('Y.m.d H:i') }}</time>
          {% if comment.is_secret %}<span class="cmt-lock" title="비밀 댓글" aria-label="비밀 댓글"><svg viewBox="0 0 16 16" width="11" height="11" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3.2" y="7" width="9.6" height="6.6" rx="1.6"/><path d="M5.6 7V5.2a2.4 2.4 0 0 1 4.8 0V7"/></svg></span>{% endif %}
        </p>
        <p class="cmt-text">{{ comment.content|nl2br }}</p>
      </div>
    </div>
    {% if comment.children is not empty %}
      {% include 'posts/_comments.html.twig' with {'nodes': comment.children, 'nested': true} only %}
    {% endif %}
  </li>
{% endfor %}
</ul>
