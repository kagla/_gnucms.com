<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#15181b" media="(prefers-color-scheme: dark)">
<title>{% block title %}{{ site.site_name }}{% endblock %}</title>
{% block meta_description %}<meta name="description" content="{{ site.site_tagline }}">{% endblock %}
<script>
try{var t=localStorage.getItem('gnucms-theme');if(t){document.documentElement.dataset.theme=t}if(localStorage.getItem('gnucms-admin-sidebar')==='collapsed'){document.documentElement.dataset.adminSidebar='collapsed'}}catch(e){}
</script>
<link rel="stylesheet" href="{{ theme_asset('theme.css') }}">
</head>
<body class="{% block body_class %}{% endblock %}" data-section="{% block nav_section %}{% endblock %}">
<a class="skip-link" href="#main">본문 바로가기</a>
{% block chrome %}
{% block site_header %}
<header class="gnb">
  <div class="gnb-bar">
    <div class="gnb-inner container">
      <a class="logo" href="{{ url_for('boards.index') }}">
        <span class="logo-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 10.4 12 3.6l8.5 6.8"/><path d="M5.8 12v7.2a1 1 0 0 0 1 1h10.4a1 1 0 0 0 1-1V12"/><path d="M9.9 20.2v-5h4.2v5"/></svg>
        </span>
        <span class="logo-text">{{ site.site_name }}</span>
      </a>

      <div class="gnb-center">{% block header_search %}{% endblock %}</div>

      <div class="gnb-actions">
        <button class="icon-btn theme-toggle" type="button" aria-label="다크 모드로 전환" title="다크 모드로 전환"><span class="theme-icon" aria-hidden="true">☾</span></button>
        {% if current_user.is_guest %}
          <a class="btn btn-ghost btn-sm gnb-login" href="{{ url_for('auth.login') }}">로그인</a>
          {% if registration_available %}<a class="btn btn-brand btn-sm gnb-join" href="{{ url_for('auth.register') }}">회원가입</a>{% endif %}
        {% else %}
          {% if current_user.is_admin %}<a class="gnb-link" href="{{ url_for('admin.index') }}">관리</a>{% endif %}
          <span class="gnb-me">
            <span class="avatar avatar-sm" data-tone="{{ current_user.display_name|length % 6 }}" aria-hidden="true">{{ current_user.display_name|slice(0, 1)|upper }}</span>
            <span class="gnb-me-name">{{ current_user.display_name }}</span>
          </span>
          <form class="logout-form" method="post" action="{{ url_for('auth.logout') }}">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <button class="btn btn-ghost btn-sm" type="submit">로그아웃</button>
          </form>
        {% endif %}
        <button class="icon-btn drawer-toggle" type="button" aria-expanded="false" aria-controls="drawer" aria-label="메뉴 열기"><span class="bars" aria-hidden="true"></span></button>
      </div>
    </div>
  </div>

  <nav class="gnb-tabs" aria-label="주요 메뉴">
    <div class="gnb-tabs-inner container">
      <a class="tab{% if block('nav_section')|trim == 'home' %} is-active{% endif %}" href="{{ url_for('boards.index') }}"{% if block('nav_section')|trim == 'home' %} aria-current="page"{% endif %}>홈</a>
      {% block extra_tabs %}{% endblock %}
      {% for item in site_menu %}
        <a class="tab" href="{{ url_for('content.show', {slug: item.slug}) }}">{{ item.title }}</a>
      {% endfor %}
    </div>
  </nav>
</header>

<div class="drawer" id="drawer" hidden>
  <div class="drawer-dim" data-drawer-close></div>
  <nav class="drawer-sheet" aria-label="전체 메뉴">
    <div class="drawer-top">
      <strong>{{ site.site_name }}</strong>
      <button class="icon-btn" type="button" data-drawer-close aria-label="메뉴 닫기">✕</button>
    </div>
    {% if not current_user.is_guest %}
      <div class="drawer-me">
        <span class="avatar" data-tone="{{ current_user.display_name|length % 6 }}" aria-hidden="true">{{ current_user.display_name|slice(0, 1)|upper }}</span>
        <div>
          <strong>{{ current_user.display_name }}</strong>
          <small>{{ current_user.is_admin ? '사이트 소유자' : '회원' }}</small>
        </div>
      </div>
    {% endif %}
    <div class="drawer-links">
      <a href="{{ url_for('boards.index') }}">홈</a>
      {% for item in site_menu %}<a href="{{ url_for('content.show', {slug: item.slug}) }}">{{ item.title }}</a>{% endfor %}
      {% if not current_user.is_guest and current_user.is_admin %}<a href="{{ url_for('admin.index') }}">관리 콘솔</a>{% endif %}
    </div>
    <div class="drawer-bottom">
      {% if current_user.is_guest %}
        <a class="btn btn-ghost" href="{{ url_for('auth.login') }}">로그인</a>
        {% if registration_available %}<a class="btn btn-brand" href="{{ url_for('auth.register') }}">회원가입</a>{% endif %}
      {% else %}
        <form class="logout-form" method="post" action="{{ url_for('auth.logout') }}">
          <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
          <button class="btn btn-ghost" type="submit">로그아웃</button>
        </form>
      {% endif %}
    </div>
  </nav>
</div>
{% endblock %}

{% block subnav %}{% endblock %}

<main class="container" id="main">{% block body %}{% endblock %}</main>

{% block site_footer %}
<footer class="foot">
  <div class="foot-inner container">
    <div class="foot-brand">
      <span class="logo-mark logo-mark-sm" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 10.4 12 3.6l8.5 6.8"/><path d="M5.8 12v7.2a1 1 0 0 0 1 1h10.4a1 1 0 0 0 1-1V12"/></svg>
      </span>
      <div>
        <strong>{{ site.site_name }}</strong>
        <p>{{ site.site_tagline }}</p>
      </div>
    </div>
    <nav class="foot-nav" aria-label="사이트 메뉴">
      <a href="{{ url_for('boards.index') }}">홈</a>
      {% for item in site_menu %}<a href="{{ url_for('content.show', {slug: item.slug}) }}">{{ item.title }}</a>{% endfor %}
      {% if legal_documents %}
        <a href="{{ url_for('terms.show', {type: 'service'}) }}">이용약관</a>
        <a href="{{ url_for('terms.show', {type: 'privacy'}) }}">개인정보 처리방침</a>
      {% endif %}
    </nav>
  </div>
</footer>
{% endblock %}

<nav class="tabbar" aria-label="빠른 이동">
  <a class="tabbar-item{% if block('nav_section')|trim == 'home' %} is-active{% endif %}" href="{{ url_for('boards.index') }}">
    <span class="tabbar-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 10.4 12 3.6l8.5 6.8"/><path d="M5.8 12v7.2a1 1 0 0 0 1 1h10.4a1 1 0 0 0 1-1V12"/></svg></span>
    <span>홈</span>
  </a>
  <button class="tabbar-item" type="button" data-drawer-open>
    <span class="tabbar-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg></span>
    <span>메뉴</span>
  </button>
  {% if current_user.is_guest %}
    <a class="tabbar-item" href="{{ url_for('auth.login') }}">
      <span class="tabbar-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8.4" r="3.4"/><path d="M5.2 19.4a6.8 6.8 0 0 1 13.6 0"/></svg></span>
      <span>로그인</span>
    </a>
  {% else %}
    <a class="tabbar-item" href="{{ current_user.is_admin ? url_for('admin.index') : url_for('boards.index') }}">
      <span class="tabbar-icon" aria-hidden="true"><span class="avatar avatar-xs" data-tone="{{ current_user.display_name|length % 6 }}">{{ current_user.display_name|slice(0, 1)|upper }}</span></span>
      <span>{{ current_user.is_admin ? '관리' : '내 계정' }}</span>
    </a>
  {% endif %}
</nav>
{% endblock %}

<button class="to-top" type="button" hidden aria-label="맨 위로 이동" title="맨 위로"><span aria-hidden="true">↑</span></button>

<script>
(function(){
  var root=document.documentElement;
  function isDark(){return root.dataset.theme==='dark'||(!root.dataset.theme&&window.matchMedia('(prefers-color-scheme: dark)').matches)}
  var toggles=document.querySelectorAll('.theme-toggle');
  function syncTheme(){
    var dark=isDark();
    for(var i=0;i<toggles.length;i++){
      var icon=toggles[i].querySelector('.theme-icon');
      if(icon){icon.textContent=dark?'☀':'☾'}
      toggles[i].setAttribute('aria-label',dark?'라이트 모드로 전환':'다크 모드로 전환');
      toggles[i].title=toggles[i].getAttribute('aria-label');
    }
  }
  for(var i=0;i<toggles.length;i++){
    toggles[i].addEventListener('click',function(){
      var theme=isDark()?'light':'dark';
      root.dataset.theme=theme;
      try{localStorage.setItem('gnucms-theme',theme)}catch(e){}
      syncTheme();
    });
  }
  syncTheme();

  var drawer=document.getElementById('drawer');
  var openers=document.querySelectorAll('.drawer-toggle,[data-drawer-open]');
  var toggleBtn=document.querySelector('.drawer-toggle');
  function openDrawer(){
    if(!drawer){return}
    drawer.hidden=false;document.body.classList.add('is-locked');
    if(toggleBtn){toggleBtn.setAttribute('aria-expanded','true');toggleBtn.setAttribute('aria-label','메뉴 닫기')}
    var first=drawer.querySelector('.drawer-links a');if(first){first.focus()}
  }
  function closeDrawer(){
    if(!drawer||drawer.hidden){return}
    drawer.hidden=true;document.body.classList.remove('is-locked');
    if(toggleBtn){toggleBtn.setAttribute('aria-expanded','false');toggleBtn.setAttribute('aria-label','메뉴 열기');toggleBtn.focus()}
  }
  for(var o=0;o<openers.length;o++){openers[o].addEventListener('click',openDrawer)}
  if(drawer){
    var closers=drawer.querySelectorAll('[data-drawer-close]');
    for(var c=0;c<closers.length;c++){closers[c].addEventListener('click',closeDrawer)}
  }
  document.addEventListener('keydown',function(e){if(e.key==='Escape'){closeDrawer()}});

  var toTop=document.querySelector('.to-top'),ticking=false;
  function updateTop(){toTop.hidden=window.scrollY<560;ticking=false}
  if(toTop){
    window.addEventListener('scroll',function(){if(!ticking){ticking=true;window.requestAnimationFrame(updateTop)}},{passive:true});
    toTop.addEventListener('click',function(){
      window.scrollTo({top:0,behavior:window.matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth'});
    });
    updateTop();
  }

  var lastY=window.scrollY,gnb=document.querySelector('.gnb');
  if(gnb){
    window.addEventListener('scroll',function(){
      var y=window.scrollY;
      if(y>140&&y>lastY){gnb.classList.add('is-tucked')}else{gnb.classList.remove('is-tucked')}
      lastY=y;
    },{passive:true});
  }

  document.addEventListener('keydown',function(e){
    if(e.key!=='/'||e.metaKey||e.ctrlKey||e.altKey){return}
    var tag=(e.target.tagName||'').toLowerCase();
    if(tag==='input'||tag==='textarea'||tag==='select'||e.target.isContentEditable){return}
    var search=document.querySelector('[data-search-input]');
    if(search){e.preventDefault();search.focus();search.select()}
  });
})();
</script>
{% block scripts %}{% endblock %}
</body>
</html>
