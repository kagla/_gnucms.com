<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#f2f4f7">
<title>{% block title %}{{ site.site_name }}{% endblock %}</title>
{% block meta_description %}<meta name="description" content="{{ site.site_tagline }}">{% endblock %}
<script>
try{var t=localStorage.getItem('aboard-theme');if(t){document.documentElement.dataset.theme=t}}catch(e){}
</script>
<link rel="stylesheet" href="{{ theme_asset('theme.css') }}">
</head>
<body class="{% block body_class %}theme-compact{% endblock %}">
<a class="skip-link" href="#main">본문 바로가기</a>
{% block site_header %}
<header class="site-header">
  <div class="header-inner shell">
    <a class="brand" href="{{ url_for('boards.index') }}" aria-label="{{ site.site_name }} 홈">
      <span class="brand-mark" aria-hidden="true">a</span><span class="brand-name">{{ site.site_name }}</span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="메뉴 열기"><span aria-hidden="true"></span></button>
    <nav class="site-nav" id="site-nav" aria-label="주요 메뉴">
      <a class="nav-link" href="{{ url_for('boards.index') }}">게시판</a>
      {% for item in site_menu %}<a class="nav-link" href="{{ url_for('content.show', {slug: item.slug}) }}">{{ item.title }}</a>{% endfor %}
    </nav>
    <div class="header-actions">
      <nav class="account-nav" aria-label="회원 메뉴">
        {% if current_user.is_guest %}
          <a class="nav-link" href="{{ url_for('auth.login') }}">로그인</a>
          {% if registration_available %}<a class="nav-link nav-link-primary" href="{{ url_for('auth.register') }}">회원가입</a>{% endif %}
        {% else %}
          {% if current_user.is_admin %}<a class="nav-link nav-link-primary" href="{{ url_for('admin.index') }}">관리</a>{% endif %}
          <span class="account-name">{{ current_user.display_name }}</span>
          <form class="logout-form" method="post" action="{{ url_for('auth.logout') }}"><input type="hidden" name="csrf_token" value="{{ csrf_token }}"><button class="logout-button" type="submit">로그아웃</button></form>
        {% endif %}
      </nav>
      <button class="theme-toggle" type="button" aria-label="다크 모드로 전환" title="다크 모드로 전환"><span aria-hidden="true">☾</span></button>
    </div>
  </div>
</header>
{% endblock %}
<main class="shell" id="main">{% block public_body %}{% block body %}{% endblock %}{% endblock %}</main>
{% block site_footer %}
<footer class="site-footer">
  <div class="footer-inner shell">
    <span class="footer-brand">{{ site.site_name }}</span>
    <span>{{ site.site_tagline }}</span>
    {% if legal_documents %}
      <nav class="footer-links" aria-label="정책">
        <a href="{{ url_for('terms.show', {type: 'service'}) }}">이용약관</a>
        <a href="{{ url_for('terms.show', {type: 'privacy'}) }}">개인정보 처리방침</a>
      </nav>
    {% endif %}
  </div>
</footer>
{% endblock %}
<script>
(function(){
  var root=document.documentElement;
  var meta=document.querySelector('meta[name="theme-color"]');
  var button=document.querySelector('.theme-toggle');
  function isDark(){return root.dataset.theme==='dark'||(!root.dataset.theme&&window.matchMedia('(prefers-color-scheme: dark)').matches)}
  function sync(){
    if(!button){return}
    var dark=isDark();
    button.firstElementChild.textContent=dark?'☀':'☾';
    button.setAttribute('aria-label',dark?'라이트 모드로 전환':'다크 모드로 전환');
    button.title=button.getAttribute('aria-label');
    if(meta){meta.content=dark?'#0e1116':'#f2f4f7'}
  }
  if(button){
    button.addEventListener('click',function(){
      var theme=isDark()?'light':'dark';
      root.dataset.theme=theme;
      try{localStorage.setItem('aboard-theme',theme)}catch(e){}
      sync();
    });
    sync();
  }
  var header=document.querySelector('.site-header');
  var toggle=document.querySelector('.nav-toggle');
  if(header&&toggle){
    toggle.addEventListener('click',function(){
      var open=header.getAttribute('data-nav')==='open';
      if(open){header.removeAttribute('data-nav')}else{header.setAttribute('data-nav','open')}
      toggle.setAttribute('aria-expanded',open?'false':'true');
      toggle.setAttribute('aria-label',open?'메뉴 열기':'메뉴 닫기');
    });
    document.addEventListener('keydown',function(e){
      if(e.key==='Escape'&&header.getAttribute('data-nav')==='open'){
        header.removeAttribute('data-nav');
        toggle.setAttribute('aria-expanded','false');
        toggle.setAttribute('aria-label','메뉴 열기');
        toggle.focus();
      }
    });
  }
})();
</script>
{% block scripts %}{% endblock %}
</body>
</html>
