{% extends "layout.html.twig" %}
{% block title %}{{ post.title }} · {{ site.site_name }}{% endblock %}
{% block body %}
  <nav class="breadcrumb" aria-label="현재 위치">
    <a href="{{ url_for('boards.index') }}">게시판</a><span class="breadcrumb-separator" aria-hidden="true">/</span>
    <a href="{{ url_for('posts.index', {'key': board.board_key}) }}">{{ board.name }}</a><span class="breadcrumb-separator" aria-hidden="true">/</span><span>게시글</span>
  </nav>

  <article class="surface article-card">
    <header class="article-header">
      {% if post.category %}<p class="eyebrow">{{ post.category }}</p>{% endif %}
      <h1 class="article-title">{{ post.title }}</h1>
      <p class="article-meta">
        <strong>{{ post.author_name }}</strong>
        <span class="sep" aria-hidden="true">|</span>
        <time datetime="{{ post.created_at }}">{{ post.created_at }}</time>
        <span class="sep" aria-hidden="true">|</span>
        <span>조회 {{ post.view_count }}</span>
        <span class="sep" aria-hidden="true">|</span>
        <span>댓글 {{ post.comment_count }}</span>
      </p>
    </header>

    <div class="article-body">{{ post.content|nl2br }}</div>

    {% if post.attachments is not empty %}
      <section class="attachments-section" aria-labelledby="attachments-title">
        <h2 id="attachments-title">첨부파일 {{ post.attachments|length }}</h2>
        <ul class="attachments">
          {% for file in post.attachments %}
            <li>
              <a href="{{ url_for('files.download', {'id': post.id, 'index': file.index}) }}">{{ file.name }}</a>
              <span>{{ file.size }} bytes</span>
            </li>
          {% endfor %}
        </ul>
      </section>
    {% endif %}

    <section class="comments" aria-labelledby="comments-title">
      <h2 id="comments-title">댓글 <span class="comment-count-heading">{{ post.comment_count }}</span></h2>
      {% if comments is empty %}
        <p class="empty">첫 댓글을 기다리고 있습니다.</p>
      {% else %}
        {% include 'posts/_comments.html.twig' with {'nodes': comments, 'nested': false} only %}
      {% endif %}
    </section>

    <div class="article-actions">
      <a class="button button-ghost" href="{{ url_for('posts.index', {'key': board.board_key}) }}">← 목록으로</a>
    </div>
  </article>
{% endblock %}
