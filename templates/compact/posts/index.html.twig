{% extends "layout.html.twig" %}
{% import _self as pager %}
{% macro pageLink(board, query, p, label) %}<a href="{{ url_for('posts.index', {'key': board.board_key}) }}?page={{ p }}{% if query.q %}&amp;q={{ query.q|url_encode }}{% endif %}{% if query.category %}&amp;category={{ query.category|url_encode }}{% endif %}" aria-label="{{ p }} 페이지">{{ label|default(p) }}</a>{% endmacro %}
{% block title %}{{ board.name }} · {{ site.site_name }}{% endblock %}
{% block body %}
  <nav class="breadcrumb" aria-label="현재 위치">
    <a href="{{ url_for('boards.index') }}">게시판</a><span class="breadcrumb-separator" aria-hidden="true">/</span><span>{{ board.name }}</span>
  </nav>

  <header class="page-head board-page-head">
    <div class="page-head-copy">
      <p class="eyebrow">Board · {{ board.board_key }}</p>
      <h1>{{ board.name }}</h1>
      {% if board.description %}<p class="lead">{{ board.description }}</p>{% endif %}
    </div>
    {% if can_write %}<a class="button board-write-button" href="{{ url_for('posts.create', {'key': board.board_key}) }}"><span aria-hidden="true">＋</span>글쓰기</a>{% endif %}
  </header>

  <form class="toolbar board-search" method="get" action="{{ url_for('posts.index', {'key': board.board_key}) }}" role="search">
    {% if board.use_category and board.categories is not empty %}
      <select name="category" aria-label="분류 선택">
        <option value="">전체 분류</option>
        {% for name in board.categories %}<option value="{{ name }}"{% if query.category == name %} selected{% endif %}>{{ name }}</option>{% endfor %}
      </select>
    {% endif %}
    <div class="board-search-field"><span class="board-search-icon" aria-hidden="true"></span><input type="search" name="q" value="{{ query.q }}" placeholder="제목이나 내용 검색" aria-label="게시글 검색"></div>
    <button type="submit">검색</button>
  </form>

  {% if list.data is empty and list.notices is empty %}
    <div class="surface list-empty">
      <p>{% if query.q or query.category %}조건에 맞는 글이 없습니다.{% else %}아직 등록된 글이 없습니다.{% endif %}</p>
      {% if query.q or query.category %}<a class="button button-ghost" href="{{ url_for('posts.index', {'key': board.board_key}) }}">전체 글 보기</a>
      {% elseif can_write %}<a class="button" href="{{ url_for('posts.create', {'key': board.board_key}) }}">첫 글 쓰기</a>{% endif %}
    </div>
  {% else %}
    <div class="post-table-wrap">
      <table class="post-table">
        <caption class="visually-hidden">{{ board.name }} 게시글 목록</caption>
        <thead>
          <tr>
            {% if board.use_category %}<th scope="col" class="cell-cat">분류</th>{% endif %}
            <th scope="col" class="cell-title">제목</th>
            <th scope="col" class="cell-author">글쓴이</th>
            <th scope="col" class="cell-date">날짜</th>
            <th scope="col" class="cell-views">조회</th>
          </tr>
        </thead>
        <tbody>
        {% for post in list.notices|merge(list.data) %}
          <tr{% if post.is_notice %} class="is-notice"{% endif %}>
            {% if board.use_category %}
              <td class="cell-cat">{% if post.is_notice %}<span class="tag">공지</span>{% elseif post.category %}<span class="chip">{{ post.category }}</span>{% else %}<span class="dash">—</span>{% endif %}</td>
            {% endif %}
            <td class="cell-title">
              {% if post.is_notice and not board.use_category %}<span class="tag">공지</span> {% endif %}
              <a class="post-title-link" href="{{ url_for('posts.show', {'id': post.id}) }}">{{ post.title }}</a>
              {% if post.comment_count > 0 %}<span class="comment-count">[{{ post.comment_count }}]</span>{% endif %}
              {% if post.is_secret %}<span class="post-markers" title="비밀글" aria-label="비밀글">●</span>{% endif %}
              {% if post.file_count > 0 %}<span class="post-markers" title="첨부파일 있음" aria-label="첨부파일 있음">＋</span>{% endif %}
            </td>
            <td class="cell-author">{{ post.author_name }}</td>
            <td class="cell-date"><time datetime="{{ post.created_at }}">{{ post.created_at|slice(0, 10) }}</time></td>
            <td class="cell-views">{{ post.view_count }}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}

  {% if list.total_pages > 1 %}
    {% set window = 5 %}{% set start = max(1, list.page - window) %}{% set end = min(list.total_pages, list.page + window) %}
    <nav class="pagination" aria-label="페이지 이동">
      {% if start > 1 %}{{ pager.pageLink(board, query, 1) }}{% if start > 2 %}<span class="muted">…</span>{% endif %}{% endif %}
      {% for p in start..end %}{% if p == list.page %}<strong aria-current="page">{{ p }}</strong>{% else %}{{ pager.pageLink(board, query, p) }}{% endif %}{% endfor %}
      {% if end < list.total_pages %}{% if end < list.total_pages - 1 %}<span class="muted">…</span>{% endif %}{{ pager.pageLink(board, query, list.total_pages) }}{% endif %}
    </nav>
  {% endif %}
{% endblock %}
