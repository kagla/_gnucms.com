<ul class="comment-list{% if nested|default(false) %} comment-children{% endif %}">
{% for comment in nodes %}
  <li class="comment-item">
    <p class="comment-head">
      {% if comment.deleted %}<span class="comment-author muted">삭제된 댓글</span>{% else %}<span class="comment-author">{{ comment.author_name }}</span>{% endif %}
      <time datetime="{{ comment.created_at }}">{{ comment.created_at }}</time>
      {% if comment.is_secret %}<span class="post-markers" title="비밀 댓글" aria-label="비밀 댓글">●</span>{% endif %}
    </p>
    <p class="comment-body">{{ comment.content|nl2br }}</p>
    {% if comment.children is not empty %}{% include 'posts/_comments.html.twig' with {'nodes': comment.children, 'nested': true} only %}{% endif %}
  </li>
{% endfor %}
</ul>
