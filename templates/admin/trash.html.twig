{% extends "admin/layout.html.twig" %}
{% block title %}내용 휴지통 · {{ site.site_name }}{% endblock %}
{% block admin_section %}content{% endblock %}
{% block body %}<div class="page-head"><div class="page-head-copy"><nav class="breadcrumb"><a href="{{ url_for('admin.index') }}">사이트 관리</a><span class="breadcrumb-separator">/</span><a href="{{ url_for('admin.content') }}">내용</a><span class="breadcrumb-separator">/</span><span>휴지통</span></nav><h1>내용 휴지통</h1><p class="lead">삭제한 내용은 공개되지 않으며 언제든 복원할 수 있습니다.</p></div><a class="button button-secondary" href="{{ url_for('admin.content') }}">내용 관리로 돌아가기</a></div>
{% if query.restored|default('') == '1' %}<p class="notice success">내용을 초안 상태로 복원했습니다.</p>{% endif %}{% if query.deleted|default('') == '1' %}<p class="notice success">내용과 연결된 이미지를 완전히 삭제했습니다.</p>{% endif %}
<section class="surface admin-panel"><div class="table-wrap"><table><thead><tr><th>제목</th><th>주소</th><th>삭제일</th><th>관리</th></tr></thead><tbody>{% for page in pages %}<tr><td><strong>{{ page.title }}</strong></td><td class="meta-cell">/content/{{ page.slug }}</td><td class="meta-cell">{{ page.deleted_at|date('Y.m.d H:i') }}</td><td><div class="table-actions"><form method="post" action="{{ url_for('admin.content.restore', {id: page.id}) }}"><input type="hidden" name="csrf_token" value="{{ csrf_token }}"><button class="small-button" type="submit">복원</button></form><form method="post" action="{{ url_for('admin.content.permanent_delete', {id: page.id}) }}" onsubmit="return confirm('내용과 연결된 이미지를 모두 완전히 삭제할까요? 이 작업은 되돌릴 수 없습니다.')"><input type="hidden" name="csrf_token" value="{{ csrf_token }}"><button class="small-button danger-button" type="submit">완전 삭제</button></form></div></td></tr>{% else %}<tr><td colspan="4" class="empty-row">휴지통이 비어 있습니다.</td></tr>{% endfor %}</tbody></table></div></section>{% endblock %}
