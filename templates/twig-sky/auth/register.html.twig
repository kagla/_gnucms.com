{% extends "layout.html.twig" %}
{% import '_icons.html.twig' as ico %}
{% block title %}회원가입 · {{ site.site_name }}{% endblock %}
{% block body %}
<div class="auth-wrap">
  <section class="card auth-card">
    <div class="card-body">
      <div class="auth-head">
        <span class="auth-mark" aria-hidden="true">{{ ico.i('sparkle', 22) }}</span>
        <h1 class="card-title">{{ site.site_name }} 시작하기</h1>
        <p class="card-sub">1분이면 가입할 수 있어요.</p>
      </div>
      <form method="post" action="{{ url_for('auth.register') }}">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <fieldset class="fieldset{% if errors.email is defined %} is-invalid{% endif %}">
          <legend class="fieldset-legend">이메일</legend>
          <label class="input input-bordered input-block">
            <span class="input-icon" aria-hidden="true">{{ ico.i('mail', 16) }}</span>
            <input type="email" name="email" value="{{ values.email|default('') }}" maxlength="191" autocomplete="email" placeholder="you@example.com" required>
          </label>
          {% if errors.email is defined %}<p class="validator-hint">{{ ico.i('warning', 14) }} {{ errors.email }}</p>{% endif %}
        </fieldset>
        <fieldset class="fieldset{% if errors.password is defined %} is-invalid{% endif %}">
          <legend class="fieldset-legend">비밀번호 <span class="legend-hint">8자 이상</span></legend>
          <label class="input input-bordered input-block">
            <span class="input-icon" aria-hidden="true">{{ ico.i('lock', 16) }}</span>
            <input type="password" name="password" minlength="8" autocomplete="new-password" required>
          </label>
          {% if errors.password is defined %}<p class="validator-hint">{{ ico.i('warning', 14) }} {{ errors.password }}</p>{% endif %}
        </fieldset>
        <fieldset class="fieldset{% if errors.password_confirmation is defined %} is-invalid{% endif %}">
          <legend class="fieldset-legend">비밀번호 확인</legend>
          <label class="input input-bordered input-block">
            <span class="input-icon" aria-hidden="true">{{ ico.i('lock', 16) }}</span>
            <input type="password" name="password_confirmation" minlength="8" autocomplete="new-password" required>
          </label>
          {% if errors.password_confirmation is defined %}<p class="validator-hint">{{ ico.i('warning', 14) }} {{ errors.password_confirmation }}</p>{% endif %}
        </fieldset>
        {% include "auth/_consents.html.twig" %}
        <button class="btn btn-primary btn-block btn-lg" type="submit">가입하기</button>
      </form>
      {% include "auth/_social.html.twig" %}
      <p class="auth-switch">이미 계정이 있으신가요? <a class="link" href="{{ url_for('auth.login') }}">로그인</a></p>
    </div>
  </section>
</div>
{% endblock %}
