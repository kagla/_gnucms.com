{% extends "layout.html.twig" %}
{% import '_icons.html.twig' as ico %}
{% block title %}{{ title }} · {{ site.site_name }}{% endblock %}
{% block body %}
<section class="card status-card">
  <div class="card-body">
    <span class="status-icon status-icon-error" aria-hidden="true">{{ ico.i('warning', 28) }}</span>
    <h1 class="card-title">{{ title }}</h1>
    <p>{{ message }}</p>
    {% if details is not empty %}
      <ul class="list status-list">
        {% for field, detail in details %}
          <li class="list-row"><strong>{{ field }}</strong><span>{{ detail }}</span></li>
        {% endfor %}
      </ul>
    {% endif %}
    <div class="card-actions">
      <a class="btn btn-primary btn-lg" href="{{ url_for('boards.index') }}">{{ ico.i('home', 16) }} 홈으로 가기</a>
    </div>
  </div>
</section>
{% endblock %}
