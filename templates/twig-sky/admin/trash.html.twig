{% extends "admin/layout.html.twig" %}
{% import '_icons.html.twig' as ico %}
{% block title %}내용 휴지통 · {{ site.site_name }}{% endblock %}
{% block admin_section %}content{% endblock %}
{% block body %}
<div class="breadcrumbs"><ul><li><a href="{{ url_for('admin.index') }}">사이트 관리</a></li><li><a href="{{ url_for('admin.content') }}">내용</a></li><li aria-current="page">휴지통</li></ul></div>
<div class="page-head">
  <div><h1>내용 휴지통</h1><p class="page-sub">삭제한 내용은 공개되지 않으며 언제든 복원할 수 있습니다.</p></div>
  <div class="page-head-actions"><a class="btn btn-outline" href="{{ url_for('admin.content') }}">{{ ico.i('arrow-left', 15) }} 내용 관리로</a></div>
</div>
{% if query.restored|default('') == '1' %}<div class="alert alert-success"><span aria-hidden="true">{{ ico.i('check-circle', 18) }}</span><span>내용을 초안 상태로 복원했습니다.</span></div>{% endif %}
{% if query.deleted|default('') == '1' %}<div class="alert alert-success"><span aria-hidden="true">{{ ico.i('check-circle', 18) }}</span><span>내용과 연결된 이미지를 완전히 삭제했습니다.</span></div>{% endif %}
<section class="card">
  <div class="table-wrap">
    <table class="table table-zebra">
      <thead><tr><th>제목</th><th>주소</th><th>삭제일</th><th class="right">관리</th></tr></thead>
      <tbody>
      {% for page in pages %}
        <tr>
          <td data-label="제목"><span class="cell-title">{{ page.title }}</span></td>
          <td data-label="주소"><code class="kbd kbd-sm">/content/{{ page.slug }}</code></td>
          <td data-label="삭제일">{{ page.deleted_at|date('Y.m.d H:i') }}</td>
          <td data-label="관리" class="right">
            <div class="row-actions">
              <form method="post" action="{{ url_for('admin.content.restore', {id: page.id}) }}">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                <button class="btn btn-outline btn-sm" type="submit">{{ ico.i('restore', 14) }} 복원</button>
              </form>
              <form method="post" action="{{ url_for('admin.content.permanent_delete', {id: page.id}) }}" onsubmit="return confirm('내용과 연결된 이미지를 모두 완전히 삭제할까요? 이 작업은 되돌릴 수 없습니다.')">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                <button class="btn btn-error btn-outline btn-sm" type="submit">{{ ico.i('trash', 14) }} 완전 삭제</button>
              </form>
            </div>
          </td>
        </tr>
      {% else %}
        <tr class="table-empty"><td colspan="4">휴지통이 비어 있습니다.</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endblock %}
