{% extends "admin/layout.html.twig" %}
{% import '_icons.html.twig' as ico %}
{% block title %}관리자 비밀번호 변경 · {{ site.site_name }}{% endblock %}
{% block admin_section %}security{% endblock %}
{% block body %}
<div class="breadcrumbs"><ul><li><a href="{{ url_for('admin.index') }}">사이트 관리</a></li><li aria-current="page">계정 보안</li></ul></div>
<section class="card card-narrow">
  <div class="card-body">
    <h1 class="card-title">{{ ico.i('shield', 19) }} 비밀번호 변경</h1>
    <p class="card-sub">새 비밀번호를 저장하면 모든 기기에서 다시 로그인해야 합니다.</p>
    <form method="post" action="{{ url_for('admin.password') }}">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <fieldset class="fieldset{% if errors.current_password is defined %} is-invalid{% endif %}">
        <legend class="fieldset-legend">현재 비밀번호</legend>
        <input class="input input-bordered input-block" type="password" name="current_password" autocomplete="current-password" required>
        {% if errors.current_password is defined %}<p class="validator-hint">{{ ico.i('warning', 14) }} {{ errors.current_password }}</p>{% endif %}
      </fieldset>
      <fieldset class="fieldset{% if errors.password is defined %} is-invalid{% endif %}">
        <legend class="fieldset-legend">새 비밀번호 <span class="legend-hint">8자 이상</span></legend>
        <input class="input input-bordered input-block" type="password" name="password" minlength="8" autocomplete="new-password" required>
        {% if errors.password is defined %}<p class="validator-hint">{{ ico.i('warning', 14) }} {{ errors.password }}</p>{% endif %}
      </fieldset>
      <fieldset class="fieldset{% if errors.password_confirmation is defined %} is-invalid{% endif %}">
        <legend class="fieldset-legend">새 비밀번호 확인</legend>
        <input class="input input-bordered input-block" type="password" name="password_confirmation" minlength="8" autocomplete="new-password" required>
        {% if errors.password_confirmation is defined %}<p class="validator-hint">{{ ico.i('warning', 14) }} {{ errors.password_confirmation }}</p>{% endif %}
      </fieldset>
      <div class="card-actions form-actions">
        <a class="btn btn-ghost" href="{{ url_for('admin.index') }}">취소</a>
        <button class="btn btn-primary" type="submit">비밀번호 변경</button>
      </div>
    </form>
  </div>
</section>
{% endblock %}
