{% extends 'layout.html.twig' %}
{% import '_icons.html.twig' as ico %}

{% block title %}알림{% endblock %}

{% block body %}
<div class="page-head">
  <div>
    <h1>알림</h1>
    <p class="page-sub">내 글에 달린 댓글과 내 댓글에 달린 답글을 모아 보여 줍니다.</p>
  </div>
  {% if unread_notifications > 0 %}
    <form method="post" action="{{ url_for('notifications.read_all') }}">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <button class="btn btn-outline btn-sm" type="submit">모두 읽음으로</button>
    </form>
  {% endif %}
</div>

{% if notifications.items is empty %}
  <div class="card empty-card">
    <div class="card-body">
      <h2 class="card-title">{{ ico.i('bell-off', 22) }} 아직 알림이 없습니다</h2>
      <p>글을 쓰고 댓글이 달리면 이곳에 쌓입니다.</p>
    </div>
  </div>
{% else %}
  <ul class="list card notice-list">
    {% for item in notifications.items %}
      <li class="list-row notice-row{% if not item.is_read %} is-unread{% endif %}">
        <a class="notice-link" href="{{ url_for('notifications.open', {'id': item.id}) }}">
          <span class="notice-ico" aria-hidden="true">{{ ico.i('comment', 18) }}</span>
          <span class="notice-body">
            <span class="notice-text">
              <strong>{{ item.actor_name }}</strong>님이
              {% if item.kind == 'reply' %}내 댓글에 답글을 달았습니다.{% else %}내 글에 댓글을 달았습니다.{% endif %}
            </span>
            <span class="notice-subject">{{ item.subject }}</span>
          </span>
          <time class="notice-time" datetime="{{ item.created_at }}">{{ item.created_at|date('Y.m.d H:i') }}</time>
        </a>
      </li>
    {% endfor %}
  </ul>

  {% if notifications.total_pages > 1 %}
    <nav class="pager" aria-label="알림 페이지 이동">
      <div class="join">
        {% for p in 1..notifications.total_pages %}
          {% if p == notifications.page %}
            <span class="join-item btn btn-sm btn-active" aria-current="page">{{ p }}</span>
          {% else %}
            <a class="join-item btn btn-sm" href="{{ url_for('notifications.index') }}?page={{ p }}" aria-label="{{ p }} 페이지">{{ p }}</a>
          {% endif %}
        {% endfor %}
      </div>
    </nav>
  {% endif %}
{% endif %}
{% endblock %}
