{% extends "admin/layout.html.twig" %}
{% import '_icons.html.twig' as ico %}
{% block title %}회원 수정 · {{ site.site_name }}{% endblock %}
{% block admin_section %}members{% endblock %}
{% block body %}
<div class="breadcrumbs"><ul><li><a href="{{ url_for('admin.index') }}">사이트 관리</a></li><li><a href="{{ url_for('admin.members') }}">회원</a></li><li aria-current="page">{{ values.email }}</li></ul></div>
<section class="card">
  <div class="card-body">
    <h1 class="card-title">회원 수정</h1>
    <p class="card-sub">로그인 이메일과 화면에 표시할 이름, 이용 상태를 관리합니다.</p>
    <form method="post" action="{{ url_for('admin.members.edit', {id: values.id}) }}">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <fieldset class="fieldset{% if errors.email is defined %} is-invalid{% endif %}">
        <legend class="fieldset-legend">이메일</legend>
        <input class="input input-bordered input-block" type="email" name="email" value="{{ values.email|default('') }}" maxlength="191" autocomplete="off" required>
        {% if errors.email is defined %}<p class="validator-hint">{{ ico.i('warning', 14) }} {{ errors.email }}</p>{% endif %}
      </fieldset>
      <fieldset class="fieldset{% if errors.display_name is defined %} is-invalid{% endif %}">
        <legend class="fieldset-legend">표시 이름</legend>
        <input class="input input-bordered input-block" type="text" name="display_name" value="{{ values.display_name|default('') }}" maxlength="100" required>
        {% if errors.display_name is defined %}<p class="validator-hint">{{ ico.i('warning', 14) }} {{ errors.display_name }}</p>{% endif %}
      </fieldset>
      <fieldset class="fieldset{% if errors.status is defined %} is-invalid{% endif %}">
        <legend class="fieldset-legend">이용 상태</legend>
        <select class="select select-bordered select-block" name="status">
          <option value="active"{{ values.status|default('active') == 'active' ? ' selected' : '' }}>활성</option>
          <option value="blocked"{{ values.status|default('active') == 'blocked' ? ' selected' : '' }}>차단</option>
        </select>
        {% if errors.status is defined %}<p class="validator-hint">{{ ico.i('warning', 14) }} {{ errors.status }}</p>{% endif %}
      </fieldset>
      <ul class="list fact-list">
        <li class="list-row"><span>권한</span><strong>{{ values.is_admin ? '소유자' : '일반 회원' }}</strong></li>
        <li class="list-row"><span>이메일 인증</span><strong>{{ values.email_verified ? '완료' : '대기' }}</strong></li>
        <li class="list-row"><span>가입일</span><strong>{{ values.created_at|date('Y.m.d H:i') }}</strong></li>
      </ul>
      <div class="card-actions form-actions">
        <a class="btn btn-ghost" href="{{ url_for('admin.members') }}">취소</a>
        <button class="btn btn-primary" type="submit">변경사항 저장</button>
      </div>
    </form>
  </div>
</section>
{% include "admin/_member_consents.html.twig" %}
{% endblock %}
