{% extends "@default/layout.html.twig" %}
{% block body_class %}theme-modern{% endblock %}
{% block site_header %}
<header class="site-header modern-header">
  <div class="header-inner">
    <a class="modern-brand" href="{{ url_for('boards.index') }}" aria-label="{{ site.site_name }} 홈">
      <span class="modern-brand-mark" aria-hidden="true">{{ site.site_name|first }}<span></span></span>
      <span class="modern-brand-copy"><strong>{{ site.site_name }}</strong><small>open community</small></span>
    </a>
    <nav class="modern-nav" aria-label="주요 메뉴">
      <a href="{{ url_for('boards.index') }}">커뮤니티</a>
      {% for item in site_menu %}<a href="{{ url_for('content.show', {slug: item.slug}) }}">{{ item.title }}</a>{% endfor %}
    </nav>
    <div class="modern-account">
      {% if current_user.is_guest %}
        <a class="modern-login" href="{{ url_for('auth.login') }}">로그인</a>
        {% if registration_available %}<a class="modern-join" href="{{ url_for('auth.register') }}">가입하기 <span aria-hidden="true">↗</span></a>{% endif %}
      {% else %}
        <span class="modern-user">{{ current_user.display_name }}</span>
        {% if current_user.is_admin %}<a class="modern-manage" href="{{ url_for('admin.index') }}">관리</a>{% endif %}
        <form class="logout-form" method="post" action="{{ url_for('auth.logout') }}"><input type="hidden" name="csrf_token" value="{{ csrf_token }}"><button class="logout-button" type="submit">로그아웃</button></form>
      {% endif %}
      <button class="theme-toggle" type="button" aria-label="다크 모드로 전환" title="다크 모드로 전환"><span aria-hidden="true">☾</span></button>
    </div>
  </div>
</header>
{% endblock %}
{% block site_footer %}
<footer class="site-footer modern-footer">
  <div><strong>{{ site.site_name }}</strong><p>{{ site.site_tagline }}</p></div>
  <p class="modern-footer-note">작은 이야기들이 오래 이어지는 곳.</p>
  {% if legal_documents %}<nav aria-label="정책"><a href="{{ url_for('content.show', {slug: 'terms'}) }}">이용약관</a><a href="{{ url_for('content.show', {slug: 'privacy'}) }}">개인정보 처리방침</a></nav>{% endif %}
</footer>
{% endblock %}
