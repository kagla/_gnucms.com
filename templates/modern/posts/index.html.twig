{% extends "layout.html.twig" %}
{% import _self as pager %}
{% macro pageLink(board, query, p, label) %}<a href="{{ url_for('posts.index', {'key': board.board_key}) }}?page={{ p }}{% if query.q %}&amp;q={{ query.q|url_encode }}{% endif %}{% if query.category %}&amp;category={{ query.category|url_encode }}{% endif %}" aria-label="{{ p }} 페이지">{{ label|default(p) }}</a>{% endmacro %}
{% block title %}{{ board.name }} · {{ site.site_name }}{% endblock %}
{% block body %}
<nav class="modern-crumb" aria-label="현재 위치"><a href="{{ url_for('boards.index') }}">Community</a><span>→</span><strong>{{ board.name }}</strong></nav>
<header class="modern-board-head">
  <div><p>BOARD / {{ board.board_key|upper }}</p><h1>{{ board.name }}</h1>{% if board.description %}<span>{{ board.description }}</span>{% endif %}</div>
  {% if can_write %}<a class="modern-write" href="{{ url_for('posts.create', {'key': board.board_key}) }}"><span aria-hidden="true">＋</span> 새 글</a>{% endif %}
</header>
<div class="modern-board-tools">
  <form class="board-search" method="get" action="{{ url_for('posts.index', {'key': board.board_key}) }}" role="search">
    {% if board.use_category and board.categories is not empty %}<select name="category" aria-label="분류 선택"><option value="">전체 분류</option>{% for name in board.categories %}<option value="{{ name }}"{% if query.category == name %} selected{% endif %}>{{ name }}</option>{% endfor %}</select>{% endif %}
    <div class="board-search-field"><span class="board-search-icon" aria-hidden="true"></span><input type="search" name="q" value="{{ query.q }}" placeholder="이 게시판에서 검색" aria-label="게시글 검색"></div>
    <button type="submit">검색</button>
  </form>
</div>
<section class="modern-post-list" aria-label="게시글 목록">
  {% if list.data is empty and list.notices is empty %}<div class="modern-empty"><span aria-hidden="true">＋</span><p>조건에 맞는 글이 없습니다.</p></div>{% else %}
    <div class="modern-post-labels"><span>이야기</span><span>글쓴이</span><span>날짜</span><span>조회</span></div>
    {% for post in list.notices|merge(list.data) %}
    <article class="modern-post-row">
      <a class="modern-post-title" href="{{ url_for('posts.show', {'id': post.id}) }}">
        <span>{% if post.is_notice %}<b>공지</b>{% elseif board.use_category and post.category %}<b class="category">{{ post.category }}</b>{% endif %}{% if post.is_secret %}<i aria-label="비밀글">●</i>{% endif %}{{ post.title }}{% if post.comment_count > 0 %}<em>{{ post.comment_count }}</em>{% endif %}</span>
      </a>
      <span class="modern-post-author">{{ post.author_name }}</span><time datetime="{{ post.created_at }}">{{ post.created_at|slice(0, 10) }}</time><span>{{ post.view_count }}</span>
    </article>
    {% endfor %}
  {% endif %}
</section>
{% if list.total_pages > 1 %}{% set window = 5 %}{% set start = max(1, list.page - window) %}{% set end = min(list.total_pages, list.page + window) %}<nav class="pagination" aria-label="페이지 이동">{% if start > 1 %}{{ pager.pageLink(board, query, 1) }}{% if start > 2 %}<span class="muted">…</span>{% endif %}{% endif %}{% for p in start..end %}{% if p == list.page %}<strong aria-current="page">{{ p }}</strong>{% else %}{{ pager.pageLink(board, query, p) }}{% endif %}{% endfor %}{% if end < list.total_pages %}{% if end < list.total_pages - 1 %}<span class="muted">…</span>{% endif %}{{ pager.pageLink(board, query, list.total_pages) }}{% endif %}</nav>{% endif %}
{% endblock %}
