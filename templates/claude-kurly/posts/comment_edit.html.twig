{% extends "layout.html.twig" %}
{% import '_icons.html.twig' as ico %}
{% block title %}댓글 수정 · {{ board.name }} · {{ site.site_name }}{% endblock %}
{% block nav_section %}board{% endblock %}
{% block extra_tabs %}<a class="head-nav-link is-current" href="{{ url_for('posts.index', {'key': board.board_key}) }}" aria-current="page">{{ board.name }}</a>{% endblock %}
{% block body %}
<div class="breadcrumbs">
  <ul>
    <li><a href="{{ url_for('boards.index') }}">홈</a></li>
    <li><a href="{{ url_for('posts.index', {'key': board.board_key}) }}">{{ board.name }}</a></li>
    <li><a href="{{ url_for('posts.show', {'id': post.id}) }}">{{ post.title }}</a></li>
    <li aria-current="page">댓글 수정</li>
  </ul>
</div>

<section class="card">
  <div class="card-body">
    <h1 class="card-title">{{ ico.i('pencil', 19) }} 댓글 수정</h1>
    <p class="card-sub">{{ post.title }}에 남긴 댓글을 고칩니다.</p>

    <form method="post" action="{{ url_for('comments.edit', {'id': comment.id}) }}">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <input type="hidden" name="image_key" value="{{ values.image_key|default('') }}">
      <input type="hidden" name="uploaded_images" value="" data-uploaded-images>

      {% if needs_password %}
        <fieldset class="fieldset{% if errors.password is defined %} is-invalid{% endif %}">
          <legend class="fieldset-legend">비밀번호 <span class="legend-hint">댓글을 쓸 때 정한 비밀번호</span></legend>
          <input class="input input-bordered input-block" type="password" name="password" required autofocus>
          {% if errors.password is defined %}<p class="validator-hint">{{ ico.i('warning', 14) }} {{ errors.password }}</p>{% endif %}
        </fieldset>
      {% endif %}

      <fieldset class="fieldset{% if errors.content is defined %} is-invalid{% endif %}">
        <legend class="fieldset-legend sr-only">댓글 내용</legend>
        <textarea class="textarea textarea-bordered textarea-block" id="comment-edit-content" name="content" rows="5" data-required="1">{{ values.content|default(comment.content) }}</textarea>
        {% if errors.content is defined %}<p class="validator-hint">{{ ico.i('warning', 14) }} {{ errors.content }}</p>{% endif %}
      </fieldset>

      {% if board.use_secret %}
        <label class="label toggle-row">
          <input class="toggle toggle-primary" type="checkbox" name="is_secret" value="1"{% if comment.is_secret %} checked{% endif %}>
          <span><strong>{{ ico.i('lock', 14) }} 비밀 댓글</strong></span>
        </label>
      {% endif %}

      <div class="form-actions">
        <a class="btn btn-ghost" href="{{ url_for('posts.show', {'id': post.id}) }}#comment-{{ comment.id }}">취소</a>
        <button class="btn btn-primary" type="submit">{{ ico.i('check', 16) }} 저장</button>
        {# 같은 폼을 삭제 주소로 보낸다. 비밀번호 칸도 그대로 함께 간다. #}
        <button class="btn btn-error btn-outline btn-delete" type="submit"
                formaction="{{ url_for('comments.delete', {'id': comment.id}) }}" formnovalidate
                onclick="return confirm('이 댓글을 삭제할까요? 되돌릴 수 없습니다.')">{{ ico.i('trash', 15) }} 삭제</button>
      </div>
    </form>
  </div>

</section>

{% endblock %}
{% block scripts %}
{% include 'posts/_editor.html.twig' with {
  'editor_id': 'comment-edit-content',
  'upload_url': url_for('comment.editor.images', {'id': post.id}) ~ '?csrf_token=' ~ (csrf_token|url_encode) ~ '&image_key=' ~ (values.image_key|default('')|url_encode),
  'discard_url': url_for('comment.editor.images.discard', {'id': post.id}) ~ '?csrf_token=' ~ (csrf_token|url_encode) ~ '&image_key=' ~ (values.image_key|default('')|url_encode),
  'editor_mini': true
} only %}
{% endblock %}
