{% extends "layout.html.twig" %}
{% import '_icons.html.twig' as ico %}
{% import _self as h %}

{% macro listUrl(board, q, category, page, view) %}
{%- set params = [] -%}
{%- if q %}{% set params = params|merge(['q=' ~ q|url_encode]) %}{% endif -%}
{%- if category %}{% set params = params|merge(['category=' ~ category|url_encode]) %}{% endif -%}
{%- if view %}{% set params = params|merge(['view=' ~ view]) %}{% endif -%}
{%- if page and page > 1 %}{% set params = params|merge(['page=' ~ page]) %}{% endif -%}
{{- url_for('posts.index', {'key': board.board_key}) }}{% if params is not empty %}?{{ params|join('&amp;')|raw }}{% endif %}
{%- endmacro %}

{% block title %}{{ board.name }} · {{ site.site_name }}{% endblock %}
{% block nav_section %}board{% endblock %}
{% block extra_tabs %}<a class="head-nav-link is-current" href="{{ url_for('posts.index', {'key': board.board_key}) }}" aria-current="page">{{ board.name }}</a>{% endblock %}

{% block header_search %}
<form class="header-search" method="get" action="{{ url_for('posts.index', {'key': board.board_key}) }}" role="search">
  {% if query.category is not empty %}<input type="hidden" name="category" value="{{ query.category }}">{% endif %}
  <label class="input">
    <input type="search" name="q" value="{{ query.q }}" placeholder="{{ board.name }}에서 검색" aria-label="게시글 검색" data-search-input>
    <button class="header-search-go" type="submit" aria-label="검색">{{ ico.i('search', 19) }}</button>
  </label>
</form>
{% endblock %}

{% block subnav %}
<div class="subnav">
  <div class="wrap subnav-inner">
    <div class="chip-bar" role="group" aria-label="분류 선택">
      {% if board.use_category and board.categories is not empty %}
        <a class="btn btn-sm chip{% if query.category is empty %} btn-active{% endif %}" href="{{ h.listUrl(board, query.q, null, 1)|trim }}">전체</a>
        {% for name in board.categories %}
          <a class="btn btn-sm chip{% if query.category == name %} btn-active{% endif %}" href="{{ h.listUrl(board, query.q, name, 1)|trim }}">{{ name }}</a>
        {% endfor %}
      {% else %}
        <span class="btn btn-sm chip btn-active">전체</span>
      {% endif %}
    </div>
    <span class="badge badge-ghost">{{ list.total }}개</span>
  </div>
</div>
{% endblock %}

{% block body %}
{% set filtered = query.q is not empty or query.category is not empty %}
{# 목록 형태는 게시판 설정이 기본, ?view= 로 잠시 바꾼다.
   view 값은 컨트롤러가 허용 목록으로 검증한 뒤 내려준다. #}
{% set view = view|default('list') %}
{% set view_param = view != board.list_type|default('list') ? view : null %}

<div class="breadcrumbs">
  <ul>
    <li><a href="{{ url_for('boards.index') }}">홈</a></li>
    <li aria-current="page">{{ board.name }}</li>
  </ul>
</div>

<div class="page-head">
  <div>
    <h1>{{ board.name }}</h1>
    {% if board.description %}<p class="page-sub">{{ board.description }}</p>{% endif %}
    <p class="page-count">글 <strong>{{ list.total }}</strong>개{% if list.notices is not empty %} · 공지 {{ list.notices|length }}개{% endif %}</p>
  </div>
  <div class="page-head-actions">
    {# 검색과 단추를 한 줄에 둔다. 넓은 화면에서는 머리글에 검색이 있으므로 여기서는 감춘다. #}
    <form class="inline-search show-sm" method="get" action="{{ url_for('posts.index', {'key': board.board_key}) }}" role="search">
      {% if query.category is not empty %}<input type="hidden" name="category" value="{{ query.category }}">{% endif %}
      {% if view_param %}<input type="hidden" name="view" value="{{ view_param }}">{% endif %}
      <label class="input">
        <input type="search" name="q" value="{{ query.q }}" placeholder="{{ board.name }}에서 검색" aria-label="게시글 검색">
      </label>
      <button class="btn btn-primary" type="submit">검색</button>
    </form>
    {% if not current_user.is_guest and current_user.is_admin %}
      {# 톱니만. 무슨 단추인지는 도움말과 화면 낭독기에 남긴다. #}
      <a class="btn btn-outline btn-sm btn-square" href="{{ url_for('admin.boards.edit', {key: board.board_key}) }}"
         title="게시판 설정" aria-label="게시판 설정">{{ ico.i('cog', 15) }}</a>
    {% endif %}
    {% if can_write %}
      <a class="btn btn-primary hide-sm" href="{{ url_for('posts.create', {'key': board.board_key}) }}">{{ ico.i('pencil', 15) }} 글쓰기</a>
    {% endif %}
  </div>
</div>

{% if filtered %}
  <div class="filter-note">
    {% if query.category is not empty %}<span class="badge badge-primary badge-soft">{{ query.category }}</span>{% endif %}
    {% if query.q is not empty %}<span class="badge badge-soft">“{{ query.q }}”</span>{% endif %}
    <span>검색 결과 {{ list.total }}개</span>
    <a class="link link-hover" href="{{ url_for('posts.index', {'key': board.board_key}) }}">필터 지우기</a>
  </div>
{% endif %}

{% if list.notices is not empty %}
  <ul class="list card notice-list" aria-label="공지">
    {% for post in list.notices %}
      <li class="list-row">
        <span class="notice-ico" aria-hidden="true">{{ ico.i('megaphone', 16) }}</span>
        <span class="badge badge-primary badge-soft badge-sm">공지</span>
        <a class="notice-title" href="{{ url_for('posts.show', {'id': post.id}) }}">{{ post.title }}</a>
        <time class="notice-date" datetime="{{ post.created_at }}">{{ post.created_at|date('m.d') }}</time>
      </li>
    {% endfor %}
  </ul>
{% endif %}

{% if view_types is defined and view_types|length > 1 %}
  {% set view_labels = {'list': '목록', 'gallery': '갤러리', 'magazine': '매거진', 'news': '뉴스형'} %}
  {% set view_icons = {'list': 'board', 'gallery': 'grid', 'magazine': 'document', 'news': 'megaphone'} %}
  <nav class="view-switch" aria-label="목록 형태 선택">
    {% for name in view_types %}
      {% if name == view %}
        <span class="btn btn-sm btn-active" aria-current="true">{{ ico.i(view_icons[name], 14) }} {{ view_labels[name]|default(name) }}</span>
      {% else %}
        <a class="btn btn-sm" href="{{ h.listUrl(board, query.q, query.category, 1, name)|trim }}">{{ ico.i(view_icons[name], 14) }} {{ view_labels[name]|default(name) }}</a>
      {% endif %}
    {% endfor %}
  </nav>
{% endif %}

{% if list.data is empty and list.notices is empty %}
  <div class="card empty-card">
    <div class="card-body">
      <span class="empty-icon" aria-hidden="true">{{ ico.i(filtered ? 'search' : 'document', 26) }}</span>
      <h2 class="card-title">{% if filtered %}조건에 맞는 글이 없습니다{% else %}아직 등록된 글이 없습니다{% endif %}</h2>
      <p>{% if filtered %}다른 검색어나 분류로 다시 찾아보세요.{% else %}첫 이야기를 남겨 이 게시판을 열어보세요.{% endif %}</p>
      <div class="card-actions">
        {% if filtered %}
          <a class="btn btn-outline" href="{{ url_for('posts.index', {'key': board.board_key}) }}">전체 글 보기</a>
        {% elseif can_write %}
          <a class="btn btn-primary" href="{{ url_for('posts.create', {'key': board.board_key}) }}">{{ ico.i('pencil', 16) }} 첫 글 쓰기</a>
        {% endif %}
      </div>
    </div>
  </div>
{% elseif list.data is not empty %}
  {# 파셜이 배포에서 빠져도 오류 화면 대신 목록형으로 떨어지게 한다. #}
  {% include ['posts/_list_' ~ view ~ '.html.twig', 'posts/_list_list.html.twig'] %}
{% endif %}

{% if list.total_pages > 1 %}
  {% set window = 3 %}
  {% set start = max(1, list.page - window) %}
  {% set end = min(list.total_pages, list.page + window) %}
  <nav class="pager" aria-label="페이지 이동">
    <div class="join">
      {% if list.page > 1 %}<a class="join-item btn btn-sm" rel="prev" href="{{ h.listUrl(board, query.q, query.category, list.page - 1, view_param)|trim }}" aria-label="이전 페이지">{{ ico.i('chevron-left', 15) }}</a>{% endif %}
      {% if start > 1 %}
        <a class="join-item btn btn-sm" href="{{ h.listUrl(board, query.q, query.category, 1, view_param)|trim }}" aria-label="1 페이지">1</a>
        {% if start > 2 %}<span class="join-item btn btn-sm btn-disabled" aria-hidden="true">…</span>{% endif %}
      {% endif %}
      {% for p in start..end %}
        {% if p == list.page %}
          <span class="join-item btn btn-sm btn-active" aria-current="page">{{ p }}</span>
        {% else %}
          <a class="join-item btn btn-sm" href="{{ h.listUrl(board, query.q, query.category, p, view_param)|trim }}" aria-label="{{ p }} 페이지">{{ p }}</a>
        {% endif %}
      {% endfor %}
      {% if end < list.total_pages %}
        {% if end < list.total_pages - 1 %}<span class="join-item btn btn-sm btn-disabled" aria-hidden="true">…</span>{% endif %}
        <a class="join-item btn btn-sm" href="{{ h.listUrl(board, query.q, query.category, list.total_pages, view_param)|trim }}" aria-label="{{ list.total_pages }} 페이지">{{ list.total_pages }}</a>
      {% endif %}
      {% if list.page < list.total_pages %}<a class="join-item btn btn-sm" rel="next" href="{{ h.listUrl(board, query.q, query.category, list.page + 1, view_param)|trim }}" aria-label="다음 페이지">{{ ico.i('chevron-right', 15) }}</a>{% endif %}
    </div>
  </nav>
{% endif %}

{% if can_write %}
  <a class="fab btn btn-primary btn-circle" href="{{ url_for('posts.create', {'key': board.board_key}) }}" aria-label="글쓰기">{{ ico.i('pencil', 22) }}</a>
{% endif %}
{% endblock %}
