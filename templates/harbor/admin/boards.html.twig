{# harbor view: admin/boards.html.twig #}
{% extends "admin/layout.html.twig" %}
{% import '_icons.html.twig' as ic %}
{% block title %}게시판 관리 · {{ site.site_name }}{% endblock %}
{% block admin_section %}boards{% endblock %}
{% block body %}
<nav class="harbor-admin-crumb" aria-label="현재 위치">
  <a href="{{ url_for('admin.index') }}">관리</a><span>/</span><span>게시판</span>
</nav>
<header class="harbor-admin-head">
  <div>
    <h1>게시판 관리</h1>
    <p class="harbor-lead">게시판을 만들고 이용 권한과 기능, 노출 순서를 관리합니다.</p>
  </div>
  <div class="harbor-admin-actions">
    <a class="harbor-btn harbor-btn-primary" href="{{ url_for('admin.boards.create') }}">{{ ic.plus() }} 게시판 만들기</a>
  </div>
</header>
{% if query.saved|default('') == '1' %}<p class="harbor-notice harbor-notice-success">게시판 설정을 저장했습니다.</p>{% endif %}
{% if query.deleted|default('') == '1' %}<p class="harbor-notice harbor-notice-success">게시판을 삭제했습니다.</p>{% endif %}
<section class="harbor-panel">
  <div class="harbor-table-wrap">
    <table class="harbor-table">
      <thead><tr><th>게시판</th><th>주소</th><th>권한</th><th>기능</th><th>정렬</th><th>관리</th></tr></thead>
      <tbody>
        {% for board in boards %}
          <tr>
            <td>
              <a class="harbor-table-link" href="{{ url_for('posts.index', {key: board.board_key}) }}">{{ board.name }}</a>
              {% if board.description %}<div class="harbor-table-sub">{{ board.description }}</div>{% endif %}
            </td>
            <td class="harbor-table-meta">/boards/{{ board.board_key }}</td>
            <td>
              <div class="harbor-perm-tags">
                <span>읽기 {{ board.perm_read }}</span>
                <span>쓰기 {{ board.perm_write }}</span>
                <span>댓글 {{ board.perm_comment }}</span>
              </div>
            </td>
            <td>
              <div class="harbor-tag-row">
                {% if board.use_category %}<span class="harbor-tag harbor-tag-soft">분류</span>{% endif %}
                {% if board.use_secret %}<span class="harbor-tag harbor-tag-soft">비밀글</span>{% endif %}
                {% if board.use_file %}<span class="harbor-tag harbor-tag-soft">첨부</span>{% endif %}
                {% if not board.use_category and not board.use_secret and not board.use_file %}<span class="muted">기본</span>{% endif %}
              </div>
            </td>
            <td class="harbor-table-meta">{{ board.sort_order }}</td>
            <td><a class="harbor-btn harbor-btn-sm harbor-btn-ghost" href="{{ url_for('admin.boards.edit', {key: board.board_key}) }}">설정</a></td>
          </tr>
        {% else %}
          <tr><td colspan="6" class="harbor-table-empty">아직 게시판이 없습니다. 첫 게시판을 만들어 보세요.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endblock %}
