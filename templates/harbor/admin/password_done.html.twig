{# harbor view: admin/password_done.html.twig #}
{% extends "layout.html.twig" %}
{% block body_class %}theme-harbor{% endblock %}
{% block title %}비밀번호 변경 완료 · {{ site.site_name }}{% endblock %}
{% block body %}
<div class="auth-shell">
  <section class="harbor-auth-card harbor-status-card">
    <span class="status-dot"></span>
    <p class="harbor-section-kicker">변경 완료</p>
    <h1>비밀번호를 변경했습니다</h1>
    <p class="harbor-lead">새 비밀번호로 다시 로그인해 주세요.</p>
    <a class="harbor-btn harbor-btn-primary harbor-btn-block" href="{{ url_for('auth.login') }}">로그인</a>
  </section>
</div>
{% endblock %}
