{# harbor view: admin/trash.html.twig #}
{% extends "admin/layout.html.twig" %}
{% block title %}내용 휴지통 · {{ site.site_name }}{% endblock %}
{% block admin_section %}content{% endblock %}
{% block body %}
<nav class="harbor-admin-crumb" aria-label="현재 위치">
  <a href="{{ url_for('admin.index') }}">관리</a><span>/</span>
  <a href="{{ url_for('admin.content') }}">내용</a><span>/</span>
  <span>휴지통</span>
</nav>
<header class="harbor-admin-head">
  <div>
    <h1>내용 휴지통</h1>
    <p class="harbor-lead">삭제한 내용은 공개되지 않으며 언제든 복원할 수 있습니다.</p>
  </div>
  <a class="harbor-btn harbor-btn-ghost" href="{{ url_for('admin.content') }}">내용 관리로 돌아가기</a>
</header>
{% if query.restored|default('') == '1' %}<p class="harbor-notice harbor-notice-success">내용을 초안 상태로 복원했습니다.</p>{% endif %}
{% if query.deleted|default('') == '1' %}<p class="harbor-notice harbor-notice-success">내용과 연결된 이미지를 완전히 삭제했습니다.</p>{% endif %}
<section class="harbor-panel">
  <div class="harbor-table-wrap">
    <table class="harbor-table">
      <thead><tr><th>제목</th><th>주소</th><th>삭제일</th><th>관리</th></tr></thead>
      <tbody>
        {% for page in pages %}
          <tr>
            <td><strong>{{ page.title }}</strong></td>
            <td class="harbor-table-meta">/content/{{ page.slug }}</td>
            <td class="harbor-table-meta">{{ page.deleted_at|date('Y.m.d H:i') }}</td>
            <td>
              <div class="harbor-row-actions">
                <form method="post" action="{{ url_for('admin.content.restore', {id: page.id}) }}">
                  <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                  <button class="harbor-btn harbor-btn-sm harbor-btn-ghost" type="submit">복원</button>
                </form>
                <form method="post" action="{{ url_for('admin.content.permanent_delete', {id: page.id}) }}" onsubmit="return confirm('내용과 연결된 이미지를 모두 완전히 삭제할까요? 이 작업은 되돌릴 수 없습니다.')">
                  <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                  <button class="harbor-btn harbor-btn-sm harbor-btn-danger" type="submit">완전 삭제</button>
                </form>
              </div>
            </td>
          </tr>
        {% else %}
          <tr><td colspan="4" class="harbor-table-empty">휴지통이 비어 있습니다.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endblock %}
