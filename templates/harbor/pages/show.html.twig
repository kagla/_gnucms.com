{# harbor view: pages/show.html.twig #}
{% extends "layout.html.twig" %}
{% import '_icons.html.twig' as ic %}
{% block title %}{{ page.title }} · {{ site.site_name }}{% endblock %}
{% block meta_description %}<meta name="description" content="{{ page.seo_description ?: site.site_tagline }}">{% endblock %}
{% block body %}
{% if preview %}
  <aside class="preview-bar harbor-preview">{{ ic.eye() }}<span>{{ page.status == 'published' ? '공개된 내용 미리보기' : '아직 공개되지 않은 초안 미리보기' }}</span><a href="{{ preview_legal_type ? url_for('admin.terms.edit', {type: preview_legal_type}) : url_for('admin.content.edit', {id: page.id}) }}">{{ ic.pen() }} 편집으로 돌아가기</a></aside>
{% endif %}
<article class="harbor-article">
  <header class="harbor-article-head">
    <p class="harbor-section-kicker">{{ ic.doc() }} {{ site.site_name }}</p>
    <h1>{{ page.title }}</h1>
    {% if page.seo_description %}<p class="harbor-lead">{{ page.seo_description }}</p>{% endif %}
  </header>
  <div class="harbor-article-body page-content rich-content">{{ page.content|cms_html }}</div>
</article>
{% endblock %}
