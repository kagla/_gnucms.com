{# harbor view: auth/verified.html.twig #}
{% extends "layout.html.twig" %}
{% import '_icons.html.twig' as ic %}
{% block title %}이메일 인증 완료 · {{ site.site_name }}{% endblock %}
{% block body %}
<div class="auth-shell">
  <section class="harbor-auth-card harbor-status-card">
    <span class="harbor-empty-icon">{{ ic.check() }}</span>
    <p class="harbor-section-kicker">{{ ic.sparkle() }} Welcome aboard</p>
    <h1>인증이 완료됐습니다</h1>
    <p class="harbor-lead">이제 로그인하고 커뮤니티에 참여할 수 있습니다.</p>
    <a class="harbor-btn harbor-btn-primary harbor-btn-block" href="{{ url_for('auth.login') }}">{{ ic.user() }} 로그인하기</a>
  </section>
</div>
{% endblock %}
