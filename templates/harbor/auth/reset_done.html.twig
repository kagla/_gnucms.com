{# harbor view: auth/reset_done.html.twig #}
{% extends "layout.html.twig" %}
{% import '_icons.html.twig' as ic %}
{% block title %}비밀번호 변경 완료 · {{ site.site_name }}{% endblock %}
{% block body %}
<div class="auth-shell">
  <section class="harbor-auth-card harbor-status-card">
    <span class="harbor-empty-icon">{{ ic.check() }}</span>
    <p class="harbor-section-kicker">{{ ic.shield() }} All set</p>
    <h1>비밀번호를 변경했습니다</h1>
    <p class="harbor-lead">새 비밀번호로 다시 로그인해 주세요.</p>
    <a class="harbor-btn harbor-btn-primary harbor-btn-block" href="{{ url_for('auth.login') }}">{{ ic.user() }} 로그인하기</a>
  </section>
</div>
{% endblock %}
