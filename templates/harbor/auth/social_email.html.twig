{# harbor view: auth/social_email.html.twig #}
{% extends "layout.html.twig" %}
{% import '_icons.html.twig' as ic %}
{% block title %}이메일 확인 · {{ site.site_name }}{% endblock %}
{% block body %}
<div class="auth-shell">
  <section class="harbor-auth-card">
    <header class="harbor-panel-head harbor-panel-head-compact">
      <p class="harbor-section-kicker">{{ ic.user() }} {{ provider_label }} 로그인</p>
      <h1>이메일을 확인해 주세요</h1>
      <p class="harbor-lead">계정을 안전하게 연결하려면 사용할 이메일 주소를 한 번 확인해야 합니다.</p>
    </header>
    <form class="harbor-form harbor-auth-form" method="post" action="{{ url_for('oauth.email') }}">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <label class="harbor-field">{{ ic.mail() }} 이메일<input type="email" name="email" value="{{ values.email|default('') }}" maxlength="191" autocomplete="email" required></label>
      {% if errors.email is defined %}<p class="harbor-field-error">{{ errors.email }}</p>{% endif %}
      <button class="harbor-btn harbor-btn-primary harbor-btn-block" type="submit">{{ ic.mail() }} 확인 메일 보내기</button>
    </form>
  </section>
</div>
{% endblock %}
