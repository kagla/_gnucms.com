{# harbor view: auth/_social.html.twig #}
{% if oauth_providers is not empty %}
  <div class="harbor-auth-divider"><span>또는</span></div>
  <div class="harbor-social-login" aria-label="소셜 로그인">
    {% for provider in oauth_providers %}
      <a class="harbor-social-btn harbor-social-{{ provider.key }}" href="{{ url_for('oauth.start', {provider: provider.key}) }}">
        <span class="harbor-social-icon" aria-hidden="true">
          {% if provider.key == 'google' %}G{% elseif provider.key == 'naver' %}N{% elseif provider.key == 'kakao' %}K{% else %}⌘{% endif %}
        </span>
        {{ provider.label }}로 계속하기
      </a>
    {% endfor %}
  </div>
  {% include "auth/_social_consent.html.twig" %}
{% endif %}
