{# harbor view: auth/check_email.html.twig #}
{% extends "layout.html.twig" %}
{% import '_icons.html.twig' as ic %}
{% block title %}이메일을 확인해 주세요 · {{ site.site_name }}{% endblock %}
{% block body %}
<div class="auth-shell">
  <section class="harbor-auth-card harbor-status-card">
    <span class="harbor-empty-icon">{{ ic.mail() }}</span>
    <p class="harbor-section-kicker">{{ ic.sparkle() }} Almost there</p>
    <h1>이메일을 확인해 주세요</h1>
    <p class="harbor-lead">가입 주소로 인증 링크를 보냈습니다. 링크를 열면 회원가입이 완료됩니다.</p>
    <p class="auth-switch"><a href="{{ url_for('auth.login') }}">{{ ic.user() }} 로그인으로 돌아가기</a></p>
  </section>
</div>
{% endblock %}
