{# harbor view: auth/forgot.html.twig #}
{% extends "layout.html.twig" %}
{% import '_icons.html.twig' as ic %}
{% block title %}비밀번호 찾기 · {{ site.site_name }}{% endblock %}
{% block body %}
<div class="auth-shell">
  <section class="harbor-auth-card">
    <header class="harbor-panel-head harbor-panel-head-compact">
      <p class="harbor-section-kicker">{{ ic.mail() }} Password reset</p>
      <h1>비밀번호 찾기</h1>
      <p class="harbor-lead">가입한 이메일로 재설정 링크를 보내드립니다.</p>
    </header>
    <form class="harbor-form harbor-auth-form" method="post" action="{{ url_for('auth.forgot') }}">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <label class="harbor-field">{{ ic.mail() }} 이메일<input type="email" name="email" autocomplete="email" required></label>
      <button class="harbor-btn harbor-btn-primary harbor-btn-block" type="submit">{{ ic.mail() }} 재설정 링크 받기</button>
    </form>
    <p class="auth-switch"><a href="{{ url_for('auth.login') }}">{{ ic.user() }} 로그인으로 돌아가기</a></p>
  </section>
</div>
{% endblock %}
