{# harbor view: home/index.html.twig #}
{% extends "layout.html.twig" %}
{% import '_icons.html.twig' as ic %}
{% block title %}{{ site.site_name }} · {{ site.site_tagline }}{% endblock %}
{% block body %}
<section class="harbor-banner" aria-label="추천">
  <div class="harbor-banner-slide">
    <div class="harbor-banner-copy">
      <p class="harbor-eyebrow">{{ ic.sparkle() }} 오늘의 픽</p>
      <h1>{{ site.home_title }}</h1>
      <p class="harbor-lead">{{ site.home_intro }}</p>
      {% if boards is not empty %}
        <a class="harbor-btn harbor-btn-primary harbor-btn-lg" href="{{ url_for('posts.index', {'key': boards[0].board_key}) }}">{{ ic.arrow() }} 지금 둘러보기</a>
      {% endif %}
    </div>
    <div class="harbor-banner-visual" aria-hidden="true"><span></span><span></span><span></span></div>
  </div>
</section>

{% if boards is not empty %}
<nav class="harbor-chips" aria-label="게시판 카테고리">
  {% for board in boards %}
    <a class="harbor-chip{% if loop.first %} is-active{% endif %}" href="{{ url_for('posts.index', {'key': board.board_key}) }}">{{ ic.chip() }}<span>{{ board.name }}</span></a>
  {% endfor %}
</nav>
{% endif %}

<section class="harbor-feed" aria-labelledby="harbor-feed-title">
  <header class="harbor-feed-head">
    <h2 id="harbor-feed-title">{{ ic.comment() }} 오늘의 이야기</h2>
    <p>커뮤니티에서 올라온 최신 글을 모았습니다.</p>
  </header>
  {% if boards is empty %}
    <div class="harbor-empty-state">{{ ic.empty() }}<p>아직 만들어진 게시판이 없습니다.</p></div>
  {% else %}
    <div class="harbor-card-grid">
      {% for board in boards %}
        {% set board_index = loop.index0 %}
        {% for post in board.latest_posts|slice(0, 2) %}
          <article class="harbor-feed-card">
            <a href="{{ url_for('posts.show', {'id': post.id}) }}" class="harbor-feed-thumb harbor-thumb-{{ (loop.index0 + board_index) % 6 }}" aria-hidden="true"></a>
            <div class="harbor-feed-body">
              <p class="harbor-feed-board">{{ ic.board() }} {{ board.name }}</p>
              <h3><a href="{{ url_for('posts.show', {'id': post.id}) }}">{% if post.is_notice %}<span class="harbor-tag">{{ ic.pin() }} 공지</span>{% endif %}{{ post.title }}</a></h3>
              <p class="harbor-feed-meta"><span class="harbor-meta-item">{{ ic.user() }} {{ post.author_name }}</span><span class="harbor-meta-item">{{ ic.calendar() }} {{ post.created_at|slice(0, 10) }}</span>{% if post.comment_count > 0 %}<span class="harbor-meta-item">{{ ic.comment() }} {{ post.comment_count }}</span>{% endif %}</p>
            </div>
          </article>
        {% else %}
          <article class="harbor-feed-card harbor-feed-card-empty">
            <a href="{{ url_for('posts.index', {'key': board.board_key}) }}" class="harbor-feed-thumb harbor-thumb-muted"></a>
            <div class="harbor-feed-body">
              <p class="harbor-feed-board">{{ ic.board() }} {{ board.name }}</p>
              <h3><a href="{{ url_for('posts.index', {'key': board.board_key}) }}">{{ ic.pen() }} 첫 이야기를 시작해 보세요</a></h3>
              <p class="harbor-feed-meta">{{ board.description ?: '새로운 공간이 열렸습니다.' }}</p>
            </div>
          </article>
        {% endfor %}
      {% endfor %}
    </div>
  {% endif %}
</section>

<section class="harbor-spaces" id="harbor-boards" aria-labelledby="harbor-spaces-title">
  <header class="harbor-feed-head">
    <h2 id="harbor-spaces-title">{{ ic.grid() }} 공간 둘러보기</h2>
    <p>관심 주제의 게시판으로 이동하세요.</p>
  </header>
  {% if boards is not empty %}
    <div class="harbor-space-list">
      {% for board in boards %}
        <a class="harbor-space-item" href="{{ url_for('posts.index', {'key': board.board_key}) }}">
          <span class="harbor-space-icon" aria-hidden="true">{{ ic.board() }}</span>
          <span class="harbor-space-copy"><strong>{{ board.name }}</strong><small>{{ board.description ?: '이야기와 소식을 나누는 공간' }}</small></span>
          <span class="harbor-space-arrow" aria-hidden="true">{{ ic.arrow() }}</span>
        </a>
      {% endfor %}
    </div>
  {% endif %}
</section>
{% endblock %}
