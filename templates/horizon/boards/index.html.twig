{% extends "layout.html.twig" %}
{% import '_icons.html.twig' as ic %}
{% block title %}게시판 · {{ site.site_name }}{% endblock %}
{% block body %}
<section class="nest-hero nest-hero-compact">
  <div class="nest-hero-copy">
    <p class="nest-badge">{{ ic.grid() }} Community</p>
    <h1>커뮤니티</h1>
    <p class="nest-lead">작은 모임부터 새로운 서비스까지, 필요한 이야기만 담아 가볍게 시작하는 공간입니다.</p>
  </div>
</section>
<section class="nest-boards" aria-labelledby="nest-all-boards">
  <header class="nest-section-head">
    <div><p class="nest-section-kicker">{{ ic.board() }} All boards</p><h2 id="nest-all-boards">전체 게시판</h2></div>
  </header>
  {% if boards is empty %}
    <div class="nest-empty-state">{{ ic.empty() }}<p>아직 만들어진 게시판이 없습니다.</p></div>
  {% else %}
    <div class="nest-board-grid">
      {% for board in boards %}
        <article class="nest-board-card">
          <a class="nest-board-card-head" href="{{ url_for('posts.index', {'key': board.board_key}) }}">
            <span class="nest-board-index">{{ ic.board() }}</span>
            <div><h3>{{ board.name }}</h3><p>{{ board.description ?: '새로운 이야기와 소식을 확인해 보세요.' }}</p></div>
            <span class="nest-board-arrow" aria-hidden="true">{{ ic.arrow() }}</span>
          </a>
          <div class="nest-board-latest">
            <div class="nest-board-latest-head"><span>{{ ic.sparkle() }} 최신글</span><a href="{{ url_for('posts.index', {'key': board.board_key}) }}">{{ ic.arrow() }} 전체</a></div>
            {% if board.latest_posts is empty %}<p class="nest-board-latest-empty">{{ ic.pen() }} 아직 등록된 글이 없습니다.</p>{% else %}
              <ul>{% for post in board.latest_posts %}<li><a href="{{ url_for('posts.show', {'id': post.id}) }}"><span>{% if post.is_notice %}<em class="nest-tag">{{ ic.pin() }} 공지</em>{% endif %}{{ post.title }}{% if post.comment_count > 0 %}<b>{{ ic.comment() }} {{ post.comment_count }}</b>{% endif %}</span><time datetime="{{ post.created_at }}">{{ post.created_at|slice(0, 10) }}</time></a></li>{% endfor %}</ul>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  {% endif %}
</section>
{% endblock %}
