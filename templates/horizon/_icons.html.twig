{% macro logo(size) %}<svg class="nest-svg nest-svg-logo" viewBox="0 0 32 32" width="{{ size|default(32) }}" height="{{ size|default(32) }}" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect width="32" height="32" rx="8" fill="currentColor" opacity=".12"/><path d="M11 21c0-3.5 2.2-6 5-6s5 2.5 5 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M9 18c1.5-4 4.2-6 7-6s5.5 2 7 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity=".55"/><circle cx="16" cy="11" r="3.5" fill="currentColor"/><path d="M21 9l1.2 2.4 2.6.4-1.9 1.8.45 2.6L21 14.8l-2.35 1.4.45-2.6-1.9-1.8 2.6-.4L21 9z" fill="#ffb980" opacity=".9"/></svg>{% endmacro %}
