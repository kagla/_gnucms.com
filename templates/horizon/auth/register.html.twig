{% extends "layout.html.twig" %}
{% block title %}회원가입 · {{ site.site_name }}{% endblock %}
{% block body %}
<div class="auth-shell"><section class="surface auth-card">
  <header class="auth-head"><p class="eyebrow">Join {{ site.site_name }}</p><h1>회원가입</h1><p class="lead">가벼운 커뮤니티에 참여하고 새로운 이야기를 시작하세요.</p></header>
  <form class="auth-form" method="post" action="{{ url_for('auth.register') }}">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <label>이메일<input type="email" name="email" value="{{ values.email|default('') }}" maxlength="191" autocomplete="email" required></label>
    {% if errors.email is defined %}<p class="field-error">{{ errors.email }}</p>{% endif %}
    <label>비밀번호 <span class="muted">8자 이상</span><input type="password" name="password" minlength="8" autocomplete="new-password" required></label>
    {% if errors.password is defined %}<p class="field-error">{{ errors.password }}</p>{% endif %}
    <label>비밀번호 확인<input type="password" name="password_confirmation" minlength="8" autocomplete="new-password" required></label>
    {% if errors.password_confirmation is defined %}<p class="field-error">{{ errors.password_confirmation }}</p>{% endif %}
    {% include "auth/_consents.html.twig" %}
    <button class="auth-submit" type="submit">가입하고 시작하기</button>
  </form>
  {% include "auth/_social.html.twig" %}
  <p class="auth-switch">이미 계정이 있으신가요? <a href="{{ url_for('auth.login') }}">로그인</a></p>
</section></div>
{% endblock %}
