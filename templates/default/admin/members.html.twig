{% extends "admin/layout.html.twig" %}
{% block title %}회원 관리 · {{ site.site_name }}{% endblock %}
{% block admin_section %}members{% endblock %}
{% block body %}
<div class="page-head"><div class="page-head-copy"><nav class="breadcrumb"><a href="{{ url_for('admin.index') }}">사이트 관리</a><span class="breadcrumb-separator">/</span><span>회원</span></nav><h1>회원 관리</h1><p class="lead">회원 정보를 수정하거나 필요한 경우 이용을 차단합니다. 소유자 권한은 변경되지 않습니다.</p></div></div>
{% if saved %}<p class="notice success">회원 정보를 저장했습니다.</p>{% endif %}
<form class="toolbar member-search" method="get" action="{{ url_for('admin.members') }}" role="search"><span class="search-icon" aria-hidden="true"></span><input type="search" name="q" value="{{ query }}" placeholder="이메일 또는 표시 이름 검색" aria-label="회원 검색"><button type="submit">검색</button></form>
<section class="surface admin-panel"><div class="table-wrap"><table><thead><tr><th>회원</th><th>가입일</th><th>상태</th><th>관리</th></tr></thead><tbody>
{% for member in members %}<tr><td><strong>{{ member.display_name }}</strong>{% if member.is_admin %} <span class="tag">소유자</span>{% endif %}<div class="member-email">{{ member.email }}</div></td><td class="meta-cell">{{ member.created_at|date('Y.m.d') }}</td><td><span class="status-pill {{ member.status == 'active' ? 'active' : 'blocked' }}">{{ member.status == 'active' ? '활성' : '차단' }}</span></td><td><div class="row-actions"><a class="small-button" href="{{ url_for('admin.members.edit', {id: member.id}) }}">수정</a><form method="post" action="{{ url_for('admin.members.status', {id: member.id}) }}"><input type="hidden" name="csrf_token" value="{{ csrf_token }}"><button class="small-button" type="submit">{{ member.status == 'active' ? '차단' : '해제' }}</button></form></div></td></tr>
{% else %}<tr><td colspan="4" class="empty-row">조건에 맞는 회원이 없습니다.</td></tr>{% endfor %}
</tbody></table></div></section>
{% endblock %}
