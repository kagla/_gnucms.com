{% extends "admin/layout.html.twig" %}
{% import '_icons.html.twig' as ico %}
{% block title %}{{ create ? (legal ? '약관 만들기' : '내용 만들기') : (legal ? values.title ~ ' 수정' : '내용 수정') }} · {{ site.site_name }}{% endblock %}
{% block admin_section %}content{% endblock %}
{% block body %}
<div class="breadcrumbs"><ul><li><a href="{{ url_for('admin.index') }}">사이트 관리</a></li><li><a href="{{ url_for(legal ? 'admin.terms' : 'admin.content') }}">{{ legal ? '약관' : '내용' }}</a></li><li aria-current="page">{{ create ? (legal ? '새 약관' : '새 내용') : values.title }}</li></ul></div>
<section class="card">
  <div class="card-body">
    <h1 class="card-title">{{ create ? (legal ? '약관 만들기' : '내용 만들기') : (legal ? values.title ~ ' 수정' : '내용 수정') }}</h1>
    <p class="card-sub">{{ legal ? '약관 내용을 작성하고 어디에 쓸지 정하세요. 공개된 약관은 사이트 하단에 나옵니다.' : '내용을 작성하고 공개 여부와 메뉴 표시만 정하세요.' }}</p>
    <form method="post" action="{{ create ? url_for(legal ? 'admin.terms.create' : 'admin.content.create') : url_for('admin.content.edit', {id: page_id}) }}">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <input type="hidden" name="image_key" value="{{ values.image_key }}">
      <input type="hidden" name="uploaded_images" value="{{ values.uploaded_images|default('') }}" data-uploaded-images>
      <fieldset class="fieldset{% if errors.title is defined %} is-invalid{% endif %}">
        <legend class="fieldset-legend">제목</legend>
        <input class="input input-bordered input-block" type="text" name="title" value="{{ values.title|default('') }}" maxlength="200" required>
        {% if errors.title is defined %}<p class="validator-hint">{{ ico.i('warning', 14) }} {{ errors.title }}</p>{% endif %}
      </fieldset>
      <fieldset class="fieldset{% if errors.slug is defined %} is-invalid{% endif %}">
        <legend class="fieldset-legend">주소 <span class="legend-hint">{{ legal and not create ? '동의 기록 연결을 위해 고정됩니다.' : '예: about' }}</span></legend>
        <input class="input input-bordered input-block" type="text" name="slug" value="{{ values.slug|default('') }}" maxlength="100" pattern="[a-z0-9][a-z0-9_-]*"{{ legal and not create ? ' readonly' : '' }} required>
        {% if errors.slug is defined %}<p class="validator-hint">{{ ico.i('warning', 14) }} {{ errors.slug }}</p>{% endif %}
      </fieldset>
      <fieldset class="fieldset{% if errors.content is defined %} is-invalid{% endif %}">
        <legend class="fieldset-legend">내용</legend>
        <textarea class="textarea textarea-bordered textarea-block" id="content-editor" name="content" rows="14" data-cms-editor>{{ values.content|default('') }}</textarea>
        <p class="fieldset-label">사진 올리기에서 여러 장을 선택하거나 편집 영역으로 끌어놓을 수 있습니다.</p>
        {% if errors.content is defined %}<p class="validator-hint">{{ ico.i('warning', 14) }} {{ errors.content }}</p>{% endif %}
      </fieldset>
      <div class="grid-2">
        <fieldset class="fieldset">
          <legend class="fieldset-legend">상태</legend>
          <select class="select select-bordered select-block" name="status">
            <option value="draft"{{ values.status|default('draft') == 'draft' ? ' selected' : '' }}>초안</option>
            <option value="published"{{ values.status|default('draft') == 'published' ? ' selected' : '' }}>공개</option>
          </select>
        </fieldset>
        <fieldset class="fieldset">
          <legend class="fieldset-legend">메뉴 순서</legend>
          <input class="input input-bordered input-block" type="number" name="sort_order" value="{{ values.sort_order|default(0) }}" min="-9999" max="9999" inputmode="numeric">
        </fieldset>
      </div>
      {% if legal %}
      {# 사용처는 약관에만 있다. 회원가입 동의로 정하면 가입 화면에 필수·선택으로 붙는다. #}
      <div class="grid-2">
        <fieldset class="fieldset">
          <legend class="fieldset-legend">사용처</legend>
          <select class="select select-bordered select-block" name="consent_usage">
            <option value="signup"{{ values.consent_usage|default('none') == 'signup' ? ' selected' : '' }}>회원가입 동의</option>
            <option value="form"{{ values.consent_usage|default('none') == 'form' ? ' selected' : '' }}>신청서·등록 동의</option>
            <option value="none"{{ values.consent_usage|default('none') == 'none' ? ' selected' : '' }}>안내만</option>
          </select>
          <ul class="fieldset-label usage-guide">
            <li><strong>회원가입 동의</strong> — 회원가입 화면에 동의 체크박스로 나옵니다. 아래 토글로 필수·선택을 정합니다.</li>
            <li><strong>신청서·등록 동의</strong> — 신청서 같은 제출 기능이 생기면 그 화면에 붙습니다. 아직 쓰는 곳이 없으니 미리 정해 두는 용도입니다.</li>
            <li><strong>안내만</strong> — 어디에도 붙지 않습니다. 청소년 보호정책처럼 하단 목록에서 읽기만 하는 약관입니다.</li>
          </ul>
          <p class="fieldset-label">공개 상태여야 화면에 붙습니다.</p>
        </fieldset>
        <fieldset class="fieldset">
          <legend class="fieldset-legend">동의 차례 <span class="legend-hint">작을수록 위</span></legend>
          <input class="input input-bordered input-block" type="number" name="consent_order" value="{{ values.consent_order|default(0) }}" min="-9999" max="9999" inputmode="numeric">
        </fieldset>
      </div>
      {% endif %}
      <fieldset class="fieldset toggle-list">
        <label class="label toggle-row">
          <input class="toggle toggle-primary" type="checkbox" name="show_in_menu" value="1"{{ values.show_in_menu|default(false) ? ' checked' : '' }}>
          <span><strong>{{ legal ? '하단에 표시' : '상단 메뉴에 표시' }}</strong>{% if legal %}<small>사이트 하단의 약관 목록에 나옵니다. 끄면 주소로만 열 수 있습니다.</small>{% endif %}</span>
        </label>
        {% if legal %}
        <label class="label toggle-row">
          <input class="toggle toggle-primary" type="checkbox" name="consent_required" value="1"{{ values.consent_required|default(1) ? ' checked' : '' }}>
          <span><strong>가입할 때 반드시 동의</strong><small>풀면 선택 동의가 됩니다. 안 해도 가입은 됩니다.</small></span>
        </label>
        {% endif %}
      </fieldset>
      <div class="card-actions form-actions">
        {% if not create %}<a class="btn btn-outline" href="{{ url_for('admin.content.preview', {id: page_id}) }}" target="_blank" rel="noopener">{{ ico.i('eye', 15) }} 미리보기</a>{% endif %}
        <a class="btn btn-ghost" href="{{ url_for(legal ? 'admin.terms' : 'admin.content') }}">취소</a>
        <button class="btn btn-primary" type="submit">{{ create ? (legal ? '약관 만들기' : '내용 만들기') : '변경사항 저장' }}</button>
      </div>
    </form>
  </div>
  {% if not create %}
    <form class="danger-zone" method="post" action="{{ url_for('admin.content.delete', {id: page_id}) }}" onsubmit="return confirm('이 내용을 휴지통으로 옮길까요?')">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <div><strong>{{ ico.i('trash', 15) }} 휴지통으로 이동</strong><p>공개가 중단되며 휴지통에서 다시 복원할 수 있습니다.</p></div>
      <button class="btn btn-error btn-outline" type="submit">휴지통으로 이동</button>
    </form>
  {% endif %}
</section>
{% endblock %}
{% block scripts %}{% include "admin/_editor.html.twig" %}{% endblock %}
