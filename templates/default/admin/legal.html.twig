{% extends "admin/layout.html.twig" %}
{% import '_icons.html.twig' as ico %}
{% block title %}약관 관리 · {{ site.site_name }}{% endblock %}
{% block admin_section %}legal{% endblock %}
{% block body %}
{% set ready = legal.terms and legal.terms.status == 'published' and legal.privacy and legal.privacy.status == 'published' %}
<div class="breadcrumbs"><ul><li><a href="{{ url_for('admin.index') }}">사이트 관리</a></li><li aria-current="page">약관</li></ul></div>
<div class="page-head">
  <div><h1>약관 관리</h1><p class="page-sub">회원가입에 연결되는 이용약관과 개인정보 처리방침을 관리합니다.</p></div>
  <div class="page-head-actions">
    <form method="post" action="{{ url_for('admin.terms.setup') }}">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <button class="btn btn-outline" type="submit">누락된 초안 만들기</button>
    </form>
  </div>
</div>
{% if query.created|default('') == '1' %}<div class="alert alert-success"><span aria-hidden="true">{{ ico.i('check-circle', 18) }}</span><span>약관 초안을 준비했습니다. 운영 정보에 맞게 수정한 뒤 공개하세요.</span></div>{% endif %}
{% if query.saved|default('') == '1' %}<div class="alert alert-success"><span aria-hidden="true">{{ ico.i('check-circle', 18) }}</span><span>약관을 저장했습니다.</span></div>{% endif %}
{% if query.deleted|default('') == '1' %}<div class="alert alert-success"><span aria-hidden="true">{{ ico.i('check-circle', 18) }}</span><span>약관을 삭제했습니다.</span></div>{% endif %}
{% if ready %}
  <div class="alert alert-success"><span aria-hidden="true">{{ ico.i('check-circle', 18) }}</span><span>필수 약관이 모두 공개되어 회원가입에 연결되어 있습니다.</span></div>
{% else %}
  <div class="alert alert-info"><span aria-hidden="true">{{ ico.i('info', 18) }}</span><span>두 항목을 검토하고 모두 공개하면 회원가입 링크와 필수 동의 항목이 자동으로 활성화됩니다.</span></div>
{% endif %}
<section class="card">
  <div class="table-wrap">
    <table class="table table-zebra">
      <thead><tr><th>구분</th><th>공개 주소</th><th>상태</th><th>수정일</th><th class="right">관리</th></tr></thead>
      <tbody>
      {% for type, label in {'service':'이용약관','privacy':'개인정보 처리방침'} %}
        {% set page = type == 'service' ? legal.terms : legal.privacy %}
        <tr>
          <td data-label="구분"><span class="cell-title">{{ label }}</span></td>
          <td data-label="공개 주소"><code class="kbd kbd-sm">/terms/{{ type }}</code></td>
          {% if page %}
            <td data-label="상태"><span class="badge badge-sm badge-soft {{ page.status == 'published' ? 'badge-success' : 'badge-ghost' }}">{{ page.status == 'published' ? '공개' : '초안' }}</span></td>
            <td data-label="수정일">{{ page.updated_at|date('Y.m.d') }}</td>
            <td data-label="관리" class="right">
              <div class="join">
                <a class="btn btn-outline btn-sm join-item" href="{{ url_for('admin.terms.preview', {type: type}) }}" target="_blank" rel="noopener">미리보기</a>
                <a class="btn btn-outline btn-sm join-item" href="{{ url_for('admin.terms.edit', {type: type}) }}">수정</a>
              </div>
            </td>
          {% else %}
            <td data-label="상태"><span class="badge badge-error badge-soft badge-sm">미생성</span></td>
            <td data-label="수정일">-</td>
            <td data-label="관리" class="right"><span class="cell-sub">초안을 만들어 주세요.</span></td>
          {% endif %}
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</section>
<p class="page-note">초안은 일반적인 시작 문구입니다. 실제 운영자 정보와 개인정보 처리 현황에 맞게 수정하고 필요하면 법률 전문가의 검토를 받으세요.</p>
{% endblock %}
