{% extends "admin/layout.html.twig" %}
{% import '_icons.html.twig' as ico %}
{% block title %}메일 설정 · {{ site.site_name }}{% endblock %}
{% block admin_section %}mail{% endblock %}
{% block body %}
<div class="breadcrumbs"><ul><li><a href="{{ url_for('admin.index') }}">사이트 관리</a></li><li aria-current="page">메일 설정</li></ul></div>
<section class="card">
  <div class="card-body">
    <h1 class="card-title">{{ ico.i('mail', 19) }} 메일 설정</h1>
    <p class="card-sub">회원 인증과 비밀번호 재설정 메일을 보낼 계정을 연결합니다.</p>
    {% if query.saved|default('') == '1' %}<div class="alert alert-success"><span aria-hidden="true">{{ ico.i('check-circle', 18) }}</span><span>SMTP 설정을 저장했습니다.</span></div>{% endif %}
    {% if query.tested|default('') == '1' %}<div class="alert alert-success"><span aria-hidden="true">{{ ico.i('check-circle', 18) }}</span><span>발신 주소로 테스트 메일을 보냈습니다.</span></div>{% endif %}
    {% if test_error %}<div class="alert alert-error"><span aria-hidden="true">{{ ico.i('warning', 18) }}</span><span>{{ test_error }}</span></div>{% endif %}

    <form method="post" action="{{ url_for('admin.mail') }}">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <fieldset class="fieldset toggle-list">
        <label class="label toggle-row">
          <input class="toggle toggle-primary" type="checkbox" name="enabled" value="1"{{ values.enabled|default(false) ? ' checked' : '' }}>
          <span><strong>SMTP로 메일 보내기</strong></span>
        </label>
      </fieldset>

      <div class="form-section">
        <h2 class="form-section-title">서버</h2>
        <fieldset class="fieldset">
          <legend class="fieldset-legend">메일 서비스</legend>
          <select class="select select-bordered select-block" name="provider" data-mail-provider>
            <option value="gmail"{{ values.provider|default('gmail') == 'gmail' ? ' selected' : '' }}>Gmail</option>
            <option value="naver"{{ values.provider|default('') == 'naver' ? ' selected' : '' }}>네이버 메일</option>
            <option value="daum"{{ values.provider|default('') == 'daum' ? ' selected' : '' }}>다음 메일</option>
            <option value="custom"{{ values.provider|default('') == 'custom' ? ' selected' : '' }}>직접 설정</option>
          </select>
        </fieldset>
        <div class="grid-2">
          <fieldset class="fieldset{% if errors.host is defined %} is-invalid{% endif %}">
            <legend class="fieldset-legend">SMTP 서버</legend>
            <input class="input input-bordered input-block" type="text" name="host" value="{{ values.host|default('smtp.gmail.com') }}" maxlength="253" data-mail-host required>
            {% if errors.host is defined %}<p class="validator-hint">{{ ico.i('warning', 14) }} {{ errors.host }}</p>{% endif %}
          </fieldset>
          <fieldset class="fieldset">
            <legend class="fieldset-legend">포트</legend>
            <input class="input input-bordered input-block" type="number" name="port" value="{{ values.port|default(465) }}" min="1" max="65535" data-mail-port required>
          </fieldset>
        </div>
        <fieldset class="fieldset">
          <legend class="fieldset-legend">보안 연결</legend>
          <select class="select select-bordered select-block" name="encryption" data-mail-encryption>
            <option value="ssl"{{ values.encryption|default('ssl') == 'ssl' ? ' selected' : '' }}>SSL/TLS</option>
            <option value="tls"{{ values.encryption|default('') == 'tls' ? ' selected' : '' }}>STARTTLS</option>
          </select>
        </fieldset>
        <div class="alert alert-info alert-soft" data-mail-help></div>
      </div>

      <div class="form-section">
        <h2 class="form-section-title">계정</h2>
        <fieldset class="fieldset{% if errors.username is defined %} is-invalid{% endif %}">
          <legend class="fieldset-legend">SMTP 사용자 이름</legend>
          <input class="input input-bordered input-block" type="text" name="username" value="{{ values.username|default('') }}" maxlength="254" autocomplete="username" required>
          {% if errors.username is defined %}<p class="validator-hint">{{ ico.i('warning', 14) }} {{ errors.username }}</p>{% endif %}
        </fieldset>
        <fieldset class="fieldset{% if errors.password is defined %} is-invalid{% endif %}">
          <legend class="fieldset-legend">앱 비밀번호</legend>
          <input class="input input-bordered input-block" type="password" name="password" value="" autocomplete="new-password" placeholder="{{ values.password_set|default(false) ? '저장됨 · 변경할 때만 입력' : '앱 비밀번호 입력' }}">
          {% if errors.password is defined %}<p class="validator-hint">{{ ico.i('warning', 14) }} {{ errors.password }}</p>{% endif %}
          <p class="fieldset-label">일반 로그인 비밀번호가 아니라 메일 서비스에서 발급한 앱 비밀번호를 사용하세요.</p>
        </fieldset>
      </div>

      <div class="form-section">
        <h2 class="form-section-title">발신 정보</h2>
        <div class="grid-2">
          <fieldset class="fieldset{% if errors.from_email is defined %} is-invalid{% endif %}">
            <legend class="fieldset-legend">발신 이메일</legend>
            <input class="input input-bordered input-block" type="email" name="from_email" value="{{ values.from_email|default('') }}" maxlength="254" required>
            {% if errors.from_email is defined %}<p class="validator-hint">{{ ico.i('warning', 14) }} {{ errors.from_email }}</p>{% endif %}
          </fieldset>
          <fieldset class="fieldset">
            <legend class="fieldset-legend">발신 이름</legend>
            <input class="input input-bordered input-block" type="text" name="from_name" value="{{ values.from_name|default('aboard') }}" maxlength="100" required>
          </fieldset>
        </div>
      </div>

      <div class="card-actions form-actions">
        <a class="btn btn-ghost" href="{{ url_for('admin.index') }}">취소</a>
        <button class="btn btn-primary" type="submit">설정 저장</button>
      </div>
    </form>

    {% if values.password_set|default(false) and values.enabled|default(false) %}
      <form class="test-mail" method="post" action="{{ url_for('admin.mail.test') }}">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <button class="btn btn-outline" type="submit">{{ ico.i('mail', 15) }} 테스트 메일 보내기</button>
      </form>
    {% endif %}
  </div>
</section>
{% endblock %}
{% block scripts %}
<script>
(function(){
  var p=document.querySelector('[data-mail-provider]');if(!p){return}
  var host=document.querySelector('[data-mail-host]'),port=document.querySelector('[data-mail-port]'),enc=document.querySelector('[data-mail-encryption]'),help=document.querySelector('[data-mail-help]');
  var presets={
    gmail:{host:'smtp.gmail.com',port:'465',encryption:'ssl',help:'Google 계정의 2단계 인증을 켠 뒤 16자리 앱 비밀번호를 발급하세요.'},
    naver:{host:'smtp.naver.com',port:'587',encryption:'tls',help:'네이버 메일에서 IMAP/SMTP 사용을 켜고 애플리케이션 비밀번호를 발급하세요.'},
    daum:{host:'smtp.daum.net',port:'465',encryption:'ssl',help:'다음 계정에서 앱 비밀번호를 발급해 사용하세요.'}
  };
  function sync(change){
    var s=presets[p.value],custom=!s;
    host.readOnly=!custom;port.readOnly=!custom;enc.disabled=!custom;
    if(change&&s){host.value=s.host;port.value=s.port;enc.value=s.encryption}
    help.textContent=s?s.help:'SMTP 제공업체가 안내한 서버, 포트와 보안 연결을 입력하세요.';
  }
  p.addEventListener('change',function(){sync(true)});
  sync(false);
})();
</script>
{% endblock %}
