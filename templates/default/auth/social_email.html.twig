{% extends "layout.html.twig" %}
{% block title %}이메일 확인 · {{ site.site_name }}{% endblock %}
{% block body %}
<div class="auth-shell"><section class="surface auth-card">
  <header class="auth-head"><p class="eyebrow">{{ provider_label }} 로그인</p><h1>이메일을 확인해 주세요</h1><p class="lead">계정을 안전하게 연결하려면 사용할 이메일 주소를 한 번 확인해야 합니다.</p></header>
  <form class="auth-form" method="post" action="{{ url_for('oauth.email') }}">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <label>이메일<input type="email" name="email" value="{{ values.email|default('') }}" maxlength="191" autocomplete="email" required></label>
    {% if errors.email is defined %}<p class="field-error">{{ errors.email }}</p>{% endif %}
    <button class="auth-submit" type="submit">확인 메일 보내기</button>
  </form>
</section></div>
{% endblock %}
