{% extends "layout.html.twig" %}
{% import '_icons.html.twig' as ico %}
{% block title %}로그인 · {{ site.site_name }}{% endblock %}
{% block body %}
<div class="auth-wrap">
  <section class="card auth-card">
    <div class="card-body">
      <div class="auth-head">
        <span class="auth-mark" aria-hidden="true">{{ ico.i('brand', 22) }}</span>
        <h1 class="card-title">{{ site.site_name }}에 로그인</h1>
        <p class="card-sub">이야기를 이어서 나눠 보세요.</p>
      </div>
      <form method="post" action="{{ url_for('auth.login') }}">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <fieldset class="fieldset{% if errors.email is defined %} is-invalid{% endif %}">
          <legend class="fieldset-legend">이메일</legend>
          <label class="input input-bordered input-block">
            <span class="input-icon" aria-hidden="true">{{ ico.i('mail', 16) }}</span>
            <input type="email" name="email" value="{{ values.email|default('') }}" autocomplete="email" placeholder="you@example.com" required>
          </label>
          {% if errors.email is defined %}<p class="validator-hint">{{ ico.i('warning', 14) }} {{ errors.email }}</p>{% endif %}
        </fieldset>
        <fieldset class="fieldset">
          <legend class="fieldset-legend">비밀번호 <a class="link link-hover legend-link" href="{{ url_for('auth.forgot') }}">비밀번호 찾기</a></legend>
          <label class="input input-bordered input-block">
            <span class="input-icon" aria-hidden="true">{{ ico.i('lock', 16) }}</span>
            <input type="password" name="password" autocomplete="current-password" required>
          </label>
        </fieldset>
        <button class="btn btn-primary btn-block btn-lg" type="submit">로그인</button>
      </form>
      {% include "auth/_social.html.twig" %}
      <p class="auth-switch">아직 회원이 아니신가요? <a class="link" href="{{ url_for('auth.register') }}">회원가입</a></p>
    </div>
  </section>
</div>
{% endblock %}
