{% if oauth_providers is not empty %}
  <div class="divider">또는</div>
  <div class="social-list">
    {% for provider in oauth_providers %}
      <a class="btn btn-outline btn-block social-btn social-{{ provider.key }}" href="{{ url_for('oauth.start', {provider: provider.key}) }}">
        <span class="social-mark" aria-hidden="true">{% if provider.key == 'google' %}G{% elseif provider.key == 'naver' %}N{% elseif provider.key == 'kakao' %}K{% else %}⌘{% endif %}</span>
        {{ provider.label }}로 계속하기
      </a>
    {% endfor %}
  </div>
{% endif %}
