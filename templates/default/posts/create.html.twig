{% extends "layout.html.twig" %}
{% block title %}글쓰기 · {{ board.name }} · {{ site.site_name }}{% endblock %}
{% block body %}
  <nav class="breadcrumb" aria-label="현재 위치"><a href="{{ url_for('boards.index') }}">게시판</a><span class="breadcrumb-separator">/</span><a href="{{ url_for('posts.index', {'key': board.board_key}) }}">{{ board.name }}</a><span class="breadcrumb-separator">/</span><span>글쓰기</span></nav>
  <section class="surface editor-card">
    <header class="auth-head"><p class="eyebrow">New post</p><h1>새 글 작성</h1><p class="lead">{{ board.name }}에 새로운 이야기를 남겨보세요.</p></header>
    <form class="editor-form" method="post" action="{{ url_for('posts.create', {'key': board.board_key}) }}">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      {% if board.use_category and board.categories is not empty %}
        <label>분류<select name="category" required><option value="">분류를 선택하세요</option>{% for name in board.categories %}<option value="{{ name }}"{% if values.category|default('') == name %} selected{% endif %}>{{ name }}</option>{% endfor %}</select></label>
        {% if errors.category is defined %}<p class="field-error">{{ errors.category }}</p>{% endif %}
      {% endif %}
      <label>제목<input type="text" name="title" value="{{ values.title|default('') }}" maxlength="200" required autofocus></label>
      {% if errors.title is defined %}<p class="field-error">{{ errors.title }}</p>{% endif %}
      <label>내용<textarea name="content" rows="12" required>{{ values.content|default('') }}</textarea></label>
      {% if errors.content is defined %}<p class="field-error">{{ errors.content }}</p>{% endif %}
      {% if board.use_secret %}<label class="check-label"><input type="checkbox" name="is_secret" value="1"{% if values.is_secret|default(false) %} checked{% endif %}> 비밀글로 작성</label>{% endif %}
      <div class="form-actions"><a class="nav-link" href="{{ url_for('posts.index', {'key': board.board_key}) }}">취소</a><button type="submit">글 등록</button></div>
    </form>
  </section>
{% endblock %}
