{% extends "layout.html.twig" %}
{% block title %}{{ title }}{% endblock %}
{% block body %}
  <section class="surface status-card">
    <p class="eyebrow">Something went wrong</p>
    <h1>{{ title }}</h1>
    <p class="lead">{{ message }}</p>
    {% if details is not empty %}
      <ul class="errors">
        {% for field, detail in details %}<li><strong>{{ field }}</strong>: {{ detail }}</li>{% endfor %}
      </ul>
    {% endif %}
    <p><a class="text-link" href="{{ url_for('boards.index') }}">게시판으로 돌아가기 →</a></p>
  </section>
{% endblock %}
