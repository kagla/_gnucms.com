{# daylight view: auth/forgot.html.twig #}
{% extends "layout.html.twig" %}{% block title %}비밀번호 찾기 · gnucms.com{% endblock %}{% block body %}<div class="auth-shell"><section class="surface auth-card"><header class="auth-head"><p class="eyebrow">Password reset</p><h1>비밀번호 찾기</h1><p class="lead">가입한 이메일로 재설정 링크를 보내드립니다.</p></header><form class="auth-form" method="post" action="{{ url_for('auth.forgot') }}"><input type="hidden" name="csrf_token" value="{{ csrf_token }}"><label>이메일<input type="email" name="email" autocomplete="email" required></label><button class="auth-submit" type="submit">재설정 링크 받기</button></form><p class="auth-switch"><a href="{{ url_for('auth.login') }}">로그인으로 돌아가기</a></p></section></div>{% endblock %}
