{# daylight view: layout.html.twig #}
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#ffffff">
<title>{% block title %}{{ site.site_name }}{% endblock %}</title>
{% block meta_description %}<meta name="description" content="{{ site.site_tagline }}">{% endblock %}
<link rel="stylesheet" href="{{ theme_asset('theme.css') }}">
<script>
try{var savedTheme=localStorage.getItem('aboard-theme');if(savedTheme){document.documentElement.dataset.theme=savedTheme}if(localStorage.getItem('aboard-admin-sidebar')==='collapsed'){document.documentElement.dataset.adminSidebar='collapsed'}}catch(e){}
</script>
</head>
<body class="{% block body_class %}daylight-page{% endblock %}">
<a class="skip-link" href="#main-content">본문으로 바로가기</a>
{% block site_header %}
{% if block('body_class')|trim != 'admin-page' %}
<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="{{ url_for('boards.index') }}" aria-label="{{ site.site_name }} 홈">
      <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      <span class="brand-copy"><strong>{{ site.site_name }}</strong><small>everyday community</small></span>
    </a>
    <nav class="site-nav" aria-label="주요 메뉴">
      <a class="nav-link" href="{{ url_for('boards.index') }}">커뮤니티</a>
      {% for item in site_menu %}<a class="nav-link" href="{{ url_for('content.show', {slug: item.slug}) }}">{{ item.title }}</a>{% endfor %}
    </nav>
    <div class="header-actions">
      <nav class="account-nav" aria-label="회원 메뉴">
      {% if current_user.is_guest %}
        <a class="nav-link login-link" href="{{ url_for('auth.login') }}">로그인</a>
        {% if registration_available %}<a class="nav-link nav-link-primary" href="{{ url_for('auth.register') }}">시작하기 <span aria-hidden="true">↗</span></a>{% endif %}
      {% else %}
        <span class="account-name">{{ current_user.display_name }}</span>
        {% if current_user.is_admin %}<a class="nav-link manage-link" href="{{ url_for('admin.index') }}">관리 콘솔</a>{% endif %}
        <form class="logout-form" method="post" action="{{ url_for('auth.logout') }}"><input type="hidden" name="csrf_token" value="{{ csrf_token }}"><button class="logout-button" type="submit">로그아웃</button></form>
      {% endif %}
      </nav>
      <button class="theme-toggle" type="button" aria-label="다크 모드로 전환" title="다크 모드로 전환"><span aria-hidden="true">☾</span></button>
    </div>
  </div>
  <div class="header-subnav-wrap">
    <nav class="header-subnav" aria-label="커뮤니티 탐색">
      <a class="active" href="{{ url_for('boards.index') }}">홈</a>
      <a href="{{ url_for('boards.index') }}#community-title">게시판</a>
      <a href="{{ url_for('boards.index') }}#studio-popular">인기 이야기</a>
      <a href="{{ url_for('boards.index') }}#studio-guide">커뮤니티 안내</a>
      <span>함께 만드는 공간 <b>NEW</b></span>
    </nav>
  </div>
</header>
{% endif %}
{% endblock %}
<main id="main-content">
{% if block('body_class')|trim == 'admin-page' %}
  <div class="admin-shell" data-admin-page="{{ block('admin_section')|default('dashboard')|trim }}">
    {% include 'admin/_sidebar.html.twig' %}
    <div class="admin-content">{% block body %}{% endblock %}</div>
  </div>
{% else %}
  {% block public_body %}{{ block('body') }}{% endblock %}
{% endif %}
</main>
{% block site_footer %}
{% if block('body_class')|trim != 'admin-page' %}
<footer class="site-footer">
  <div class="footer-brand"><span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span><div><strong>{{ site.site_name }}</strong><p>{{ site.site_tagline }}</p></div></div>
  <p class="footer-message">오늘 발견한 이야기가<br>내일의 영감이 되는 공간.</p>
  <nav aria-label="정책">{% if legal_documents %}<a href="{{ url_for('terms.show', {type: 'service'}) }}">이용약관</a><a href="{{ url_for('terms.show', {type: 'privacy'}) }}">개인정보 처리방침</a>{% endif %}<a href="#main-content">맨 위로 ↑</a></nav>
</footer>
{% endif %}
{% endblock %}
<script>
(function(){
  var root=document.documentElement,button=document.querySelector('.theme-toggle'),meta=document.querySelector('meta[name="theme-color"]');
  function isDark(){return root.dataset.theme==='dark'||(!root.dataset.theme&&window.matchMedia('(prefers-color-scheme: dark)').matches)}
  function sync(){if(!button){return}var dark=isDark(),icon=button.querySelector('span');if(icon){icon.textContent=dark?'☀':'☾'}button.setAttribute('aria-label',dark?'라이트 모드로 전환':'다크 모드로 전환');button.title=button.getAttribute('aria-label');if(meta){meta.content=dark?'#16191c':'#ffffff'}}
  if(button){button.addEventListener('click',function(){var theme=isDark()?'light':'dark';root.dataset.theme=theme;try{localStorage.setItem('aboard-theme',theme)}catch(e){}sync()})}
  var sidebarToggle=document.querySelector('.admin-sidebar-toggle');
  function syncSidebar(){if(!sidebarToggle){return}var collapsed=root.dataset.adminSidebar==='collapsed';sidebarToggle.setAttribute('aria-expanded',collapsed?'false':'true');sidebarToggle.setAttribute('aria-label',collapsed?'관리 메뉴 펼치기':'관리 메뉴 접기');sidebarToggle.title=sidebarToggle.getAttribute('aria-label')}
  if(sidebarToggle){sidebarToggle.addEventListener('click',function(){var collapsed=root.dataset.adminSidebar==='collapsed';if(collapsed){delete root.dataset.adminSidebar}else{root.dataset.adminSidebar='collapsed'}try{localStorage.setItem('aboard-admin-sidebar',collapsed?'expanded':'collapsed')}catch(e){}syncSidebar()});syncSidebar()}
  sync();
})();
</script>
{% block scripts %}{% endblock %}
</body>
</html>
