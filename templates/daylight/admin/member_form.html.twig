{# daylight view: admin/member_form.html.twig #}
{% extends "admin/layout.html.twig" %}
{% block title %}회원 수정 · {{ site.site_name }}{% endblock %}
{% block admin_section %}members{% endblock %}
{% block body %}
<nav class="breadcrumb"><a href="{{ url_for('admin.index') }}">사이트 관리</a><span class="breadcrumb-separator">/</span><a href="{{ url_for('admin.members') }}">회원</a><span class="breadcrumb-separator">/</span><span>{{ values.email }}</span></nav>
<section class="surface editor-card admin-editor"><header class="auth-head"><p class="eyebrow">회원 정보</p><h1>회원 수정</h1><p class="lead">로그인 이메일과 화면에 표시할 이름, 이용 상태를 관리합니다.</p></header>
<form class="editor-form" method="post" action="{{ url_for('admin.members.edit', {id: values.id}) }}"><input type="hidden" name="csrf_token" value="{{ csrf_token }}">
<label>이메일<input type="email" name="email" value="{{ values.email|default('') }}" maxlength="191" autocomplete="off" required></label>{% if errors.email is defined %}<p class="field-error">{{ errors.email }}</p>{% endif %}
<label>표시 이름<input type="text" name="display_name" value="{{ values.display_name|default('') }}" maxlength="100" required></label>{% if errors.display_name is defined %}<p class="field-error">{{ errors.display_name }}</p>{% endif %}
<label>이용 상태<select name="status"><option value="active"{{ values.status|default('active') == 'active' ? ' selected' : '' }}>활성</option><option value="blocked"{{ values.status|default('active') == 'blocked' ? ' selected' : '' }}>차단</option></select></label>{% if errors.status is defined %}<p class="field-error">{{ errors.status }}</p>{% endif %}
<dl class="member-facts"><div><dt>권한</dt><dd>{{ values.is_admin ? '소유자' : '일반 회원' }}</dd></div><div><dt>이메일 인증</dt><dd>{{ values.email_verified ? '완료' : '대기' }}</dd></div><div><dt>가입일</dt><dd>{{ values.created_at|date('Y.m.d H:i') }}</dd></div></dl>
<div class="form-actions"><a class="nav-link" href="{{ url_for('admin.members') }}">취소</a><button type="submit">변경사항 저장</button></div>
</form></section>
{% include "admin/_member_consents.html.twig" %}
{% endblock %}
