{# daylight view: admin/board_form.html.twig #}
{% extends "admin/layout.html.twig" %}
{% block title %}{{ create ? '게시판 만들기' : '게시판 설정' }} · {{ site.site_name }}{% endblock %}
{% block admin_section %}boards{% endblock %}
{% block body %}
<nav class="breadcrumb"><a href="{{ url_for('admin.index') }}">사이트 관리</a><span class="breadcrumb-separator">/</span><a href="{{ url_for('admin.boards') }}">게시판</a><span class="breadcrumb-separator">/</span><span>{{ create ? '게시판 만들기' : values.name }}</span></nav>
<section class="surface editor-card admin-editor"><header class="auth-head"><p class="eyebrow">Board settings</p><h1>{{ create ? '게시판 만들기' : '게시판 설정' }}</h1><p class="lead">기본 정보와 이용 권한을 설정합니다.</p></header>
  <form class="editor-form" method="post" action="{{ create ? url_for('admin.boards.create') : url_for('admin.boards.edit', {key: board_key}) }}">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    {% if create %}<label>게시판 키 <span class="muted">주소에 사용되는 영문 소문자</span><input type="text" name="board_key" value="{{ values.board_key|default('') }}" maxlength="50" pattern="[a-z0-9_-]+" required></label>{% if errors.board_key is defined %}<p class="field-error">{{ errors.board_key }}</p>{% endif %}{% endif %}
    <label>게시판 이름<input type="text" name="name" value="{{ values.name|default('') }}" maxlength="100" required></label>{% if errors.name is defined %}<p class="field-error">{{ errors.name }}</p>{% endif %}
    <label>설명<textarea name="description" rows="3">{{ values.description|default('') }}</textarea></label>
    <div class="form-grid three"><label>읽기 권한<select name="perm_read">{% for p in ['guest','member','admin'] %}<option value="{{ p }}"{{ values.perm_read == p ? ' selected' : '' }}>{{ p }}</option>{% endfor %}</select></label><label>쓰기 권한<select name="perm_write">{% for p in ['guest','member','admin'] %}<option value="{{ p }}"{{ values.perm_write == p ? ' selected' : '' }}>{{ p }}</option>{% endfor %}</select></label><label>댓글 권한<select name="perm_comment">{% for p in ['guest','member','admin'] %}<option value="{{ p }}"{{ values.perm_comment == p ? ' selected' : '' }}>{{ p }}</option>{% endfor %}</select></label></div>
    <label>분류 <span class="muted">한 줄에 하나씩 입력</span><textarea class="compact-textarea" name="categories_text" rows="3">{{ values.categories_text|default('') }}</textarea></label>
    <div class="form-grid"><label>페이지당 글 수<input type="number" name="per_page" value="{{ values.per_page|default(20) }}" min="1" max="100"></label><label>정렬 순서<input type="number" name="sort_order" value="{{ values.sort_order|default(0) }}" min="-9999" max="9999"></label></div>
    <div class="option-row"><label class="check-label"><input type="checkbox" name="use_category" value="1"{{ values.use_category|default(false) ? ' checked' : '' }}>분류 사용</label><label class="check-label"><input type="checkbox" name="use_secret" value="1"{{ values.use_secret|default(false) ? ' checked' : '' }}>비밀글 사용</label><label class="check-label"><input type="checkbox" name="use_file" value="1"{{ values.use_file|default(false) ? ' checked' : '' }}>첨부파일 사용</label></div>
    <div class="form-actions"><a class="nav-link" href="{{ url_for('admin.boards') }}">취소</a><button type="submit">{{ create ? '게시판 만들기' : '변경사항 저장' }}</button></div>
  </form>
  {% if not create %}<form class="danger-zone" method="post" action="{{ url_for('admin.boards.delete', {key: board_key}) }}" onsubmit="return confirm('게시판의 글과 댓글도 함께 삭제됩니다. 정말 삭제할까요?')"><input type="hidden" name="csrf_token" value="{{ csrf_token }}"><div><strong>게시판 삭제</strong><p>게시글과 댓글을 포함해 되돌릴 수 없이 삭제합니다.</p></div><button class="danger-button" type="submit">삭제</button></form>{% endif %}
</section>
{% endblock %}
