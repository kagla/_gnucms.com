{# daylight view: admin/legal.html.twig #}
{% extends "admin/layout.html.twig" %}
{% block title %}약관 관리 · {{ site.site_name }}{% endblock %}
{% block admin_section %}legal{% endblock %}
{% block body %}
{% set ready = legal.terms and legal.terms.status == 'published' and legal.privacy and legal.privacy.status == 'published' %}
<div class="page-head"><div class="page-head-copy"><nav class="breadcrumb"><a href="{{ url_for('admin.index') }}">사이트 관리</a><span class="breadcrumb-separator">/</span><span>약관</span></nav><h1>약관 관리</h1><p class="lead">회원가입에 연결되는 이용약관과 개인정보 처리방침을 관리합니다.</p></div><form method="post" action="{{ url_for('admin.terms.setup') }}"><input type="hidden" name="csrf_token" value="{{ csrf_token }}"><button class="button button-secondary" type="submit">누락된 초안 만들기</button></form></div>
{% if query.created|default('') == '1' %}<p class="notice success">약관 초안을 준비했습니다. 운영 정보에 맞게 수정한 뒤 공개하세요.</p>{% endif %}{% if query.saved|default('') == '1' %}<p class="notice success">약관을 저장했습니다.</p>{% endif %}{% if query.deleted|default('') == '1' %}<p class="notice success">약관을 삭제했습니다.</p>{% endif %}
{% if ready %}<p class="notice success">필수 약관이 모두 공개되어 회원가입에 연결되어 있습니다.</p>{% else %}<p class="notice">두 항목을 검토하고 모두 공개하면 회원가입 링크와 필수 동의 항목이 자동으로 활성화됩니다.</p>{% endif %}
<section class="surface admin-panel"><div class="table-wrap"><table><thead><tr><th>구분</th><th>공개 주소</th><th>상태</th><th>수정일</th><th>관리</th></tr></thead><tbody>
{% for type, label in {'service':'이용약관','privacy':'개인정보 처리방침'} %}{% set page = type == 'service' ? legal.terms : legal.privacy %}<tr><td><strong>{{ label }}</strong></td>{% if page %}<td class="meta-cell">/terms/{{ type }}</td><td><span class="status-pill {{ page.status == 'published' ? 'active' : 'blocked' }}">{{ page.status == 'published' ? '공개' : '초안' }}</span></td><td class="meta-cell">{{ page.updated_at|date('Y.m.d') }}</td><td><div class="row-actions"><a class="small-button" href="{{ url_for('admin.terms.preview', {type: type}) }}" target="_blank" rel="noopener">미리보기</a><a class="small-button" href="{{ url_for('admin.terms.edit', {type: type}) }}">수정</a></div></td>{% else %}<td class="meta-cell">/terms/{{ type }}</td><td><span class="status-pill blocked">미생성</span></td><td class="meta-cell">-</td><td><span class="muted">초안을 만들어 주세요.</span></td>{% endif %}</tr>{% endfor %}
</tbody></table></div></section>
<p class="muted">초안은 일반적인 시작 문구입니다. 실제 운영자 정보와 개인정보 처리 현황에 맞게 수정하고 필요하면 법률 전문가의 검토를 받으세요.</p>
{% endblock %}
