{# daylight view: admin/password.html.twig #}
{% extends "admin/layout.html.twig" %}
{% block title %}관리자 비밀번호 변경 · {{ site.site_name }}{% endblock %}
{% block admin_section %}security{% endblock %}
{% block body %}
<div class="auth-shell"><section class="surface auth-card">
  <header class="auth-head"><p class="eyebrow">Account security</p><h1>비밀번호 변경</h1><p class="lead">새 비밀번호를 저장하면 모든 기기에서 다시 로그인해야 합니다.</p></header>
  <form class="auth-form" method="post" action="{{ url_for('admin.password') }}">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <label>현재 비밀번호<input type="password" name="current_password" autocomplete="current-password" required></label>{% if errors.current_password is defined %}<p class="field-error">{{ errors.current_password }}</p>{% endif %}
    <label>새 비밀번호 <span class="muted">8자 이상</span><input type="password" name="password" minlength="8" autocomplete="new-password" required></label>{% if errors.password is defined %}<p class="field-error">{{ errors.password }}</p>{% endif %}
    <label>새 비밀번호 확인<input type="password" name="password_confirmation" minlength="8" autocomplete="new-password" required></label>{% if errors.password_confirmation is defined %}<p class="field-error">{{ errors.password_confirmation }}</p>{% endif %}
    <button class="auth-submit" type="submit">비밀번호 변경</button>
  </form>
  <p class="auth-switch"><a href="{{ url_for('admin.index') }}">관리 화면으로 돌아가기</a></p>
</section></div>
{% endblock %}
