{% extends "layout.html.twig" %}
{% block title %}게시판{% endblock %}
{% block body %}
  <h1>게시판</h1>
  {% if boards is empty %}
    <p class="empty">게시판이 없습니다.</p>
  {% else %}
    <table>
      <thead><tr><th>이름</th><th>설명</th></tr></thead>
      <tbody>
      {% for board in boards %}
        <tr>
          <td><a href="{{ base_path() }}/b/{{ board.board_key }}">{{ board.name }}</a></td>
          <td class="muted">{{ board.description }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  {% endif %}
{% endblock %}
