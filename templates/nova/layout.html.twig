{% extends "@default/layout.html.twig" %}
{% block body_class %}theme-nova{% endblock %}
{% block site_header %}
<header class="site-header nova-header">
  <div class="header-inner nova-masthead">
    <div class="nova-masthead-top">
      <p class="nova-issue-line">{% if site.site_tagline %}{{ site.site_tagline }}{% else %}커뮤니티{% endif %}</p>
      <div class="header-actions">
        <nav class="account-nav" aria-label="회원 메뉴">
          {% if current_user.is_guest %}
            <a class="nav-link" href="{{ url_for('auth.login') }}">로그인</a>
            {% if registration_available %}<a class="nav-link nav-link-primary" href="{{ url_for('auth.register') }}">회원가입</a>{% endif %}
          {% else %}
            {% if current_user.is_admin %}<a class="nav-link nav-link-primary" href="{{ url_for('admin.index') }}">관리</a>{% endif %}
            <span class="account-name">{{ current_user.display_name }}</span>
            <form class="logout-form" method="post" action="{{ url_for('auth.logout') }}"><input type="hidden" name="csrf_token" value="{{ csrf_token }}"><button class="logout-button" type="submit">로그아웃</button></form>
          {% endif %}
        </nav>
        <button class="theme-toggle" type="button" aria-label="다크 모드로 전환" title="다크 모드로 전환"><span aria-hidden="true">☾</span></button>
      </div>
    </div>
    <a class="nova-wordmark" href="{{ url_for('boards.index') }}" aria-label="{{ site.site_name }} 홈">{{ site.site_name }}</a>
    <div class="nova-rule" aria-hidden="true"></div>
    <nav class="site-nav nova-nav" aria-label="주요 메뉴">
      <a class="nav-link" href="{{ url_for('boards.index') }}">게시판</a>
      {% for item in site_menu %}<a class="nav-link" href="{{ url_for('content.show', {slug: item.slug}) }}">{{ item.title }}</a>{% endfor %}
    </nav>
  </div>
</header>
{% endblock %}
{% block public_body %}
<div class="nova-page">{{ block('body') }}</div>
{% endblock %}
{% block site_footer %}
<footer class="site-footer nova-footer">
  <div class="nova-rule" aria-hidden="true"></div>
  <p class="nova-colophon"><strong>{{ site.site_name }}</strong>{% if site.site_tagline %} · {{ site.site_tagline }}{% endif %}</p>
  {% if legal_documents %}
    <nav class="nova-legal" aria-label="정책">
      <a href="{{ url_for('terms.show', {type: 'service'}) }}">이용약관</a>
      <a href="{{ url_for('terms.show', {type: 'privacy'}) }}">개인정보 처리방침</a>
    </nav>
  {% endif %}
</footer>
{% endblock %}
{% block scripts %}
<script>
(function(){
  var meta=document.querySelector('meta[name="theme-color"]');
  if(!meta){return}
  function paper(){
    var d=document.documentElement.dataset.theme==='dark'||(!document.documentElement.dataset.theme&&window.matchMedia('(prefers-color-scheme: dark)').matches);
    meta.content=d?'#1a1714':'#f4efe6';
  }
  paper();
  var button=document.querySelector('.theme-toggle');
  if(button){button.addEventListener('click',function(){setTimeout(paper,0)})}
})();
</script>
{% endblock %}
