{% extends "layout.html.twig" %}
{% import _self as pager %}
{% macro pageLink(board, query, p, label) %}
  <a href="{{ url_for('posts.index', {'key': board.board_key}) }}?page={{ p }}{% if query.q %}&amp;q={{ query.q|url_encode }}{% endif %}{% if query.category %}&amp;category={{ query.category|url_encode }}{% endif %}" aria-label="{{ p }} 페이지">{{ label|default(p) }}</a>
{% endmacro %}
{% block title %}{{ board.name }} · {{ site.site_name }}{% endblock %}
{% block body %}
  <nav class="breadcrumb nova-crumb" aria-label="현재 위치">
    <a href="{{ url_for('boards.index') }}">게시판</a><span class="breadcrumb-separator" aria-hidden="true">/</span><span>{{ board.name }}</span>
  </nav>
  <header class="page-head board-page-head nova-board-head">
    <div class="page-head-copy">
      <p class="eyebrow">{{ board.board_key }}</p>
      <h1>{{ board.name }}</h1>
      {% if board.description %}<p class="lead">{{ board.description }}</p>{% endif %}
    </div>
    {% if can_write %}<a class="button board-write-button" href="{{ url_for('posts.create', {'key': board.board_key}) }}"><span aria-hidden="true">＋</span>글쓰기</a>{% endif %}
  </header>

  <form class="toolbar board-search nova-search" method="get" action="{{ url_for('posts.index', {'key': board.board_key}) }}" role="search">
    {% if board.use_category and board.categories is not empty %}
      <select name="category" aria-label="분류 선택">
        <option value="">전체 분류</option>
        {% for name in board.categories %}<option value="{{ name }}"{% if query.category == name %} selected{% endif %}>{{ name }}</option>{% endfor %}
      </select>
    {% endif %}
    <div class="board-search-field"><span class="board-search-icon" aria-hidden="true"></span><input type="search" name="q" value="{{ query.q }}" placeholder="제목이나 내용 검색" aria-label="게시글 검색"></div>
    <button type="submit">검색</button>
  </form>

  {% if list.data is empty and list.notices is empty %}
    <div class="nova-empty" role="status"><p>조건에 맞는 글이 없습니다.</p></div>
  {% else %}
    <ol class="nova-post-list">
      {% for post in list.notices|merge(list.data) %}
        <li class="nova-post-item{% if post.is_notice %} is-notice{% endif %}">
          <a class="nova-post-link" href="{{ url_for('posts.show', {'id': post.id}) }}">
            <span class="nova-post-title">
              {% if post.is_notice %}<span class="tag">공지</span>{% endif %}
              {% if board.use_category and post.category and not post.is_notice %}<span class="nova-cat">{{ post.category }}</span>{% endif %}
              {% if post.is_secret %}<span class="post-markers" title="비밀글" aria-label="비밀글">●</span>{% endif %}
              {{ post.title }}
              {% if post.comment_count > 0 %}<span class="comment-count">{{ post.comment_count }}</span>{% endif %}
              {% if post.file_count > 0 %}<span class="post-markers" title="첨부파일 있음" aria-label="첨부파일 있음">＋</span>{% endif %}
            </span>
            <span class="nova-post-meta">
              <span class="nova-post-author">{{ post.author_name }}</span>
              <time datetime="{{ post.created_at }}">{{ post.created_at }}</time>
              <span>조회 {{ post.view_count }}</span>
            </span>
          </a>
        </li>
      {% endfor %}
    </ol>
  {% endif %}

  {% if list.total_pages > 1 %}
    {% set window = 5 %}{% set start = max(1, list.page - window) %}{% set end = min(list.total_pages, list.page + window) %}
    <nav class="pagination" aria-label="페이지 이동">
      {% if start > 1 %}{{ pager.pageLink(board, query, 1) }}{% if start > 2 %}<span class="muted">…</span>{% endif %}{% endif %}
      {% for p in start..end %}{% if p == list.page %}<strong aria-current="page">{{ p }}</strong>{% else %}{{ pager.pageLink(board, query, p) }}{% endif %}{% endfor %}
      {% if end < list.total_pages %}{% if end < list.total_pages - 1 %}<span class="muted">…</span>{% endif %}{{ pager.pageLink(board, query, list.total_pages) }}{% endif %}
    </nav>
  {% endif %}
{% endblock %}
