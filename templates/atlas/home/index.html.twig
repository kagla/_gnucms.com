{% extends "layout.html.twig" %}
{% block title %}{{ site.site_name }} · {{ site.site_tagline }}{% endblock %}
{% block nav_section %}home{% endblock %}
{% block body %}
{% set total_recent = boards|reduce((carry, b) => carry + b.latest_posts|length, 0) %}
<section class="hero">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="hero-copy">
    <p class="chip chip-accent">{{ site.site_tagline }}</p>
    <h1 class="hero-title">{{ site.home_title }}</h1>
    <p class="hero-lead">{{ site.home_intro }}</p>
    <div class="hero-actions">
      {% if boards is not empty %}
        <a class="button button-lg" href="{{ url_for('posts.index', {'key': boards[0].board_key}) }}">
          {{ boards[0].name }} 둘러보기
          <span class="button-arrow" aria-hidden="true">→</span>
        </a>
      {% endif %}
      {% if current_user.is_guest and registration_available %}
        <a class="button button-lg button-quiet" href="{{ url_for('auth.register') }}">회원가입</a>
      {% endif %}
    </div>
  </div>
  <dl class="hero-stats">
    <div class="hero-stat">
      <dt>게시판</dt>
      <dd>{{ boards|length }}</dd>
    </div>
    <div class="hero-stat">
      <dt>최근 글</dt>
      <dd>{{ total_recent }}</dd>
    </div>
  </dl>
</section>

<section class="section" aria-labelledby="board-directory">
  <header class="section-head">
    <div>
      <h2 id="board-directory">커뮤니티</h2>
      <p class="section-sub">최근 이야기를 게시판별로 모았습니다.</p>
    </div>
  </header>

  {% if boards is empty %}
    <div class="empty-state">
      <span class="empty-art" aria-hidden="true"></span>
      <p class="empty-title">아직 만들어진 게시판이 없습니다</p>
      <p class="empty-sub">관리 콘솔에서 첫 게시판을 만들어 보세요.</p>
      {% if not current_user.is_guest and current_user.is_admin %}
        <a class="button" href="{{ url_for('admin.boards.create') }}">게시판 만들기</a>
      {% endif %}
    </div>
  {% else %}
    <div class="board-grid">
      {% for board in boards %}
        <article class="board-card">
          <a class="board-card-head" href="{{ url_for('posts.index', {'key': board.board_key}) }}">
            <span class="board-card-title">
              <span class="board-name">{{ board.name }}</span>
              <span class="board-description">{{ board.description ?: '새로운 이야기와 소식을 확인해 보세요.' }}</span>
            </span>
            <span class="board-card-go" aria-hidden="true">→</span>
          </a>
          <div class="board-card-body">
            {% if board.latest_posts is empty %}
              <p class="board-card-empty">아직 등록된 글이 없습니다.</p>
            {% else %}
              <ul class="mini-list">
                {% for post in board.latest_posts %}
                  <li>
                    <a href="{{ url_for('posts.show', {'id': post.id}) }}">
                      {% if post.is_notice %}<span class="chip chip-notice">공지</span>{% endif %}
                      <span class="mini-title">{{ post.title }}</span>
                      {% if post.comment_count > 0 %}<span class="mini-count">{{ post.comment_count }}</span>{% endif %}
                      <time class="mini-date" datetime="{{ post.created_at }}">{{ post.created_at|date('m.d') }}</time>
                    </a>
                  </li>
                {% endfor %}
              </ul>
            {% endif %}
          </div>
          <a class="board-card-foot" href="{{ url_for('posts.index', {'key': board.board_key}) }}">전체 글 보기</a>
        </article>
      {% endfor %}
    </div>
  {% endif %}
</section>
{% endblock %}
