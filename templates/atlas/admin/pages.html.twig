{% extends "admin/layout.html.twig" %}
{% block title %}내용 관리 · {{ site.site_name }}{% endblock %}
{% block admin_section %}content{% endblock %}
{% block body %}
<div class="page-head">
  <div class="page-head-copy">
    <nav class="breadcrumb" aria-label="현재 위치"><a href="{{ url_for('admin.index') }}">사이트 관리</a><span class="breadcrumb-sep" aria-hidden="true">/</span><span aria-current="page">내용</span></nav>
    <h1>내용 관리</h1>
    <p class="lead">소개·이용안내 같은 사이트 내용을 작성합니다. 공개와 메뉴 표시만 고르면 됩니다.</p>
  </div>
  <div class="page-head-actions">
    <a class="button button-quiet" href="{{ url_for('admin.content.trash') }}">휴지통{% if trash_count > 0 %} <span class="count-pill">{{ trash_count }}</span>{% endif %}</a>
    <a class="button" href="{{ url_for('admin.content.create') }}"><span aria-hidden="true">＋</span> 내용 만들기</a>
  </div>
</div>

{% if query.saved|default('') == '1' %}<p class="notice notice-success">내용을 저장했습니다.</p>{% endif %}
{% if query.deleted|default('') == '1' %}<p class="notice notice-success">내용을 휴지통으로 옮겼습니다.</p>{% endif %}

<section class="panel">
  <div class="table-scroll">
    <table class="data-table">
      <thead><tr><th>제목</th><th>주소</th><th>상태</th><th>메뉴</th><th class="actions">관리</th></tr></thead>
      <tbody>
      {% for page in pages %}
        <tr>
          <td data-label="제목">
            {% if page.status == 'published' %}
              <a class="cell-title" href="{{ url_for('content.show', {slug: page.slug}) }}">{{ page.title }}</a>
            {% else %}
              <strong class="cell-title">{{ page.title }}</strong>
            {% endif %}
          </td>
          <td data-label="주소"><code class="code">/content/{{ page.slug }}</code></td>
          <td data-label="상태"><span class="pill pill-{{ page.status == 'published' ? 'ok' : 'muted' }}">{{ page.status == 'published' ? '공개' : '초안' }}</span></td>
          <td data-label="메뉴">{{ page.show_in_menu ? '표시' : '숨김' }}</td>
          <td data-label="관리" class="actions">
            <div class="row-actions">
              <a class="button button-quiet button-sm" href="{{ url_for('admin.content.preview', {id: page.id}) }}" target="_blank" rel="noopener">미리보기</a>
              <a class="button button-quiet button-sm" href="{{ url_for('admin.content.edit', {id: page.id}) }}">수정</a>
            </div>
          </td>
        </tr>
      {% else %}
        <tr class="is-empty"><td colspan="5">아직 등록된 내용이 없습니다.</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endblock %}
