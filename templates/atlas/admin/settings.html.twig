{% extends "admin/layout.html.twig" %}
{% block title %}사이트 설정 · {{ site.site_name }}{% endblock %}
{% block admin_section %}site{% endblock %}
{% block body %}
<nav class="breadcrumb" aria-label="현재 위치">
  <a href="{{ url_for('admin.index') }}">사이트 관리</a><span class="breadcrumb-sep" aria-hidden="true">/</span>
  <span aria-current="page">사이트 설정</span>
</nav>

<section class="panel form-panel">
  <header class="panel-head">
    <h1>사이트 설정</h1>
    <p class="lead">방문자가 가장 먼저 보는 이름과 소개를 정합니다.</p>
  </header>

  {% if query.saved|default('') == '1' %}<p class="notice notice-success">사이트 설정을 저장했습니다.</p>{% endif %}

  <form class="form" method="post" action="{{ url_for('admin.settings') }}">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

    <fieldset class="form-section">
      <legend>사이트 정보</legend>
      <div class="field{% if errors.site_name is defined %} has-error{% endif %}">
        <label for="site-name">사이트 이름</label>
        <input id="site-name" type="text" name="site_name" value="{{ values.site_name|default('') }}" maxlength="50" required>
        {% if errors.site_name is defined %}<p class="field-error">{{ errors.site_name }}</p>{% endif %}
      </div>
      <div class="field{% if errors.site_tagline is defined %} has-error{% endif %}">
        <label for="site-tagline">짧은 소개</label>
        <input id="site-tagline" type="text" name="site_tagline" value="{{ values.site_tagline|default('') }}" maxlength="120" required>
        {% if errors.site_tagline is defined %}<p class="field-error">{{ errors.site_tagline }}</p>{% endif %}
      </div>
    </fieldset>

    <fieldset class="form-section">
      <legend>홈 화면</legend>
      <div class="field{% if errors.home_title is defined %} has-error{% endif %}">
        <label for="home-title">홈 제목</label>
        <input id="home-title" type="text" name="home_title" value="{{ values.home_title|default('') }}" maxlength="120" required>
        {% if errors.home_title is defined %}<p class="field-error">{{ errors.home_title }}</p>{% endif %}
      </div>
      <div class="field{% if errors.home_intro is defined %} has-error{% endif %}">
        <label for="home-intro">홈 소개</label>
        <textarea id="home-intro" name="home_intro" rows="4" maxlength="500" required>{{ values.home_intro|default('') }}</textarea>
        {% if errors.home_intro is defined %}<p class="field-error">{{ errors.home_intro }}</p>{% endif %}
      </div>
    </fieldset>

    <fieldset class="form-section">
      <legend>표시와 가입</legend>
      <div class="field{% if errors.theme is defined %} has-error{% endif %}">
        <label for="site-theme">템플릿</label>
        <select id="site-theme" name="theme" required>
          {% for theme_name in available_themes %}
            <option value="{{ theme_name }}"{{ values.theme|default(active_theme) == theme_name ? ' selected' : '' }}>{{ theme_name == 'default' ? 'default (기본)' : theme_name }}</option>
          {% endfor %}
        </select>
        {% if errors.theme is defined %}<p class="field-error">{{ errors.theme }}</p>{% endif %}
        <p class="field-hint-block">선택한 템플릿에 없는 화면과 파일은 default 템플릿을 사용합니다.</p>
      </div>
      <div class="check-row">
        <label class="check"><input type="checkbox" name="registration_enabled" value="1"{{ values.registration_enabled|default(false) ? ' checked' : '' }}><span>새 회원가입 허용</span></label>
      </div>
    </fieldset>

    <div class="form-actions">
      <a class="button button-quiet" href="{{ url_for('admin.index') }}">취소</a>
      <button class="button" type="submit">설정 저장</button>
    </div>
  </form>
</section>
{% endblock %}
