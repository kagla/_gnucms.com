{% extends "admin/layout.html.twig" %}
{% block title %}관리자 비밀번호 변경 · {{ site.site_name }}{% endblock %}
{% block admin_section %}security{% endblock %}
{% block body %}
<nav class="breadcrumb" aria-label="현재 위치">
  <a href="{{ url_for('admin.index') }}">사이트 관리</a><span class="breadcrumb-sep" aria-hidden="true">/</span>
  <span aria-current="page">계정 보안</span>
</nav>

<section class="panel form-panel form-panel-narrow">
  <header class="panel-head">
    <h1>비밀번호 변경</h1>
    <p class="lead">새 비밀번호를 저장하면 모든 기기에서 다시 로그인해야 합니다.</p>
  </header>
  <form class="form" method="post" action="{{ url_for('admin.password') }}">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <div class="field{% if errors.current_password is defined %} has-error{% endif %}">
      <label for="cur-password">현재 비밀번호</label>
      <input id="cur-password" type="password" name="current_password" autocomplete="current-password" required>
      {% if errors.current_password is defined %}<p class="field-error">{{ errors.current_password }}</p>{% endif %}
    </div>
    <div class="field{% if errors.password is defined %} has-error{% endif %}">
      <label for="new-password">새 비밀번호 <span class="field-hint">8자 이상</span></label>
      <input id="new-password" type="password" name="password" minlength="8" autocomplete="new-password" required>
      {% if errors.password is defined %}<p class="field-error">{{ errors.password }}</p>{% endif %}
    </div>
    <div class="field{% if errors.password_confirmation is defined %} has-error{% endif %}">
      <label for="new-password2">새 비밀번호 확인</label>
      <input id="new-password2" type="password" name="password_confirmation" minlength="8" autocomplete="new-password" required>
      {% if errors.password_confirmation is defined %}<p class="field-error">{{ errors.password_confirmation }}</p>{% endif %}
    </div>
    <div class="form-actions">
      <a class="button button-quiet" href="{{ url_for('admin.index') }}">취소</a>
      <button class="button" type="submit">비밀번호 변경</button>
    </div>
  </form>
</section>
{% endblock %}
