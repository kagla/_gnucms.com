<aside class="admin-sidebar" id="admin-sidebar">
  <div class="admin-sidebar-head">
    <a class="admin-brand" href="{{ url_for('admin.index') }}">
      <span class="admin-brand-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="3.5" width="7" height="7" rx="1.6"/><rect x="13.5" y="3.5" width="7" height="7" rx="1.6"/><rect x="3.5" y="13.5" width="7" height="7" rx="1.6"/><rect x="13.5" y="13.5" width="7" height="7" rx="1.6"/></svg>
      </span>
      <span class="admin-brand-text">
        <strong>관리 콘솔</strong>
        <small>{{ site.site_name }}</small>
      </span>
    </a>
    <button class="icon-button admin-collapse" type="button" aria-controls="admin-sidebar" aria-expanded="true" aria-label="관리 메뉴 접기" title="관리 메뉴 접기">
      <span aria-hidden="true">‹</span>
    </button>
  </div>

  <nav class="admin-nav" aria-label="관리 메뉴">
    <p class="admin-nav-label">운영</p>
    <a class="admin-nav-item" href="{{ url_for('admin.index') }}" data-key="dashboard"{% if section == 'dashboard' %} aria-current="page"{% endif %} title="대시보드">
      <span class="admin-nav-icon" aria-hidden="true"><svg viewBox="0 0 20 20" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9.2 10 3.5l7 5.7"/><path d="M4.8 10.6V16a.9.9 0 0 0 .9.9h8.6a.9.9 0 0 0 .9-.9v-5.4"/></svg></span>
      <span class="admin-nav-text">대시보드</span>
    </a>
    <a class="admin-nav-item" href="{{ url_for('admin.boards') }}" data-key="boards"{% if section == 'boards' %} aria-current="page"{% endif %} title="게시판 관리">
      <span class="admin-nav-icon" aria-hidden="true"><svg viewBox="0 0 20 20" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="3" y="4" width="14" height="12" rx="2"/><path d="M3 8h14M7.5 12h6"/></svg></span>
      <span class="admin-nav-text">게시판 관리</span>
    </a>
    <a class="admin-nav-item" href="{{ url_for('admin.content') }}" data-key="content"{% if section == 'content' %} aria-current="page"{% endif %} title="내용 관리">
      <span class="admin-nav-icon" aria-hidden="true"><svg viewBox="0 0 20 20" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M5 3.5h6.5L15.5 7v9.5a1 1 0 0 1-1 1h-9a1 1 0 0 1-1-1v-12a1 1 0 0 1 1-1z"/><path d="M11.2 3.6V7.2h3.8M7.5 11h5M7.5 13.6h3.5"/></svg></span>
      <span class="admin-nav-text">내용 관리</span>
    </a>
    <a class="admin-nav-item" href="{{ url_for('admin.members') }}" data-key="members"{% if section == 'members' %} aria-current="page"{% endif %} title="회원 관리">
      <span class="admin-nav-icon" aria-hidden="true"><svg viewBox="0 0 20 20" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="8" cy="7.2" r="2.8"/><path d="M3.2 16.2a4.9 4.9 0 0 1 9.6 0"/><path d="M13.4 5.1a2.6 2.6 0 0 1 0 4.9M14.4 11.8a4.4 4.4 0 0 1 2.5 3.6"/></svg></span>
      <span class="admin-nav-text">회원 관리</span>
    </a>

    <p class="admin-nav-label">설정</p>
    <a class="admin-nav-item" href="{{ url_for('admin.settings') }}" data-key="site"{% if section == 'site' %} aria-current="page"{% endif %} title="사이트 설정">
      <span class="admin-nav-icon" aria-hidden="true"><svg viewBox="0 0 20 20" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="10" cy="10" r="2.6"/><path d="M10 2.8v2M10 15.2v2M2.8 10h2M15.2 10h2M4.9 4.9l1.4 1.4M13.7 13.7l1.4 1.4M15.1 4.9l-1.4 1.4M6.3 13.7l-1.4 1.4"/></svg></span>
      <span class="admin-nav-text">사이트 설정</span>
    </a>
    <a class="admin-nav-item" href="{{ url_for('admin.mail') }}" data-key="mail"{% if section == 'mail' %} aria-current="page"{% endif %} title="메일 설정">
      <span class="admin-nav-icon" aria-hidden="true"><svg viewBox="0 0 20 20" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2.8" y="4.5" width="14.4" height="11" rx="1.8"/><path d="m3.4 6 6.6 4.6L16.6 6"/></svg></span>
      <span class="admin-nav-text">메일 설정</span>
    </a>
    <a class="admin-nav-item" href="{{ url_for('admin.terms') }}" data-key="legal"{% if section == 'legal' %} aria-current="page"{% endif %} title="약관 관리">
      <span class="admin-nav-icon" aria-hidden="true"><svg viewBox="0 0 20 20" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10 3.2v13.6"/><path d="M4.4 6.4h11.2M6.6 6.4 4 12a2.6 2.6 0 0 0 5.2 0zM13.4 6.4 10.8 12a2.6 2.6 0 0 0 5.2 0z"/></svg></span>
      <span class="admin-nav-text">약관 관리</span>
    </a>
    <a class="admin-nav-item" href="{{ url_for('admin.password') }}" data-key="security"{% if section == 'security' %} aria-current="page"{% endif %} title="계정 보안">
      <span class="admin-nav-icon" aria-hidden="true"><svg viewBox="0 0 20 20" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2.8 4.4 5v4.6c0 3.4 2.3 6.3 5.6 7.6 3.3-1.3 5.6-4.2 5.6-7.6V5z"/><path d="m7.7 10 1.7 1.7 3-3.4"/></svg></span>
      <span class="admin-nav-text">계정 보안</span>
    </a>
  </nav>

  <div class="admin-sidebar-foot">
    <a class="admin-site-link" href="{{ url_for('boards.index') }}" title="사이트 보기">
      <span class="admin-nav-icon" aria-hidden="true"><svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7.5 4.5h8v8"/><path d="M15.5 4.5 8 12"/><path d="M13 15.5H5.5a1 1 0 0 1-1-1V7"/></svg></span>
      <span class="admin-nav-text">사이트 보기</span>
    </a>
    <div class="admin-account">
      <span class="avatar avatar-sm" data-tone="{{ current_user.display_name|length % 6 }}" aria-hidden="true">{{ current_user.display_name|slice(0, 1)|upper }}</span>
      <span class="admin-account-name">{{ current_user.display_name }}</span>
      <button class="icon-button theme-toggle" type="button" aria-label="다크 모드로 전환" title="다크 모드로 전환"><span class="theme-icon" aria-hidden="true">☾</span></button>
      <form class="logout-form" method="post" action="{{ url_for('auth.logout') }}">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <button class="icon-button" type="submit" aria-label="로그아웃" title="로그아웃"><span aria-hidden="true">↪</span></button>
      </form>
    </div>
  </div>
</aside>
