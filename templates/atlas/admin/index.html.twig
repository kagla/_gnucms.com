{% extends "admin/layout.html.twig" %}
{% block title %}관리 · {{ site.site_name }}{% endblock %}
{% block admin_section %}dashboard{% endblock %}
{% block body %}
<div class="page-head">
  <div class="page-head-copy">
    <p class="chip chip-accent">1인 운영</p>
    <h1>사이트 관리</h1>
    <p class="lead">사이트 내용과 커뮤니티를 복잡한 절차 없이 관리합니다.</p>
  </div>
  <div class="page-head-actions">
    <a class="button" href="{{ url_for('admin.content.create') }}"><span aria-hidden="true">＋</span> 내용 만들기</a>
  </div>
</div>

{% if query.saved|default('') == '1' %}<p class="notice notice-success">변경사항을 저장했습니다.</p>{% endif %}
{% if query.deleted|default('') == '1' %}<p class="notice notice-success">게시판을 삭제했습니다.</p>{% endif %}

<section class="stat-grid" aria-label="운영 현황">
  <a class="stat-card" href="{{ url_for('admin.boards') }}">
    <span class="stat-label">게시판</span>
    <strong class="stat-value">{{ board_count }}</strong>
    <span class="stat-link">관리하기 <span aria-hidden="true">→</span></span>
  </a>
  <a class="stat-card" href="{{ url_for('admin.content') }}">
    <span class="stat-label">내용</span>
    <strong class="stat-value">{{ page_count }}</strong>
    <span class="stat-link">관리하기 <span aria-hidden="true">→</span></span>
  </a>
  <div class="stat-card">
    <span class="stat-label">게시글</span>
    <strong class="stat-value">{{ post_count }}</strong>
    <span class="stat-sub">삭제되지 않은 글</span>
  </div>
  <a class="stat-card" href="{{ url_for('admin.members') }}">
    <span class="stat-label">회원</span>
    <strong class="stat-value">{{ user_count }}</strong>
    <span class="stat-link">관리하기 <span aria-hidden="true">→</span></span>
  </a>
</section>

<section class="panel">
  <header class="panel-head">
    <h2>게시판 바로가기</h2>
    <a class="text-link" href="{{ url_for('admin.boards') }}">전체 관리 →</a>
  </header>
  {% if boards is empty %}
    <div class="empty-state empty-state-sm">
      <p class="empty-title">아직 게시판이 없습니다</p>
      <a class="button" href="{{ url_for('admin.boards.create') }}">첫 게시판 만들기</a>
    </div>
  {% else %}
    <ul class="link-list">
      {% for board in boards %}
        <li>
          <a href="{{ url_for('admin.boards.edit', {key: board.board_key}) }}">
            <span class="link-list-main">
              <strong>{{ board.name }}</strong>
              <small>/boards/{{ board.board_key }}</small>
            </span>
            <span class="link-list-go" aria-hidden="true">→</span>
          </a>
        </li>
      {% endfor %}
    </ul>
  {% endif %}
</section>
{% endblock %}
