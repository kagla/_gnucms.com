{% extends "admin/layout.html.twig" %}
{% block title %}{{ values.title }} 수정 · {{ site.site_name }}{% endblock %}
{% block admin_section %}legal{% endblock %}
{% block body %}
<nav class="breadcrumb" aria-label="현재 위치">
  <a href="{{ url_for('admin.index') }}">사이트 관리</a><span class="breadcrumb-sep" aria-hidden="true">/</span>
  <a href="{{ url_for('admin.terms') }}">약관</a><span class="breadcrumb-sep" aria-hidden="true">/</span>
  <span aria-current="page">{{ values.title }}</span>
</nav>

<section class="panel form-panel">
  <header class="panel-head">
    <h1>{{ values.title }} 수정</h1>
    <p class="lead">공개 주소는 <code class="code">/{{ type }}</code>로 고정되며, 공개하면 회원가입에 자동 연결됩니다.</p>
  </header>

  <form class="form" method="post" action="{{ url_for('admin.terms.edit', {type: type}) }}">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <input type="hidden" name="image_key" value="{{ values.image_key }}">
    <input type="hidden" name="uploaded_images" value="{{ values.uploaded_images|default('') }}" data-uploaded-images>

    <div class="field{% if errors.title is defined %} has-error{% endif %}">
      <label for="legal-title">제목</label>
      <input id="legal-title" type="text" name="title" value="{{ values.title|default('') }}" maxlength="200" required>
      {% if errors.title is defined %}<p class="field-error">{{ errors.title }}</p>{% endif %}
    </div>

    <div class="field{% if errors.content is defined %} has-error{% endif %}">
      <label for="content-editor">내용</label>
      <textarea id="content-editor" name="content" rows="18" data-cms-editor>{{ values.content|default('') }}</textarea>
      <p class="field-hint-block">사진 올리기에서 여러 장을 선택하거나 편집 영역으로 끌어놓을 수 있습니다.</p>
      {% if errors.content is defined %}<p class="field-error">{{ errors.content }}</p>{% endif %}
    </div>

    <div class="field">
      <label for="legal-status">상태</label>
      <select id="legal-status" name="status">
        <option value="draft"{{ values.status|default('draft') == 'draft' ? ' selected' : '' }}>초안</option>
        <option value="published"{{ values.status|default('draft') == 'published' ? ' selected' : '' }}>공개</option>
      </select>
    </div>

    <input type="hidden" name="sort_order" value="{{ values.sort_order|default(0) }}">

    <div class="form-actions">
      <a class="button button-quiet" href="{{ url_for('admin.terms.preview', {type: type}) }}" target="_blank" rel="noopener">미리보기</a>
      <a class="button button-quiet" href="{{ url_for('admin.terms') }}">취소</a>
      <button class="button" type="submit">변경사항 저장</button>
    </div>
  </form>
</section>
{% endblock %}
{% block scripts %}{% include "admin/_editor.html.twig" %}{% endblock %}
