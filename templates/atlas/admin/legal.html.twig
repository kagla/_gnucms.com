{% extends "admin/layout.html.twig" %}
{% block title %}약관 관리 · {{ site.site_name }}{% endblock %}
{% block admin_section %}legal{% endblock %}
{% block body %}
{% set ready = legal.terms and legal.terms.status == 'published' and legal.privacy and legal.privacy.status == 'published' %}
<div class="page-head">
  <div class="page-head-copy">
    <nav class="breadcrumb" aria-label="현재 위치"><a href="{{ url_for('admin.index') }}">사이트 관리</a><span class="breadcrumb-sep" aria-hidden="true">/</span><span aria-current="page">약관</span></nav>
    <h1>약관 관리</h1>
    <p class="lead">회원가입에 연결되는 이용약관과 개인정보 처리방침을 관리합니다.</p>
  </div>
  <div class="page-head-actions">
    <form method="post" action="{{ url_for('admin.terms.setup') }}">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <button class="button button-quiet" type="submit">누락된 초안 만들기</button>
    </form>
  </div>
</div>

{% if query.created|default('') == '1' %}<p class="notice notice-success">약관 초안을 준비했습니다. 운영 정보에 맞게 수정한 뒤 공개하세요.</p>{% endif %}
{% if query.saved|default('') == '1' %}<p class="notice notice-success">약관을 저장했습니다.</p>{% endif %}
{% if query.deleted|default('') == '1' %}<p class="notice notice-success">약관을 삭제했습니다.</p>{% endif %}
{% if ready %}
  <p class="notice notice-success">필수 약관이 모두 공개되어 회원가입에 연결되어 있습니다.</p>
{% else %}
  <p class="notice notice-info">두 항목을 검토하고 모두 공개하면 회원가입 링크와 필수 동의 항목이 자동으로 활성화됩니다.</p>
{% endif %}

<section class="panel">
  <div class="table-scroll">
    <table class="data-table">
      <thead><tr><th>구분</th><th>공개 주소</th><th>상태</th><th>수정일</th><th class="actions">관리</th></tr></thead>
      <tbody>
      {% for type, label in {'service':'이용약관','privacy':'개인정보 처리방침'} %}
        {% set page = type == 'service' ? legal.terms : legal.privacy %}
        <tr>
          <td data-label="구분"><strong class="cell-title">{{ label }}</strong></td>
          <td data-label="공개 주소"><code class="code">/content/{{ type == 'service' ? 'terms' : 'privacy' }}</code></td>
          {% if page %}
            <td data-label="상태"><span class="pill pill-{{ page.status == 'published' ? 'ok' : 'muted' }}">{{ page.status == 'published' ? '공개' : '초안' }}</span></td>
            <td data-label="수정일">{{ page.updated_at|date('Y.m.d') }}</td>
            <td data-label="관리" class="actions">
              <div class="row-actions">
                <a class="button button-quiet button-sm" href="{{ url_for('admin.terms.preview', {type: type}) }}" target="_blank" rel="noopener">미리보기</a>
                <a class="button button-quiet button-sm" href="{{ url_for('admin.terms.edit', {type: type}) }}">수정</a>
              </div>
            </td>
          {% else %}
            <td data-label="상태"><span class="pill pill-danger">미생성</span></td>
            <td data-label="수정일">-</td>
            <td data-label="관리" class="actions"><span class="muted">초안을 만들어 주세요.</span></td>
          {% endif %}
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</section>

<p class="hint-text">초안은 일반적인 시작 문구입니다. 실제 운영자 정보와 개인정보 처리 현황에 맞게 수정하고 필요하면 법률 전문가의 검토를 받으세요.</p>
{% endblock %}
