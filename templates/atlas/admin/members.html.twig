{% extends "admin/layout.html.twig" %}
{% block title %}회원 관리 · {{ site.site_name }}{% endblock %}
{% block admin_section %}members{% endblock %}
{% block body %}
<div class="page-head">
  <div class="page-head-copy">
    <nav class="breadcrumb" aria-label="현재 위치"><a href="{{ url_for('admin.index') }}">사이트 관리</a><span class="breadcrumb-sep" aria-hidden="true">/</span><span aria-current="page">회원</span></nav>
    <h1>회원 관리</h1>
    <p class="lead">회원 정보를 수정하거나 필요한 경우 이용을 차단합니다. 소유자 권한은 변경되지 않습니다.</p>
  </div>
</div>

{% if saved %}<p class="notice notice-success">회원 정보를 저장했습니다.</p>{% endif %}

<form class="search-form search-form-wide" method="get" action="{{ url_for('admin.members') }}" role="search">
  <div class="search-field">
    <span class="search-icon" aria-hidden="true"><svg viewBox="0 0 20 20" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="9" cy="9" r="5.5"/><path d="M13.2 13.2 17 17"/></svg></span>
    <input type="search" name="q" value="{{ query }}" placeholder="이메일 또는 표시 이름 검색" aria-label="회원 검색" data-search-input>
    <kbd class="search-kbd" aria-hidden="true">/</kbd>
  </div>
  <button class="button button-quiet" type="submit">검색</button>
</form>

<section class="panel">
  <div class="table-scroll">
    <table class="data-table">
      <thead><tr><th>회원</th><th>가입일</th><th>상태</th><th class="actions">관리</th></tr></thead>
      <tbody>
      {% for member in members %}
        <tr>
          <td data-label="회원">
            <span class="user-cell">
              <span class="avatar avatar-sm" data-tone="{{ member.display_name|length % 6 }}" aria-hidden="true">{{ member.display_name|slice(0, 1)|upper }}</span>
              <span>
                <strong class="cell-title">{{ member.display_name }}{% if member.is_admin %} <span class="chip chip-accent">소유자</span>{% endif %}</strong>
                <span class="cell-sub">{{ member.email }}</span>
              </span>
            </span>
          </td>
          <td data-label="가입일">{{ member.created_at|date('Y.m.d') }}</td>
          <td data-label="상태"><span class="pill pill-{{ member.status == 'active' ? 'ok' : 'danger' }}">{{ member.status == 'active' ? '활성' : '차단' }}</span></td>
          <td data-label="관리" class="actions">
            <div class="row-actions">
              <a class="button button-quiet button-sm" href="{{ url_for('admin.members.edit', {id: member.id}) }}">수정</a>
              <form method="post" action="{{ url_for('admin.members.status', {id: member.id}) }}">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                <button class="button button-quiet button-sm" type="submit">{{ member.status == 'active' ? '차단' : '해제' }}</button>
              </form>
            </div>
          </td>
        </tr>
      {% else %}
        <tr class="is-empty"><td colspan="4">조건에 맞는 회원이 없습니다.</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endblock %}
