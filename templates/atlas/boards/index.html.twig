{% extends "layout.html.twig" %}
{% block title %}게시판 · {{ site.site_name }}{% endblock %}
{% block nav_section %}home{% endblock %}
{% block body %}
<header class="page-head">
  <div class="page-head-copy">
    <p class="chip chip-accent">Board directory</p>
    <h1>{{ site.home_title }}</h1>
    <p class="lead">{{ site.home_intro }}</p>
  </div>
</header>

{% if boards is empty %}
  <div class="empty-state">
    <span class="empty-art" aria-hidden="true"></span>
    <p class="empty-title">아직 만들어진 게시판이 없습니다</p>
  </div>
{% else %}
  <div class="board-grid">
    {% for board in boards %}
      <article class="board-card">
        <a class="board-card-head" href="{{ url_for('posts.index', {'key': board.board_key}) }}">
          <span class="board-card-title">
            <span class="board-name">{{ board.name }}</span>
            <span class="board-description">{{ board.description ?: '새로운 이야기와 소식을 확인해 보세요.' }}</span>
          </span>
          <span class="board-card-go" aria-hidden="true">→</span>
        </a>
        <div class="board-card-body">
          {% if board.latest_posts is empty %}
            <p class="board-card-empty">아직 등록된 글이 없습니다.</p>
          {% else %}
            <ul class="mini-list">
              {% for post in board.latest_posts %}
                <li>
                  <a href="{{ url_for('posts.show', {'id': post.id}) }}">
                    {% if post.is_notice %}<span class="chip chip-notice">공지</span>{% endif %}
                    <span class="mini-title">{{ post.title }}</span>
                    {% if post.comment_count > 0 %}<span class="mini-count">{{ post.comment_count }}</span>{% endif %}
                    <time class="mini-date" datetime="{{ post.created_at }}">{{ post.created_at|date('m.d') }}</time>
                  </a>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
        <a class="board-card-foot" href="{{ url_for('posts.index', {'key': board.board_key}) }}">전체 글 보기</a>
      </article>
    {% endfor %}
  </div>
{% endif %}
{% endblock %}
