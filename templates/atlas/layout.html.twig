<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0b0e14" media="(prefers-color-scheme: dark)">
<title>{% block title %}{{ site.site_name }}{% endblock %}</title>
{% block meta_description %}<meta name="description" content="{{ site.site_tagline }}">{% endblock %}
<script>
try{var t=localStorage.getItem('gnucms-theme');if(t){document.documentElement.dataset.theme=t}if(localStorage.getItem('gnucms-admin-sidebar')==='collapsed'){document.documentElement.dataset.adminSidebar='collapsed'}}catch(e){}
</script>
<link rel="stylesheet" href="{{ theme_asset('theme.css') }}">
</head>
<body class="{% block body_class %}{% endblock %}" data-section="{% block nav_section %}{% endblock %}">
<a class="skip-link" href="#main">본문 바로가기</a>
{% block chrome %}
{% block site_header %}
<header class="site-header">
  <div class="header-inner container">
    <a class="brand" href="{{ url_for('boards.index') }}">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6.5A2.5 2.5 0 0 1 6.5 4H19v13H6.5A2.5 2.5 0 0 0 4 19.5z"/><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H19v3H6.5A2.5 2.5 0 0 1 4 19.5z"/></svg>
      </span>
      <span class="brand-text">
        <strong>{{ site.site_name }}</strong>
        <small>{{ site.site_tagline }}</small>
      </span>
    </a>

    <nav class="site-nav" aria-label="주요 메뉴">
      <a class="nav-link" href="{{ url_for('boards.index') }}" data-nav="home"{% if block('nav_section')|trim in ['home', 'board'] %} aria-current="page"{% endif %}>커뮤니티</a>
      {% for item in site_menu %}
        <a class="nav-link" href="{{ url_for('content.show', {slug: item.slug}) }}">{{ item.title }}</a>
      {% endfor %}
    </nav>

    <div class="header-actions">
      <nav class="account-nav" aria-label="회원 메뉴">
        {% if current_user.is_guest %}
          <a class="nav-link" href="{{ url_for('auth.login') }}">로그인</a>
          {% if registration_available %}<a class="button button-sm" href="{{ url_for('auth.register') }}">회원가입</a>{% endif %}
        {% else %}
          {% if current_user.is_admin %}<a class="nav-link nav-link-strong" href="{{ url_for('admin.index') }}">관리</a>{% endif %}
          <span class="account-name" title="{{ current_user.display_name }}">
            <span class="avatar avatar-sm" aria-hidden="true">{{ current_user.display_name|slice(0, 1)|upper }}</span>
            <span class="account-name-text">{{ current_user.display_name }}</span>
          </span>
          <form class="logout-form" method="post" action="{{ url_for('auth.logout') }}">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <button class="button button-quiet button-sm" type="submit">로그아웃</button>
          </form>
        {% endif %}
      </nav>
      <button class="icon-button theme-toggle" type="button" aria-label="다크 모드로 전환" title="다크 모드로 전환">
        <span class="theme-icon" aria-hidden="true">☾</span>
      </button>
      <button class="icon-button drawer-toggle" type="button" aria-expanded="false" aria-controls="mobile-drawer" aria-label="메뉴 열기">
        <span class="drawer-icon" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<div class="drawer" id="mobile-drawer" hidden>
  <div class="drawer-backdrop" data-drawer-close></div>
  <nav class="drawer-panel" aria-label="모바일 메뉴">
    <div class="drawer-head">
      <strong>{{ site.site_name }}</strong>
      <button class="icon-button" type="button" data-drawer-close aria-label="메뉴 닫기">✕</button>
    </div>
    <div class="drawer-links">
      <a href="{{ url_for('boards.index') }}">커뮤니티</a>
      {% for item in site_menu %}<a href="{{ url_for('content.show', {slug: item.slug}) }}">{{ item.title }}</a>{% endfor %}
    </div>
    <div class="drawer-foot">
      {% if current_user.is_guest %}
        <a class="button button-quiet" href="{{ url_for('auth.login') }}">로그인</a>
        {% if registration_available %}<a class="button" href="{{ url_for('auth.register') }}">회원가입</a>{% endif %}
      {% else %}
        {% if current_user.is_admin %}<a class="button button-quiet" href="{{ url_for('admin.index') }}">관리 콘솔</a>{% endif %}
        <form class="logout-form" method="post" action="{{ url_for('auth.logout') }}">
          <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
          <button class="button button-quiet" type="submit">로그아웃</button>
        </form>
      {% endif %}
    </div>
  </nav>
</div>
{% endblock %}

<main class="container" id="main">{% block body %}{% endblock %}</main>

{% block site_footer %}
<footer class="site-footer">
  <div class="footer-inner container">
    <div class="footer-brand">
      <strong>{{ site.site_name }}</strong>
      <p>{{ site.site_tagline }}</p>
    </div>
    <nav class="footer-nav" aria-label="사이트 메뉴">
      <a href="{{ url_for('boards.index') }}">커뮤니티</a>
      {% for item in site_menu %}<a href="{{ url_for('content.show', {slug: item.slug}) }}">{{ item.title }}</a>{% endfor %}
      {% if legal_documents %}
        <a href="{{ url_for('terms.show', {type: 'service'}) }}">이용약관</a>
        <a href="{{ url_for('terms.show', {type: 'privacy'}) }}">개인정보 처리방침</a>
      {% endif %}
    </nav>
  </div>
</footer>
{% endblock %}
{% endblock %}

<button class="to-top" type="button" hidden aria-label="맨 위로 이동" title="맨 위로">
  <span aria-hidden="true">↑</span>
</button>

<script>
(function(){
  var root=document.documentElement;
  function isDark(){return root.dataset.theme==='dark'||(!root.dataset.theme&&window.matchMedia('(prefers-color-scheme: dark)').matches)}
  var toggles=document.querySelectorAll('.theme-toggle');
  function syncTheme(){
    var dark=isDark();
    for(var i=0;i<toggles.length;i++){
      var icon=toggles[i].querySelector('.theme-icon');
      if(icon){icon.textContent=dark?'☀':'☾'}
      toggles[i].setAttribute('aria-label',dark?'라이트 모드로 전환':'다크 모드로 전환');
      toggles[i].title=toggles[i].getAttribute('aria-label');
    }
  }
  for(var i=0;i<toggles.length;i++){
    toggles[i].addEventListener('click',function(){
      var theme=isDark()?'light':'dark';
      root.dataset.theme=theme;
      try{localStorage.setItem('gnucms-theme',theme)}catch(e){}
      syncTheme();
      document.dispatchEvent(new CustomEvent('gnucms:theme',{detail:{dark:theme==='dark'}}));
    });
  }
  syncTheme();

  var drawer=document.getElementById('mobile-drawer');
  var drawerToggle=document.querySelector('.drawer-toggle');
  function closeDrawer(){
    if(!drawer||drawer.hidden){return}
    drawer.hidden=true;document.body.classList.remove('drawer-open');
    if(drawerToggle){drawerToggle.setAttribute('aria-expanded','false');drawerToggle.setAttribute('aria-label','메뉴 열기');drawerToggle.focus()}
  }
  if(drawer&&drawerToggle){
    drawerToggle.addEventListener('click',function(){
      drawer.hidden=false;document.body.classList.add('drawer-open');
      drawerToggle.setAttribute('aria-expanded','true');drawerToggle.setAttribute('aria-label','메뉴 닫기');
      var first=drawer.querySelector('.drawer-links a');if(first){first.focus()}
    });
    var closers=drawer.querySelectorAll('[data-drawer-close]');
    for(var c=0;c<closers.length;c++){closers[c].addEventListener('click',closeDrawer)}
    document.addEventListener('keydown',function(e){if(e.key==='Escape'){closeDrawer()}});
  }

  var toTop=document.querySelector('.to-top');
  if(toTop){
    var ticking=false;
    function updateTop(){
      toTop.hidden=window.scrollY<600;
      ticking=false;
    }
    window.addEventListener('scroll',function(){
      if(!ticking){ticking=true;window.requestAnimationFrame(updateTop)}
    },{passive:true});
    toTop.addEventListener('click',function(){
      window.scrollTo({top:0,behavior:window.matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth'});
    });
    updateTop();
  }

  document.addEventListener('keydown',function(e){
    if(e.key!=='/'||e.metaKey||e.ctrlKey||e.altKey){return}
    var tag=(e.target.tagName||'').toLowerCase();
    if(tag==='input'||tag==='textarea'||tag==='select'||e.target.isContentEditable){return}
    var search=document.querySelector('[data-search-input]');
    if(search){e.preventDefault();search.focus();search.select()}
  });
})();
</script>
{% block scripts %}{% endblock %}
</body>
</html>
