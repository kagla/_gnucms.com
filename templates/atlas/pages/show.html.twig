{% extends "layout.html.twig" %}
{% block title %}{{ page.title }} · {{ site.site_name }}{% endblock %}
{% block meta_description %}<meta name="description" content="{{ page.seo_description ?: site.site_tagline }}">{% endblock %}
{% block body %}
{% if preview %}
  <aside class="notice notice-info preview-bar">
    <span>{{ page.status == 'published' ? '공개된 내용 미리보기입니다.' : '아직 공개되지 않은 초안 미리보기입니다.' }}</span>
    <a class="text-link" href="{{ url_for('admin.content.edit', {id: page.id}) }}">편집으로 돌아가기</a>
  </aside>
{% endif %}
<div class="read-progress" aria-hidden="true"></div>
<article class="article article-page">
  <header class="article-head">
    <p class="chip">{{ site.site_name }}</p>
    <h1 class="article-title">{{ page.title }}</h1>
    {% if page.seo_description %}<p class="article-summary">{{ page.seo_description }}</p>{% endif %}
  </header>
  <div class="article-body prose rich-content">{{ page.content|cms_html }}</div>
</article>
{% endblock %}
