{% extends "layout.html.twig" %}
{% block title %}{{ title }} · {{ site.site_name }}{% endblock %}
{% block body %}
<section class="status-page">
  <span class="status-art status-art-error" aria-hidden="true"></span>
  <h1>{{ title }}</h1>
  <p class="lead">{{ message }}</p>
  {% if details is not empty %}
    <ul class="error-list">
      {% for field, detail in details %}<li><strong>{{ field }}</strong><span>{{ detail }}</span></li>{% endfor %}
    </ul>
  {% endif %}
  <div class="status-actions">
    <a class="button" href="{{ url_for('boards.index') }}">커뮤니티로 돌아가기</a>
  </div>
</section>
{% endblock %}
