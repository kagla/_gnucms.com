<ul class="comment-list{% if nested|default(false) %} comment-list-nested{% endif %}">
{% for comment in nodes %}
  <li class="comment{% if comment.deleted %} is-deleted{% endif %}">
    <div class="comment-inner">
      <span class="avatar avatar-sm" data-tone="{{ comment.deleted ? 0 : comment.author_name|length % 6 }}" aria-hidden="true">{{ comment.deleted ? '·' : comment.author_name|slice(0, 1)|upper }}</span>
      <div class="comment-body">
        <p class="comment-head">
          {% if comment.deleted %}
            <span class="comment-author is-muted">삭제된 댓글</span>
          {% else %}
            <span class="comment-author">{{ comment.author_name }}</span>
          {% endif %}
          <time datetime="{{ comment.created_at }}">{{ comment.created_at|date('Y.m.d H:i') }}</time>
          {% if comment.is_secret %}<span class="marker" title="비밀 댓글" aria-label="비밀 댓글">
            <svg viewBox="0 0 16 16" width="11" height="11" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="7" width="10" height="7" rx="1.6"/><path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2"/></svg>
          </span>{% endif %}
        </p>
        <p class="comment-text">{{ comment.content|nl2br }}</p>
      </div>
    </div>
    {% if comment.children is not empty %}
      {% include 'posts/_comments.html.twig' with {'nodes': comment.children, 'nested': true} only %}
    {% endif %}
  </li>
{% endfor %}
</ul>
