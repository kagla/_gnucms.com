{% extends "layout.html.twig" %}
{% block title %}글쓰기 · {{ board.name }} · {{ site.site_name }}{% endblock %}
{% block nav_section %}board{% endblock %}
{% block body %}
<nav class="breadcrumb" aria-label="현재 위치">
  <a href="{{ url_for('boards.index') }}">커뮤니티</a>
  <span class="breadcrumb-sep" aria-hidden="true">/</span>
  <a href="{{ url_for('posts.index', {'key': board.board_key}) }}">{{ board.name }}</a>
  <span class="breadcrumb-sep" aria-hidden="true">/</span>
  <span aria-current="page">글쓰기</span>
</nav>

<section class="panel form-panel">
  <header class="panel-head">
    <h1>새 글 작성</h1>
    <p class="lead">{{ board.name }}에 새로운 이야기를 남겨보세요.</p>
  </header>

  <form class="form" method="post" action="{{ url_for('posts.create', {'key': board.board_key}) }}">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

    {% if board.use_category and board.categories is not empty %}
      <div class="field{% if errors.category is defined %} has-error{% endif %}">
        <label for="post-category">분류</label>
        <select id="post-category" name="category" required>
          <option value="">분류를 선택하세요</option>
          {% for name in board.categories %}<option value="{{ name }}"{% if values.category|default('') == name %} selected{% endif %}>{{ name }}</option>{% endfor %}
        </select>
        {% if errors.category is defined %}<p class="field-error">{{ errors.category }}</p>{% endif %}
      </div>
    {% endif %}

    <div class="field{% if errors.title is defined %} has-error{% endif %}">
      <label for="post-title">제목</label>
      <input id="post-title" type="text" name="title" value="{{ values.title|default('') }}" maxlength="200" required autofocus placeholder="제목을 입력하세요">
      {% if errors.title is defined %}<p class="field-error">{{ errors.title }}</p>{% endif %}
    </div>

    <div class="field{% if errors.content is defined %} has-error{% endif %}">
      <label for="post-content">내용</label>
      <textarea id="post-content" name="content" rows="14" required placeholder="내용을 입력하세요" data-autogrow>{{ values.content|default('') }}</textarea>
      {% if errors.content is defined %}<p class="field-error">{{ errors.content }}</p>{% endif %}
    </div>

    {% if board.use_secret %}
      <label class="check">
        <input type="checkbox" name="is_secret" value="1"{% if values.is_secret|default(false) %} checked{% endif %}>
        <span>비밀글로 작성 <small>작성자와 관리자만 볼 수 있습니다.</small></span>
      </label>
    {% endif %}

    <div class="form-actions">
      <a class="button button-quiet" href="{{ url_for('posts.index', {'key': board.board_key}) }}">취소</a>
      <button class="button" type="submit">글 등록</button>
    </div>
  </form>
</section>
{% endblock %}
{% block scripts %}
<script>
(function(){
  var area=document.querySelector('[data-autogrow]');
  if(!area){return}
  function grow(){area.style.height='auto';area.style.height=Math.max(area.scrollHeight,240)+'px'}
  area.addEventListener('input',grow);grow();
})();
</script>
{% endblock %}
