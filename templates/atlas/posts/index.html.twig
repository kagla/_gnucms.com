{% extends "layout.html.twig" %}
{% import _self as h %}

{% macro listUrl(board, q, category, page) %}
{%- set params = [] -%}
{%- if q %}{% set params = params|merge(['q=' ~ q|url_encode]) %}{% endif -%}
{%- if category %}{% set params = params|merge(['category=' ~ category|url_encode]) %}{% endif -%}
{%- if page and page > 1 %}{% set params = params|merge(['page=' ~ page]) %}{% endif -%}
{{- url_for('posts.index', {'key': board.board_key}) }}{% if params is not empty %}?{{ params|join('&amp;')|raw }}{% endif %}
{%- endmacro %}

{% block title %}{{ board.name }} · {{ site.site_name }}{% endblock %}
{% block nav_section %}board{% endblock %}
{% block body %}
{% set filtered = query.q is not empty or query.category is not empty %}

<nav class="breadcrumb" aria-label="현재 위치">
  <a href="{{ url_for('boards.index') }}">커뮤니티</a>
  <span class="breadcrumb-sep" aria-hidden="true">/</span>
  <span aria-current="page">{{ board.name }}</span>
</nav>

<header class="page-head">
  <div class="page-head-copy">
    <h1>{{ board.name }}</h1>
    {% if board.description %}<p class="lead">{{ board.description }}</p>{% endif %}
    <p class="page-head-meta">
      <span>전체 {{ list.total }}개</span>
      {% if list.total_pages > 1 %}<span class="dot" aria-hidden="true"></span><span>{{ list.page }} / {{ list.total_pages }} 페이지</span>{% endif %}
    </p>
  </div>
  {% if can_write %}
    <a class="button write-button" href="{{ url_for('posts.create', {'key': board.board_key}) }}">
      <span aria-hidden="true">＋</span> 글쓰기
    </a>
  {% endif %}
</header>

<div class="filter-bar">
  {% if board.use_category and board.categories is not empty %}
    <div class="filter-pills" role="group" aria-label="분류 선택">
      <a class="pill{% if query.category is empty %} is-active{% endif %}" href="{{ h.listUrl(board, query.q, null, 1)|trim }}">전체</a>
      {% for name in board.categories %}
        <a class="pill{% if query.category == name %} is-active{% endif %}" href="{{ h.listUrl(board, query.q, name, 1)|trim }}">{{ name }}</a>
      {% endfor %}
    </div>
  {% endif %}

  <form class="search-form" method="get" action="{{ url_for('posts.index', {'key': board.board_key}) }}" role="search">
    {% if query.category is not empty %}<input type="hidden" name="category" value="{{ query.category }}">{% endif %}
    <div class="search-field">
      <span class="search-icon" aria-hidden="true">
        <svg viewBox="0 0 20 20" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="9" cy="9" r="5.5"/><path d="M13.2 13.2 17 17"/></svg>
      </span>
      <input type="search" name="q" value="{{ query.q }}" placeholder="제목이나 내용 검색" aria-label="게시글 검색" data-search-input>
      <kbd class="search-kbd" aria-hidden="true">/</kbd>
    </div>
    <button class="button button-quiet" type="submit">검색</button>
  </form>
</div>

{% if filtered %}
  <p class="filter-summary">
    {% if query.category is not empty %}<strong>{{ query.category }}</strong>{% endif %}
    {% if query.q is not empty %}<strong>“{{ query.q }}”</strong> 검색{% endif %}
    결과 {{ list.total }}개
    <a class="text-link" href="{{ url_for('posts.index', {'key': board.board_key}) }}">필터 지우기</a>
  </p>
{% endif %}

{% if list.data is empty and list.notices is empty %}
  <div class="empty-state">
    <span class="empty-art" aria-hidden="true"></span>
    <p class="empty-title">{% if filtered %}조건에 맞는 글이 없습니다{% else %}아직 등록된 글이 없습니다{% endif %}</p>
    <p class="empty-sub">{% if filtered %}다른 검색어나 분류로 다시 찾아보세요.{% else %}첫 이야기를 남겨 이 게시판을 열어보세요.{% endif %}</p>
    {% if filtered %}
      <a class="button button-quiet" href="{{ url_for('posts.index', {'key': board.board_key}) }}">전체 글 보기</a>
    {% elseif can_write %}
      <a class="button" href="{{ url_for('posts.create', {'key': board.board_key}) }}">첫 글 쓰기</a>
    {% endif %}
  </div>
{% else %}
  {% if list.notices is not empty %}
    <ol class="post-list post-list-pinned" aria-label="공지 목록">
      {% for post in list.notices %}
        {{ h.row(board, post, true) }}
      {% endfor %}
    </ol>
  {% endif %}

  {% if list.data is not empty %}
    <ol class="post-list" aria-label="게시글 목록">
      {% for post in list.data %}
        {{ h.row(board, post, false) }}
      {% endfor %}
    </ol>
  {% endif %}
{% endif %}

{% if list.total_pages > 1 %}
  {% set window = 4 %}
  {% set start = max(1, list.page - window) %}
  {% set end = min(list.total_pages, list.page + window) %}
  <nav class="pagination" aria-label="페이지 이동">
    {% if list.page > 1 %}
      <a class="page-step" rel="prev" href="{{ h.listUrl(board, query.q, query.category, list.page - 1)|trim }}" aria-label="이전 페이지"><span aria-hidden="true">←</span> 이전</a>
    {% endif %}
    <span class="page-numbers">
      {% if start > 1 %}
        <a href="{{ h.listUrl(board, query.q, query.category, 1)|trim }}" aria-label="1 페이지">1</a>
        {% if start > 2 %}<span class="page-gap" aria-hidden="true">…</span>{% endif %}
      {% endif %}
      {% for p in start..end %}
        {% if p == list.page %}
          <strong aria-current="page">{{ p }}</strong>
        {% else %}
          <a href="{{ h.listUrl(board, query.q, query.category, p)|trim }}" aria-label="{{ p }} 페이지">{{ p }}</a>
        {% endif %}
      {% endfor %}
      {% if end < list.total_pages %}
        {% if end < list.total_pages - 1 %}<span class="page-gap" aria-hidden="true">…</span>{% endif %}
        <a href="{{ h.listUrl(board, query.q, query.category, list.total_pages)|trim }}" aria-label="{{ list.total_pages }} 페이지">{{ list.total_pages }}</a>
      {% endif %}
    </span>
    {% if list.page < list.total_pages %}
      <a class="page-step" rel="next" href="{{ h.listUrl(board, query.q, query.category, list.page + 1)|trim }}" aria-label="다음 페이지">다음 <span aria-hidden="true">→</span></a>
    {% endif %}
  </nav>
{% endif %}

{% if can_write %}
  <a class="fab" href="{{ url_for('posts.create', {'key': board.board_key}) }}" aria-label="글쓰기"><span aria-hidden="true">＋</span></a>
{% endif %}
{% endblock %}

{% macro row(board, post, pinned) %}
<li class="post-row{% if pinned %} is-pinned{% endif %}">
  <a class="post-row-link" href="{{ url_for('posts.show', {'id': post.id}) }}">
    <span class="post-row-main">
      <span class="post-row-title">
        {% if pinned %}<span class="chip chip-notice">공지</span>{% elseif board.use_category and post.category %}<span class="chip">{{ post.category }}</span>{% endif %}
        {% if post.is_secret %}<span class="marker" title="비밀글" aria-label="비밀글">
          <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="7" width="10" height="7" rx="1.6"/><path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2"/></svg>
        </span>{% endif %}
        <span class="post-title">{{ post.title }}</span>
        {% if post.comment_count > 0 %}<span class="comment-pill">{{ post.comment_count }}</span>{% endif %}
        {% if post.file_count > 0 %}<span class="marker" title="첨부파일 있음" aria-label="첨부파일 있음">
          <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M10.5 5 5.8 9.7a1.9 1.9 0 0 0 2.7 2.7l4.7-4.7a3.4 3.4 0 0 0-4.8-4.8L3.6 7.6"/></svg>
        </span>{% endif %}
      </span>
      <span class="post-row-meta">
        <span class="avatar avatar-xs" data-tone="{{ post.author_name|length % 6 }}" aria-hidden="true">{{ post.author_name|slice(0, 1)|upper }}</span>
        <span class="post-author">{{ post.author_name }}</span>
        <span class="dot" aria-hidden="true"></span>
        <time datetime="{{ post.created_at }}">{{ post.created_at|date('Y.m.d') }}</time>
        <span class="dot" aria-hidden="true"></span>
        <span>조회 {{ post.view_count }}</span>
      </span>
    </span>
    <span class="post-row-go" aria-hidden="true">→</span>
  </a>
</li>
{% endmacro %}
