{% extends "layout.html.twig" %}
{% block title %}비밀번호 찾기 · {{ site.site_name }}{% endblock %}
{% block body %}
<div class="auth-shell">
  <section class="auth-card">
    <header class="auth-head">
      <span class="auth-mark" aria-hidden="true">?</span>
      <h1>비밀번호 찾기</h1>
      <p class="lead">가입한 이메일로 재설정 링크를 보내드립니다.</p>
    </header>
    <form class="form" method="post" action="{{ url_for('auth.forgot') }}">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <div class="field">
        <label for="forgot-email">이메일</label>
        <input id="forgot-email" type="email" name="email" autocomplete="email" required>
      </div>
      <button class="button button-block button-lg" type="submit">재설정 링크 받기</button>
    </form>
    <p class="auth-switch"><a href="{{ url_for('auth.login') }}">로그인으로 돌아가기</a></p>
  </section>
</div>
{% endblock %}
