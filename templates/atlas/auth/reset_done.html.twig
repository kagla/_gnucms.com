{% extends "layout.html.twig" %}
{% block title %}비밀번호 변경 완료 · {{ site.site_name }}{% endblock %}
{% block body %}
<div class="auth-shell">
  <section class="auth-card auth-card-status">
    <span class="auth-mark auth-mark-ok" aria-hidden="true">✓</span>
    <h1>비밀번호를 변경했습니다</h1>
    <p class="lead">새 비밀번호로 다시 로그인해 주세요.</p>
    <a class="button button-block button-lg" href="{{ url_for('auth.login') }}">로그인하기</a>
  </section>
</div>
{% endblock %}
