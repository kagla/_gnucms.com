{% extends "layout.html.twig" %}
{% block title %}회원가입 · {{ site.site_name }}{% endblock %}
{% block body %}
<div class="auth-shell">
  <section class="auth-card">
    <header class="auth-head">
      <span class="auth-mark" aria-hidden="true">{{ site.site_name|slice(0, 1)|upper }}</span>
      <h1>{{ site.site_name }} 시작하기</h1>
      <p class="lead">가벼운 커뮤니티에 참여하고 새로운 이야기를 시작하세요.</p>
    </header>
    <form class="form" method="post" action="{{ url_for('auth.register') }}">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <div class="field{% if errors.email is defined %} has-error{% endif %}">
        <label for="join-email">이메일</label>
        <input id="join-email" type="email" name="email" value="{{ values.email|default('') }}" maxlength="191" autocomplete="email" required>
        {% if errors.email is defined %}<p class="field-error">{{ errors.email }}</p>{% endif %}
      </div>
      <div class="field{% if errors.password is defined %} has-error{% endif %}">
        <label for="join-password">비밀번호 <span class="field-hint">8자 이상</span></label>
        <input id="join-password" type="password" name="password" minlength="8" autocomplete="new-password" required>
        {% if errors.password is defined %}<p class="field-error">{{ errors.password }}</p>{% endif %}
      </div>
      <div class="field{% if errors.password_confirmation is defined %} has-error{% endif %}">
        <label for="join-password2">비밀번호 확인</label>
        <input id="join-password2" type="password" name="password_confirmation" minlength="8" autocomplete="new-password" required>
        {% if errors.password_confirmation is defined %}<p class="field-error">{{ errors.password_confirmation }}</p>{% endif %}
      </div>
      {% if legal %}
        <div class="consent-box">
          <label class="check{% if errors.agree_terms is defined %} has-error{% endif %}">
            <input type="checkbox" name="agree_terms" value="1"{{ values.agree_terms|default(false) ? ' checked' : '' }} required>
            <span><a class="text-link" href="{{ url_for('terms.show', {type: 'service'}) }}" target="_blank" rel="noopener">이용약관</a>에 동의합니다 <em class="req">필수</em></span>
          </label>
          {% if errors.agree_terms is defined %}<p class="field-error">{{ errors.agree_terms }}</p>{% endif %}
          <label class="check{% if errors.agree_privacy is defined %} has-error{% endif %}">
            <input type="checkbox" name="agree_privacy" value="1"{{ values.agree_privacy|default(false) ? ' checked' : '' }} required>
            <span><a class="text-link" href="{{ url_for('terms.show', {type: 'privacy'}) }}" target="_blank" rel="noopener">개인정보 수집·이용 안내</a>에 동의합니다 <em class="req">필수</em></span>
          </label>
          {% if errors.agree_privacy is defined %}<p class="field-error">{{ errors.agree_privacy }}</p>{% endif %}
        </div>
      {% endif %}
      <button class="button button-block button-lg" type="submit">가입하고 시작하기</button>
    </form>
    {% include "auth/_social.html.twig" %}
    <p class="auth-switch">이미 계정이 있으신가요? <a href="{{ url_for('auth.login') }}">로그인</a></p>
  </section>
</div>
{% endblock %}
