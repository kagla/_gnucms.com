{% extends "layout.html.twig" %}
{% block title %}이메일 인증 완료 · {{ site.site_name }}{% endblock %}
{% block body %}
<div class="auth-shell">
  <section class="auth-card auth-card-status">
    <span class="auth-mark auth-mark-ok" aria-hidden="true">✓</span>
    <h1>인증이 완료됐습니다</h1>
    <p class="lead">이제 로그인하고 커뮤니티에 참여할 수 있습니다.</p>
    <a class="button button-block button-lg" href="{{ url_for('auth.login') }}">로그인하기</a>
  </section>
</div>
{% endblock %}
