{% extends "layout.html.twig" %}
{% block title %}새 비밀번호 설정 · {{ site.site_name }}{% endblock %}
{% block body %}
<div class="auth-shell">
  <section class="lumen-auth-card">
    <header class="lumen-panel-head lumen-panel-head-compact">
      <p class="lumen-section-kicker">New password</p>
      <h1>새 비밀번호 설정</h1>
    </header>
    <form class="lumen-form lumen-auth-form" method="post" action="{{ url_for('auth.reset') }}">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <input type="hidden" name="token" value="{{ token }}">
      <label class="lumen-field">새 비밀번호 <span class="muted">8자 이상</span><input type="password" name="password" minlength="8" autocomplete="new-password" required></label>
      {% if errors.password is defined %}<p class="lumen-field-error">{{ errors.password }}</p>{% endif %}
      <label class="lumen-field">비밀번호 확인<input type="password" name="password_confirmation" minlength="8" autocomplete="new-password" required></label>
      {% if errors.password_confirmation is defined %}<p class="lumen-field-error">{{ errors.password_confirmation }}</p>{% endif %}
      {% if errors.token is defined %}<p class="lumen-field-error">{{ errors.token }}</p>{% endif %}
      <button class="lumen-btn lumen-btn-primary lumen-btn-block" type="submit">비밀번호 변경</button>
    </form>
  </section>
</div>
{% endblock %}
