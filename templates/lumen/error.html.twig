{% extends "layout.html.twig" %}
{% block title %}{{ title }}{% endblock %}
{% block body %}
<section class="lumen-status">
  <span class="lumen-empty-icon" aria-hidden="true">!</span>
  <p class="lumen-section-kicker">Something went wrong</p>
  <h1>{{ title }}</h1>
  <p class="lumen-lead">{{ message }}</p>
  {% if details is not empty %}
    <ul class="errors lumen-errors">
      {% for field, detail in details %}<li><strong>{{ field }}</strong>: {{ detail }}</li>{% endfor %}
    </ul>
  {% endif %}
  <a class="lumen-btn lumen-btn-primary" href="{{ url_for('boards.index') }}">홈으로 돌아가기</a>
</section>
{% endblock %}
