{% extends "admin/layout.html.twig" %}
{% block title %}메일 설정 · {{ site.site_name }}{% endblock %}
{% block admin_section %}mail{% endblock %}
{% block body %}
<nav class="lumen-admin-crumb" aria-label="현재 위치">
  <a href="{{ url_for('admin.index') }}">관리</a><span>/</span><span>메일 설정</span>
</nav>
<section class="lumen-panel lumen-panel-form">
  <header class="lumen-panel-head">
    <p class="lumen-section-kicker">SMTP</p>
    <h1>메일 설정</h1>
    <p class="lumen-lead">회원 인증과 비밀번호 재설정 메일을 보낼 계정을 연결합니다.</p>
  </header>
  {% if query.saved|default('') == '1' %}<p class="lumen-notice lumen-notice-success">SMTP 설정을 저장했습니다.</p>{% endif %}
  {% if query.tested|default('') == '1' %}<p class="lumen-notice lumen-notice-success">발신 주소로 테스트 메일을 보냈습니다.</p>{% endif %}
  {% if test_error %}<p class="lumen-notice lumen-notice-error">{{ test_error }}</p>{% endif %}
  <form class="lumen-form" method="post" action="{{ url_for('admin.mail') }}">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <label class="lumen-check"><input type="checkbox" name="enabled" value="1"{{ values.enabled|default(false) ? ' checked' : '' }}> SMTP로 메일 보내기</label>
    <label class="lumen-field">메일 서비스
      <select name="provider" data-mail-provider>
        <option value="gmail"{{ values.provider|default('gmail') == 'gmail' ? ' selected' : '' }}>Gmail</option>
        <option value="naver"{{ values.provider|default('') == 'naver' ? ' selected' : '' }}>네이버 메일</option>
        <option value="daum"{{ values.provider|default('') == 'daum' ? ' selected' : '' }}>다음 메일</option>
        <option value="custom"{{ values.provider|default('') == 'custom' ? ' selected' : '' }}>직접 설정</option>
      </select>
    </label>
    <div class="lumen-form-grid">
      <label class="lumen-field">SMTP 서버<input type="text" name="host" value="{{ values.host|default('smtp.gmail.com') }}" maxlength="253" data-mail-host required></label>
      <label class="lumen-field">포트<input type="number" name="port" value="{{ values.port|default(465) }}" min="1" max="65535" data-mail-port required></label>
    </div>
    {% if errors.host is defined %}<p class="lumen-field-error">{{ errors.host }}</p>{% endif %}
    <label class="lumen-field">보안 연결
      <select name="encryption" data-mail-encryption>
        <option value="ssl"{{ values.encryption|default('ssl') == 'ssl' ? ' selected' : '' }}>SSL/TLS</option>
        <option value="tls"{{ values.encryption|default('') == 'tls' ? ' selected' : '' }}>STARTTLS</option>
      </select>
    </label>
    <label class="lumen-field">SMTP 사용자 이름<input type="text" name="username" value="{{ values.username|default('') }}" maxlength="254" autocomplete="username" required></label>
    {% if errors.username is defined %}<p class="lumen-field-error">{{ errors.username }}</p>{% endif %}
    <label class="lumen-field">앱 비밀번호<input type="password" name="password" value="" autocomplete="new-password" placeholder="{{ values.password_set|default(false) ? '저장됨 · 변경할 때만 입력' : '앱 비밀번호 입력' }}"></label>
    {% if errors.password is defined %}<p class="lumen-field-error">{{ errors.password }}</p>{% endif %}
    <p class="lumen-form-help">일반 로그인 비밀번호가 아니라 메일 서비스에서 발급한 앱 비밀번호를 사용하세요.</p>
    <div class="lumen-form-grid">
      <label class="lumen-field">발신 이메일<input type="email" name="from_email" value="{{ values.from_email|default('') }}" maxlength="254" required></label>
      <label class="lumen-field">발신 이름<input type="text" name="from_name" value="{{ values.from_name|default('gnucms.com') }}" maxlength="100" required></label>
    </div>
    {% if errors.from_email is defined %}<p class="lumen-field-error">{{ errors.from_email }}</p>{% endif %}
    <div class="lumen-mail-help" data-mail-help></div>
    <div class="lumen-form-actions">
      <a class="lumen-btn lumen-btn-ghost" href="{{ url_for('admin.index') }}">취소</a>
      <button class="lumen-btn lumen-btn-primary" type="submit">설정 저장</button>
    </div>
  </form>
  {% if values.password_set|default(false) and values.enabled|default(false) %}
    <form class="lumen-mail-test" method="post" action="{{ url_for('admin.mail.test') }}">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <button class="lumen-btn lumen-btn-ghost" type="submit">테스트 메일 보내기</button>
    </form>
  {% endif %}
</section>
{% endblock %}
{% block scripts %}<script>(function(){var provider=document.querySelector('[data-mail-provider]');if(!provider){return}var host=document.querySelector('[data-mail-host]'),port=document.querySelector('[data-mail-port]'),encryption=document.querySelector('[data-mail-encryption]'),help=document.querySelector('[data-mail-help]');var presets={gmail:{host:'smtp.gmail.com',port:'465',encryption:'ssl',help:'Google 계정의 2단계 인증을 켠 뒤 16자리 앱 비밀번호를 발급하세요.'},naver:{host:'smtp.naver.com',port:'587',encryption:'tls',help:'네이버 메일에서 IMAP/SMTP 사용을 켜고 애플리케이션 비밀번호를 발급하세요.'},daum:{host:'smtp.daum.net',port:'465',encryption:'ssl',help:'다음 계정에서 앱 비밀번호를 발급해 사용하세요.'}};function sync(change){var preset=presets[provider.value],custom=!preset;host.readOnly=!custom;port.readOnly=!custom;encryption.disabled=!custom;if(change&&preset){host.value=preset.host;port.value=preset.port;encryption.value=preset.encryption}help.textContent=preset?preset.help:'SMTP 제공업체가 안내한 서버, 포트와 보안 연결을 입력하세요.'}provider.addEventListener('change',function(){sync(true)});sync(false)})();</script>{% endblock %}
