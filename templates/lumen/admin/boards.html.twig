{% extends "admin/layout.html.twig" %}
{% block title %}게시판 관리 · {{ site.site_name }}{% endblock %}
{% block admin_section %}boards{% endblock %}
{% block body %}
<nav class="lumen-admin-crumb" aria-label="현재 위치">
  <a href="{{ url_for('admin.index') }}">관리</a><span>/</span><span>게시판</span>
</nav>
<header class="lumen-admin-head">
  <div>
    <h1>게시판 관리</h1>
    <p class="lumen-lead">게시판을 만들고 이용 권한과 기능, 노출 순서를 관리합니다.</p>
  </div>
  <div class="lumen-admin-actions">
    <a class="lumen-btn lumen-btn-primary" href="{{ url_for('admin.boards.create') }}"><span aria-hidden="true">＋</span> 게시판 만들기</a>
  </div>
</header>
{% if query.saved|default('') == '1' %}<p class="lumen-notice lumen-notice-success">게시판 설정을 저장했습니다.</p>{% endif %}
{% if query.deleted|default('') == '1' %}<p class="lumen-notice lumen-notice-success">게시판을 삭제했습니다.</p>{% endif %}
<section class="lumen-panel">
  <div class="lumen-table-wrap">
    <table class="lumen-table">
      <thead><tr><th>게시판</th><th>주소</th><th>권한</th><th>기능</th><th>정렬</th><th>관리</th></tr></thead>
      <tbody>
        {% for board in boards %}
          <tr>
            <td>
              <a class="lumen-table-link" href="{{ url_for('posts.index', {key: board.board_key}) }}">{{ board.name }}</a>
              {% if board.description %}<div class="lumen-table-sub">{{ board.description }}</div>{% endif %}
            </td>
            <td class="lumen-table-meta">/boards/{{ board.board_key }}</td>
            <td>
              <div class="lumen-perm-tags">
                <span>읽기 {{ board.perm_read }}</span>
                <span>쓰기 {{ board.perm_write }}</span>
                <span>댓글 {{ board.perm_comment }}</span>
              </div>
            </td>
            <td>
              <div class="lumen-tag-row">
                {% if board.use_category %}<span class="lumen-tag lumen-tag-soft">분류</span>{% endif %}
                {% if board.use_secret %}<span class="lumen-tag lumen-tag-soft">비밀글</span>{% endif %}
                {% if board.use_file %}<span class="lumen-tag lumen-tag-soft">첨부</span>{% endif %}
                {% if not board.use_category and not board.use_secret and not board.use_file %}<span class="muted">기본</span>{% endif %}
              </div>
            </td>
            <td class="lumen-table-meta">{{ board.sort_order }}</td>
            <td><a class="lumen-btn lumen-btn-sm lumen-btn-ghost" href="{{ url_for('admin.boards.edit', {key: board.board_key}) }}">설정</a></td>
          </tr>
        {% else %}
          <tr><td colspan="6" class="lumen-table-empty">아직 게시판이 없습니다. 첫 게시판을 만들어 보세요.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endblock %}
