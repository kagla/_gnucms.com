{% extends "admin/layout.html.twig" %}
{% block title %}내용 관리 · {{ site.site_name }}{% endblock %}
{% block admin_section %}content{% endblock %}
{% block body %}
<nav class="lumen-admin-crumb" aria-label="현재 위치">
  <a href="{{ url_for('admin.index') }}">관리</a><span>/</span><span>내용</span>
</nav>
<header class="lumen-admin-head">
  <div>
    <h1>내용 관리</h1>
    <p class="lumen-lead">소개·이용안내 같은 사이트 내용을 작성합니다. 공개와 메뉴 표시만 고르면 됩니다.</p>
  </div>
  <div class="lumen-admin-actions">
    <a class="lumen-btn lumen-btn-ghost" href="{{ url_for('admin.content.trash') }}">휴지통{% if trash_count > 0 %} {{ trash_count }}{% endif %}</a>
    <a class="lumen-btn lumen-btn-primary" href="{{ url_for('admin.content.create') }}"><span aria-hidden="true">＋</span> 내용 만들기</a>
  </div>
</header>
{% if query.saved|default('') == '1' %}<p class="lumen-notice lumen-notice-success">내용을 저장했습니다.</p>{% endif %}
{% if query.deleted|default('') == '1' %}<p class="lumen-notice lumen-notice-success">내용을 휴지통으로 옮겼습니다.</p>{% endif %}
<section class="lumen-panel">
  <div class="lumen-table-wrap">
    <table class="lumen-table">
      <thead><tr><th>제목</th><th>주소</th><th>상태</th><th>메뉴</th><th>관리</th></tr></thead>
      <tbody>
        {% for page in pages %}
          <tr>
            <td>
              {% if page.status == 'published' %}
                <a class="lumen-table-link" href="{{ url_for('content.show', {slug: page.slug}) }}">{{ page.title }}</a>
              {% else %}
                <strong>{{ page.title }}</strong>
              {% endif %}
            </td>
            <td class="lumen-table-meta">/content/{{ page.slug }}</td>
            <td><span class="lumen-status-pill {{ page.status == 'published' ? 'is-active' : 'is-blocked' }}">{{ page.status == 'published' ? '공개' : '초안' }}</span></td>
            <td>{{ page.show_in_menu ? '표시' : '숨김' }}</td>
            <td>
              <div class="lumen-row-actions">
                <a class="lumen-btn lumen-btn-sm lumen-btn-ghost" href="{{ url_for('admin.content.preview', {id: page.id}) }}" target="_blank" rel="noopener">미리보기</a>
                <a class="lumen-btn lumen-btn-sm lumen-btn-ghost" href="{{ url_for('admin.content.edit', {id: page.id}) }}">수정</a>
              </div>
            </td>
          </tr>
        {% else %}
          <tr><td colspan="5" class="lumen-table-empty">아직 등록된 내용이 없습니다.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endblock %}
