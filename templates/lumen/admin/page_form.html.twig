{% extends "admin/layout.html.twig" %}
{% block title %}{{ create ? '내용 만들기' : (legal ? values.title ~ ' 수정' : '내용 수정') }} · {{ site.site_name }}{% endblock %}
{% block admin_section %}content{% endblock %}
{% block body %}
<nav class="lumen-admin-crumb" aria-label="현재 위치">
  <a href="{{ url_for('admin.index') }}">관리</a><span>/</span>
  <a href="{{ url_for(legal ? 'admin.terms' : 'admin.content') }}">{{ legal ? '약관' : '내용' }}</a><span>/</span>
  <span>{{ create ? '새 내용' : values.title }}</span>
</nav>
<section class="lumen-panel lumen-panel-form">
  <header class="lumen-panel-head">
    <p class="lumen-section-kicker">{{ legal ? '필수 약관' : '사이트 내용' }}</p>
    <h1>{{ create ? '내용 만들기' : (legal ? values.title ~ ' 수정' : '내용 수정') }}</h1>
    <p class="lumen-lead">내용을 작성하고 공개 여부와 메뉴 표시만 정하세요.</p>
  </header>
  <form class="lumen-form" method="post" action="{{ create ? url_for('admin.content.create') : url_for('admin.content.edit', {id: page_id}) }}">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <input type="hidden" name="image_key" value="{{ values.image_key }}">
    <input type="hidden" name="uploaded_images" value="{{ values.uploaded_images|default('') }}" data-uploaded-images>
    <label class="lumen-field">제목<input type="text" name="title" value="{{ values.title|default('') }}" maxlength="200" required></label>
    {% if errors.title is defined %}<p class="lumen-field-error">{{ errors.title }}</p>{% endif %}
    <label class="lumen-field">주소 <span class="muted">{{ legal ? '회원가입 연결을 위해 고정됩니다.' : '예: about' }}</span>
      <input type="text" name="slug" value="{{ values.slug|default('') }}" maxlength="100" pattern="[a-z0-9][a-z0-9_-]*"{{ legal ? ' readonly' : '' }} required>
    </label>
    {% if errors.slug is defined %}<p class="lumen-field-error">{{ errors.slug }}</p>{% endif %}
    <label class="lumen-field">내용<textarea id="content-editor" name="content" rows="14" data-cms-editor>{{ values.content|default('') }}</textarea></label>
    <p class="lumen-form-help">사진 올리기에서 여러 장을 선택하거나 편집 영역으로 끌어놓을 수 있습니다.</p>
    {% if errors.content is defined %}<p class="lumen-field-error">{{ errors.content }}</p>{% endif %}
    <div class="lumen-form-grid">
      <label class="lumen-field">상태
        <select name="status">
          <option value="draft"{{ values.status|default('draft') == 'draft' ? ' selected' : '' }}>초안</option>
          <option value="published"{{ values.status|default('draft') == 'published' ? ' selected' : '' }}>공개</option>
        </select>
      </label>
      <label class="lumen-field">메뉴 순서<input type="number" name="sort_order" value="{{ values.sort_order|default(0) }}" min="-9999" max="9999" inputmode="numeric"></label>
    </div>
    <label class="lumen-check"><input type="checkbox" name="show_in_menu" value="1"{{ values.show_in_menu|default(false) ? ' checked' : '' }}> 상단 메뉴에 표시</label>
    <div class="lumen-form-actions">
      {% if not create %}<a class="lumen-btn lumen-btn-ghost" href="{{ url_for('admin.content.preview', {id: page_id}) }}" target="_blank" rel="noopener">미리보기</a>{% endif %}
      <a class="lumen-btn lumen-btn-ghost" href="{{ url_for(legal ? 'admin.terms' : 'admin.content') }}">취소</a>
      <button class="lumen-btn lumen-btn-primary" type="submit">{{ create ? '내용 만들기' : '변경사항 저장' }}</button>
    </div>
  </form>
  {% if not create %}
    <form class="lumen-danger-zone" method="post" action="{{ url_for('admin.content.delete', {id: page_id}) }}" onsubmit="return confirm('이 내용을 휴지통으로 옮길까요?')">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <div><strong>휴지통으로 이동</strong><p>공개가 중단되며 휴지통에서 다시 복원할 수 있습니다.</p></div>
      <button class="lumen-btn lumen-btn-danger" type="submit">휴지통으로 이동</button>
    </form>
  {% endif %}
</section>
{% endblock %}
{% block scripts %}{% include "admin/_editor.html.twig" %}{% endblock %}
