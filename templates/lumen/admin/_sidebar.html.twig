<aside class="admin-sidebar lumen-admin-sidebar" id="admin-sidebar">
  <div class="lumen-admin-sidebar-top">
    <a class="lumen-admin-brand" href="{{ url_for('admin.index') }}">
      <span class="lumen-admin-brand-mark" aria-hidden="true">◆</span>
      <span><strong>관리 콘솔</strong><small>{{ site.site_name }}</small></span>
    </a>
    <button class="admin-sidebar-toggle lumen-admin-toggle" type="button" aria-controls="admin-sidebar" aria-label="관리 메뉴 접기" aria-expanded="true" title="관리 메뉴 접기"><span aria-hidden="true">‹</span></button>
  </div>
  <nav class="admin-nav lumen-admin-nav" aria-label="관리 메뉴">
    <div class="admin-nav-group">
      <span class="admin-nav-label lumen-admin-nav-label">운영</span>
      <a class="admin-nav-item admin-nav-dashboard lumen-admin-nav-item" href="{{ url_for('admin.index') }}" title="대시보드"><span class="admin-nav-icon" aria-hidden="true">⌂</span><span>대시보드</span></a>
      <a class="admin-nav-item admin-nav-boards lumen-admin-nav-item" href="{{ url_for('admin.boards') }}" title="게시판 관리"><span class="admin-nav-icon" aria-hidden="true">▤</span><span>게시판</span></a>
      <a class="admin-nav-item admin-nav-content lumen-admin-nav-item" href="{{ url_for('admin.content') }}" title="내용 관리"><span class="admin-nav-icon" aria-hidden="true">□</span><span>내용</span></a>
      <a class="admin-nav-item admin-nav-members lumen-admin-nav-item" href="{{ url_for('admin.members') }}" title="회원 관리"><span class="admin-nav-icon" aria-hidden="true">♙</span><span>회원</span></a>
    </div>
    <div class="admin-nav-group">
      <span class="admin-nav-label lumen-admin-nav-label">설정</span>
      <a class="admin-nav-item admin-nav-site lumen-admin-nav-item" href="{{ url_for('admin.settings') }}" title="사이트 설정"><span class="admin-nav-icon" aria-hidden="true">◇</span><span>사이트</span></a>
      <a class="admin-nav-item admin-nav-mail lumen-admin-nav-item" href="{{ url_for('admin.mail') }}" title="메일 설정"><span class="admin-nav-icon" aria-hidden="true">✉</span><span>메일</span></a>
      <a class="admin-nav-item admin-nav-legal lumen-admin-nav-item" href="{{ url_for('admin.terms') }}" title="약관 관리"><span class="admin-nav-icon" aria-hidden="true">§</span><span>약관</span></a>
      <a class="admin-nav-item admin-nav-security lumen-admin-nav-item" href="{{ url_for('admin.password') }}" title="계정 보안"><span class="admin-nav-icon" aria-hidden="true">○</span><span>보안</span></a>
    </div>
  </nav>
  <a class="admin-site-link lumen-admin-site-link" href="{{ url_for('boards.index') }}" title="사이트 보기"><span>사이트 보기</span><span aria-hidden="true">↗</span></a>
  <div class="admin-account lumen-admin-account">
    <span class="admin-account-name">{{ current_user.display_name }}</span>
    <button class="theme-toggle lumen-theme-toggle" type="button" aria-label="다크 모드로 전환" title="다크 모드로 전환"><span aria-hidden="true">☾</span></button>
    <form class="logout-form" method="post" action="{{ url_for('auth.logout') }}">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <button class="logout-button lumen-btn lumen-btn-ghost" type="submit" title="로그아웃"><span class="admin-logout-icon" aria-hidden="true">↪</span><span class="admin-logout-label">로그아웃</span></button>
    </form>
  </div>
</aside>
