{% extends "admin/layout.html.twig" %}
{% block title %}약관 관리 · {{ site.site_name }}{% endblock %}
{% block admin_section %}legal{% endblock %}
{% block body %}
{% set ready = legal.terms and legal.terms.status == 'published' and legal.privacy and legal.privacy.status == 'published' %}
<nav class="lumen-admin-crumb" aria-label="현재 위치">
  <a href="{{ url_for('admin.index') }}">관리</a><span>/</span><span>약관</span>
</nav>
<header class="lumen-admin-head">
  <div>
    <h1>약관 관리</h1>
    <p class="lumen-lead">회원가입에 연결되는 이용약관과 개인정보 처리방침을 관리합니다.</p>
  </div>
  <form method="post" action="{{ url_for('admin.terms.setup') }}">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <button class="lumen-btn lumen-btn-ghost" type="submit">누락된 초안 만들기</button>
  </form>
</header>
{% if query.created|default('') == '1' %}<p class="lumen-notice lumen-notice-success">약관 초안을 준비했습니다. 운영 정보에 맞게 수정한 뒤 공개하세요.</p>{% endif %}
{% if query.saved|default('') == '1' %}<p class="lumen-notice lumen-notice-success">약관을 저장했습니다.</p>{% endif %}
{% if query.deleted|default('') == '1' %}<p class="lumen-notice lumen-notice-success">약관을 삭제했습니다.</p>{% endif %}
{% if ready %}
  <p class="lumen-notice lumen-notice-success">필수 약관이 모두 공개되어 회원가입에 연결되어 있습니다.</p>
{% else %}
  <p class="lumen-notice lumen-notice-warn">두 항목을 검토하고 모두 공개하면 회원가입 링크와 필수 동의 항목이 자동으로 활성화됩니다.</p>
{% endif %}
<section class="lumen-panel">
  <div class="lumen-table-wrap">
    <table class="lumen-table">
      <thead><tr><th>구분</th><th>공개 주소</th><th>상태</th><th>수정일</th><th>관리</th></tr></thead>
      <tbody>
        {% for type, label in {'service':'이용약관','privacy':'개인정보 처리방침'} %}
          {% set page = type == 'service' ? legal.terms : legal.privacy %}
          <tr>
            <td><strong>{{ label }}</strong></td>
            {% if page %}
              <td class="lumen-table-meta">/terms/{{ type }}</td>
              <td><span class="lumen-status-pill {{ page.status == 'published' ? 'is-active' : 'is-blocked' }}">{{ page.status == 'published' ? '공개' : '초안' }}</span></td>
              <td class="lumen-table-meta">{{ page.updated_at|date('Y.m.d') }}</td>
              <td>
                <div class="lumen-row-actions">
                  <a class="lumen-btn lumen-btn-sm lumen-btn-ghost" href="{{ url_for('admin.terms.preview', {type: type}) }}" target="_blank" rel="noopener">미리보기</a>
                  <a class="lumen-btn lumen-btn-sm lumen-btn-ghost" href="{{ url_for('admin.terms.edit', {type: type}) }}">수정</a>
                </div>
              </td>
            {% else %}
              <td class="lumen-table-meta">/terms/{{ type }}</td>
              <td><span class="lumen-status-pill is-blocked">미생성</span></td>
              <td class="lumen-table-meta">-</td>
              <td><span class="muted">초안을 만들어 주세요.</span></td>
            {% endif %}
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</section>
<p class="lumen-form-help">초안은 일반적인 시작 문구입니다. 실제 운영자 정보와 개인정보 처리 현황에 맞게 수정하고 필요하면 법률 전문가의 검토를 받으세요.</p>
{% endblock %}
