{% extends "layout.html.twig" %}
{% import _self as pager %}
{% macro pageLink(board, query, p, label) %}
  <a href="{{ url_for('posts.index', {'key': board.board_key}) }}?page={{ p }}{% if query.q %}&amp;q={{ query.q|url_encode }}{% endif %}{% if query.category %}&amp;category={{ query.category|url_encode }}{% endif %}" aria-label="{{ p }} 페이지">{{ label|default(p) }}</a>
{% endmacro %}
{% block title %}{{ board.name }} · {{ site.site_name }}{% endblock %}
{% block body %}
<nav class="lumen-crumb" aria-label="현재 위치"><a href="{{ url_for('boards.index') }}">홈</a><span aria-hidden="true">/</span><span>{{ board.name }}</span></nav>
<header class="lumen-page-head">
  <div><p class="lumen-section-kicker">{{ board.board_key }}</p><h1>{{ board.name }}</h1>{% if board.description %}<p class="lumen-lead">{{ board.description }}</p>{% endif %}</div>
  {% if can_write %}<a class="lumen-btn lumen-btn-primary" href="{{ url_for('posts.create', {'key': board.board_key}) }}"><span aria-hidden="true">＋</span> 글쓰기</a>{% endif %}
</header>
<form class="lumen-search" method="get" action="{{ url_for('posts.index', {'key': board.board_key}) }}" role="search">
  {% if board.use_category and board.categories is not empty %}
    <select name="category" aria-label="분류 선택"><option value="">전체 분류</option>{% for name in board.categories %}<option value="{{ name }}"{% if query.category == name %} selected{% endif %}>{{ name }}</option>{% endfor %}</select>
  {% endif %}
  <div class="lumen-search-field"><span class="lumen-search-icon" aria-hidden="true"></span><input type="search" name="q" value="{{ query.q }}" placeholder="제목이나 내용 검색" aria-label="게시글 검색"></div>
  <button class="lumen-btn lumen-btn-primary" type="submit">검색</button>
</form>
<section class="lumen-post-feed" aria-label="게시글 목록">
  {% if list.data is empty and list.notices is empty %}
    <div class="lumen-empty-state"><span class="lumen-empty-icon" aria-hidden="true">◇</span><p>조건에 맞는 글이 없습니다.</p></div>
  {% else %}
    {% for post in list.notices|merge(list.data) %}
      <article class="lumen-post-card{% if post.is_notice %} is-notice{% endif %}">
        <a class="lumen-post-card-link" href="{{ url_for('posts.show', {'id': post.id}) }}">
          <div class="lumen-post-card-main">
            <div class="lumen-post-card-tags">
              {% if post.is_notice %}<span class="lumen-tag">공지</span>{% endif %}
              {% if board.use_category and post.category %}<span class="lumen-tag lumen-tag-soft">{{ post.category }}</span>{% endif %}
              {% if post.is_secret %}<span class="lumen-tag lumen-tag-muted" title="비밀글">●</span>{% endif %}
            </div>
            <h2>{{ post.title }}</h2>
          </div>
          <div class="lumen-post-card-meta">
            <span>{{ post.author_name }}</span>
            <time datetime="{{ post.created_at }}">{{ post.created_at|slice(0, 10) }}</time>
            <span>조회 {{ post.view_count }}</span>
            {% if post.comment_count > 0 %}<span class="lumen-comment-badge">{{ post.comment_count }}</span>{% endif %}
            {% if post.file_count > 0 %}<span class="lumen-file-badge" title="첨부파일">📎</span>{% endif %}
          </div>
        </a>
      </article>
    {% endfor %}
  {% endif %}
</section>
{% if list.total_pages > 1 %}
  {% set window = 5 %}{% set start = max(1, list.page - window) %}{% set end = min(list.total_pages, list.page + window) %}
  <nav class="pagination lumen-pagination" aria-label="페이지 이동">
    {% if start > 1 %}{{ pager.pageLink(board, query, 1) }}{% if start > 2 %}<span class="muted">…</span>{% endif %}{% endif %}
    {% for p in start..end %}{% if p == list.page %}<strong aria-current="page">{{ p }}</strong>{% else %}{{ pager.pageLink(board, query, p) }}{% endif %}{% endfor %}
    {% if end < list.total_pages %}{% if end < list.total_pages - 1 %}<span class="muted">…</span>{% endif %}{{ pager.pageLink(board, query, list.total_pages) }}{% endif %}
  </nav>
{% endif %}
{% endblock %}
