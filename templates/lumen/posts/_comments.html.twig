<ul class="lumen-comment-list{% if nested|default(false) %} lumen-comment-children{% endif %}">
{% for comment in nodes %}
  <li class="lumen-comment">
    <div class="lumen-comment-head">
      {% if not comment.deleted %}<span class="lumen-comment-author">{{ comment.author_name }}</span>{% else %}<span class="muted">삭제된 댓글</span>{% endif %}
      <time datetime="{{ comment.created_at }}">{{ comment.created_at }}</time>
      {% if comment.is_secret %}<span class="lumen-tag lumen-tag-muted" title="비밀 댓글">●</span>{% endif %}
    </div>
    <p class="lumen-comment-body">{{ comment.content|nl2br }}</p>
    {% if comment.children is not empty %}
      {% include 'posts/_comments.html.twig' with {'nodes': comment.children, 'nested': true} only %}
    {% endif %}
  </li>
{% endfor %}
</ul>
