<body class="{% block body_class %}theme-lumen{% endblock %}">
{% block site_header %}{% if 'admin-page' not in block('body_class')|trim %}<header class="site-header lumen-header"><div class="lumen-glow" aria-hidden="true"></div><div class="header-inner lumen-bar"><a class="lumen-brand" href="{{ url_for('boards.index') }}" aria-label="{{ site.site_name }} 홈"><span class="lumen-brand-icon" aria-hidden="true"><svg viewBox="0 0 32 32" width="32" height="32" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="16" cy="16" r="14" stroke="currentColor" stroke-width="1.5" opacity=".35"/><path d="M8 20c3-6 6-9 8-9s5 3 8 9" stroke="url(#lumenGrad)" stroke-width="2.5" stroke-linecap="round"/><defs><linearGradient id="lumenGrad" x1="8" y1="20" x2="24" y2="11"><stop stop-color="#5eead4"/><stop offset="1" stop-color="#a78bfa"/></linearGradient></defs></svg></span><span class="lumen-brand-text"><strong>{{ site.site_name }}</strong><small>{{ site.site_tagline ?: '함께 만드는 이야기' }}</small></span></a><nav class="lumen-nav" aria-label="주요 메뉴"><a class="lumen-nav-link" href="{{ url_for('boards.index') }}">홈</a>{% for item in site_menu %}<a class="lumen-nav-link" href="{{ url_for('content.show', {slug: item.slug}) }}">{{ item.title }}</a>{% endfor %}</nav><div class="lumen-actions">{% if current_user.is_guest %}<a class="lumen-btn lumen-btn-ghost" href="{{ url_for('auth.login') }}">로그인</a>{% if registration_available %}<a class="lumen-btn lumen-btn-primary" href="{{ url_for('auth.register') }}">시작하기</a>{% endif %}{% else %}<span class="lumen-user" title="{{ current_user.display_name }}">{{ current_user.display_name }}</span>{% if current_user.is_admin %}<a class="lumen-btn lumen-btn-ghost" href="{{ url_for('admin.index') }}">관리</a>{% endif %}<form class="logout-form" method="post" action="{{ url_for('auth.logout') }}"><input type="hidden" name="csrf_token" value="{{ csrf_token }}"><button class="lumen-btn lumen-btn-ghost logout-button" type="submit">로그아웃</button></form>{% endif %}<button class="theme-toggle lumen-theme-toggle" type="button" aria-label="다크 모드로 전환" title="다크 모드로 전환"><span aria-hidden="true">☾</span></button></div></div></header>{% endif %}{% endblock %}
<main>{% if 'admin-page' in block('body_class')|trim %}<div class="admin-shell" data-admin-page="{{ block('admin_section')|default('dashboard')|trim }}">{% include 'admin/_sidebar.html.twig' %}<div class="admin-content">{% block body %}{% endblock %}</div></div>{% else %}<div class="lumen-shell">{% block public_body %}{{ block('body') }}{% endblock %}</div>{% endif %}</main>
{% block site_footer %}{% if 'admin-page' not in block('body_class')|trim %}<footer class="site-footer lumen-footer"><div class="lumen-footer-grid"><div class="lumen-footer-brand"><strong>{{ site.site_name }}</strong><p>{{ site.site_tagline }}</p></div><nav class="lumen-footer-links" aria-label="바로가기"><a href="{{ url_for('boards.index') }}">커뮤니티</a>{% for item in site_menu|slice(0, 3) %}<a href="{{ url_for('content.show', {slug: item.slug}) }}">{{ item.title }}</a>{% endfor %}</nav>{% if legal_documents %}<nav class="lumen-footer-legal" aria-label="정책"><a href="{{ url_for('terms.show', {type: 'service'}) }}">이용약관</a><a href="{{ url_for('terms.show', {type: 'privacy'}) }}">개인정보 처리방침</a></nav>{% endif %}</div><p class="lumen-footer-copy">© {{ "now"|date("Y") }} {{ site.site_name }}. 모든 이야기는 커뮤니티의 것입니다.</p></footer>{% endif %}{% endblock %}
<script>
(function(){
  var root=document.documentElement,button=document.querySelector('.theme-toggle'),icon=button?button.querySelector('span'):null,meta=document.querySelector('meta[name="theme-color"]');
  function isDark(){return root.dataset.theme==='dark'||(!root.dataset.theme&&window.matchMedia('(prefers-color-scheme: dark)').matches)}
  function sync(){var dark=isDark();if(button&&icon){icon.textContent=dark?'☀':'☾';button.setAttribute('aria-label',dark?'라이트 모드로 전환':'다크 모드로 전환');button.title=button.getAttribute('aria-label')}if(meta){meta.content=dark?'#0c1222':'#eef2ff'}}
  if(button){button.addEventListener('click',function(){var theme=isDark()?'light':'dark';root.dataset.theme=theme;try{localStorage.setItem('{{ GNUCMS_ID }}-theme',theme)}catch(e){}sync()})}
  var sidebarToggle=document.querySelector('.admin-sidebar-toggle');
  function syncSidebar(){if(!sidebarToggle){return}var collapsed=root.dataset.adminSidebar==='collapsed';sidebarToggle.setAttribute('aria-expanded',collapsed?'false':'true');sidebarToggle.setAttribute('aria-label',collapsed?'관리 메뉴 펼치기':'관리 메뉴 접기');sidebarToggle.title=sidebarToggle.getAttribute('aria-label')}
  if(sidebarToggle){sidebarToggle.addEventListener('click',function(){var collapsed=root.dataset.adminSidebar==='collapsed';if(collapsed){delete root.dataset.adminSidebar}else{root.dataset.adminSidebar='collapsed'}try{localStorage.setItem('{{ GNUCMS_ID }}-admin-sidebar',collapsed?'expanded':'collapsed')}catch(e){}syncSidebar()});syncSidebar()}
  sync();
})();
</script>
{% block scripts %}{% endblock %}
</body>
</html>
