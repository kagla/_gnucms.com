{% extends "layout.html.twig" %}
{% import '_icons.html.twig' as ico %}

{% block title %}{{ site.site_name }} · {{ site.site_tagline }}{% endblock %}
{% block nav_section %}home{% endblock %}

{% block body %}
<!-- 오늘의집 스타일 프로모션 히어로 배너 -->
<section class="home-promo" aria-label="메인 프로모션">
  <div class="home-promo-content">
    <div class="home-promo-badge">
      {{ ico.i('sparkle', 14) }} 오늘의 인기 이야기
    </div>
    <h1 class="home-promo-title">{{ site.home_title ?: site.site_name }}</h1>
    <p class="home-promo-desc">{{ site.home_intro ?: site.site_tagline }}</p>
    <div class="home-promo-actions">
      {% if boards is not empty %}
        <a class="btn btn-white" href="{{ url_for('posts.index', {'key': boards[0].board_key}) }}">
          {{ ico.i('compass', 16) }} 이야기 둘러보기
        </a>
      {% endif %}
      {% if current_user.is_guest and registration_available %}
        <a class="btn btn-ghost" style="color: #ffffff; border: 1px solid rgba(255,255,255,0.4);" href="{{ url_for('auth.register') }}">
          {{ ico.i('user', 16) }} 회원가입
        </a>
      {% endif %}
    </div>
  </div>
  <div class="home-promo-art" aria-hidden="true"></div>
</section>

<!-- 퀵 카테고리 네비게이션 그리드 -->
{% if boards is not empty %}
  <nav class="quick-nav" aria-label="게시판 바로가기">
    {% for board in boards %}
      <a class="quick-nav-item" href="{{ url_for('posts.index', {'key': board.board_key}) }}">
        <span class="quick-nav-icon" data-tone="{{ loop.index0 % 6 }}" aria-hidden="true">
          {{ board.name|slice(0, 1) }}
        </span>
        <span class="quick-nav-label">{{ board.name }}</span>
      </a>
    {% endfor %}
  </nav>
{% endif %}

<!-- 게시판별 피드 섹션 -->
{% if boards is empty %}
  <div class="card" style="text-align: center; padding: 4rem 2rem; margin-top: 2rem;">
    <div style="font-size: 3rem; margin-bottom: 1rem; color: var(--text-hint);">{{ ico.i('house', 56) }}</div>
    <h2 style="font-size: 1.35rem; font-weight: 800; margin-bottom: 0.5rem;">아직 개설된 게시판이 없습니다</h2>
    <p style="color: var(--text-muted); font-size: 0.92rem; margin-bottom: 1.5rem;">새로운 소통 공간을 관리 콘솔에서 만들어 보세요.</p>
    {% if not current_user.is_guest and current_user.is_admin %}
      <div>
        <a class="btn btn-primary" href="{{ url_for('admin.boards.create') }}">
          {{ ico.i('plus', 16) }} 첫 게시판 개설하기
        </a>
      </div>
    {% endif %}
  </div>
{% else %}
  {% for board in boards %}
    <section style="margin-bottom: 3.5rem;" aria-labelledby="board-heading-{{ board.board_key }}">
      <div class="section-head">
        <div>
          <h2 class="section-title" id="board-heading-{{ board.board_key }}">{{ board.name }}</h2>
          <p class="section-sub">{{ board.description ?: '다양한 생각과 꿀팁을 함께 나눠보세요.' }}</p>
        </div>
        <a class="section-more" href="{{ url_for('posts.index', {'key': board.board_key}) }}">
          전체보기 {{ ico.i('chevron-right', 14) }}
        </a>
      </div>

      {% if board.latest_posts is empty %}
        <div class="card" style="padding: 2.5rem; text-align: center; background: var(--base-100); border: 1px dashed var(--line);">
          <p style="color: var(--text-muted); font-size: 0.92rem;">아직 등록된 게시글이 없습니다. 첫 이야기를 들려주세요!</p>
        </div>
      {% else %}
        <div class="feed-grid">
          {% for post in board.latest_posts %}
            <a class="feed-card" href="{{ url_for('posts.show', {'id': post.id}) }}">
              <div class="feed-cover" data-tone="{{ post.id % 6 }}">
                <span class="feed-cover-badge">
                  {% if post.is_notice %}공지{% elseif post.category %}{{ post.category }}{% else %}{{ board.name }}{% endif %}
                </span>
                <span aria-hidden="true">{{ post.title|slice(0, 1) }}</span>
              </div>
              <div class="feed-body">
                <h3 class="feed-title">{{ post.title }}</h3>
                <div class="feed-meta">
                  <span class="feed-author">
                    <span class="avatar avatar-xs">
                      <span class="avatar-inner" data-tone="{{ post.author_name|length % 6 }}" aria-hidden="true">
                        {{ post.author_name|slice(0, 1)|upper }}
                      </span>
                    </span>
                    <span>{{ post.author_name }}</span>
                  </span>
                  <div class="feed-stats">
                    <span class="feed-stat-item" title="조회수">
                      {{ ico.i('eye', 13) }} {{ post.view_count }}
                    </span>
                    <span class="feed-stat-item" title="댓글 수">
                      {{ ico.i('comment', 13) }} {{ post.comment_count }}
                    </span>
                  </div>
                </div>
              </div>
            </a>
          {% endfor %}
        </div>
      {% endif %}
    </section>
  {% endfor %}
{% endif %}
{% endblock %}
