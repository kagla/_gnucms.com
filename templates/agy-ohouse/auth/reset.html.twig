{% extends "layout.html.twig" %}
{% import '_icons.html.twig' as ico %}

{% block title %}새 비밀번호 설정 · {{ site.site_name }}{% endblock %}

{% block body %}
<div style="max-width: 440px; margin: 3rem auto;">
  <section class="card" style="padding: clamp(1.75rem, 5vw, 2.5rem);">
    <header style="text-align: center; margin-bottom: 2rem;">
      <span class="badge badge-soft" style="margin-bottom: 0.5rem;">New password</span>
      <h1 style="font-size: 1.75rem; font-weight: 900; letter-spacing: -0.04em; color: var(--text-main);">새 비밀번호 설정</h1>
      <p style="color: var(--text-muted); font-size: 0.88rem; margin-top: 0.35rem;">새롭게 사용할 비밀번호를 입력해 주세요.</p>
    </header>

    <form method="post" action="{{ url_for('auth.reset') }}" style="display: flex; flex-direction: column; gap: 1rem;">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <input type="hidden" name="token" value="{{ token }}">

      <div>
        <label class="label"><span class="label-text" style="font-weight: 750;">새 비밀번호 <span style="font-size: 0.75rem; color: var(--text-muted);">(8자 이상)</span></span></label>
        <input class="input input-bordered" type="password" name="password" minlength="8" placeholder="8자 이상" autocomplete="new-password" required autofocus>
        {% if errors.password is defined %}<p class="badge badge-error-soft" style="margin-top: 0.4rem;">{{ errors.password }}</p>{% endif %}
      </div>

      <div>
        <label class="label"><span class="label-text" style="font-weight: 750;">비밀번호 확인</span></label>
        <input class="input input-bordered" type="password" name="password_confirmation" minlength="8" placeholder="새 비밀번호 다시 입력" autocomplete="new-password" required>
        {% if errors.password_confirmation is defined %}<p class="badge badge-error-soft" style="margin-top: 0.4rem;">{{ errors.password_confirmation }}</p>{% endif %}
      </div>

      {% if errors.token is defined %}
        <p class="badge badge-error-soft" style="margin-top: 0.4rem;">{{ errors.token }}</p>
      {% endif %}

      <button class="btn btn-primary btn-block" type="submit" style="margin-top: 0.5rem; height: 3rem;">
        {{ ico.i('check', 16) }} 비밀번호 변경 완료
      </button>
    </form>
  </section>
</div>
{% endblock %}
