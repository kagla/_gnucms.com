{% extends "layout.html.twig" %}
{% import '_icons.html.twig' as ico %}

{% block title %}이메일 인증 완료 · {{ site.site_name }}{% endblock %}

{% block body %}
<div style="max-width: 440px; margin: 3.5rem auto; text-align: center;">
  <section class="card" style="padding: clamp(2rem, 5vw, 3rem);">
    <div style="color: var(--success); margin-bottom: 1rem;">
      {{ ico.i('check-circle', 56) }}
    </div>
    <span class="badge badge-success-soft" style="align-self: center; margin-bottom: 0.5rem;">Welcome</span>
    <h1 style="font-size: 1.75rem; font-weight: 900; letter-spacing: -0.04em; color: var(--text-main); margin-bottom: 0.5rem;">인증이 완료되었습니다</h1>
    <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.6; margin-bottom: 2rem;">이제 로그인하여 소통과 나눔을 시작하세요.</p>
    <a class="btn btn-primary btn-block" href="{{ url_for('auth.login') }}">로그인하기</a>
  </section>
</div>
{% endblock %}
