{% extends "layout.html.twig" %}
{% import '_icons.html.twig' as ico %}

{% block title %}로그인 · {{ site.site_name }}{% endblock %}

{% block body %}
<div style="max-width: 440px; margin: 3rem auto;">
  <section class="card" style="padding: clamp(1.75rem, 5vw, 2.5rem);">
    <header style="text-align: center; margin-bottom: 2rem;">
      <span class="badge badge-soft" style="margin-bottom: 0.5rem;">Welcome</span>
      <h1 style="font-size: 1.75rem; font-weight: 900; letter-spacing: -0.04em; color: var(--text-main);">로그인</h1>
      <p style="color: var(--text-muted); font-size: 0.88rem; margin-top: 0.35rem;">{{ site.site_name }}에서 따뜻한 일상을 나누세요.</p>
    </header>

    <form method="post" action="{{ url_for('auth.login') }}" style="display: flex; flex-direction: column; gap: 1rem;">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

      <div>
        <label class="label"><span class="label-text" style="font-weight: 750;">이메일</span></label>
        <input class="input input-bordered" type="email" name="email" value="{{ values.email|default('') }}" placeholder="example@domain.com" autocomplete="email" required autofocus>
        {% if errors.email is defined %}<p class="badge badge-error-soft" style="margin-top: 0.4rem;">{{ errors.email }}</p>{% endif %}
      </div>

      <div>
        <label class="label"><span class="label-text" style="font-weight: 750;">비밀번호</span></label>
        <input class="input input-bordered" type="password" name="password" placeholder="비밀번호 입력" autocomplete="current-password" required>
        <div style="text-align: right; margin-top: 0.4rem;">
          <a href="{{ url_for('auth.forgot') }}" style="font-size: 0.78rem; color: var(--text-muted); font-weight: 700;">비밀번호를 잊으셨나요?</a>
        </div>
      </div>

      <button class="btn btn-primary btn-block" type="submit" style="margin-top: 0.5rem; height: 3rem;">
        {{ ico.i('user', 16) }} 로그인
      </button>
    </form>

    {% include "auth/_social.html.twig" %}

    <div style="text-align: center; margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid var(--line); font-size: 0.88rem; color: var(--text-muted);">
      아직 회원이 아니신가요?
      <a href="{{ url_for('auth.register') }}" style="color: var(--primary); font-weight: 800; margin-left: 0.35rem;">회원가입</a>
    </div>
  </section>
</div>
{% endblock %}
