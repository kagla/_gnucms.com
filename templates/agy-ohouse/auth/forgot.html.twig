{% extends "layout.html.twig" %}
{% import '_icons.html.twig' as ico %}

{% block title %}비밀번호 찾기 · {{ site.site_name }}{% endblock %}

{% block body %}
<div style="max-width: 440px; margin: 3rem auto;">
  <section class="card" style="padding: clamp(1.75rem, 5vw, 2.5rem);">
    <header style="text-align: center; margin-bottom: 2rem;">
      <span class="badge badge-soft" style="margin-bottom: 0.5rem;">Password recovery</span>
      <h1 style="font-size: 1.75rem; font-weight: 900; letter-spacing: -0.04em; color: var(--text-main);">비밀번호 찾기</h1>
      <p style="color: var(--text-muted); font-size: 0.88rem; margin-top: 0.35rem;">가입하신 이메일로 비밀번호 재설정 링크를 보내드립니다.</p>
    </header>

    <form method="post" action="{{ url_for('auth.forgot') }}" style="display: flex; flex-direction: column; gap: 1.25rem;">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

      <div>
        <label class="label"><span class="label-text" style="font-weight: 750;">이메일</span></label>
        <input class="input input-bordered" type="email" name="email" placeholder="가입했던 이메일 주소" autocomplete="email" required autofocus>
      </div>

      <button class="btn btn-primary btn-block" type="submit" style="height: 3rem;">
        {{ ico.i('mail', 16) }} 재설정 링크 받기
      </button>
    </form>

    <div style="text-align: center; margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid var(--line); font-size: 0.88rem;">
      <a href="{{ url_for('auth.login') }}" style="color: var(--text-muted); font-weight: 750;">로그인으로 돌아가기</a>
    </div>
  </section>
</div>
{% endblock %}
