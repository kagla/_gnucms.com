{% extends "layout.html.twig" %}
{% import '_icons.html.twig' as ico %}

{% block title %}확인 메일 전송 · {{ site.site_name }}{% endblock %}

{% block body %}
<div style="max-width: 460px; margin: 3.5rem auto; text-align: center;">
  <section class="card" style="padding: clamp(2rem, 5vw, 3rem);">
    <div style="color: var(--primary); margin-bottom: 1rem;">
      {{ ico.i('mail', 56) }}
    </div>
    <span class="badge badge-soft" style="align-self: center; margin-bottom: 0.5rem;">메일 전송 완료</span>
    <h1 style="font-size: 1.75rem; font-weight: 900; letter-spacing: -0.04em; color: var(--text-main); margin-bottom: 0.5rem;">메일함을 확인해 주세요</h1>
    <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.6; margin-bottom: 2rem;">보내드린 확인 링크를 열면 계정 연결과 로그인이 완료됩니다. 링크는 30분 동안 유효합니다.</p>
    <a class="btn btn-outline btn-block" href="{{ url_for('boards.index') }}">홈으로 이동</a>
  </section>
</div>
{% endblock %}
