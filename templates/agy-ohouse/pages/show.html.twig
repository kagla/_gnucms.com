{% extends "layout.html.twig" %}
{% import '_icons.html.twig' as ico %}

{% block title %}{{ page.title }} · {{ site.site_name }}{% endblock %}
{% block meta_description %}<meta name="description" content="{{ page.seo_description ?: site.site_tagline }}">{% endblock %}

{% block body %}
<div class="article-wrap">
  {% if preview %}
    <div class="alert alert-info" style="margin-bottom: 1.5rem;">
      <span style="font-size: 1.25rem;">{{ ico.i('info', 20) }}</span>
      <div style="flex: 1;">
        <h3 style="font-weight: 800; font-size: 0.95rem;">미리보기 모드</h3>
        <p style="font-size: 0.85rem;">{{ page.status == 'published' ? '공개된 페이지의 미리보기입니다.' : '아직 공개되지 않은 초안 미리보기입니다.' }}</p>
      </div>
      <a class="btn btn-sm btn-primary" href="{{ url_for('admin.content.edit', {id: page.id}) }}">
        {{ ico.i('edit', 14) }} 편집으로 돌아가기
      </a>
    </div>
  {% endif %}

  <div class="breadcrumbs" style="font-size: 0.82rem; color: var(--text-muted); margin-bottom: 1.25rem;">
    <a href="{{ url_for('boards.index') }}">홈</a>
    <span style="margin-inline: 0.35rem; color: var(--text-hint);">›</span>
    <span style="color: var(--text-main); font-weight: 700;" aria-current="page">{{ page.title }}</span>
  </div>

  <article class="card" style="padding: clamp(1.5rem, 4vw, 3rem); margin-bottom: 3rem;">
    <header style="padding-bottom: 1.5rem; border-bottom: 1px solid var(--line); margin-bottom: 2rem;">
      <span class="badge badge-soft" style="margin-bottom: 0.5rem;">{{ site.site_name }}</span>
      <h1 style="font-size: 2rem; font-weight: 900; letter-spacing: -0.04em; color: var(--text-main); line-height: 1.3;">{{ page.title }}</h1>
      {% if page.seo_description %}
        <p style="color: var(--text-muted); font-size: 0.95rem; margin-top: 0.5rem; line-height: 1.6;">{{ page.seo_description }}</p>
      {% endif %}
    </header>

    <div class="article-body" style="font-size: 1rem; line-height: 1.8;">
      {{ page.content|cms_html }}
    </div>
  </article>
</div>
{% endblock %}
