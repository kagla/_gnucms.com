{% extends "layout.html.twig" %}
{% import '_icons.html.twig' as ico %}

{% block title %}커뮤니티 · {{ site.site_name }}{% endblock %}
{% block nav_section %}home{% endblock %}

{% block body %}
<div class="breadcrumbs" style="font-size: 0.82rem; color: var(--text-muted); margin-bottom: 1.25rem;">
  <span style="color: var(--primary); font-weight: 750;">커뮤니티 홈</span>
</div>

<header class="section-head" style="margin-bottom: 2rem;">
  <div>
    <h1 style="font-size: 2rem; font-weight: 900; letter-spacing: -0.04em; color: var(--text-main);">모든 이야기 모음</h1>
    <p class="section-sub">관심 있는 주제를 찾아 사람들과 즐겁게 소통해 보세요.</p>
  </div>
</header>

{% if boards is empty %}
  <div class="card" style="text-align: center; padding: 4rem 2rem;">
    <div style="font-size: 3rem; margin-bottom: 1rem; color: var(--text-hint);">{{ ico.i('folder', 56) }}</div>
    <h2 style="font-size: 1.25rem; font-weight: 800; margin-bottom: 0.5rem;">아직 개설된 게시판이 없습니다</h2>
    <p style="color: var(--text-muted); font-size: 0.92rem;">관리 콘솔에서 첫 번째 게시판을 만들어 보세요.</p>
  </div>
{% else %}
  <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5rem;">
    {% for board in boards %}
      <section class="card card-hover" style="display: flex; flex-direction: column;">
        <a href="{{ url_for('posts.index', {'key': board.board_key}) }}" style="padding: 1.5rem 1.5rem 1rem; display: block;">
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.5rem;">
            <span class="badge badge-soft">{{ board.board_key }}</span>
            <span style="font-size: 0.78rem; color: var(--text-hint);">바로가기 {{ ico.i('chevron-right', 12) }}</span>
          </div>
          <h2 style="font-size: 1.3rem; font-weight: 800; color: var(--text-main); margin-bottom: 0.4rem;">{{ board.name }}</h2>
          <p style="font-size: 0.88rem; color: var(--text-sub); line-height: 1.5; min-height: 2.7rem;">{{ board.description ?: '새로운 이야기와 일상을 함께 나눠보세요.' }}</p>
        </a>

        <!-- 최신 글 목록 블록 -->
        <div style="background-color: var(--base-200); border-top: 1px solid var(--line); padding: 1rem 1.25rem; margin-top: auto;">
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.6rem;">
            <span style="font-size: 0.75rem; font-weight: 800; color: var(--text-hint); text-transform: uppercase;">최신 등록글</span>
            <a href="{{ url_for('posts.index', {'key': board.board_key}) }}" style="font-size: 0.78rem; font-weight: 750; color: var(--primary);">더보기</a>
          </div>

          {% if board.latest_posts is empty %}
            <p style="font-size: 0.82rem; color: var(--text-hint); text-align: center; padding: 1rem 0;">등록된 글이 없습니다</p>
          {% else %}
            <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.45rem;">
              {% for post in board.latest_posts %}
                <li>
                  <a href="{{ url_for('posts.show', {'id': post.id}) }}" style="display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; font-size: 0.85rem; color: var(--text-main); padding: 0.2rem 0;">
                    <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 600; flex: 1;">
                      {% if post.is_notice %}<span class="badge badge-primary badge-sm" style="margin-right: 0.35rem;">공지</span>{% endif %}
                      {{ post.title }}
                      {% if post.comment_count > 0 %}<span style="color: var(--primary); font-size: 0.75rem; font-weight: 800; margin-left: 0.25rem;">[{{ post.comment_count }}]</span>{% endif %}
                    </span>
                    <time style="font-size: 0.72rem; color: var(--text-hint); flex: 0 0 auto;">{{ post.created_at|date('m.d') }}</time>
                  </a>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      </section>
    {% endfor %}
  </div>
{% endif %}
{% endblock %}
