{% extends "admin/layout.html.twig" %}
{% import '_icons.html.twig' as ico %}

{% block title %}{{ values.title }} 수정 · {{ site.site_name }}{% endblock %}
{% block admin_section %}legal{% endblock %}

{% block body %}
<div class="breadcrumbs" style="font-size: 0.82rem; color: var(--text-muted); margin-bottom: 0.85rem;">
  <a href="{{ url_for('admin.index') }}">관리 콘솔</a>
  <span style="margin-inline: 0.35rem; color: var(--text-hint);">›</span>
  <a href="{{ url_for('admin.terms') }}">약관 관리</a>
  <span style="margin-inline: 0.35rem; color: var(--text-hint);">›</span>
  <span style="color: var(--text-main); font-weight: 700;" aria-current="page">{{ values.title }}</span>
</div>

<section class="card" style="padding: clamp(1.5rem, 4vw, 2.5rem); margin-bottom: 2rem;">
  <div style="margin-bottom: 1.5rem; padding-bottom: 1rem; border-bottom: 1px solid var(--line);">
    <h1 style="font-size: 1.75rem; font-weight: 900; letter-spacing: -0.04em; color: var(--text-main);">{{ values.title }} 수정</h1>
    <p style="color: var(--text-muted); font-size: 0.88rem; margin-top: 0.25rem;">공개 주소는 <code style="background: var(--base-200); padding: 0.2rem 0.4rem; border-radius: 0.35rem; font-size: 0.78rem;">/terms/{{ type }}</code>로 고정되며, 공개 시 회원가입 화면에 자동 연결됩니다.</p>
  </div>

  <form method="post" action="{{ url_for('admin.terms.edit', {type: type}) }}" style="display: flex; flex-direction: column; gap: 1.25rem;">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <input type="hidden" name="image_key" value="{{ values.image_key }}">
    <input type="hidden" name="uploaded_images" value="{{ values.uploaded_images|default('') }}" data-uploaded-images>

    <div>
      <label class="label"><span class="label-text" style="font-weight: 750;">약관 제목</span></label>
      <input class="input input-bordered" type="text" name="title" value="{{ values.title|default('') }}" maxlength="200" required autofocus>
      {% if errors.title is defined %}<p class="badge badge-error-soft" style="margin-top: 0.4rem;">{{ errors.title }}</p>{% endif %}
    </div>

    <div>
      <label class="label"><span class="label-text" style="font-weight: 750;">약관 본문</span></label>
      <textarea class="textarea textarea-bordered" id="content-editor" name="content" rows="18" placeholder="약관 내용을 작성해 주세요." data-cms-editor>{{ values.content|default('') }}</textarea>
      {% if errors.content is defined %}<p class="badge badge-error-soft" style="margin-top: 0.4rem;">{{ errors.content }}</p>{% endif %}
    </div>

    <div>
      <label class="label"><span class="label-text" style="font-weight: 750;">공개 상태</span></label>
      <select class="select select-bordered" name="status">
        <option value="draft"{{ values.status|default('draft') == 'draft' ? ' selected' : '' }}>초안</option>
        <option value="published"{{ values.status|default('draft') == 'published' ? ' selected' : '' }}>공개</option>
      </select>
    </div>

    <input type="hidden" name="sort_order" value="{{ values.sort_order|default(0) }}">

    <div style="display: flex; justify-content: flex-end; gap: 0.75rem; padding-top: 1rem; border-top: 1px solid var(--line);">
      <a class="btn btn-outline" href="{{ url_for('admin.terms.preview', {type: type}) }}" target="_blank" rel="noopener">
        {{ ico.i('eye', 15) }} 미리보기
      </a>
      <a class="btn btn-ghost" href="{{ url_for('admin.terms') }}">취소</a>
      <button class="btn btn-primary" type="submit">변경사항 저장</button>
    </div>
  </form>
</section>
{% endblock %}
{% block scripts %}{% include "admin/_editor.html.twig" %}{% endblock %}
