{% extends "admin/layout.html.twig" %}
{% import '_icons.html.twig' as ico %}

{% block title %}내용 관리 · {{ site.site_name }}{% endblock %}
{% block admin_section %}content{% endblock %}

{% block body %}
<div class="breadcrumbs" style="font-size: 0.82rem; color: var(--text-muted); margin-bottom: 0.85rem;">
  <a href="{{ url_for('admin.index') }}">관리 콘솔</a>
  <span style="margin-inline: 0.35rem; color: var(--text-hint);">›</span>
  <span style="color: var(--text-main); font-weight: 700;" aria-current="page">내용 관리</span>
</div>

<div class="section-head" style="margin-bottom: 1.5rem;">
  <div>
    <h1 style="font-size: 1.85rem; font-weight: 900; letter-spacing: -0.04em; color: var(--text-main);">내용 관리</h1>
    <p class="section-sub">사이트 소개나 안내 페이지를 작성하고 관리합니다.</p>
  </div>
  <div style="display: flex; gap: 0.5rem;">
    <a class="btn btn-outline" href="{{ url_for('admin.content.trash') }}">
      {{ ico.i('trash', 15) }} 휴지통{% if trash_count > 0 %} <span class="badge badge-sm badge-soft">{{ trash_count }}</span>{% endif %}
    </a>
    <a class="btn btn-primary" href="{{ url_for('admin.content.create') }}">
      {{ ico.i('plus', 16) }} 내용 만들기
    </a>
  </div>
</div>

{% if query.saved|default('') == '1' %}<div class="alert alert-success" style="margin-bottom: 1.25rem;">{{ ico.i('check-circle', 18) }}<span>내용을 저장했습니다.</span></div>{% endif %}
{% if query.deleted|default('') == '1' %}<div class="alert alert-success" style="margin-bottom: 1.25rem;">{{ ico.i('check-circle', 18) }}<span>내용을 휴지통으로 옮겼습니다.</span></div>{% endif %}

<section class="card">
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th>제목</th>
          <th>주소</th>
          <th>상태</th>
          <th>메뉴 표시</th>
          <th style="text-align: right;">관리</th>
        </tr>
      </thead>
      <tbody>
      {% for page in pages %}
        <tr>
          <td>
            {% if page.status == 'published' %}
              <a href="{{ url_for('content.show', {slug: page.slug}) }}" style="font-weight: 800; color: var(--text-main);" target="_blank">{{ page.title }}</a>
            {% else %}
              <span style="font-weight: 800;">{{ page.title }}</span>
            {% endif %}
          </td>
          <td><code style="background: var(--base-200); padding: 0.2rem 0.4rem; border-radius: 0.35rem; font-size: 0.78rem;">/content/{{ page.slug }}</code></td>
          <td>
            <span class="badge badge-sm {{ page.status == 'published' ? 'badge-success-soft' : 'badge-ghost' }}">
              {{ page.status == 'published' ? '공개' : '초안' }}
            </span>
          </td>
          <td>{{ page.show_in_menu ? '표시' : '숨김' }}</td>
          <td style="text-align: right;">
            <div class="join">
              <a class="btn btn-outline btn-sm join-item" href="{{ url_for('admin.content.preview', {id: page.id}) }}" target="_blank" rel="noopener">미리보기</a>
              <a class="btn btn-outline btn-sm join-item" href="{{ url_for('admin.content.edit', {id: page.id}) }}">수정</a>
            </div>
          </td>
        </tr>
      {% else %}
        <tr>
          <td colspan="5" style="text-align: center; padding: 3rem 1rem; color: var(--text-muted);">
            등록된 내용이 없습니다.
          </td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endblock %}
