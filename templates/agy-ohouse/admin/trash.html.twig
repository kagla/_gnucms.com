{% extends "admin/layout.html.twig" %}
{% import '_icons.html.twig' as ico %}

{% block title %}내용 휴지통 · {{ site.site_name }}{% endblock %}
{% block admin_section %}content{% endblock %}

{% block body %}
<div class="breadcrumbs" style="font-size: 0.82rem; color: var(--text-muted); margin-bottom: 0.85rem;">
  <a href="{{ url_for('admin.index') }}">관리 콘솔</a>
  <span style="margin-inline: 0.35rem; color: var(--text-hint);">›</span>
  <a href="{{ url_for('admin.content') }}">내용 관리</a>
  <span style="margin-inline: 0.35rem; color: var(--text-hint);">›</span>
  <span style="color: var(--text-main); font-weight: 700;" aria-current="page">휴지통</span>
</div>

<div class="section-head" style="margin-bottom: 1.5rem;">
  <div>
    <h1 style="font-size: 1.85rem; font-weight: 900; letter-spacing: -0.04em; color: var(--text-main);">내용 휴지통</h1>
    <p class="section-sub">삭제된 내용은 비공개되며 언제든 복원할 수 있습니다.</p>
  </div>
  <a class="btn btn-outline" href="{{ url_for('admin.content') }}">
    {{ ico.i('arrow-left', 15) }} 내용 관리로
  </a>
</div>

{% if query.restored|default('') == '1' %}<div class="alert alert-success" style="margin-bottom: 1.25rem;">{{ ico.i('check-circle', 18) }}<span>내용을 초안 상태로 복원했습니다.</span></div>{% endif %}
{% if query.deleted|default('') == '1' %}<div class="alert alert-success" style="margin-bottom: 1.25rem;">{{ ico.i('check-circle', 18) }}<span>내용을 완전히 삭제했습니다.</span></div>{% endif %}

<section class="card">
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th>제목</th>
          <th>주소</th>
          <th>삭제일시</th>
          <th style="text-align: right;">관리</th>
        </tr>
      </thead>
      <tbody>
      {% for page in pages %}
        <tr>
          <td style="font-weight: 800;">{{ page.title }}</td>
          <td><code style="background: var(--base-200); padding: 0.2rem 0.4rem; border-radius: 0.35rem; font-size: 0.78rem;">/content/{{ page.slug }}</code></td>
          <td style="font-size: 0.85rem; color: var(--text-muted);">{{ page.deleted_at|date('Y.m.d H:i') }}</td>
          <td style="text-align: right;">
            <div class="join">
              <form method="post" action="{{ url_for('admin.content.restore', {id: page.id}) }}" class="join-item">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                <button class="btn btn-outline btn-sm" type="submit">{{ ico.i('restore', 14) }} 복원</button>
              </form>
              <form method="post" action="{{ url_for('admin.content.permanent_delete', {id: page.id}) }}" class="join-item" onsubmit="return confirm('내용을 영구 삭제할까요? 되돌릴 수 없습니다.')">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                <button class="btn btn-error btn-outline btn-sm" type="submit">{{ ico.i('trash', 14) }} 삭제</button>
              </form>
            </div>
          </td>
        </tr>
      {% else %}
        <tr>
          <td colspan="4" style="text-align: center; padding: 3rem 1rem; color: var(--text-muted);">
            휴지통이 비어 있습니다.
          </td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endblock %}
