{% extends "admin/layout.html.twig" %}
{% import '_icons.html.twig' as ico %}

{% block title %}약관 관리 · {{ site.site_name }}{% endblock %}
{% block admin_section %}legal{% endblock %}

{% block body %}
{% set ready = legal.terms and legal.terms.status == 'published' and legal.privacy and legal.privacy.status == 'published' %}

<div class="breadcrumbs" style="font-size: 0.82rem; color: var(--text-muted); margin-bottom: 0.85rem;">
  <a href="{{ url_for('admin.index') }}">관리 콘솔</a>
  <span style="margin-inline: 0.35rem; color: var(--text-hint);">›</span>
  <span style="color: var(--text-main); font-weight: 700;" aria-current="page">약관 관리</span>
</div>

<div class="section-head" style="margin-bottom: 1.5rem;">
  <div>
    <h1 style="font-size: 1.85rem; font-weight: 900; letter-spacing: -0.04em; color: var(--text-main);">약관 관리</h1>
    <p class="section-sub">회원가입에 연동되는 이용약관 및 개인정보 처리방침을 관리합니다.</p>
  </div>
  <form method="post" action="{{ url_for('admin.terms.setup') }}">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <button class="btn btn-outline" type="submit">초안 일괄 생성</button>
  </form>
</div>

{% if query.created|default('') == '1' %}<div class="alert alert-success" style="margin-bottom: 1.25rem;">{{ ico.i('check-circle', 18) }}<span>약관 초안이 생성되었습니다. 내용 확인 후 공개해 주세요.</span></div>{% endif %}
{% if query.saved|default('') == '1' %}<div class="alert alert-success" style="margin-bottom: 1.25rem;">{{ ico.i('check-circle', 18) }}<span>약관을 저장했습니다.</span></div>{% endif %}
{% if query.deleted|default('') == '1' %}<div class="alert alert-success" style="margin-bottom: 1.25rem;">{{ ico.i('check-circle', 18) }}<span>약관을 삭제했습니다.</span></div>{% endif %}

{% if ready %}
  <div class="alert alert-success" style="margin-bottom: 1.5rem;">
    {{ ico.i('check-circle', 18) }}
    <span>필수 약관이 모두 공개되어 회원가입에 정상 연동 중입니다.</span>
  </div>
{% else %}
  <div class="alert alert-info" style="margin-bottom: 1.5rem;">
    {{ ico.i('info', 18) }}
    <span>이용약관과 개인정보 처리방침을 모두 공개하면 회원가입 동의 체크박스가 자동 활성화됩니다.</span>
  </div>
{% endif %}

<section class="card">
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th>구분</th>
          <th>공개 주소</th>
          <th>상태</th>
          <th>수정일</th>
          <th style="text-align: right;">관리</th>
        </tr>
      </thead>
      <tbody>
      {% for type, label in {'service':'이용약관','privacy':'개인정보 처리방침'} %}
        {% set page = type == 'service' ? legal.terms : legal.privacy %}
        <tr>
          <td style="font-weight: 800;">{{ label }}</td>
          <td><code style="background: var(--base-200); padding: 0.2rem 0.4rem; border-radius: 0.35rem; font-size: 0.78rem;">/content/{{ type == 'service' ? 'terms' : 'privacy' }}</code></td>
          {% if page %}
            <td>
              <span class="badge badge-sm {{ page.status == 'published' ? 'badge-success-soft' : 'badge-ghost' }}">
                {{ page.status == 'published' ? '공개' : '초안' }}
              </span>
            </td>
            <td style="font-size: 0.85rem; color: var(--text-muted);">{{ page.updated_at|date('Y.m.d') }}</td>
            <td style="text-align: right;">
              <div class="join">
                <a class="btn btn-outline btn-sm join-item" href="{{ url_for('admin.terms.preview', {type: type}) }}" target="_blank" rel="noopener">미리보기</a>
                <a class="btn btn-outline btn-sm join-item" href="{{ url_for('admin.terms.edit', {type: type}) }}">수정</a>
              </div>
            </td>
          {% else %}
            <td><span class="badge badge-error-soft badge-sm">미생성</span></td>
            <td>-</td>
            <td style="text-align: right;"><span style="color: var(--text-hint); font-size: 0.82rem;">초안을 만들어 주세요</span></td>
          {% endif %}
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endblock %}
