{% extends "admin/layout.html.twig" %}
{% import '_icons.html.twig' as ico %}

{% block title %}관리자 비밀번호 변경 · {{ site.site_name }}{% endblock %}
{% block admin_section %}security{% endblock %}

{% block body %}
<div class="breadcrumbs" style="font-size: 0.82rem; color: var(--text-muted); margin-bottom: 0.85rem;">
  <a href="{{ url_for('admin.index') }}">관리 콘솔</a>
  <span style="margin-inline: 0.35rem; color: var(--text-hint);">›</span>
  <span style="color: var(--text-main); font-weight: 700;" aria-current="page">계정 보안</span>
</div>

<section class="card" style="padding: clamp(1.5rem, 4vw, 2.5rem); max-width: 540px; margin-bottom: 2rem;">
  <div style="margin-bottom: 1.5rem; padding-bottom: 1rem; border-bottom: 1px solid var(--line);">
    <h1 style="font-size: 1.75rem; font-weight: 900; letter-spacing: -0.04em; color: var(--text-main);">비밀번호 변경</h1>
    <p style="color: var(--text-muted); font-size: 0.88rem; margin-top: 0.25rem;">새 비밀번호를 저장하면 모든 기기에서 다시 로그인해야 합니다.</p>
  </div>

  <form method="post" action="{{ url_for('admin.password') }}" style="display: flex; flex-direction: column; gap: 1.25rem;">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

    <div>
      <label class="label"><span class="label-text" style="font-weight: 750;">현재 비밀번호</span></label>
      <input class="input input-bordered" type="password" name="current_password" autocomplete="current-password" required autofocus>
      {% if errors.current_password is defined %}<p class="badge badge-error-soft" style="margin-top: 0.4rem;">{{ errors.current_password }}</p>{% endif %}
    </div>

    <div>
      <label class="label"><span class="label-text" style="font-weight: 750;">새 비밀번호 <span style="font-size: 0.75rem; color: var(--text-muted);">(8자 이상)</span></span></label>
      <input class="input input-bordered" type="password" name="password" minlength="8" autocomplete="new-password" required>
      {% if errors.password is defined %}<p class="badge badge-error-soft" style="margin-top: 0.4rem;">{{ errors.password }}</p>{% endif %}
    </div>

    <div>
      <label class="label"><span class="label-text" style="font-weight: 750;">새 비밀번호 확인</span></label>
      <input class="input input-bordered" type="password" name="password_confirmation" minlength="8" autocomplete="new-password" required>
      {% if errors.password_confirmation is defined %}<p class="badge badge-error-soft" style="margin-top: 0.4rem;">{{ errors.password_confirmation }}</p>{% endif %}
    </div>

    <div style="display: flex; justify-content: flex-end; gap: 0.75rem; padding-top: 1rem; border-top: 1px solid var(--line);">
      <a class="btn btn-ghost" href="{{ url_for('admin.index') }}">취소</a>
      <button class="btn btn-primary" type="submit">비밀번호 변경</button>
    </div>
  </form>
</section>
{% endblock %}
