{% import '_icons.html.twig' as ico %}

<aside class="admin-sidebar">
  <div class="admin-sidebar-head">
    <a class="brand" href="{{ url_for('admin.index') }}">
      <span class="brand-logo" aria-hidden="true" style="width: 2rem; height: 2rem;">{{ ico.i('dashboard', 16) }}</span>
      <span class="admin-sidebar-brand-name" style="font-size: 1.05rem;">관리 콘솔</span>
    </a>
    <button class="btn btn-ghost btn-square btn-sm admin-fold hide-sm" type="button" aria-expanded="true" aria-label="사이드바 접기">
      {{ ico.i('chevron-left', 16) }}
    </button>
  </div>

  <nav class="admin-nav" aria-label="관리 메뉴">
    <span class="admin-nav-label" style="padding: 0.5rem 0.5rem 0.2rem; font-size: 0.72rem; font-weight: 800; color: var(--text-hint); text-transform: uppercase;">서비스 운영</span>
    <a class="admin-nav-item{% if section == 'dashboard' %} active{% endif %}" href="{{ url_for('admin.index') }}" title="대시보드">
      <span class="admin-nav-icon">{{ ico.i('dashboard', 18) }}</span>
      <span>대시보드</span>
    </a>
    <a class="admin-nav-item{% if section == 'boards' %} active{% endif %}" href="{{ url_for('admin.boards') }}" title="게시판 관리">
      <span class="admin-nav-icon">{{ ico.i('board', 18) }}</span>
      <span>게시판 관리</span>
    </a>
    <a class="admin-nav-item{% if section == 'content' %} active{% endif %}" href="{{ url_for('admin.content') }}" title="내용 관리">
      <span class="admin-nav-icon">{{ ico.i('document', 18) }}</span>
      <span>내용 관리</span>
    </a>
    <a class="admin-nav-item{% if section == 'members' %} active{% endif %}" href="{{ url_for('admin.members') }}" title="회원 관리">
      <span class="admin-nav-icon">{{ ico.i('users', 18) }}</span>
      <span>회원 관리</span>
    </a>
    <a class="admin-nav-item{% if section == 'trash' %} active{% endif %}" href="{{ url_for('admin.trash') }}" title="휴지통">
      <span class="admin-nav-icon">{{ ico.i('trash', 18) }}</span>
      <span>휴지통</span>
    </a>

    <span class="admin-nav-label" style="padding: 1rem 0.5rem 0.2rem; font-size: 0.72rem; font-weight: 800; color: var(--text-hint); text-transform: uppercase;">시스템 설정</span>
    <a class="admin-nav-item{% if section == 'site' %} active{% endif %}" href="{{ url_for('admin.settings') }}" title="사이트 설정">
      <span class="admin-nav-icon">{{ ico.i('cog', 18) }}</span>
      <span>사이트 설정</span>
    </a>
    <a class="admin-nav-item{% if section == 'mail' %} active{% endif %}" href="{{ url_for('admin.mail') }}" title="메일 설정">
      <span class="admin-nav-icon">{{ ico.i('mail', 18) }}</span>
      <span>메일 설정</span>
    </a>
    <a class="admin-nav-item{% if section == 'legal' %} active{% endif %}" href="{{ url_for('admin.terms') }}" title="약관 관리">
      <span class="admin-nav-icon">{{ ico.i('scale', 18) }}</span>
      <span>약관 관리</span>
    </a>
    <a class="admin-nav-item{% if section == 'security' %} active{% endif %}" href="{{ url_for('admin.password') }}" title="계정 보안">
      <span class="admin-nav-icon">{{ ico.i('shield', 18) }}</span>
      <span>계정 보안</span>
    </a>
  </nav>

  <div style="padding-top: 1rem; border-top: 1px solid var(--line); margin-top: auto; display: flex; align-items: center; justify-content: space-between;">
    <div style="display: flex; align-items: center; gap: 0.5rem; min-width: 0;">
      <div class="avatar avatar-xs">
        <span class="avatar-inner" data-tone="{{ current_user.display_name|length % 6 }}">
          <span>{{ current_user.display_name|slice(0, 1)|upper }}</span>
        </span>
      </div>
      <span class="admin-sidebar-brand-name" style="font-size: 0.85rem; font-weight: 750; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{{ current_user.display_name }}</span>
    </div>
    <form method="post" action="{{ url_for('auth.logout') }}">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <button class="btn btn-ghost btn-square btn-sm" type="submit" aria-label="로그아웃" title="로그아웃">
        {{ ico.i('logout', 16) }}
      </button>
    </form>
  </div>
</aside>
