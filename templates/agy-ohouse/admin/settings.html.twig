{% extends "admin/layout.html.twig" %}
{% import '_icons.html.twig' as ico %}

{% block title %}사이트 설정 · {{ site.site_name }}{% endblock %}
{% block admin_section %}site{% endblock %}

{% block body %}
<div class="breadcrumbs" style="font-size: 0.82rem; color: var(--text-muted); margin-bottom: 0.85rem;">
  <a href="{{ url_for('admin.index') }}">관리 콘솔</a>
  <span style="margin-inline: 0.35rem; color: var(--text-hint);">›</span>
  <span style="color: var(--text-main); font-weight: 700;" aria-current="page">사이트 설정</span>
</div>

<section class="card" style="padding: clamp(1.5rem, 4vw, 2.5rem); margin-bottom: 2rem;">
  <div style="margin-bottom: 1.5rem; padding-bottom: 1rem; border-bottom: 1px solid var(--line);">
    <h1 style="font-size: 1.75rem; font-weight: 900; letter-spacing: -0.04em; color: var(--text-main);">사이트 설정</h1>
    <p style="color: var(--text-muted); font-size: 0.88rem; margin-top: 0.25rem;">사이트 이름, 소개, 홈 화면 문구 및 템플릿 테마를 설정합니다.</p>
  </div>

  {% if query.saved|default('') == '1' %}<div class="alert alert-success" style="margin-bottom: 1.25rem;">{{ ico.i('check-circle', 18) }}<span>사이트 설정을 저장했습니다.</span></div>{% endif %}

  <form method="post" action="{{ url_for('admin.settings') }}" style="display: flex; flex-direction: column; gap: 1.5rem;">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

    <!-- 사이트 기본 정보 -->
    <div style="display: flex; flex-direction: column; gap: 1rem;">
      <h2 style="font-size: 1.1rem; font-weight: 800; color: var(--text-main); border-left: 3px solid var(--primary); padding-left: 0.6rem;">사이트 기본 정보</h2>

      <div>
        <label class="label"><span class="label-text" style="font-weight: 750;">사이트 이름</span></label>
        <input class="input input-bordered" type="text" name="site_name" value="{{ values.site_name|default('') }}" maxlength="50" placeholder="예: 오늘의집, 내일의방" required>
        {% if errors.site_name is defined %}<p class="badge badge-error-soft" style="margin-top: 0.4rem;">{{ errors.site_name }}</p>{% endif %}
      </div>

      <div>
        <label class="label"><span class="label-text" style="font-weight: 750;">짧은 소개 (슬로건)</span></label>
        <input class="input input-bordered" type="text" name="site_tagline" value="{{ values.site_tagline|default('') }}" maxlength="120" placeholder="예: 공간의 이야기를 나누는 라이프스타일 커뮤니티" required>
        {% if errors.site_tagline is defined %}<p class="badge badge-error-soft" style="margin-top: 0.4rem;">{{ errors.site_tagline }}</p>{% endif %}
      </div>
    </div>

    <!-- 홈 화면 문구 -->
    <div style="display: flex; flex-direction: column; gap: 1rem;">
      <h2 style="font-size: 1.1rem; font-weight: 800; color: var(--text-main); border-left: 3px solid var(--primary); padding-left: 0.6rem;">홈 화면 문구</h2>

      <div>
        <label class="label"><span class="label-text" style="font-weight: 750;">홈 메인 제목</span></label>
        <input class="input input-bordered" type="text" name="home_title" value="{{ values.home_title|default('') }}" maxlength="120" placeholder="홈 프로모션 배너 제목" required>
        {% if errors.home_title is defined %}<p class="badge badge-error-soft" style="margin-top: 0.4rem;">{{ errors.home_title }}</p>{% endif %}
      </div>

      <div>
        <label class="label"><span class="label-text" style="font-weight: 750;">홈 메인 소개</span></label>
        <textarea class="textarea textarea-bordered" name="home_intro" rows="3" maxlength="500" placeholder="홈 화면 소개글" required>{{ values.home_intro|default('') }}</textarea>
        {% if errors.home_intro is defined %}<p class="badge badge-error-soft" style="margin-top: 0.4rem;">{{ errors.home_intro }}</p>{% endif %}
      </div>
    </div>

    <!-- 테마 및 가입 설정 -->
    <div style="display: flex; flex-direction: column; gap: 1rem;">
      <h2 style="font-size: 1.1rem; font-weight: 800; color: var(--text-main); border-left: 3px solid var(--primary); padding-left: 0.6rem;">템플릿 테마 & 가입 설정</h2>

      <div>
        <label class="label"><span class="label-text" style="font-weight: 750;">적용 템플릿 테마</span></label>
        <select class="select select-bordered" name="theme" required>
          {% for theme_name in available_themes %}
            <option value="{{ theme_name }}"{{ values.theme|default(active_theme) == theme_name ? ' selected' : '' }}>
              {{ theme_name == 'agy-ohouse' ? 'agy-ohouse (오늘의집 모티브 DaisyUI)' : (theme_name == 'default' ? 'default (기본)' : theme_name) }}
            </option>
          {% endfor %}
        </select>
        {% if errors.theme is defined %}<p class="badge badge-error-soft" style="margin-top: 0.4rem;">{{ errors.theme }}</p>{% endif %}
      </div>

      <div style="padding: 0.85rem 1rem; background: var(--base-200); border-radius: 0.65rem;">
        <label style="display: flex; align-items: center; gap: 0.6rem; cursor: pointer; font-size: 0.88rem; font-weight: 700;">
          <input type="checkbox" name="registration_enabled" value="1"{{ values.registration_enabled|default(false) ? ' checked' : '' }} style="accent-color: var(--primary);">
          <span>신규 회원가입 허용 (체크 해제 시 가입 화면 비활성화)</span>
        </label>
      </div>
    </div>

    <div style="display: flex; justify-content: flex-end; gap: 0.75rem; padding-top: 1rem; border-top: 1px solid var(--line);">
      <a class="btn btn-ghost" href="{{ url_for('admin.index') }}">취소</a>
      <button class="btn btn-primary" type="submit">설정 저장</button>
    </div>
  </form>
</section>
{% endblock %}
