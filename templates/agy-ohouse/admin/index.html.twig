{% extends "admin/layout.html.twig" %}
{% import '_icons.html.twig' as ico %}

{% block title %}대시보드 · {{ site.site_name }}{% endblock %}
{% block admin_section %}dashboard{% endblock %}

{% block body %}
<div class="section-head" style="margin-bottom: 1.5rem;">
  <div>
    <h1 style="font-size: 1.85rem; font-weight: 900; letter-spacing: -0.04em; color: var(--text-main);">대시보드</h1>
    <p class="section-sub">사이트 운영 현황을 한눈에 파악하고 관리합니다.</p>
  </div>
  <div style="display: flex; gap: 0.5rem;">
    <a class="btn btn-primary btn-sm" href="{{ url_for('admin.boards.create') }}">
      {{ ico.i('plus', 14) }} 새 게시판
    </a>
    <a class="btn btn-outline btn-sm" href="{{ url_for('admin.content.create') }}">
      {{ ico.i('plus', 14) }} 새 내용
    </a>
  </div>
</div>

{% if query.saved|default('') == '1' %}
  <div class="alert alert-success" style="margin-bottom: 1.25rem;">
    {{ ico.i('check-circle', 18) }}
    <span>변경사항을 성공적으로 저장했습니다.</span>
  </div>
{% endif %}

{% if query.deleted|default('') == '1' %}
  <div class="alert alert-success" style="margin-bottom: 1.25rem;">
    {{ ico.i('check-circle', 18) }}
    <span>게시판을 삭제했습니다.</span>
  </div>
{% endif %}

<!-- 통계 카드 그리드 -->
<div class="stats" style="margin-bottom: 2rem;">
  <a class="stat" href="{{ url_for('admin.boards') }}" style="transition: background 0.15s ease;">
    <div style="display: flex; align-items: center; justify-content: space-between;">
      <span class="stat-title">게시판</span>
      <span style="color: var(--primary);">{{ ico.i('board', 20) }}</span>
    </div>
    <div class="stat-value">{{ board_count }}</div>
    <div class="stat-desc" style="color: var(--primary); font-weight: 750;">관리하기 →</div>
  </a>

  <a class="stat" href="{{ url_for('admin.content') }}" style="transition: background 0.15s ease;">
    <div style="display: flex; align-items: center; justify-content: space-between;">
      <span class="stat-title">정적 내용</span>
      <span style="color: var(--accent);">{{ ico.i('document', 20) }}</span>
    </div>
    <div class="stat-value">{{ page_count }}</div>
    <div class="stat-desc" style="color: var(--accent); font-weight: 750;">관리하기 →</div>
  </a>

  <div class="stat">
    <div style="display: flex; align-items: center; justify-content: space-between;">
      <span class="stat-title">등록된 게시글</span>
      <span style="color: var(--secondary);">{{ ico.i('comment', 20) }}</span>
    </div>
    <div class="stat-value">{{ post_count }}</div>
    <div class="stat-desc">활성 게시글 수</div>
  </div>

  <a class="stat" href="{{ url_for('admin.members') }}" style="transition: background 0.15s ease;">
    <div style="display: flex; align-items: center; justify-content: space-between;">
      <span class="stat-title">회원 수</span>
      <span style="color: #3b82f6;">{{ ico.i('users', 20) }}</span>
    </div>
    <div class="stat-value">{{ user_count }}</div>
    <div class="stat-desc" style="color: #3b82f6; font-weight: 750;">관리하기 →</div>
  </a>
</div>

<!-- 게시판 목록 카드 -->
<section class="card" style="margin-bottom: 2rem;">
  <div class="card-body">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem;">
      <h2 class="card-title">{{ ico.i('board', 18) }} 게시판 현황</h2>
      <a class="btn btn-ghost btn-sm" href="{{ url_for('admin.boards') }}">전체 관리 →</a>
    </div>

    {% if boards is empty %}
      <div style="text-align: center; padding: 2rem 1rem; color: var(--text-muted);">
        <p>아직 생성된 게시판이 없습니다.</p>
        <a class="btn btn-primary btn-sm" href="{{ url_for('admin.boards.create') }}" style="margin-top: 0.75rem;">첫 게시판 만들기</a>
      </div>
    {% else %}
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th>게시판 이름</th>
              <th>키 (주소)</th>
              <th>읽기/쓰기 권한</th>
              <th style="text-align: right;">관리</th>
            </tr>
          </thead>
          <tbody>
            {% for board in boards %}
              <tr>
                <td>
                  <a href="{{ url_for('posts.index', {key: board.board_key}) }}" style="font-weight: 750; color: var(--text-main);" target="_blank">
                    {{ board.name }}
                  </a>
                </td>
                <td><code style="background: var(--base-200); padding: 0.2rem 0.4rem; border-radius: 0.35rem; font-size: 0.78rem;">{{ board.board_key }}</code></td>
                <td>
                  <span class="badge badge-ghost badge-sm">읽기: {{ board.perm_read }}</span>
                  <span class="badge badge-ghost badge-sm">쓰기: {{ board.perm_write }}</span>
                </td>
                <td style="text-align: right;">
                  <a class="btn btn-outline btn-sm" href="{{ url_for('admin.boards.edit', {key: board.board_key}) }}">설정</a>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% endif %}
  </div>
</section>
{% endblock %}
