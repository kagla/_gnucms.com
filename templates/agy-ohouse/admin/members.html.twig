{% extends "admin/layout.html.twig" %}
{% import '_icons.html.twig' as ico %}

{% block title %}회원 관리 · {{ site.site_name }}{% endblock %}
{% block admin_section %}members{% endblock %}

{% block body %}
<div class="breadcrumbs" style="font-size: 0.82rem; color: var(--text-muted); margin-bottom: 0.85rem;">
  <a href="{{ url_for('admin.index') }}">관리 콘솔</a>
  <span style="margin-inline: 0.35rem; color: var(--text-hint);">›</span>
  <span style="color: var(--text-main); font-weight: 700;" aria-current="page">회원 관리</span>
</div>

<div class="section-head" style="margin-bottom: 1.5rem;">
  <div>
    <h1 style="font-size: 1.85rem; font-weight: 900; letter-spacing: -0.04em; color: var(--text-main);">회원 관리</h1>
    <p class="section-sub">가입된 회원 목록을 조회하고 상태를 관리합니다.</p>
  </div>
</div>

{% if saved %}<div class="alert alert-success" style="margin-bottom: 1.25rem;">{{ ico.i('check-circle', 18) }}<span>회원 정보를 저장했습니다.</span></div>{% endif %}

<!-- 검색 폼 -->
<form method="get" action="{{ url_for('admin.members') }}" role="search" style="margin-bottom: 1.5rem; display: flex; gap: 0.5rem; max-width: 480px;">
  <div style="position: relative; flex: 1;">
    <span style="position: absolute; left: 0.85rem; top: 50%; transform: translateY(-50%); color: var(--text-hint);" aria-hidden="true">{{ ico.i('search', 16) }}</span>
    <input class="input input-bordered" style="padding-left: 2.4rem;" type="search" name="q" value="{{ query }}" placeholder="이메일 또는 표시 이름 검색" aria-label="회원 검색" data-search-input>
  </div>
  <button class="btn btn-primary" type="submit">검색</button>
</form>

<section class="card">
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th>회원</th>
          <th>가입일</th>
          <th>상태</th>
          <th style="text-align: right;">관리</th>
        </tr>
      </thead>
      <tbody>
      {% for member in members %}
        <tr>
          <td>
            <div style="display: flex; align-items: center; gap: 0.75rem;">
              <div class="avatar avatar-sm">
                <span class="avatar-inner" data-tone="{{ member.display_name|length % 6 }}" aria-hidden="true">
                  <span>{{ member.display_name|slice(0, 1)|upper }}</span>
                </span>
              </div>
              <div>
                <div style="font-weight: 800; color: var(--text-main); display: flex; align-items: center; gap: 0.35rem;">
                  {{ member.display_name }}
                  {% if member.is_admin %}<span class="badge badge-primary badge-sm">소유자</span>{% endif %}
                </div>
                <div style="font-size: 0.78rem; color: var(--text-muted);">{{ member.email }}</div>
              </div>
            </div>
          </td>
          <td style="font-size: 0.85rem; color: var(--text-sub);">{{ member.created_at|date('Y.m.d') }}</td>
          <td>
            <span class="badge badge-sm {{ member.status == 'active' ? 'badge-success-soft' : 'badge-error-soft' }}">
              {{ member.status == 'active' ? '활성' : '차단' }}
            </span>
          </td>
          <td style="text-align: right;">
            <div class="join">
              <a class="btn btn-outline btn-sm join-item" href="{{ url_for('admin.members.edit', {id: member.id}) }}">수정</a>
              <form method="post" action="{{ url_for('admin.members.status', {id: member.id}) }}" class="join-item">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                <button class="btn btn-outline btn-sm" type="submit">{{ member.status == 'active' ? '차단' : '해제' }}</button>
              </form>
            </div>
          </td>
        </tr>
      {% else %}
        <tr>
          <td colspan="4" style="text-align: center; padding: 3rem 1rem; color: var(--text-muted);">
            조건에 맞는 회원이 없습니다.
          </td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endblock %}
