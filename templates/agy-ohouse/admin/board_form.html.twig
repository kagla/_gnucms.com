{% extends "admin/layout.html.twig" %}
{% import '_icons.html.twig' as ico %}

{% block title %}{{ create ? '게시판 만들기' : '게시판 설정' }} · {{ site.site_name }}{% endblock %}
{% block admin_section %}boards{% endblock %}

{% block body %}
<div class="breadcrumbs" style="font-size: 0.82rem; color: var(--text-muted); margin-bottom: 0.85rem;">
  <a href="{{ url_for('admin.index') }}">관리 콘솔</a>
  <span style="margin-inline: 0.35rem; color: var(--text-hint);">›</span>
  <a href="{{ url_for('admin.boards') }}">게시판</a>
  <span style="margin-inline: 0.35rem; color: var(--text-hint);">›</span>
  <span style="color: var(--text-main); font-weight: 700;" aria-current="page">{{ create ? '게시판 만들기' : values.name }}</span>
</div>

<section class="card" style="padding: clamp(1.5rem, 4vw, 2.5rem); margin-bottom: 2rem;">
  <div style="margin-bottom: 1.5rem; padding-bottom: 1rem; border-bottom: 1px solid var(--line);">
    <h1 style="font-size: 1.75rem; font-weight: 900; letter-spacing: -0.04em; color: var(--text-main);">{{ create ? '게시판 만들기' : '게시판 설정' }}</h1>
    <p style="color: var(--text-muted); font-size: 0.88rem; margin-top: 0.25rem;">게시판의 기본 정보, 권한, 부가 기능을 설정합니다.</p>
  </div>

  <form method="post" action="{{ create ? url_for('admin.boards.create') : url_for('admin.boards.edit', {key: board_key}) }}" style="display: flex; flex-direction: column; gap: 1.75rem;">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

    <!-- 기본 정보 -->
    <div style="display: flex; flex-direction: column; gap: 1rem;">
      <h2 style="font-size: 1.1rem; font-weight: 800; color: var(--text-main); border-left: 3px solid var(--primary); padding-left: 0.6rem;">기본 정보</h2>
      
      {% if create %}
        <div>
          <label class="label"><span class="label-text" style="font-weight: 750;">게시판 키 (영문 소문자, 숫자, 하이픈)</span></label>
          <input class="input input-bordered" type="text" name="board_key" value="{{ values.board_key|default('') }}" maxlength="50" pattern="[a-z0-9_-]+" placeholder="예: interior, qna" required>
          {% if errors.board_key is defined %}<p class="badge badge-error-soft" style="margin-top: 0.4rem;">{{ errors.board_key }}</p>{% endif %}
        </div>
      {% else %}
        <div>
          <label class="label"><span class="label-text" style="font-weight: 750;">게시판 키 (변경 불가)</span></label>
          <input class="input input-bordered" type="text" value="{{ board_key }}" readonly style="background: var(--base-200);">
        </div>
      {% endif %}

      <div>
        <label class="label"><span class="label-text" style="font-weight: 750;">게시판 이름</span></label>
        <input class="input input-bordered" type="text" name="name" value="{{ values.name|default('') }}" maxlength="100" placeholder="예: 인테리어 자랑, 질문과 답변" required>
        {% if errors.name is defined %}<p class="badge badge-error-soft" style="margin-top: 0.4rem;">{{ errors.name }}</p>{% endif %}
      </div>

      <div>
        <label class="label"><span class="label-text" style="font-weight: 750;">설명</span></label>
        <input class="input input-bordered" type="text" name="description" value="{{ values.description|default('') }}" maxlength="200" placeholder="게시판에 대한 한 줄 소개">
      </div>
    </div>

    <!-- 이용 권한 -->
    <div style="display: flex; flex-direction: column; gap: 1rem;">
      <h2 style="font-size: 1.1rem; font-weight: 800; color: var(--text-main); border-left: 3px solid var(--primary); padding-left: 0.6rem;">이용 권한</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 1rem;">
        <div>
          <label class="label"><span class="label-text" style="font-weight: 750;">읽기 권한</span></label>
          <select class="select select-bordered" name="perm_read">
            {% for p in ['guest','member','admin'] %}<option value="{{ p }}"{{ values.perm_read == p ? ' selected' : '' }}>{{ p }}</option>{% endfor %}
          </select>
        </div>
        <div>
          <label class="label"><span class="label-text" style="font-weight: 750;">쓰기 권한</span></label>
          <select class="select select-bordered" name="perm_write">
            {% for p in ['guest','member','admin'] %}<option value="{{ p }}"{{ values.perm_write == p ? ' selected' : '' }}>{{ p }}</option>{% endfor %}
          </select>
        </div>
        <div>
          <label class="label"><span class="label-text" style="font-weight: 750;">댓글 권한</span></label>
          <select class="select select-bordered" name="perm_comment">
            {% for p in ['guest','member','admin'] %}<option value="{{ p }}"{{ values.perm_comment == p ? ' selected' : '' }}>{{ p }}</option>{% endfor %}
          </select>
        </div>
      </div>
    </div>

    <!-- 기능 및 설정 -->
    <div style="display: flex; flex-direction: column; gap: 1rem;">
      <h2 style="font-size: 1.1rem; font-weight: 800; color: var(--text-main); border-left: 3px solid var(--primary); padding-left: 0.6rem;">기능과 노출</h2>
      
      <div>
        <label class="label"><span class="label-text" style="font-weight: 750;">카테고리/분류 (줄바꿈으로 구분)</span></label>
        <textarea class="textarea textarea-bordered" name="categories_text" rows="3" placeholder="거실&#10;침실&#10;주방&#10;욕실">{{ values.categories_text|default('') }}</textarea>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem;">
        <div>
          <label class="label"><span class="label-text" style="font-weight: 750;">목록 형태</span></label>
          {% set list_labels = {'list': '목록형 (표)', 'gallery': '갤러리형 (사진 격자)', 'magazine': '매거진형 (사진 + 발췌)', 'news': '뉴스형 (제목 + 발췌)'} %}
          <select class="select select-bordered" name="list_type">
            {% for name, label in list_labels %}<option value="{{ name }}"{{ values.list_type|default('list') == name ? ' selected' : '' }}>{{ label }}</option>{% endfor %}
          </select>
        </div>
        <div>
          <label class="label"><span class="label-text" style="font-weight: 750;">페이지당 글 수</span></label>
          <input class="input input-bordered" type="number" name="per_page" value="{{ values.per_page|default(20) }}" min="1" max="100">
        </div>
        <div>
          <label class="label"><span class="label-text" style="font-weight: 750;">정렬 순서</span></label>
          <input class="input input-bordered" type="number" name="sort_order" value="{{ values.sort_order|default(0) }}" min="-9999" max="9999">
        </div>
      </div>

      <div style="padding: 1rem; background: var(--base-200); border-radius: 0.75rem; display: flex; flex-direction: column; gap: 0.6rem;">
        <label style="display: flex; align-items: center; gap: 0.6rem; cursor: pointer; font-size: 0.88rem; font-weight: 700;">
          <input type="checkbox" name="use_category" value="1"{{ values.use_category|default(false) ? ' checked' : '' }} style="accent-color: var(--primary);">
          <span>분류(카테고리) 기능 사용</span>
        </label>
        <label style="display: flex; align-items: center; gap: 0.6rem; cursor: pointer; font-size: 0.88rem; font-weight: 700;">
          <input type="checkbox" name="use_secret" value="1"{{ values.use_secret|default(false) ? ' checked' : '' }} style="accent-color: var(--primary);">
          <span>비밀글 기능 사용</span>
        </label>
        <label style="display: flex; align-items: center; gap: 0.6rem; cursor: pointer; font-size: 0.88rem; font-weight: 700;">
          <input type="checkbox" name="use_file" value="1"{{ values.use_file|default(false) ? ' checked' : '' }} style="accent-color: var(--primary);">
          <span>파일 첨부 기능 사용</span>
        </label>
      </div>
    </div>

    <div style="display: flex; justify-content: flex-end; gap: 0.75rem; padding-top: 1rem; border-top: 1px solid var(--line);">
      <a class="btn btn-ghost" href="{{ url_for('admin.boards') }}">취소</a>
      <button class="btn btn-primary" type="submit">{{ create ? '게시판 만들기' : '변경사항 저장' }}</button>
    </div>
  </form>

  {% if not create %}
    <div style="margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--line); display: flex; align-items: center; justify-content: space-between; gap: 1rem;">
      <div>
        <strong style="color: var(--error); font-size: 0.95rem;">게시판 삭제</strong>
        <p style="font-size: 0.82rem; color: var(--text-muted);">게시글과 댓글을 포함하여 게시판을 영구적으로 삭제합니다.</p>
      </div>
      <form method="post" action="{{ url_for('admin.boards.delete', {key: board_key}) }}" onsubmit="return confirm('게시판의 모든 글과 댓글이 삭제됩니다. 정말 삭제하시겠습니까?')">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <button class="btn btn-error btn-sm" type="submit">{{ ico.i('trash', 14) }} 게시판 삭제</button>
      </form>
    </div>
  {% endif %}
</section>
{% endblock %}
