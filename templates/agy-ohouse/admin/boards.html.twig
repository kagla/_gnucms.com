{% extends "admin/layout.html.twig" %}
{% import '_icons.html.twig' as ico %}

{% block title %}게시판 관리 · {{ site.site_name }}{% endblock %}
{% block admin_section %}boards{% endblock %}

{% block body %}
{% set list_labels = {'list': '목록형', 'gallery': '갤러리형', 'magazine': '매거진형', 'news': '뉴스형'} %}

<div class="breadcrumbs" style="font-size: 0.82rem; color: var(--text-muted); margin-bottom: 0.85rem;">
  <a href="{{ url_for('admin.index') }}">관리 콘솔</a>
  <span style="margin-inline: 0.35rem; color: var(--text-hint);">›</span>
  <span style="color: var(--text-main); font-weight: 700;" aria-current="page">게시판 관리</span>
</div>

<div class="section-head" style="margin-bottom: 1.5rem;">
  <div>
    <h1 style="font-size: 1.85rem; font-weight: 900; letter-spacing: -0.04em; color: var(--text-main);">게시판 관리</h1>
    <p class="section-sub">게시판을 추가하고 권한 및 기능, 정렬 순서를 관리합니다.</p>
  </div>
  <a class="btn btn-primary" href="{{ url_for('admin.boards.create') }}">
    {{ ico.i('plus', 16) }} 게시판 만들기
  </a>
</div>

{% if query.saved|default('') == '1' %}<div class="alert alert-success" style="margin-bottom: 1.25rem;">{{ ico.i('check-circle', 18) }}<span>게시판 설정을 저장했습니다.</span></div>{% endif %}
{% if query.deleted|default('') == '1' %}<div class="alert alert-success" style="margin-bottom: 1.25rem;">{{ ico.i('check-circle', 18) }}<span>게시판을 삭제했습니다.</span></div>{% endif %}

<section class="card">
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th>게시판</th>
          <th>주소</th>
          <th>형태</th>
          <th>권한</th>
          <th>기능</th>
          <th style="text-align: right;">정렬</th>
          <th style="text-align: right;">관리</th>
        </tr>
      </thead>
      <tbody>
      {% for board in boards %}
        <tr>
          <td>
            <a href="{{ url_for('posts.index', {key: board.board_key}) }}" style="font-weight: 800; color: var(--text-main);" target="_blank">
              {{ board.name }}
            </a>
            {% if board.description %}<div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 0.2rem;">{{ board.description }}</div>{% endif %}
          </td>
          <td><code style="background: var(--base-200); padding: 0.2rem 0.4rem; border-radius: 0.35rem; font-size: 0.78rem;">/boards/{{ board.board_key }}</code></td>
          <td><span class="badge badge-ghost badge-sm">{{ list_labels[board.list_type]|default(board.list_type) }}</span></td>
          <td>
            <div style="display: flex; flex-direction: column; gap: 0.2rem; font-size: 0.75rem;">
              <span>읽기: <strong style="color: var(--primary);">{{ board.perm_read }}</strong></span>
              <span>쓰기: <strong style="color: var(--primary);">{{ board.perm_write }}</strong></span>
            </div>
          </td>
          <td>
            <div style="display: flex; flex-wrap: wrap; gap: 0.25rem;">
              {% if board.use_category %}<span class="badge badge-soft badge-sm">분류</span>{% endif %}
              {% if board.use_secret %}<span class="badge badge-soft badge-sm">비밀</span>{% endif %}
              {% if board.use_file %}<span class="badge badge-soft badge-sm">첨부</span>{% endif %}
            </div>
          </td>
          <td style="text-align: right; font-weight: 700;">{{ board.sort_order }}</td>
          <td style="text-align: right;">
            <a class="btn btn-outline btn-sm" href="{{ url_for('admin.boards.edit', {key: board.board_key}) }}">설정</a>
          </td>
        </tr>
      {% else %}
        <tr>
          <td colspan="7" style="text-align: center; padding: 3rem 1rem; color: var(--text-muted);">
            등록된 게시판이 없습니다. 첫 게시판을 만들어 보세요.
          </td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endblock %}
