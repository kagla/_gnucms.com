{% extends "layout.html.twig" %}
{% import '_icons.html.twig' as ico %}

{% block title %}비밀번호 변경 완료 · {{ site.site_name }}{% endblock %}

{% block body %}
<div style="max-width: 440px; margin: 4rem auto; text-align: center;">
  <section class="card" style="padding: clamp(2rem, 5vw, 3rem);">
    <div style="color: var(--success); margin-bottom: 1rem;">
      {{ ico.i('check-circle', 56) }}
    </div>
    <span class="badge badge-success-soft" style="align-self: center; margin-bottom: 0.5rem;">Success</span>
    <h1 style="font-size: 1.75rem; font-weight: 900; letter-spacing: -0.04em; color: var(--text-main); margin-bottom: 0.5rem;">비밀번호를 변경했습니다</h1>
    <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.6; margin-bottom: 2rem;">새로운 비밀번호로 다시 로그인해 주세요.</p>
    <a class="btn btn-primary btn-block" href="{{ url_for('auth.login') }}">로그인하기</a>
  </section>
</div>
{% endblock %}
