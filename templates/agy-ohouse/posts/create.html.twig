{% extends "layout.html.twig" %}
{% import '_icons.html.twig' as ico %}

{% block title %}새 글 작성 · {{ board.name }} · {{ site.site_name }}{% endblock %}
{% block nav_section %}board{% endblock %}

{% block extra_tabs %}
<a class="tab tab-active" href="{{ url_for('posts.index', {'key': board.board_key}) }}" aria-current="page">
  {{ board.name }}
</a>
{% endblock %}

{% block body %}
<div class="article-wrap">
  <div class="breadcrumbs" style="font-size: 0.82rem; color: var(--text-muted); margin-bottom: 1.25rem;">
    <a href="{{ url_for('boards.index') }}">홈</a>
    <span style="margin-inline: 0.35rem; color: var(--text-hint);">›</span>
    <a href="{{ url_for('posts.index', {'key': board.board_key}) }}">{{ board.name }}</a>
    <span style="margin-inline: 0.35rem; color: var(--text-hint);">›</span>
    <span style="color: var(--text-main); font-weight: 700;" aria-current="page">새 글 작성</span>
  </div>

  <div class="card" style="padding: clamp(1.5rem, 4vw, 2.5rem); margin-bottom: 3rem;">
    <div style="margin-bottom: 1.75rem; padding-bottom: 1.25rem; border-bottom: 1px solid var(--line);">
      <span class="badge badge-soft" style="margin-bottom: 0.5rem;">{{ board.name }}</span>
      <h1 style="font-size: 1.75rem; font-weight: 900; letter-spacing: -0.04em; color: var(--text-main);">새로운 이야기 쓰기</h1>
      <p style="color: var(--text-muted); font-size: 0.92rem; margin-top: 0.25rem;">따뜻한 일상이나 인테리어 팁, 유용한 정보를 공유해 보세요.</p>
    </div>

    <form method="post" action="{{ url_for('posts.create', {'key': board.board_key}) }}" style="display: flex; flex-direction: column; gap: 1.25rem;">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

      {% if board.use_category and board.categories is not empty %}
        <div>
          <label class="label"><span class="label-text" style="font-weight: 750;">카테고리 선택</span></label>
          <select class="select select-bordered" name="category" required>
            <option value="">카테고리를 선택해 주세요</option>
            {% for name in board.categories %}
              <option value="{{ name }}"{% if values.category|default('') == name %} selected{% endif %}>{{ name }}</option>
            {% endfor %}
          </select>
          {% if errors.category is defined %}<p class="badge badge-error-soft" style="margin-top: 0.4rem;">{{ errors.category }}</p>{% endif %}
        </div>
      {% endif %}

      <div>
        <label class="label"><span class="label-text" style="font-weight: 750;">제목</span></label>
        <input class="input input-bordered" type="text" name="title" value="{{ values.title|default('') }}" maxlength="200" placeholder="제목을 입력해 주세요" required autofocus>
        {% if errors.title is defined %}<p class="badge badge-error-soft" style="margin-top: 0.4rem;">{{ errors.title }}</p>{% endif %}
      </div>

      <div>
        <label class="label"><span class="label-text" style="font-weight: 750;">내용</span></label>
        <textarea class="textarea textarea-bordered" name="content" rows="14" placeholder="이야기할 내용을 자유롭고 편안하게 작성해 주세요." required>{{ values.content|default('') }}</textarea>
        {% if errors.content is defined %}<p class="badge badge-error-soft" style="margin-top: 0.4rem;">{{ errors.content }}</p>{% endif %}
      </div>

      {% if board.use_secret %}
        <div style="padding: 0.75rem 1rem; background: var(--base-200); border-radius: 0.65rem;">
          <label style="display: flex; align-items: center; gap: 0.6rem; cursor: pointer; font-size: 0.88rem; font-weight: 700;">
            <input type="checkbox" name="is_secret" value="1"{% if values.is_secret|default(false) %} checked{% endif %} style="width: 1.1rem; height: 1.1rem; accent-color: var(--primary);">
            <span>{{ ico.i('lock', 15) }} 비밀글로 작성 (작성자와 관리자만 확인 가능)</span>
          </label>
        </div>
      {% endif %}

      <div style="display: flex; align-items: center; justify-content: flex-end; gap: 0.75rem; margin-top: 1rem; padding-top: 1.25rem; border-top: 1px solid var(--line);">
        <a class="btn btn-ghost" href="{{ url_for('posts.index', {'key': board.board_key}) }}">취소</a>
        <button class="btn btn-primary" type="submit">
          {{ ico.i('check', 16) }} 글 발행하기
        </button>
      </div>
    </form>
  </div>
</div>
{% endblock %}
