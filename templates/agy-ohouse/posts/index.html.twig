{% extends "layout.html.twig" %}
{% import '_icons.html.twig' as ico %}
{% import _self as h %}

{% macro listUrl(board, q, category, page) %}
{%- set params = [] -%}
{%- if q %}{% set params = params|merge(['q=' ~ q|url_encode]) %}{% endif -%}
{%- if category %}{% set params = params|merge(['category=' ~ category|url_encode]) %}{% endif -%}
{%- if page and page > 1 %}{% set params = params|merge(['page=' ~ page]) %}{% endif -%}
{{- url_for('posts.index', {'key': board.board_key}) }}{% if params is not empty %}?{{ params|join('&amp;')|raw }}{% endif %}
{%- endmacro %}

{% block title %}{{ board.name }} · {{ site.site_name }}{% endblock %}
{% block nav_section %}board{% endblock %}

{% block extra_tabs %}
<a class="tab tab-active" href="{{ url_for('posts.index', {'key': board.board_key}) }}" aria-current="page">
  {{ board.name }}
</a>
{% endblock %}

{% block header_search %}
<form class="header-search" method="get" action="{{ url_for('posts.index', {'key': board.board_key}) }}" role="search">
  {% if query.category is not empty %}<input type="hidden" name="category" value="{{ query.category }}">{% endif %}
  <div class="input-wrapper">
    <span class="header-search-icon" aria-hidden="true">{{ ico.i('search', 16) }}</span>
    <input type="search" name="q" value="{{ query.q }}" placeholder="{{ board.name }}에서 이야기 검색" aria-label="게시글 검색" data-search-input>
    <kbd class="header-search-kbd" aria-hidden="true">/</kbd>
  </div>
</form>
{% endblock %}

{% block subnav %}
<div class="subnav">
  <div class="wrap subnav-inner">
    <div class="chip-bar" role="group" aria-label="카테고리 선택">
      {% if board.use_category and board.categories is not empty %}
        <a class="chip{% if query.category is empty %} is-active{% endif %}" href="{{ h.listUrl(board, query.q, null, 1)|trim }}">전체</a>
        {% for name in board.categories %}
          <a class="chip{% if query.category == name %} is-active{% endif %}" href="{{ h.listUrl(board, query.q, name, 1)|trim }}">{{ name }}</a>
        {% endfor %}
      {% else %}
        <span class="chip is-active">전체글</span>
      {% endif %}
    </div>
    <span class="badge badge-soft">{{ list.total }}개의 이야기</span>
  </div>
</div>
{% endblock %}

{% block body %}
{% set filtered = query.q is not empty or query.category is not empty %}

<div class="breadcrumbs" style="font-size: 0.82rem; color: var(--text-muted); margin-bottom: 0.85rem;">
  <a href="{{ url_for('boards.index') }}">홈</a>
  <span style="margin-inline: 0.35rem; color: var(--text-hint);">›</span>
  <span style="color: var(--text-main); font-weight: 700;" aria-current="page">{{ board.name }}</span>
</div>

<div class="section-head" style="margin-bottom: 1.5rem;">
  <div>
    <h1 style="font-size: 1.85rem; font-weight: 900; letter-spacing: -0.04em; color: var(--text-main);">{{ board.name }}</h1>
    {% if board.description %}<p class="section-sub">{{ board.description }}</p>{% endif %}
  </div>
  {% if can_write %}
    <a class="btn btn-primary hide-sm" href="{{ url_for('posts.create', {'key': board.board_key}) }}">
      {{ ico.i('pencil', 16) }} 글쓰기
    </a>
  {% endif %}
</div>

<!-- 모바일 검색 폼 -->
<form class="md:hidden" method="get" action="{{ url_for('posts.index', {'key': board.board_key}) }}" role="search" style="margin-bottom: 1.25rem; display: flex; gap: 0.5rem;">
  {% if query.category is not empty %}<input type="hidden" name="category" value="{{ query.category }}">{% endif %}
  <div style="position: relative; flex: 1;">
    <span style="position: absolute; left: 0.85rem; top: 50%; transform: translateY(-50%); color: var(--text-hint);" aria-hidden="true">{{ ico.i('search', 16) }}</span>
    <input class="input input-bordered" style="padding-left: 2.4rem;" type="search" name="q" value="{{ query.q }}" placeholder="{{ board.name }} 검색" aria-label="게시글 검색">
  </div>
  <button class="btn btn-primary" type="submit">검색</button>
</form>

<!-- 검색/필터 결과 안내 -->
{% if filtered %}
  <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1.25rem; padding: 0.75rem 1rem; background: var(--base-100); border: 1px solid var(--line); border-radius: 0.75rem; font-size: 0.88rem;">
    {% if query.category is not empty %}<span class="badge badge-soft">{{ query.category }}</span>{% endif %}
    {% if query.q is not empty %}<span class="badge badge-soft">“{{ query.q }}” 검색</span>{% endif %}
    <span style="color: var(--text-muted);">총 {{ list.total }}개의 결과</span>
    <a style="margin-left: auto; color: var(--primary); font-weight: 750; font-size: 0.82rem;" href="{{ url_for('posts.index', {'key': board.board_key}) }}">필터 초기화</a>
  </div>
{% endif %}

<!-- 공지사항 스트립 -->
{% if list.notices is not empty %}
  <div class="notice-strip" aria-label="공지사항">
    {% for post in list.notices %}
      <a class="notice-item" href="{{ url_for('posts.show', {'id': post.id}) }}">
        <span class="badge badge-primary badge-sm">{{ ico.i('megaphone', 12) }} 공지</span>
        <span class="notice-title">{{ post.title }}</span>
        <time class="notice-date" datetime="{{ post.created_at }}">{{ post.created_at|date('m.d') }}</time>
      </a>
    {% endfor %}
  </div>
{% endif %}

<!-- 게시글 목록/피드 -->
{% if list.data is empty and list.notices is empty %}
  <div class="card" style="text-align: center; padding: 4rem 2rem;">
    <div style="font-size: 3rem; margin-bottom: 1rem; color: var(--text-hint);">{{ ico.i('document', 56) }}</div>
    <h2 style="font-size: 1.25rem; font-weight: 800; margin-bottom: 0.5rem;">
      {% if filtered %}조건에 맞는 이야기가 없습니다{% else %}아직 등록된 이야기가 없습니다{% endif %}
    </h2>
    <p style="color: var(--text-muted); font-size: 0.92rem; margin-bottom: 1.5rem;">
      {% if filtered %}다른 검색어나 카테고리로 다시 찾아보세요.{% else %}첫 번째 글을 작성하여 소통을 시작해 보세요.{% endif %}
    </p>
    {% if filtered %}
      <div><a class="btn btn-outline" href="{{ url_for('posts.index', {'key': board.board_key}) }}">전체 글 보기</a></div>
    {% elseif can_write %}
      <div><a class="btn btn-primary" href="{{ url_for('posts.create', {'key': board.board_key}) }}">{{ ico.i('pencil', 16) }} 첫 글 쓰기</a></div>
    {% endif %}
  </div>
{% elseif list.data is not empty %}
  <div class="feed-grid">
    {% for post in list.data %}
      <a class="feed-card" href="{{ url_for('posts.show', {'id': post.id}) }}">
        <div class="feed-cover" data-tone="{{ post.id % 6 }}">
          <span class="feed-cover-badge">
            {% if post.is_notice %}공지{% elseif post.category %}{{ post.category }}{% else %}{{ board.name }}{% endif %}
          </span>
          <span aria-hidden="true">{{ post.title|slice(0, 1) }}</span>
        </div>
        <div class="feed-body">
          <h2 class="feed-title">{{ post.title }}</h2>
          <div class="feed-meta">
            <span class="feed-author">
              <span class="avatar avatar-xs">
                <span class="avatar-inner" data-tone="{{ post.author_name|length % 6 }}" aria-hidden="true">
                  {{ post.author_name|slice(0, 1)|upper }}
                </span>
              </span>
              <span>{{ post.author_name }}</span>
            </span>
            <div class="feed-stats">
              <span class="feed-stat-item" title="조회수">
                {{ ico.i('eye', 13) }} {{ post.view_count }}
              </span>
              <span class="feed-stat-item" title="댓글 수">
                {{ ico.i('comment', 13) }} {{ post.comment_count }}
              </span>
            </div>
          </div>
        </div>
      </a>
    {% endfor %}
  </div>

  <!-- 페이지네이션 -->
  {% if list.total_pages > 1 %}
    <nav class="pagination" aria-label="페이지 네비게이션">
      {% if list.page > 1 %}
        <a href="{{ h.listUrl(board, query.q, query.category, list.page - 1)|trim }}" aria-label="이전 페이지">
          {{ ico.i('chevron-left', 16) }}
        </a>
      {% endif %}

      {% for p in 1..list.total_pages %}
        {% if p == list.page %}
          <strong aria-current="page">{{ p }}</strong>
        {% elseif p == 1 or p == list.total_pages or (p >= list.page - 2 and p <= list.page + 2) %}
          <a href="{{ h.listUrl(board, query.q, query.category, p)|trim }}">{{ p }}</a>
        {% elseif p == list.page - 3 or p == list.page + 3 %}
          <span style="color: var(--text-hint);">…</span>
        {% endif %}
      {% endfor %}

      {% if list.page < list.total_pages %}
        <a href="{{ h.listUrl(board, query.q, query.category, list.page + 1)|trim }}" aria-label="다음 페이지">
          {{ ico.i('chevron-right', 16) }}
        </a>
      {% endif %}
    </nav>
  {% endif %}
{% endif %}

<!-- 모바일 글쓰기 플로팅 버튼 -->
{% if can_write %}
  <a class="fab-write md:hidden" href="{{ url_for('posts.create', {'key': board.board_key}) }}" aria-label="글쓰기">
    {{ ico.i('pencil', 22) }}
  </a>
{% endif %}

{% endblock %}
