{% extends "layout.html.twig" %}
{% import '_icons.html.twig' as ico %}

{% block title %}시스템 상태 · {{ site.site_name }}{% endblock %}

{% block body %}
<div style="max-width: 580px; margin: 4rem auto;">
  <div class="card" style="padding: 2.5rem 2rem;">
    <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem;">
      <span style="color: var(--success);">{{ ico.i('check-circle', 28) }}</span>
      <h1 style="font-size: 1.45rem; font-weight: 900; color: var(--text-main); margin: 0;">모든 시스템 정상</h1>
    </div>
    <p style="font-size: 0.95rem; color: var(--text-sub); line-height: 1.6; margin-bottom: 1.25rem;">
      데이터베이스에 <strong class="badge badge-success-soft" style="font-size: 0.85rem; padding: 0.2rem 0.6rem;">{{ dialect }}</strong> 방식으로 정상 연결되어 있습니다.
    </p>
    <p style="font-size: 0.82rem; color: var(--text-hint); border-top: 1px solid var(--line); padding-top: 0.85rem;">
      이 화면은 데이터베이스 연결 핑 상태만 확인하며 테이블 유무는 검사하지 않습니다.
    </p>
  </div>
</div>
{% endblock %}
