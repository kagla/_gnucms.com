{%- elseif name == 'close' %}<path d="m6 6 12 12M18 6 6 18"/>
{%- elseif name == 'sun' %}<circle cx="12" cy="12" r="4"/><path d="M12 2v2.5M12 19.5V22M4.93 4.93l1.77 1.77M17.3 17.3l1.77 1.77M2 12h2.5M19.5 12H22M4.93 19.07l1.77-1.77M17.3 6.7l1.77-1.77"/>
