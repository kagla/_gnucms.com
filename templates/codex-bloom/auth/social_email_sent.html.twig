{# codex-bloom view: auth/social_email_sent.html.twig #}
{% extends "layout.html.twig" %}
{% import '_icons.html.twig' as ic %}
{% block title %}확인 메일 전송 · {{ site.site_name }}{% endblock %}
{% block body %}
<div class="auth-shell">
  <section class="codex-bloom-auth-card codex-bloom-status-card">
    <span class="codex-bloom-empty-icon">{{ ic.mail() }}</span>
    <p class="codex-bloom-section-kicker">{{ ic.check() }} 메일 전송 완료</p>
    <h1>메일함을 확인해 주세요</h1>
    <p class="codex-bloom-lead">보내드린 링크를 열면 소셜 계정 연결과 로그인이 완료됩니다. 링크는 30분 동안 유효합니다.</p>
  </section>
</div>
{% endblock %}
