{# codex-bloom view: auth/_social.html.twig #}
{# codex-bloom view: auth/_social.html.twig #}
{% if oauth_providers is not empty %}
  <div class="codex-bloom-auth-divider"><span>또는</span></div>
  <div class="codex-bloom-social-login" aria-label="소셜 로그인">
    {% for provider in oauth_providers %}
      <a class="codex-bloom-social-btn codex-bloom-social-{{ provider.key }}" href="{{ url_for('oauth.start', {provider: provider.key}) }}">
        <span class="codex-bloom-social-icon" aria-hidden="true">
          {% if provider.key == 'google' %}G{% elseif provider.key == 'naver' %}N{% elseif provider.key == 'kakao' %}K{% else %}⌘{% endif %}
        </span>
        {{ provider.label }}로 계속하기
      </a>
    {% endfor %}
  </div>
{% endif %}
