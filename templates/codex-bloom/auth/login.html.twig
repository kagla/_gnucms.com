{# codex-bloom view: auth/login.html.twig #}
{% extends "layout.html.twig" %}
{% import '_icons.html.twig' as ic %}
{% block title %}로그인 · {{ site.site_name }}{% endblock %}
{% block body %}
<div class="auth-shell">
  <section class="card bg-base-100 codex-bloom-auth-card">
    <header class="codex-bloom-panel-head codex-bloom-panel-head-compact">
      <p class="codex-bloom-section-kicker">{{ ic.user() }} Welcome back</p>
      <h1>로그인</h1>
      <p class="codex-bloom-lead">다시 만나서 반가워요. 이야기를 이어가세요.</p>
    </header>
    <form class="codex-bloom-form codex-bloom-auth-form" method="post" action="{{ url_for('auth.login') }}">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <label class="codex-bloom-field">{{ ic.mail() }} 이메일<input class="input input-bordered" type="email" name="email" value="{{ values.email|default('') }}" autocomplete="email" required></label>
      {% if errors.email is defined %}<p class="codex-bloom-field-error">{{ errors.email }}</p>{% endif %}
      <label class="codex-bloom-field">{{ ic.shield() }} 비밀번호<input class="input input-bordered" type="password" name="password" autocomplete="current-password" required></label>
      <p class="form-help"><a href="{{ url_for('auth.forgot') }}">비밀번호를 잊으셨나요?</a></p>
      <button class="btn btn-primary codex-bloom-btn codex-bloom-btn-primary codex-bloom-btn-block" type="submit">{{ ic.user() }} 로그인</button>
    </form>
    {% include "auth/_social.html.twig" %}
    <p class="auth-switch">아직 회원이 아니신가요? <a href="{{ url_for('auth.register') }}">{{ ic.sparkle() }} 회원가입</a></p>
  </section>
</div>
{% endblock %}
