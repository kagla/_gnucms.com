{# codex-bloom view: health.html.twig #}
{% extends "layout.html.twig" %}
{% import '_icons.html.twig' as ic %}
{% block title %}상태 · {{ site.site_name }}{% endblock %}
{% block body %}
<section class="codex-bloom-status">
  <span class="codex-bloom-empty-icon">{{ ic.check() }}</span>
  <p class="codex-bloom-section-kicker">{{ ic.settings() }} System status</p>
  <h1>모든 시스템이 정상입니다</h1>
  <p class="codex-bloom-lead">데이터베이스에 <strong>{{ dialect }}</strong>로 연결되어 있습니다.</p>
  <p class="muted">{{ ic.shield() }} 이 화면은 연결 상태만 확인하며 테이블 유무는 검사하지 않습니다.</p>
</section>
{% endblock %}
