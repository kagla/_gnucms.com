{% extends "layout.html.twig" %}
{% import '_icons.html.twig' as ic %}
{% block title %}{{ title }}{% endblock %}
{% block body %}
<section class="codex-bloom-status">
  <span class="codex-bloom-empty-icon">{{ ic.shield() }}</span>
  <p class="codex-bloom-section-kicker">Something went wrong</p>
  <h1>{{ title }}</h1>
  <p class="codex-bloom-lead">{{ message }}</p>
  {% if details is not empty %}
    <ul class="errors codex-bloom-errors">
      {% for field, detail in details %}<li><strong>{{ field }}</strong>: {{ detail }}</li>{% endfor %}
    </ul>
  {% endif %}
  <a class="codex-bloom-btn codex-bloom-btn-primary" href="{{ url_for('boards.index') }}">{{ ic.home() }} 홈으로 돌아가기</a>
</section>
{% endblock %}
