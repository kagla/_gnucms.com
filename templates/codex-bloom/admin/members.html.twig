{# codex-bloom view: admin/members.html.twig #}
{# codex-bloom view: admin/members.html.twig #}
{% extends "admin/layout.html.twig" %}
{% block title %}회원 관리 · {{ site.site_name }}{% endblock %}
{% block admin_section %}members{% endblock %}
{% block body %}
<nav class="codex-bloom-admin-crumb" aria-label="현재 위치">
  <a href="{{ url_for('admin.index') }}">관리</a><span>/</span><span>회원</span>
</nav>
<header class="codex-bloom-admin-head">
  <div>
    <h1>회원 관리</h1>
    <p class="codex-bloom-lead">회원 정보를 수정하거나 필요한 경우 이용을 차단합니다. 소유자 권한은 변경되지 않습니다.</p>
  </div>
</header>
{% if saved %}<p class="codex-bloom-notice codex-bloom-notice-success">회원 정보를 저장했습니다.</p>{% endif %}
<form class="codex-bloom-search codex-bloom-admin-search" method="get" action="{{ url_for('admin.members') }}" role="search">
  <div class="codex-bloom-search-field"><span class="codex-bloom-search-icon" aria-hidden="true"></span><input class="input input-bordered" type="search" name="q" value="{{ query }}" placeholder="이메일 또는 표시 이름 검색" aria-label="회원 검색"></div>
  <button class="btn btn-primary codex-bloom-btn codex-bloom-btn-primary" type="submit">검색</button>
</form>
<section class="card bg-base-100 codex-bloom-panel">
  <div class="codex-bloom-table-wrap">
    <table class="codex-bloom-table">
      <thead><tr><th>회원</th><th>가입일</th><th>상태</th><th>관리</th></tr></thead>
      <tbody>
        {% for member in members %}
          <tr>
            <td>
              <strong>{{ member.display_name }}</strong>
              {% if member.is_admin %}<span class="codex-bloom-tag">소유자</span>{% endif %}
              <div class="codex-bloom-table-sub">{{ member.email }}</div>
            </td>
            <td class="codex-bloom-table-meta">{{ member.created_at|date('Y.m.d') }}</td>
            <td><span class="codex-bloom-status-pill {{ member.status == 'active' ? 'is-active' : 'is-blocked' }}">{{ member.status == 'active' ? '활성' : '차단' }}</span></td>
            <td>
              <div class="codex-bloom-row-actions">
                <a class="codex-bloom-btn codex-bloom-btn-sm codex-bloom-btn-ghost" href="{{ url_for('admin.members.edit', {id: member.id}) }}">수정</a>
                <form method="post" action="{{ url_for('admin.members.status', {id: member.id}) }}">
                  <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                  <button class="codex-bloom-btn codex-bloom-btn-sm codex-bloom-btn-ghost" type="submit">{{ member.status == 'active' ? '차단' : '해제' }}</button>
                </form>
              </div>
            </td>
          </tr>
        {% else %}
          <tr><td colspan="4" class="codex-bloom-table-empty">조건에 맞는 회원이 없습니다.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endblock %}
