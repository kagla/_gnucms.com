{# codex-bloom view: admin/legal_form.html.twig #}
{# codex-bloom view: admin/legal_form.html.twig #}
{% extends "admin/layout.html.twig" %}
{% block title %}{{ values.title }} 수정 · {{ site.site_name }}{% endblock %}
{% block admin_section %}legal{% endblock %}
{% block body %}
<nav class="codex-bloom-admin-crumb" aria-label="현재 위치">
  <a href="{{ url_for('admin.index') }}">관리</a><span>/</span>
  <a href="{{ url_for('admin.terms') }}">약관</a><span>/</span>
  <span>{{ values.title }}</span>
</nav>
<section class="codex-bloom-panel codex-bloom-panel-form">
  <header class="codex-bloom-panel-head">
    <p class="codex-bloom-section-kicker">필수 약관</p>
    <h1>{{ values.title }} 수정</h1>
    <p class="codex-bloom-lead">공개 주소는 <strong>/{{ type }}</strong>로 고정되며, 공개하면 회원가입에 자동 연결됩니다.</p>
  </header>
  <form class="codex-bloom-form" method="post" action="{{ url_for('admin.terms.edit', {type: type}) }}">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <input type="hidden" name="image_key" value="{{ values.image_key }}">
    <input type="hidden" name="uploaded_images" value="{{ values.uploaded_images|default('') }}" data-uploaded-images>
    <label class="codex-bloom-field">제목<input type="text" name="title" value="{{ values.title|default('') }}" maxlength="200" required></label>
    {% if errors.title is defined %}<p class="codex-bloom-field-error">{{ errors.title }}</p>{% endif %}
    <label class="codex-bloom-field">내용<textarea id="content-editor" name="content" rows="18" data-cms-editor>{{ values.content|default('') }}</textarea></label>
    <p class="codex-bloom-form-help">사진 올리기에서 여러 장을 선택하거나 편집 영역으로 끌어놓을 수 있습니다.</p>
    {% if errors.content is defined %}<p class="codex-bloom-field-error">{{ errors.content }}</p>{% endif %}
    <label class="codex-bloom-field">상태
      <select name="status">
        <option value="draft"{{ values.status|default('draft') == 'draft' ? ' selected' : '' }}>초안</option>
        <option value="published"{{ values.status|default('draft') == 'published' ? ' selected' : '' }}>공개</option>
      </select>
    </label>
    <input type="hidden" name="sort_order" value="{{ values.sort_order|default(0) }}">
    <div class="codex-bloom-form-actions">
      <a class="codex-bloom-btn codex-bloom-btn-ghost" href="{{ url_for('admin.terms.preview', {type: type}) }}" target="_blank" rel="noopener">미리보기</a>
      <a class="codex-bloom-btn codex-bloom-btn-ghost" href="{{ url_for('admin.terms') }}">취소</a>
      <button class="codex-bloom-btn codex-bloom-btn-primary" type="submit">변경사항 저장</button>
    </div>
  </form>
</section>
{% endblock %}
{% block scripts %}{% include "admin/_editor.html.twig" %}{% endblock %}
