{% extends "layout.html.twig" %}
{% block body_class %}theme-codex-bloom{% endblock %}
{% block title %}비밀번호 변경 완료 · {{ site.site_name }}{% endblock %}
{% block body %}
<div class="auth-shell">
  <section class="codex-bloom-auth-card codex-bloom-status-card">
    <span class="status-dot"></span>
    <p class="codex-bloom-section-kicker">변경 완료</p>
    <h1>비밀번호를 변경했습니다</h1>
    <p class="codex-bloom-lead">새 비밀번호로 다시 로그인해 주세요.</p>
    <a class="codex-bloom-btn codex-bloom-btn-primary codex-bloom-btn-block" href="{{ url_for('auth.login') }}">로그인</a>
  </section>
</div>
{% endblock %}
