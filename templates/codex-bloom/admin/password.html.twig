{# codex-bloom view: admin/password.html.twig #}
{# codex-bloom view: admin/password.html.twig #}
{% extends "admin/layout.html.twig" %}
{% block title %}관리자 비밀번호 변경 · {{ site.site_name }}{% endblock %}
{% block admin_section %}security{% endblock %}
{% block body %}
<nav class="codex-bloom-admin-crumb" aria-label="현재 위치">
  <a href="{{ url_for('admin.index') }}">관리</a><span>/</span><span>계정 보안</span>
</nav>
<section class="codex-bloom-panel codex-bloom-panel-form codex-bloom-panel-narrow">
  <header class="codex-bloom-panel-head">
    <p class="codex-bloom-section-kicker">Account security</p>
    <h1>비밀번호 변경</h1>
    <p class="codex-bloom-lead">새 비밀번호를 저장하면 모든 기기에서 다시 로그인해야 합니다.</p>
  </header>
  <form class="codex-bloom-form" method="post" action="{{ url_for('admin.password') }}">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <label class="codex-bloom-field">현재 비밀번호<input type="password" name="current_password" autocomplete="current-password" required></label>
    {% if errors.current_password is defined %}<p class="codex-bloom-field-error">{{ errors.current_password }}</p>{% endif %}
    <label class="codex-bloom-field">새 비밀번호 <span class="muted">8자 이상</span><input type="password" name="password" minlength="8" autocomplete="new-password" required></label>
    {% if errors.password is defined %}<p class="codex-bloom-field-error">{{ errors.password }}</p>{% endif %}
    <label class="codex-bloom-field">새 비밀번호 확인<input type="password" name="password_confirmation" minlength="8" autocomplete="new-password" required></label>
    {% if errors.password_confirmation is defined %}<p class="codex-bloom-field-error">{{ errors.password_confirmation }}</p>{% endif %}
    <button class="codex-bloom-btn codex-bloom-btn-primary codex-bloom-btn-block" type="submit">비밀번호 변경</button>
  </form>
  <p class="codex-bloom-form-foot"><a href="{{ url_for('admin.index') }}">관리 화면으로 돌아가기</a></p>
</section>
{% endblock %}
