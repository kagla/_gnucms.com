{# codex-bloom view: posts/_comments.html.twig #}
{# codex-bloom view: posts/_comments.html.twig #}
{% import '_icons.html.twig' as ic %}
<ul class="codex-bloom-comment-list{% if nested|default(false) %} codex-bloom-comment-children{% endif %}">
{% for comment in nodes %}
  <li class="codex-bloom-comment">
    <div class="codex-bloom-comment-head">
      {% if not comment.deleted %}<span class="codex-bloom-comment-author">{{ ic.user() }} {{ comment.author_name }}</span>{% else %}<span class="muted">{{ ic.comment() }} 삭제된 댓글</span>{% endif %}
      <time datetime="{{ comment.created_at }}">{{ ic.calendar() }} {{ comment.created_at }}</time>
      {% if comment.is_secret %}<span class="codex-bloom-tag codex-bloom-tag-muted" title="비밀 댓글">{{ ic.shield() }}</span>{% endif %}
    </div>
    <p class="codex-bloom-comment-body">{{ comment.content|nl2br }}</p>
    {% if comment.children is not empty %}
      {% include 'posts/_comments.html.twig' with {'nodes': comment.children, 'nested': true} only %}
    {% endif %}
  </li>
{% endfor %}
</ul>
