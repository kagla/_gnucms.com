{# codex-bloom view: posts/create.html.twig #}
{% extends "layout.html.twig" %}
{% import '_icons.html.twig' as ic %}
{% block title %}글쓰기 · {{ board.name }} · {{ site.site_name }}{% endblock %}
{% block body %}
<nav class="codex-bloom-crumb" aria-label="현재 위치">
  <a href="{{ url_for('boards.index') }}">{{ ic.home() }} 홈</a><span aria-hidden="true">/</span>
  <a href="{{ url_for('posts.index', {'key': board.board_key}) }}">{{ board.name }}</a><span aria-hidden="true">/</span>
  <span>글쓰기</span>
</nav>
<section class="codex-bloom-editor">
  <header class="codex-bloom-panel-head">
    <p class="codex-bloom-section-kicker">{{ ic.pen() }} New post</p>
    <h1>새 글 작성</h1>
    <p class="codex-bloom-lead">{{ board.name }}에 새로운 이야기를 남겨보세요.</p>
  </header>
  <form class="codex-bloom-form codex-bloom-editor-form" method="post" action="{{ url_for('posts.create', {'key': board.board_key}) }}">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    {% if board.use_category and board.categories is not empty %}
      <label class="codex-bloom-field">분류<select name="category" required><option value="">분류를 선택하세요</option>{% for name in board.categories %}<option value="{{ name }}"{% if values.category|default('') == name %} selected{% endif %}>{{ name }}</option>{% endfor %}</select></label>
      {% if errors.category is defined %}<p class="codex-bloom-field-error">{{ errors.category }}</p>{% endif %}
    {% endif %}
    <label class="codex-bloom-field">제목<input type="text" name="title" value="{{ values.title|default('') }}" maxlength="200" required autofocus></label>
    {% if errors.title is defined %}<p class="codex-bloom-field-error">{{ errors.title }}</p>{% endif %}
    <label class="codex-bloom-field">내용<textarea name="content" rows="12" required>{{ values.content|default('') }}</textarea></label>
    {% if errors.content is defined %}<p class="codex-bloom-field-error">{{ errors.content }}</p>{% endif %}
    {% if board.use_secret %}<label class="codex-bloom-check">{{ ic.shield() }}<input type="checkbox" name="is_secret" value="1"{% if values.is_secret|default(false) %} checked{% endif %}> 비밀글로 작성</label>{% endif %}
    <div class="codex-bloom-form-actions">
      <a class="codex-bloom-btn codex-bloom-btn-ghost" href="{{ url_for('posts.index', {'key': board.board_key}) }}">취소</a>
      <button class="codex-bloom-btn codex-bloom-btn-primary" type="submit">{{ ic.pen() }} 글 등록</button>
    </div>
  </form>
</section>
{% endblock %}
