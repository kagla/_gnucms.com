{% extends "layout.html.twig" %}
{% block title %}게시판 · {{ site.site_name }}{% endblock %}
{% block body %}
  <header class="page-head">
    <div class="page-head-copy">
      <p class="eyebrow">Your community starts here</p>
      <h1>커뮤니티의 시작, {{ site.site_name }}</h1>
      <p class="lead">작은 모임부터 새로운 서비스까지, 필요한 이야기만 담아 가볍게 시작하는 기초 커뮤니티입니다.</p>
    </div>
  </header>
  {% if boards is empty %}
    <div class="surface"><p class="empty">아직 만들어진 게시판이 없습니다.</p></div>
  {% else %}
    <div class="board-grid">
      {% for board in boards %}
        <section class="board-card">
          <a class="board-card-link" href="{{ url_for('posts.index', {'key': board.board_key}) }}">
            <span class="board-name">{{ board.name }}</span>
            <span class="board-description">{{ board.description ?: '새로운 이야기와 소식을 확인해 보세요.' }}</span>
          </a>
          <div class="latest-block">
            <div class="latest-head"><span>최신글</span><a class="latest-more" href="{{ url_for('posts.index', {'key': board.board_key}) }}">전체보기</a></div>
            {% if board.latest_posts is empty %}
              <p class="latest-empty">아직 등록된 글이 없습니다.</p>
            {% else %}
              <ul class="latest-list">
              {% for post in board.latest_posts %}
                <li class="latest-item"><a href="{{ url_for('posts.show', {'id': post.id}) }}">
                  <span class="latest-title">{% if post.is_notice %}<span class="tag">공지</span>{% endif %}{{ post.title }}{% if post.comment_count > 0 %}<span class="latest-comment">{{ post.comment_count }}</span>{% endif %}</span>
                  <time class="latest-date" datetime="{{ post.created_at }}">{{ post.created_at|slice(0, 10) }}</time>
                </a></li>
              {% endfor %}
              </ul>
            {% endif %}
          </div>
        </section>
      {% endfor %}
    </div>
  {% endif %}
{% endblock %}
