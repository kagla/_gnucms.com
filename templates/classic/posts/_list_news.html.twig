{# 뉴스형: 사진 없이 제목과 발췌문 위주. 공지·소식 게시판에 맞는다. #}
{% include 'posts/_notices.html.twig' %}
{% if list.data is empty %}
  <div class="surface"><p class="empty">조건에 맞는 글이 없습니다.</p></div>
{% else %}
  <ol class="news-list surface">
    {% for post in list.data %}
      <li class="news-item">
        <p class="news-head">
          {% if board.use_category and post.category %}<span class="tag tag-quiet">{{ post.category }}</span>{% endif %}
          {% if post.is_secret %}<span class="post-markers" title="비밀글" aria-label="비밀글">●</span>{% endif %}
          <a class="news-title" href="{{ url_for('posts.show', {'id': post.id}) }}">{{ post.title }}</a>
          {% if post.comment_count > 0 %}<span class="comment-count">{{ post.comment_count }}</span>{% endif %}
        </p>
        {% if post.excerpt|default(null) %}<p class="news-excerpt">{{ post.excerpt }}</p>{% endif %}
        <p class="news-meta">
          <span>{{ post.author_name }}</span>
          <span class="dot" aria-hidden="true">·</span>
          <time datetime="{{ post.created_at }}">{{ post.created_at|date('Y.m.d H:i') }}</time>
          <span class="dot" aria-hidden="true">·</span>
          <span>조회 {{ post.view_count }}</span>
          {% if post.file_count > 0 %}<span class="post-markers" title="첨부파일 있음" aria-label="첨부파일 있음">＋</span>{% endif %}
        </p>
      </li>
    {% endfor %}
  </ol>
{% endif %}
