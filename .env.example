# 이 파일을 프로젝트 루트에 .env 로 복사해 필요한 줄만 채운다.
# public/ 안에 두면 안 된다. 평문으로 그대로 내려받힐 수 있다.
#
# 여기 적은 값이 config/config.php 를 이긴다. 반대로 도커나 호스팅 패널이
# 진짜 환경변수로 같은 이름을 주면 그쪽이 이 파일을 이긴다.
#
# 규칙
#   - 빈 값(KEY=)은 "설정하지 않음" 이다. config/config.php 의 값이 그대로 쓰인다.
#     그래서 이 파일을 통째로 복사해도 기존 설정이 바뀌지 않는다.
#   - 값을 실제로 비우려면 KEY=null 이라고 쓴다.
#   - 주석은 줄 전체(#으로 시작)만이다. 값 뒤에 #을 붙여도 주석이 되지 않는다.
#   - 공백이나 따옴표를 값에 넣으려면 "큰따옴표" 또는 '작은따옴표' 로 감싼다.
#   - 여기 없는 이름은 무시된다.

# --- DB -----------------------------------------------------------------
# sqlite:/절대경로/board.sqlite
# mysql:host=localhost;dbname=board;charset=utf8mb4
# pgsql:host=localhost;dbname=board
DB_DSN=
DB_USERNAME=
DB_PASSWORD=

# --- 인증 ---------------------------------------------------------------
# 호스트 앱과 공유하는 시크릿. 32바이트 이상 임의 문자열.
AUTH_SECRET=
# 토큰 유효 시간(초). 기본 3600
AUTH_TTL=
# 만료 허용 오차(초). 기본 60
AUTH_LEEWAY=

# --- 부트스트랩 관리자 --------------------------------------------------
# 호스트 앱을 붙인 뒤에는 아래 한 줄로 이 경로를 닫는다.
# BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_ID=
# password_hash($password, PASSWORD_DEFAULT) 의 결과를 적는다.
BOOTSTRAP_ADMIN_PASSWORD_HASH=

# --- 첨부 ---------------------------------------------------------------
# 절대경로. 기본은 storage/uploads
UPLOADS_DIR=
# 바이트. 기본 5242880 (5MB)
UPLOADS_MAX_BYTES=
# 쉼표로 나눈다. 기본 jpg,jpeg,png,gif,webp,pdf,zip,txt,hwp,doc,docx,xls,xlsx,ppt,pptx
UPLOADS_ALLOWED_EXT=

# --- CORS ---------------------------------------------------------------
# 브라우저가 직접 호출하는 호스트 앱 주소를 쉼표로 나열한다. 와일드카드는 없다.
CORS_ALLOWED_ORIGINS=

# --- 기타 ---------------------------------------------------------------
# 절대경로. 기본은 storage/logs/error.log
LOG_FILE=
# 운영에서는 반드시 false. true 면 오류 응답에 내부 메시지가 실린다.
DEBUG=
