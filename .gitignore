# 실제 설정 (샘플만 커밋한다)
/config/config.php

# 업로드된 첨부
/storage/uploads/*
!/storage/uploads/.gitkeep

# 배포물에는 vendor/ 를 포함해 올리지만, 저장소에는 커밋하지 않는다
/vendor/

# 로컬 테스트 DB
*.sqlite
*.sqlite3

# 로그
/storage/logs/*
!/storage/logs/.gitkeep

# Twig 캐시
/storage/cache/twig/

.DS_Store

# SDD 진행 기록 (스크래치)
/.superpowers/

/.phpunit.cache/
/phpunit.xml
