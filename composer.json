{
    "name": "kagla/gnucms",
    "description": "어느 DB 에서나 도는 게시판",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-openssl": "*",
        "ezyang/htmlpurifier": "^4.19",
        "league/oauth2-client": "^2.8",
        "phpmailer/phpmailer": "^7.1",
        "slim/psr7": "^1.6",
        "slim/slim": "^4.12"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "GnuCms\\": "src/"
        },
        "files": [
            "src/constants.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "GnuCms\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
