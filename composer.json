{
    "name": "kagla/gnucms",
    "description": "MySQL/MariaDB 기반 GNUCMS",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-openssl": "*",
        "ext-phar": "*",
        "ezyang/htmlpurifier": "^4.19",
        "league/oauth2-client": "^2.8",
        "phpmailer/phpmailer": "^7.1",
        "slim/psr7": "^1.6",
        "slim/slim": "^4.12",
        "ext-pdo_mysql": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "suggest": {
        "ext-zip": "PC에서 편리하게 풀 수 있는 ZIP 전체 백업을 생성합니다"
    },
    "autoload": {
        "psr-4": {
            "GnuCms\\": "src/"
        },
        "files": [
            "src/constants.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "GnuCms\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
